# Netlify / Cloudflare Pages syntax — também aplicável em adapters Astro
# Documentado em docs/SECURITY.md

/*
  # HSTS — força HTTPS por 2 anos, inclui subdomínios, elegível para preload
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # Bloqueia sniffing de MIME
  X-Content-Type-Options: nosniff

  # Limita embedding em iframes (clickjacking)
  X-Frame-Options: DENY

  # Política de referer mínima
  Referrer-Policy: strict-origin-when-cross-origin

  # Restringe APIs sensíveis do navegador
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=()

  # CSP — ajustar conforme integrações de terceiros
  # Removido 'unsafe-inline' assim que migrarmos para CSS/JS hospedados (sem cdn.tailwindcss.com)
  # RD Station usa DOIS domínios no script-src: d335luupugsy2 (loader e pop-ups) e
  # d1sag09wwfbul8 (rdtracker.min.js, injetado pelo loader, é quem registra a visita).
  # Faltando o segundo, a tag carrega e mesmo assim nada é monitorado. Os eventos saem
  # para event-harbor.rdstation.com, já coberto pelo connect-src https:.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://code.iconify.design https://d335luupugsy2.cloudfront.net https://d1sag09wwfbul8.cloudfront.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

  # Cross-origin policies
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Cache agressivo para assets imutáveis (Astro adiciona hash no nome)
/_assets/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=604800

/videos/*
  Cache-Control: public, max-age=2592000
