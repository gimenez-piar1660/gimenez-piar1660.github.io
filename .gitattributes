# Normalize line endings — fundamental para times Win/Mac/Linux
* text=auto eol=lf

# Force LF on text
*.astro    text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.svg      text eol=lf

# Binaries
*.png      binary
*.jpg      binary
*.jpeg     binary
*.webp     binary
*.avif     binary
*.gif      binary
*.ico      binary
*.mp4      binary
*.webm     binary
*.woff     binary
*.woff2    binary
*.pdf      binary

# Linguist hints for GitHub
*.astro    linguist-language=Astro
