---
// Layout base: fonte unica de head, SEO, fontes, libs externas e meta.
// Toda pagina .astro consome este layout. CSS/JS especifico da pagina entra
// via slot "head" ou como style/script dentro do conteudo.

import '@styles/global.css';
import { site, INDEXAVEL } from '@/data/site';
import { withBase } from '@/lib/base';
import ConsentimentoCookies from '@components/ConsentimentoCookies.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = '/brand/piar-horizontal-positivo.png',
  noindex = false,
  bodyClass = 'antialiased',
} = Astro.props;

// Enquanto o deploy não é indexável, o noindex vale para tudo. A prop continua
// mandando por página (é assim que o blend em staging fica fora do índice).
const semIndice = noindex || !INDEXAVEL;

const siteName = 'PiaR Group';
const fullTitle = title === siteName || title.includes(siteName)
  ? title
  : `${title} · ${siteName}`;

// og:image e twitter:image pedem URL absoluta. withBase resolve o caminho de
// public/ e Astro.site coloca o domínio na frente.
const ogImageUrl = new URL(withBase(ogImage), Astro.site).href;
---
<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0F0F11" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {semIndice && <meta name="robots" content="noindex,nofollow" />}

    <!-- Ícones -->
    <link rel="icon" href={withBase('/brand/favicon.png')} type="image/png" sizes="144x144" />
    <link rel="apple-touch-icon" href={withBase('/brand/favicon-piar-white-in-black.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- LGPD: a atribuicao de origem (cookie piar_atrib) NAO mora mais aqui.
         Ela e um cookie de marketing, entao passou a ser gravada apenas apos
         consentimento, dentro de src/components/ConsentimentoCookies.astro.
         Nao trazer de volta para o head: rastreador que dispara antes do aceite
         transforma o banner em enfeite. -->

    <!-- Fontes: self-hosted via @fontsource em global.css (pacote npm). -->

    <!-- Libs: bundladas via npm em src/scripts/bootstrap.ts (gsap, ScrollTrigger, lenis, iconify-icon).
         Tailwind: gerado em build time pela integração @astrojs/tailwind. -->
    <script>
      import '@scripts/bootstrap.ts';
    </script>

    <!-- JSON-LD: ProfessionalService (PiaR Group) + Person (CEO), fatos vindos de src/data/site.ts -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'ProfessionalService',
            '@id': `${site.domain}/#organization`,
            name: site.name,
            legalName: site.legalName,
            alternateName: site.alternateNames,
            url: site.domain,
            logo: `${site.domain}/brand/piar-horizontal-positivo.png`,
            image: `${site.domain}/brand/piar-horizontal-positivo.png`,
            email: site.email,
            telephone: site.phoneE164,
            description: `Agência boutique brasileira de relações públicas fundada em ${site.foundingYear}, em ${site.address.locality}. Em ${site.yearsOperating} anos conduziu a comunicação de ${site.brandsServed} marcas e acompanhou ${site.exitsSupported} startups até o exit.`,
            foundingDate: site.foundingYear,
            founder: { '@id': `${site.domain}/#bruno-pinheiro` },
            address: {
              '@type': 'PostalAddress',
              streetAddress: site.address.street,
              addressLocality: site.address.locality,
              addressRegion: site.address.region,
              postalCode: site.address.postalCode,
              addressCountry: site.address.country,
            },
            areaServed: { '@type': 'Country', name: 'Brazil' },
            availableLanguage: ['pt-BR', 'en'],
            knowsAbout: [
              'Relações Públicas',
              'Public Relations',
              'Assessoria de Imprensa',
              'Data PR',
              'Newsjacking',
              'Crisis Communications',
              'Executive Positioning',
              'Earned Media Measurement',
              'AMEC Barcelona Principles',
              'Share of Voice',
              'Fintech Communications',
              'Healthtech Communications',
              'Startup PR',
              'Exit Communications',
            ],
            serviceType: [
              'Narrativa Executiva',
              'Editorial Tier-1',
              'Gestão de Crise',
              'Digital & Social Ops',
            ],
            award: [site.founder.award],
            slogan: site.slogan,
            sameAs: [site.social.linkedin, site.social.instagram],
          },
          {
            '@type': 'Person',
            '@id': `${site.domain}/#bruno-pinheiro`,
            name: site.founder.name,
            jobTitle: site.founder.role,
            worksFor: { '@id': `${site.domain}/#organization` },
            award: [site.founder.award],
            knowsAbout: [
              'Public Relations Strategy',
              'Startup Communications',
              'Exit Communications',
              'Crisis Management',
              'Executive Positioning',
            ],
            knowsLanguage: ['pt-BR', 'en'],
            sameAs: [site.social.linkedin],
          },
        ],
      })}
    />

    <slot name="head" />

    <!-- LGPD: o loader do RD Station tambem saiu daqui. Ele monta um perfil de
         navegacao que vira identificado assim que a pessoa preenche o formulario,
         entao e cookie de marketing e depende de consentimento. A URL do loader
         vive em src/data/site.ts e e injetada por JS em ConsentimentoCookies.astro.
         Os dois dominios do RD continuam liberados no script-src do CSP. -->
  </head>
  <body class={bodyClass}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-black focus:text-white focus:px-4 focus:py-2 focus:rounded"
    >
      Pular para o conteúdo
    </a>
    <slot />
    <ConsentimentoCookies />
  </body>
</html>
