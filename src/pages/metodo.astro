---
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import { site } from '@/data/site';

// Conteúdo portado de project/artifacts/contents/metodo/draft.md (voice-backed).
// Decisões aplicadas (mesma régua da pep.astro):
// - exits travado em 8 e nomeados (D-IDENT-3); prêmio padronizado ABStartups 2018 (D-IDENT-5).
// - e-mail canônico hello@piar.group via site.email (D-IDENT-1); telefone/WhatsApp só em /contato (D-IDENT-2).
// - Aarin removido das citações públicas (autorização não confirmada); sem Bunsen, Primis, Liquid.
// - Seção "Notas de prova e pendências (uso interno)" e itens [a confirmar] descartados.

// Os cinco pilares editoriais — sobre o que a empresa fala.
const pilares = [
  { id: '01', nome: 'Reputação', tese: 'Confiança, conformidade e resposta a momentos sensíveis.', desc: 'O que a empresa diz quando o assunto é confiança, conformidade, segurança e a forma como ela responde a momentos sensíveis. É o pilar que protege a percepção de longo prazo.', icon: 'solar:shield-check-line-duotone', tom: 'paper' },
  { id: '02', nome: 'Influência', tese: 'Posição nas pautas de mercado e de categoria.', desc: 'Posicionamento em pautas de mercado e de categoria, em que a empresa entra na conversa que veículos e analistas já conduzem.', icon: 'solar:graph-up-line-duotone', tom: 'yellow' },
  { id: '03', nome: 'Líderes', tese: 'Autoridade pública de fundadores e executivos.', desc: 'Construção de autoridade das pessoas à frente da empresa, com fundadores e executivos assumindo posição pública sobre temas que dominam.', icon: 'solar:crown-line-duotone', tom: 'paper' },
  { id: '04', nome: 'Propósito', tese: 'O porquê da empresa, em narrativa verificável.', desc: 'O porquê da empresa existir e os compromissos que ela sustenta, traduzidos em narrativa verificável e não em discurso genérico.', icon: 'solar:compass-line-duotone', tom: 'dark' },
  { id: '05', nome: 'Bastidores', tese: 'O como por trás do produto e da operação.', desc: 'O como por trás do produto e da operação, com decisões, processos e aprendizados que dão textura à história e geram pauta de profundidade.', icon: 'solar:layers-minimalistic-line-duotone', tom: 'paper' },
];

// As seis fórmulas editoriais (F01 a F06) — como a pauta é construída.
const formulas = [
  { id: 'F01', nome: 'Inversão', desc: 'Parte de uma crença aceita no mercado e mostra, com dado, por que ela não se sustenta.' },
  { id: 'F02', nome: 'Custo Oculto', desc: 'Expõe o preço escondido de uma prática comum, traduzindo em número o que costuma passar despercebido.' },
  { id: 'F03', nome: 'Diagnóstico', desc: 'Lê um cenário a partir dos dados do cliente e nomeia o problema antes de propor leitura.' },
  { id: 'F04', nome: 'Reescrita', desc: 'Pega uma narrativa já circulando e a recontextualiza com informação nova e verificável.' },
  { id: 'F05', nome: 'Linha do Tempo', desc: 'Organiza fatos em sequência para mostrar evolução, tendência ou ponto de virada.' },
  { id: 'F06', nome: 'Manifesto', desc: 'Assume uma posição pública sobre um tema, sustentada por princípio e por prova.' },
];

// O método de quatro movimentos — o ritmo de execução.
const movimentos = [
  { num: '01', nome: 'Hipótese', titulo: 'Antes da pauta, a aposta editorial.', desc: 'Formulamos a aposta editorial. Qual dado, qual ângulo, qual veículo e por que agora. Nada avança sem hipótese explícita.' },
  { num: '02', nome: 'Cadência', titulo: 'Presença constante, sem volume vazio.', desc: 'Definimos o ritmo de produção e de oferta de pauta, para que a presença seja constante sem virar volume vazio.' },
  { num: '03', nome: 'Distribuição', titulo: 'Oferta sob medida, nunca lista única.', desc: 'Levamos a pauta a quem cobre o tema, com relacionamento direto e oferta sob medida por veículo, nunca por lista única.' },
  { num: '04', nome: 'Loop', titulo: 'O que foi medido alimenta o próximo ciclo.', desc: 'Lemos o que foi publicado, o que rendeu e o que não rendeu, e devolvemos o aprendizado para a próxima hipótese.' },
];

// Do método ao processo: quatro etapas com prazo.
const etapas = [
  { id: '01', nome: 'Diagnóstico e Mapeamento', prazo: 'Semanas 1 e 2', desc: 'Levantamos o dado interno, a mídia-alvo e os pilares aplicáveis. Definimos as hipóteses iniciais.' },
  { id: '02', nome: 'Messaging Framework', prazo: 'Semanas 3 e 4', desc: 'Consolidamos posicionamento, mensagens-chave e as fórmulas que dão forma às pautas. São 14 dias do briefing ao primeiro framework.' },
  { id: '03', nome: 'Ativação Editorial', prazo: 'Semanas 5 a 12', desc: 'Entram cadência, produção e distribuição. As pautas começam a circular junto à imprensa.', accent: true },
  { id: '04', nome: 'Monitoramento e Escala', prazo: 'Quinzenal', desc: 'Roda o loop em ciclo quinzenal, com leitura de resultado e ajuste de hipótese.' },
];

// Onde o método encontra os Projetos Especiais de PR (PEP) — seis vetores.
const vetores = [
  { nome: 'Palco', desc: 'Presença em eventos e momentos de exposição pública.' },
  { nome: 'Conversa', desc: 'Relacionamento direto e diálogo com públicos e imprensa.' },
  { nome: 'Narrativa', desc: 'Construção da história central do projeto.' },
  { nome: 'Cadência', desc: 'Ritmo de presença ao longo do projeto.' },
  { nome: 'Alcance', desc: 'Ampliação do público que a iniciativa atinge.' },
  { nome: 'Veículo', desc: 'Definição dos canais e meios que carregam a mensagem.' },
];

// Clientes liberados (sem Aarin, sem cases não confirmados). Exits nomeados separados.
const exitsNomeados = ['Axado', 'Trustvox', 'ViaNuvem', 'Konduto', 'Getrak', 'GrandChef', 'Xtech Commerce', 'Supermercado Now'];
const clientes = ['Endemol Shine Brasil', 'Solides', 'Mastercard Agro', 'AgroSmart', 'Vila 11', 'Doctoralia'];

const faq = [
  {
    q: 'O método serve para qualquer empresa?',
    a: 'Ele foi desenhado para startups, scale-ups e empresas de tecnologia. O ponto de partida é sempre o dado interno e a mídia-alvo, então funciona melhor onde existe informação própria que sustente pauta.',
  },
  {
    q: 'Em quanto tempo vejo o primeiro entregável?',
    a: 'São 14 dias do briefing ao primeiro Messaging Framework. A produção editorial entra a partir da semana 5, na etapa de Ativação Editorial.',
  },
  {
    q: 'A PiaR faz disparo de release para muitos veículos de uma vez?',
    a: 'Não. Disparo de release em massa não é estratégia, é ruído. A distribuição é direta, com oferta de pauta montada por veículo e por editoria.',
  },
  {
    q: 'Os cinco pilares são fixos para todo cliente?',
    a: 'Não. A combinação de pilares é definida no diagnóstico, conforme o objetivo e o setor. Nem todo cliente usa os cinco ao mesmo tempo.',
  },
  {
    q: 'Qual a diferença entre o trabalho contínuo e o PEP?',
    a: 'O trabalho contínuo roda o método em ciclo permanente. O PEP é um projeto com escopo fechado, montado por vetores, para iniciativas específicas que pedem mobilização concentrada.',
  },
  {
    q: 'Os conteúdos passam por aprovação jurídica?',
    a: 'Sim. 100% dos ativos passam por revisão jurídica antes de irem a público.',
  },
  {
    q: 'Como começo?',
    a: `Pelo formulário de diagnóstico. A PiaR responde em até 1 dia útil. Para contato direto, escreva para ${site.email}.`,
  },
];
---
<BaseLayout
  title="Método PiaR: do dado e da mídia-alvo à pauta publicável"
  description="O método da PiaR Group: cinco pilares, seis fórmulas e quatro movimentos. A pauta nasce do dado interno e da mídia-alvo, não do release pronto. Disparo em massa não é estratégia."
  canonical={`${site.domain}/metodo`}
>
  <Fragment slot="head">
    <style is:global>
      :root {
        --accent: #FED136;
        --accent-deep: #E0B420;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body { font-family: var(--font-sans); background: var(--paper); color: var(--primary); overflow-x: hidden; -webkit-font-smoothing: antialiased; font-feature-settings: "ss01", "cv11"; }
      ::selection { background: var(--primary); color: var(--accent); }
      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: rgba(0,0,0,.12); border-radius: 10px; }
      html.lenis { height: auto; }
      .lenis.lenis-smooth { scroll-behavior: auto; }

      .ds-body-lg { font-size: 1.25rem; font-weight: 400; line-height: 1.5; letter-spacing: -.01em; }
      .ds-body { font-size: 1.0625rem; font-weight: 400; line-height: 1.55; letter-spacing: -.01em; }
      .ds-body-sm { font-size: .875rem; font-weight: 400; line-height: 1.55; }
      .ds-mono { font-family: var(--font-mono); font-size: .72rem; letter-spacing: -.01em; text-transform: uppercase; }
      .italic-serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -.02em; }

      .reveal { opacity: 0; transform: translateY(2rem); transition: var(--t-smooth); }
      .reveal.active { opacity: 1; transform: none; }
      .delay-100 { transition-delay: .1s; } .delay-200 { transition-delay: .2s; }
      .delay-300 { transition-delay: .3s; } .delay-400 { transition-delay: .4s; }

      #scroll-progress { position: fixed; top: 0; left: 0; height: 2px; background: var(--accent); z-index: 9999; width: 0; transition: width .1s linear; }

      .eyebrow-dot { display: inline-flex; align-items: center; gap: .55rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; color: var(--text-muted); font-weight: 600; }
      .eyebrow-dot::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex-shrink: 0; box-shadow: 0 0 0 4px rgba(254,209,54,.18); }
      .eyebrow-dot.on-dark { color: rgba(255,255,255,.72); }

      .ink-pill { display: inline-flex; align-items: center; gap: .55rem; padding: .85rem 1.6rem; border-radius: var(--radius-btn); background: var(--primary); color: var(--paper); border: 1.5px solid var(--primary); font-size: .94rem; font-weight: 500; transition: var(--t-smooth); text-decoration: none; }
      .ink-pill:hover { background: #000; transform: translateY(-2px); box-shadow: 0 14px 28px rgba(0,0,0,.18); }
      .ink-pill iconify-icon { transition: transform .4s var(--ease-out-expo); }
      .ink-pill:hover iconify-icon { transform: translateX(4px); }
      .ink-pill.yellow { background: var(--accent); color: var(--primary); border-color: var(--accent); }
      .ink-pill.yellow:hover { background: #FFD84A; box-shadow: 0 14px 28px rgba(254,209,54,.32); }
      .outline-pill { display: inline-flex; align-items: center; gap: .55rem; padding: .85rem 1.55rem; border-radius: var(--radius-btn); background: #fff; color: var(--primary); border: 1.5px solid var(--primary); font-size: .94rem; font-weight: 500; transition: var(--t-smooth); text-decoration: none; }
      .outline-pill:hover { background: var(--primary); color: var(--paper); }

      /* ============================================================
         HERO PARALLAX — 4 camadas com profundidades distintas
         ============================================================ */
      .hero-parallax {
        position: relative; min-height: 100vh; min-height: 100svh; padding: 11rem 1.5rem 6rem;
        overflow: hidden; isolation: isolate;
      }
      .hero-parallax .hero-grid {
        position: absolute; inset: -10% 0; z-index: 0;
        background-image:
          linear-gradient(rgba(15,15,17,.05) 1px, transparent 1px),
          linear-gradient(90deg, rgba(15,15,17,.05) 1px, transparent 1px);
        background-size: 60px 60px;
        will-change: transform;
      }
      .hero-parallax .hero-aurora {
        position: absolute; inset: -15% -10% -10%; z-index: 1; pointer-events: none;
        background:
          radial-gradient(45% 35% at 78% 22%, rgba(254,209,54,.32) 0%, rgba(254,209,54,0) 65%),
          radial-gradient(35% 30% at 12% 85%, rgba(255,122,26,.18) 0%, transparent 65%);
        will-change: transform; filter: blur(2px);
      }
      .hero-parallax .hero-watermark {
        position: absolute; left: -2%; bottom: 8%; z-index: 1;
        font-family: var(--font-serif); font-style: italic; font-weight: 400;
        font-size: clamp(10rem, 28vw, 28rem); line-height: .8; letter-spacing: -.04em;
        color: rgba(15,15,17,.04); pointer-events: none; user-select: none; white-space: nowrap;
        will-change: transform;
      }
      .hero-parallax .hero-content { position: relative; z-index: 3; max-width: 1400px; margin: 0 auto; }
      .hero-parallax .hero-floater {
        position: absolute; right: 8%; top: 38%; z-index: 4;
        display: inline-flex; align-items: center; gap: .55rem;
        padding: .65rem 1.2rem; border-radius: var(--radius-pill); background: #fff;
        border: 1px solid var(--hairline-strong); box-shadow: 0 14px 32px rgba(0,0,0,.06);
        font-family: var(--font-mono); font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; font-weight: 600;
        will-change: transform;
      }
      .hero-parallax .hero-floater::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
      @media (max-width: 900px) { .hero-parallax .hero-floater { display: none; } }

      .hero-h1 { display: block; }
      .hero-h1 .line { display: block; }
      .hero-h1 em { color: var(--accent-deep); font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -.02em; }

      /* ============================================================
         FRENTES · 4 retratos circulares + arcos orbitais amarelos
         ============================================================ */
      .frentes-constellation { position: relative; padding: 6rem 0; }
      .frentes-constellation .arcs { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
      .frentes-constellation .arcs path { stroke: var(--accent); stroke-width: 1.5; fill: none; opacity: .55; stroke-linecap: round; }
      .frente-orb { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; max-width: 320px; text-align: center; margin-inline: auto; }
      .frente-orb .orb-wrap { position: relative; width: 220px; height: 220px; }
      .frente-orb .orb { width: 100%; height: 100%; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; box-shadow: 0 24px 48px rgba(0,0,0,.06); transition: var(--t-smooth); position: relative; }
      .frente-orb .orb iconify-icon { font-size: 4.2rem; position: relative; z-index: 1; }
      .frente-orb:hover .orb { transform: scale(1.04); box-shadow: 0 32px 64px rgba(0,0,0,.1); }
      .frente-orb.paper .orb { background: #fff; border: 1px solid var(--hairline); color: var(--primary); }
      .frente-orb.paper .orb::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(60% 40% at 70% 30%, rgba(254,209,54,.1) 0%, transparent 65%); }
      .frente-orb.yellow .orb { background: var(--accent); color: var(--primary); }
      .frente-orb.dark .orb { background: linear-gradient(135deg, #1A1A1D 0%, #0F0F11 100%); color: var(--accent); }
      .frente-orb.dark .orb::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(60% 40% at 70% 30%, rgba(254,209,54,.18) 0%, transparent 65%); }
      .frente-orb .satellite { position: absolute; right: -6px; bottom: 18px; width: 52px; height: 52px; border-radius: 50%; background: #fff; border: 1px solid var(--hairline); display: flex; align-items: center; justify-content: center; color: var(--primary); text-decoration: none; box-shadow: 0 8px 20px rgba(0,0,0,.08); transition: var(--t-smooth); z-index: 2; }
      .frente-orb .satellite:hover { background: var(--accent); transform: scale(1.1); box-shadow: 0 12px 28px rgba(254,209,54,.32); }
      .frente-orb .satellite iconify-icon { font-size: 1.15rem; }
      .frente-orb .orb-meta .frente-id { font-family: var(--font-mono); font-size: .65rem; letter-spacing: .22em; color: var(--text-faint); text-transform: uppercase; display: block; margin-bottom: .5rem; }
      .frente-orb .orb-meta .frente-nome { font-size: 1.25rem; font-weight: 600; letter-spacing: -.02em; line-height: 1.15; }
      .frente-orb .orb-meta .frente-tese { font-family: var(--font-serif); font-style: italic; font-size: .95rem; line-height: 1.4; color: var(--text-muted); max-width: 24ch; margin-inline: auto; margin-top: .65rem; }
      @media (max-width: 900px) {
        .frentes-constellation .arcs { display: none; }
        .frente-orb .orb-wrap { width: 180px; height: 180px; }
      }

      /* ============================================================
         PINNED NARRATIVE — sticky steps · 4 movimentos
         ============================================================ */
      .pinned-stage { position: relative; }
      .pinned-stage .stage-grid { display: grid; grid-template-columns: 1fr; gap: 0; }
      @media (min-width: 1024px) { .pinned-stage .stage-grid { grid-template-columns: 5fr 6fr; } }
      .pinned-stage .stage-sticky {
        position: sticky; top: 6rem; align-self: start;
        padding: 4rem 2rem; min-height: 60vh; display: flex; flex-direction: column; justify-content: center;
      }
      @media (max-width: 1023px) { .pinned-stage .stage-sticky { position: static; padding: 3rem 1.5rem 1rem; min-height: 0; } }
      .pinned-stage .stage-sticky .stage-eyebrow { display: block; margin-bottom: 1.5rem; }
      .pinned-stage .stage-sticky .stage-headline { font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 700; letter-spacing: -.04em; line-height: 1; }
      .pinned-stage .stage-sticky .stage-headline em { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--accent-deep); }
      .pinned-stage .stage-list { display: flex; flex-direction: column; gap: 1.5rem; padding: 4rem 2rem; }
      .pinned-stage .step-card {
        position: relative; padding: 2.5rem 2rem 2.25rem; border-radius: 24px;
        background: #fff; border: 1px solid var(--hairline);
        transition: var(--t-smooth);
      }
      .pinned-stage .step-card.is-active { background: var(--primary); border-color: var(--primary); color: var(--paper); transform: translateX(-8px); box-shadow: 0 30px 60px rgba(0,0,0,.16); }
      .pinned-stage .step-card.is-active .step-num { color: var(--accent); }
      .pinned-stage .step-card.is-active .step-name em { color: var(--accent); }
      .pinned-stage .step-card.is-active .step-desc { color: rgba(255,255,255,.7); }
      .pinned-stage .step-card.is-active .step-metric { background: rgba(254,209,54,.12); border-color: rgba(254,209,54,.32); color: var(--accent); }
      .pinned-stage .step-card .step-head { display: flex; align-items: baseline; gap: 1rem; }
      .pinned-stage .step-card .step-num { font-family: var(--font-mono); font-size: 1rem; letter-spacing: .12em; color: var(--text-faint); font-weight: 700; transition: color .4s; }
      .pinned-stage .step-card .step-name { font-size: 1.85rem; font-weight: 600; letter-spacing: -.025em; line-height: 1.1; }
      .pinned-stage .step-card .step-name em { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--text-muted); transition: color .4s; }
      .pinned-stage .step-card .step-titulo { font-size: 1.1rem; font-weight: 500; margin-top: 1.25rem; max-width: 48ch; line-height: 1.3; }
      .pinned-stage .step-card .step-desc { font-size: .95rem; color: var(--text-muted); line-height: 1.55; margin-top: 1rem; max-width: 56ch; transition: color .4s; }
      .pinned-stage .step-card .step-metric { display: inline-flex; align-items: baseline; gap: .5rem; padding: .5rem 1rem; border-radius: var(--radius-pill); background: var(--paper-lifted); border: 1px solid var(--hairline); margin-top: 1.5rem; transition: all .4s; }
      .pinned-stage .step-card .step-metric .ml { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .2em; text-transform: uppercase; }
      .pinned-stage .step-card .step-metric .mv { font-weight: 700; font-size: 1.05rem; letter-spacing: -.01em; }

      /* ============================================================
         NÚCLEO · CINTURÃO · ORBITAL · adaptado pro método
         ============================================================ */
      .protocol-section {
        position: relative; padding: 6rem 1.5rem; overflow: hidden;
        background: var(--primary); color: #fff;
      }
      .protocol-section::before {
        content: ''; position: absolute; inset: 0; opacity: .5;
        background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
        background-size: 80px 80px;
      }
      .protocol-grid { position: relative; max-width: 1400px; margin: 0 auto; display: grid; gap: 3rem; grid-template-columns: 1fr; align-items: center; }
      @media (min-width: 1024px) { .protocol-grid { grid-template-columns: 1fr 1.1fr; } }
      .protocol-orbit { position: relative; aspect-ratio: 1 / 1; max-width: 520px; margin: 0 auto; will-change: transform; }
      .protocol-orbit svg { width: 100%; height: 100%; }
      .protocol-orbit .ring { fill: none; stroke: rgba(254,209,54,.35); stroke-width: 1; stroke-dasharray: 3 6; }
      .protocol-orbit .ring-mid { stroke: rgba(254,209,54,.55); stroke-dasharray: 0; stroke-width: 1.4; }
      .protocol-orbit .node { fill: var(--accent); }
      .protocol-orbit .node-label { font-family: var(--font-mono); font-size: 9px; letter-spacing: .18em; text-transform: uppercase; fill: rgba(255,255,255,.6); }
      .protocol-orbit .center-text { font-family: var(--font-sans); fill: #fff; font-weight: 600; font-size: 17px; }
      .protocol-orbit .center-sub { font-family: var(--font-mono); fill: var(--accent); font-size: 9px; letter-spacing: .22em; text-transform: uppercase; }

      .protocol-row { display: flex; gap: 1rem; padding: 1.5rem 1.75rem; border-radius: 18px; transition: var(--t-smooth); }
      .protocol-row.paper-card { background: var(--paper); color: var(--primary); box-shadow: 0 24px 48px rgba(0,0,0,.32); }
      .protocol-row.paper-card .p-id { color: var(--accent-deep); opacity: 1; }
      .protocol-row.paper-card .p-titulo em { color: var(--accent-deep); }
      .protocol-row.yellow { background: var(--accent); color: var(--primary); }
      .protocol-row.dark { background: rgba(255,255,255,.04); border: 1px solid rgba(254,209,54,.28); }
      .protocol-row .p-id { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; font-weight: 700; opacity: .78; display: block; margin-bottom: .5rem; }
      .protocol-row.yellow .p-id { color: rgba(15,15,17,.7); opacity: 1; }
      .protocol-row.dark .p-id { color: var(--accent); opacity: 1; }
      .protocol-row .p-titulo { font-size: 1.15rem; font-weight: 600; letter-spacing: -.02em; line-height: 1.25; }
      .protocol-row .p-titulo em { font-family: var(--font-serif); font-style: italic; font-weight: 400; }
      .protocol-row .p-desc { font-size: .92rem; line-height: 1.5; margin-top: .5rem; opacity: .85; }
      .protocol-row.yellow .p-desc { color: rgba(15,15,17,.75); opacity: 1; }

      /* ============================================================
         PRINCÍPIO SPOTLIGHT · big stadium · parallax discreto
         ============================================================ */
      .spotlight {
        position: relative; padding: clamp(4rem, 8vw, 7rem) clamp(2rem, 5vw, 5rem);
        border-radius: var(--radius-stadium); overflow: hidden;
        background:
          radial-gradient(50% 50% at 80% 22%, rgba(254,209,54,.22) 0%, rgba(254,209,54,0) 65%),
          linear-gradient(160deg, #1A1A1D 0%, #0F0F11 60%, #050507 100%);
        color: #fff;
      }
      .spotlight .ghost-mark {
        position: absolute; top: -2rem; right: -1rem; z-index: 0;
        font-family: var(--font-serif); font-style: italic; font-weight: 400;
        font-size: clamp(8rem, 24vw, 22rem); line-height: .8; letter-spacing: -.04em;
        color: rgba(254,209,54,.05); pointer-events: none; user-select: none;
        white-space: nowrap; will-change: transform;
      }
      .spotlight .ghost-mark.left { left: -2rem; right: auto; top: auto; bottom: -3rem; color: rgba(255,255,255,.04); }
      .spotlight .spotlight-content { position: relative; z-index: 1; max-width: 60rem; }

      /* ============================================================
         COMPANION SERVICES · pill carousel
         ============================================================ */
      .companion-row { display: flex; gap: .75rem; flex-wrap: wrap; }
      .companion-row .pill {
        padding: .85rem 1.4rem; border-radius: var(--radius-pill);
        background: #fff; border: 1px solid var(--hairline);
        font-size: .9rem; font-weight: 500; letter-spacing: -.01em;
        display: inline-flex; align-items: center; gap: .5rem;
        transition: var(--t-smooth);
      }
      .companion-row .pill iconify-icon { color: var(--accent-deep); font-size: 1.1rem; }
      .companion-row .pill:hover { background: var(--primary); color: var(--paper); border-color: var(--primary); transform: translateY(-2px); }
      .companion-row .pill:hover iconify-icon { color: var(--accent); }

      /* ============================================================
         FÓRMULAS · grid de cards de argumento (F01–F06)
         ============================================================ */
      .formula-card { padding: 1.85rem 1.6rem; border-radius: 20px; background: #fff; border: 1px solid var(--hairline); transition: var(--t-smooth); }
      .formula-card:hover { border-color: rgba(254,209,54,.5); transform: translateY(-3px); box-shadow: 0 18px 36px rgba(0,0,0,.06); }
      .formula-card .f-id { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--accent-deep); font-weight: 700; }
      .formula-card .f-name { font-size: 1.3rem; font-weight: 600; letter-spacing: -.02em; margin-top: .55rem; }
      .formula-card .f-desc { font-size: .92rem; line-height: 1.55; color: var(--text-muted); margin-top: .65rem; }

      /* ============================================================
         ETAPAS · linha do processo com prazo
         ============================================================ */
      .etapa-card { padding: 1.85rem 1.6rem; border-radius: 18px; background: #fff; border: 1px solid var(--hairline); }
      .etapa-card.is-accent { background: var(--primary); border-color: var(--primary); color: var(--paper); }
      .etapa-card .e-id { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--accent-deep); font-weight: 700; }
      .etapa-card.is-accent .e-id { color: var(--accent); }
      .etapa-card .e-titulo { font-size: 1.2rem; font-weight: 600; letter-spacing: -.02em; margin-top: .55rem; }
      .etapa-card .e-prazo { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text-faint); margin-top: .35rem; display: block; }
      .etapa-card.is-accent .e-prazo { color: var(--accent); }
      .etapa-card .e-desc { font-size: .9rem; line-height: 1.55; color: var(--text-muted); margin-top: .7rem; }
      .etapa-card.is-accent .e-desc { color: rgba(255,255,255,.7); }

      /* ============================================================
         CHIP · clientes e exits
         ============================================================ */
      .chip-pill { display: inline-flex; align-items: center; gap: .5rem; padding: .55rem 1.1rem; border-radius: var(--radius-pill); font-family: var(--font-mono); font-size: .68rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; background: #fff; color: var(--primary); border: 1px solid var(--hairline); }
      .chip-pill.on-dark { background: rgba(255,255,255,.06); color: #fff; border-color: rgba(255,255,255,.18); }

      /* ============================================================
         FAQ · acordeão (mesmo idioma visual da pep.astro)
         ============================================================ */
      .faq-item { border-bottom: 1px solid var(--hairline); }
      .faq-item:last-child { border-bottom: 0; }
      .faq-item summary { list-style: none; cursor: pointer; padding: 1.5rem 0; display: flex; justify-content: space-between; align-items: center; gap: 2rem; font-size: 1.1rem; font-weight: 500; letter-spacing: -.01em; color: var(--primary); transition: color .3s; }
      .faq-item summary::-webkit-details-marker { display: none; }
      .faq-item summary:hover { color: var(--accent-deep); }
      .faq-item summary iconify-icon { transition: transform .4s var(--ease-out-expo); font-size: 1.5rem; color: var(--text-faint); flex-shrink: 0; }
      .faq-item[open] summary iconify-icon { transform: rotate(45deg); color: var(--accent-deep); }
      .faq-item .faq-body { padding: 0 0 1.5rem; color: var(--text-muted); max-width: 70ch; line-height: 1.6; }

      @media (max-width: 768px) {
        .hero-parallax { padding: 9rem 1.25rem 4rem; min-height: 80vh; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
        .reveal { opacity: 1 !important; transform: none !important; }
      }
    </style>

