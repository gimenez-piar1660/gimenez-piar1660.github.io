  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      gsap.registerPlugin(ScrollTrigger);

      // Lenis smooth scroll · drive ScrollTrigger from lenis frames
      if (!prefersReduced) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smooth: true,
          lerp: 0.1,
        });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);
      }

      // Reveal observer · igual às outras páginas
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('active'); io.unobserve(e.target); }
        });
      }, { threshold: 0.15 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Scroll progress bar
      const progressBar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', () => {
        const h = document.documentElement;
        const p = (h.scrollTop) / (h.scrollHeight - h.clientHeight) * 100;
        if (progressBar) progressBar.style.width = p + '%';
      }, { passive: true });

      // ============================================================
      // PARALLAX · qualquer elemento com data-parallax-y="N" se move
      // N% do tamanho do viewport conforme entra/sai de cena.
      // Negativo = sobe (mais lento que o scroll natural · profundidade)
      // Positivo = desce (mais rápido · vem em direção à câmera)
      // ============================================================
      if (!prefersReduced) {
        gsap.utils.toArray('[data-parallax-y]').forEach((el) => {
          const yPercent = parseFloat(el.getAttribute('data-parallax-y')) || 0;
          gsap.fromTo(el,
            { yPercent: 0 },
            {
              yPercent: yPercent,
              ease: 'none',
              scrollTrigger: {
                trigger: el,
                start: 'top bottom',
                end: 'bottom top',
                scrub: true,
              },
            }
          );
        });

        // ============================================================
        // PINNED NARRATIVE · destaca o step ativo conforme ele encosta
        // no centro da viewport. Move .step-card.is-active e atualiza
        // o label "NN / 04" + a barra de progresso.
        // ============================================================
        const stepCards = gsap.utils.toArray('.step-card');
        const progressLabel = document.getElementById('stage-progress-label');
        const progressBar2 = document.getElementById('stage-progress-bar');
        const totalSteps = stepCards.length;
        stepCards.forEach((card, idx) => {
          ScrollTrigger.create({
            trigger: card,
            start: 'top 60%',
            end: 'bottom 40%',
            onEnter: () => activate(card, idx),
            onEnterBack: () => activate(card, idx),
          });
        });
        function activate(card, idx) {
          stepCards.forEach((c) => c.classList.remove('is-active'));
          card.classList.add('is-active');
          if (progressLabel) progressLabel.textContent = String(idx + 1).padStart(2, '0') + ' / ' + String(totalSteps).padStart(2, '0');
          if (progressBar2) progressBar2.style.width = ((idx + 1) / totalSteps * 100) + '%';
        }
        // Ativa o primeiro por padrão
        if (stepCards[0]) stepCards[0].classList.add('is-active');
      }
    });
  </script>
