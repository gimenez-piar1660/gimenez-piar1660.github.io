  <div id="scroll-progress"></div>

  <Nav current="insights" />

  <main id="main">
    <!-- 1 · HERO -->
    <section class="gtm-hero">
      <canvas id="gtm-hero-canvas" aria-hidden="true"></canvas>
      <div class="scrim" aria-hidden="true"></div>
      <span class="gtm-hero-float f1 px" data-parallax-y="28" aria-hidden="true"><span class="dot"></span>Produto</span>
      <span class="gtm-hero-float f2 px" data-parallax-y="-20" aria-hidden="true"><span class="dot"></span>Mercado</span>
      <span class="gtm-hero-float f3 px" data-parallax-y="22" aria-hidden="true"><span class="dot"></span>Imprensa</span>
      <div class="wrap hero-inner">
        <span class="gtm-hero-chip reveal"><span class="dot"></span>Go-to-Market · Earned media como canal</span>
        <h1 class="reveal d1">A comunicação que faz um lançamento ser <span class="accent-serif on-dark">ouvido</span>.</h1>
        <p class="sub reveal d2">
          Produto, mercado e imprensa apontam para o mesmo ponto de lançamento. Quando a comunicação chega sincronizada, a pessoa que decide a compra já leu sobre você antes de a venda começar.
        </p>
        <div class="cta-row reveal d3">
          <a href="/contato" class="btn btn-accent">Avaliar PR no seu go-to-market<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
          <a href="#virada" class="btn btn-ghost-d">Ver como funciona<iconify-icon icon="solar:alt-arrow-down-linear"></iconify-icon></a>
        </div>
      </div>
      <span class="gtm-scroll-cue" aria-hidden="true"><span>Role</span><span class="line"></span></span>
    </section>

    <!-- 2 · A VIRADA · imagem vs go-to-market -->
    <section id="virada" class="section paper has-ghost">
      <span class="ghost-mark tr px" data-parallax-y="-16" aria-hidden="true">pipeline</span>
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">A virada</span>
          <h2>A imprensa não é custo de imagem. É canal de <span class="accent-serif">entrada</span>.</h2>
          <p class="lede">A diferença em relação ao PR tradicional é o objetivo. PR de imagem mede a saída na mídia. PR como go-to-market mede o que essa saída provoca no funil: tráfego de intenção, leads que chegam citando uma matéria, contas que avançam mais rápido.</p>
        </div>
        <div class="compare">
          <div class="compare-card reveal">
            <span class="ctag">PR de imagem</span>
            <h3>Mede a saída na mídia.</h3>
            <p>Conta quantas matérias saíram e qual o alcance. A cobertura é o destino, e o relatório para quando a marca apareceu. Vaidade que não responde à pergunta do CEO.</p>
            <div class="steps"><span>Release</span><iconify-icon icon="solar:arrow-right-linear"></iconify-icon><span>Matéria</span><iconify-icon icon="solar:arrow-right-linear"></iconify-icon><span>Alcance</span></div>
          </div>
          <div class="compare-card is-dark reveal d1">
            <span class="ctag">PR como go-to-market</span>
            <h3>Mede o que a matéria provoca.</h3>
            <p>A cobertura abre a conversa de vendas. O decisor chega tendo lido sobre o problema, a categoria e a empresa em um veículo que ele confia. A dúvida sobre legitimidade já está resolvida.</p>
            <div class="steps"><span>Dado</span><iconify-icon icon="solar:arrow-right-linear"></iconify-icon><span>Pauta</span><iconify-icon icon="solar:arrow-right-linear"></iconify-icon><span>Confiança</span><iconify-icon icon="solar:arrow-right-linear"></iconify-icon><span>Pipeline</span></div>
          </div>
        </div>
        <p class="punch reveal d1">Paga amplifica uma mensagem que o mercado ainda não validou. Earned <span class="hl">valida</span>.</p>
      </div>
    </section>

    <!-- 3 · TRES FORCAS -->
    <section class="section warm">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">Por que funciona como canal</span>
          <h2>Três forças tornam earned media um canal de <span class="accent-serif">aquisição</span>.</h2>
          <p class="lede">Investidores e compradores apostam em sinais de validação externa. A imprensa é um dos mais fortes. Por isso PR entra antes da mídia paga, não depois.</p>
        </div>
        <div class="layers">
          {forcas.map((c, i) => (
            <div class:list={['layer-card', 'reveal', i === 1 && 'd1', i === 2 && 'd2', c.featured && 'featured']}>
              {c.featured && <span class="badge">O fio que liga tudo</span>}
              <div class="l-icon"><iconify-icon icon={c.icon}></iconify-icon></div>
              <div class="l-id">{c.id}</div>
              <div class="l-name">{c.nome}</div>
              <p class="l-otimiza">{c.desc}</p>
            </div>
          ))}
        </div>
        <p class="punch reveal d1">A matéria não é só o destino. É o que faz a pessoa saber <span class="hl">o que pesquisar</span> e qual nome digitar.</p>
      </div>
    </section>

    <!-- 4 · DATAVIZ · convergencia no launch -->
    <section class="section dark">
      <div class="wrap">
        <div class="viz-grid">
          <div class="reveal">
            <div class="viz-stage px" data-parallax-y="-6">
              <canvas id="gtm-launch-canvas" role="img" aria-label="Convergência no lançamento: vetores de produto, mercado e PR sincronizam e disparam um pulso de pipeline a partir do ponto de lançamento."></canvas>
            </div>
            <div class="viz-legend" aria-hidden="true">
              <span class="li"><span class="sw" style="background:#9aa0aa"></span>Produto e mercado</span>
              <span class="li"><span class="sw" style="background:#FED136"></span>PR sincronizado</span>
              <span class="li"><span class="sw" style="background:#FFB020"></span>Pipeline gerado</span>
            </div>
          </div>
          <div class="reveal d1">
            <span class="eyebrow on-dark">A convergência</span>
            <h2>O lançamento é ouvido quando os vetores chegam <span class="accent-serif on-dark">juntos</span>.</h2>
            <p class="lede">Produto pronto, mercado mapeado e imprensa relacionada não bastam separados. O ganho aparece quando a comunicação chega sincronizada com o go-to-market, no ponto e no momento em que a categoria está sendo decidida.</p>
            <p class="lede" style="margin-top:1.25rem">Quando os três convergem, a cobertura joga tráfego de intenção no site, o decisor reconhece a marca em mais de um ponto e o ciclo de venda encurta porque a confiança já foi construída antes do primeiro contato comercial.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 · O METODO PEP -->
    <section class="section paper has-contour">
      <div class="contour-field px" data-parallax-y="-20" aria-hidden="true"></div>
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">O framework PEP aplicado</span>
          <h2>Cinco passos, e a ordem <span class="accent-serif">importa</span>.</h2>
          <p class="lede">A PiaR opera com a metodologia PEP. Aplicada à entrada de mercado, ela vira uma sequência. Pular o passo 1 é a causa mais comum de campanha que não move pipeline.</p>
        </div>
        <div class="steps-grid">
          {passos.map((e, i) => (
            <div class:list={['step-card', 'reveal', i === 1 && 'd1', i === 2 && 'd2', i === 3 && 'd3', i === 4 && 'd4']}>
              <span class="s-num">{e.num}</span>
              <span class="s-prazo">{e.foco}</span>
              <h3 class="s-titulo">{e.titulo}</h3>
              <p class="s-desc">{e.desc}</p>
            </div>
          ))}
        </div>
        <p class="punch reveal d1" style="max-width:30ch">PR raramente é o último clique. Por isso a atribuição vem por <span class="hl">evidência convergente</span>, não por último clique.</p>
      </div>
    </section>

    <!-- 6 · O QUE MEDIR -->
    <section class="section warm has-ghost">
      <span class="ghost-mark bl px" data-parallax-y="14" aria-hidden="true">medir</span>
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">O que medir, e o que ignorar</span>
          <h2>Só importa a métrica que responde à pergunta do <span class="accent-serif">CEO</span>.</h2>
          <p class="lede">Muitas agências enchem relatórios de impressões e alcance potencial. Servem de contexto, nunca de meta. Estes são os indicadores que mostram earned media virando entrada de mercado.</p>
        </div>
        <div class="frentes-grid">
          {medir.map((f, i) => (
            <div class:list={['frente-card', 'reveal', (i % 3 === 1) && 'd1', (i % 3 === 2) && 'd2']}>
              <div class="f-icon"><iconify-icon icon={f.icon}></iconify-icon></div>
              <h3 class="f-name">{f.nome}</h3>
              <p class="f-desc">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 7 · QUANDO USAR, QUANDO NAO -->
    <section class="section paper">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">O critério honesto</span>
          <h2>Quando PR é o canal de entrada, e quando <span class="accent-serif">não</span>.</h2>
          <p class="lede">Earned media acelera a chegada ao mercado. Saber a hora certa de usar evita campanha frustrada e relação queimada na redação.</p>
        </div>
        <div class="gate">
          <div class="gate-card is-yes reveal">
            <span class="g-head"><iconify-icon icon="solar:check-circle-line-duotone"></iconify-icon>Use quando</span>
            <h3>A compra depende de confiança.</h3>
            <ul class="gate-list">
              <li><iconify-icon icon="solar:check-read-line-duotone"></iconify-icon><span><b>Confiança e legitimidade decidem</b> a compra: B2B, fintech, saúde, ticket alto, categoria nova que precisa ser explicada.</span></li>
              <li><iconify-icon icon="solar:check-read-line-duotone"></iconify-icon><span><b>Há dado proprietário ou tese de categoria</b> que sustente pauta noticiável.</span></li>
              <li><iconify-icon icon="solar:check-read-line-duotone"></iconify-icon><span><b>O ciclo de venda é longo</b> e vale encurtá-lo com validação prévia.</span></li>
              <li><iconify-icon icon="solar:check-read-line-duotone"></iconify-icon><span><b>Você precisa de validação externa</b> para captação ou para abrir conversas de parceria.</span></li>
            </ul>
          </div>
          <div class="gate-card is-no reveal d1">
            <span class="g-head"><iconify-icon icon="solar:close-circle-line-duotone"></iconify-icon>Não use como canal principal quando</span>
            <h3>Você precisa de volume imediato.</h3>
            <ul class="gate-list">
              <li><iconify-icon icon="solar:minus-circle-line-duotone"></iconify-icon><span><b>Precisa de volume previsível esta semana.</b> Reputação se constrói aos poucos. Para volume imediato, paga responde mais rápido.</span></li>
              <li><iconify-icon icon="solar:minus-circle-line-duotone"></iconify-icon><span><b>Não há nada noticiável.</b> Sem dado, sem tese, sem fato novo, forçar pauta queima relação com a redação.</span></li>
              <li><iconify-icon icon="solar:minus-circle-line-duotone"></iconify-icon><span><b>O produto ainda não se sustenta.</b> PR acelera a exposição de um problema se o produto não converte ou não retém.</span></li>
              <li><iconify-icon icon="solar:minus-circle-line-duotone"></iconify-icon><span><b>Não existe quem capture a demanda.</b> Sem site, oferta e processo comercial prontos, a matéria gera tráfego que evapora.</span></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 8 · ERROS QUE QUEIMAM O CANAL -->
    <section class="section dark has-ghost">
      <span class="ghost-mark tr px" data-parallax-y="-14" aria-hidden="true">redação</span>
      <div class="wrap">
        <div class="sec-head reveal" style="max-width:48ch">
          <span class="eyebrow on-dark">Antes de o canal render</span>
          <h2>Os erros que queimam a relação com a <span class="accent-serif on-dark">redação</span>.</h2>
          <p class="lede">Boa parte do que mata uma operação de PR como go-to-market acontece antes do primeiro lead chegar. São erros de ordem e de expectativa, não de talento.</p>
        </div>
        <div class="errs reveal d1">
          <div class="err-item"><iconify-icon icon="solar:danger-triangle-line-duotone"></iconify-icon><div><div class="e-t">Disparo em massa</div><div class="e-d">Release genérico para centenas de contatos em cópia oculta. Mata a relação com a redação e a reputação da marca.</div></div></div>
          <div class="err-item"><iconify-icon icon="solar:danger-triangle-line-duotone"></iconify-icon><div><div class="e-t">Pular a definição de resultado</div><div class="e-d">Começar pela pauta sem combinar o que conta como sucesso. Garante a briga no sexto mês.</div></div></div>
          <div class="err-item"><iconify-icon icon="solar:danger-triangle-line-duotone"></iconify-icon><div><div class="e-t">Excesso de autopromoção</div><div class="e-d">Tratar a matéria como anúncio. Jornalista quer fato, não propaganda disfarçada.</div></div></div>
          <div class="err-item"><iconify-icon icon="solar:danger-triangle-line-duotone"></iconify-icon><div><div class="e-t">Expectativa de capa em um mês</div><div class="e-d">Confundir PR com mídia paga. Visibilidade se constrói por consistência.</div></div></div>
          <div class="err-item"><iconify-icon icon="solar:danger-triangle-line-duotone"></iconify-icon><div><div class="e-t">Medir vaidade</div><div class="e-d">Reportar impressões enquanto o pipeline não se move.</div></div></div>
          <div class="err-item"><iconify-icon icon="solar:danger-triangle-line-duotone"></iconify-icon><div><div class="e-t">Ligar a torneira sem balde</div><div class="e-d">Conseguir cobertura sem página, oferta e captura prontas. É paga antes de earned, escalando o que o mercado ainda não validou.</div></div></div>
        </div>
      </div>
    </section>

    <!-- 9 · PROVA -->
    <section class="section paper">
      <div class="wrap">
        <div class="sec-head reveal" style="max-width:48ch">
          <span class="eyebrow">Prova e lastro</span>
          <h2>Método com <span class="accent-serif">13 anos</span> de estrada.</h2>
          <p class="lede">A autoridade que transforma imprensa em entrada de mercado é a mesma que sempre colocou marcas na pauta. A PiaR opera comunicação desde {site.foundingYear}, em São Paulo, com revisão jurídica do dado à pauta à publicação.</p>
        </div>
        <div class="reveal d1">
          <span class="ds-mono" style="color:var(--text-faint); display:block; margin-bottom:.9rem; font-family:var(--font-mono); font-size:.7rem; letter-spacing:.1em;">/// {site.exitsSupported} startups acompanhadas até o exit</span>
          <div class="chips" style="--c:0">{exits.map((c) => <span class="chip" style="background:rgba(15,15,17,.04); color:var(--primary); border-color:var(--hairline)">{c}</span>)}</div>
          <span class="ds-mono" style="color:var(--text-faint); display:block; margin:2rem 0 .9rem; font-family:var(--font-mono); font-size:.7rem; letter-spacing:.1em;">/// Entre os clientes atendidos</span>
          <div class="chips">{clientes.map((c) => <span class="chip" style="background:rgba(15,15,17,.04); color:var(--primary); border-color:var(--hairline)">{c}</span>)}</div>
        </div>
      </div>
    </section>

    <!-- 10 · HONESTIDADE (dark) -->
    <section class="section dark">
      <div class="wrap">
        <div class="reveal" style="max-width:52ch">
          <span class="eyebrow on-dark">Como medimos de verdade</span>
          <h2>Atribuição por evidência, sem prometer <span class="accent-serif on-dark">último clique</span>.</h2>
        </div>
        <div class="honesty reveal d1">
          <iconify-icon icon="solar:shield-check-line-duotone"></iconify-icon>
          <p>A PiaR não reporta métrica de vaidade como objetivo. Medimos leads que citam a matéria, tráfego direto e de marca na janela da publicação e influência de pipeline, com pergunta de origem no formulário. Bruno Pinheiro, fundador e CEO, foi eleito Profissional de imprensa no Startup Awards da ABStartups (2018).</p>
        </div>
      </div>
    </section>

    <!-- 11 · FAQ -->
    <section class="section paper">
      <div class="wrap" style="max-width:1000px">
        <div class="sec-head reveal">
          <span class="eyebrow">Perguntas frequentes</span>
          <h2>O que dá para <span class="accent-serif">responder por aqui</span>.</h2>
        </div>
        <div class="reveal d1">
          {faq.map((f) => (
            <details class="faq-item">
              <summary>{f.q}<iconify-icon icon="solar:add-square-linear"></iconify-icon></summary>
              <div class="faq-body">{f.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 12 · CTA -->
    <section class="section dark cta-final has-ghost">
      <span class="ghost-mark bl px" data-parallax-y="12" aria-hidden="true">GTM</span>
      <div class="wrap">
        <span class="eyebrow on-dark reveal" style="justify-content:center; display:inline-flex">Vamos conversar</span>
        <h2 class="reveal d1">Comece pelo passo 1: o resultado comercial que você <span class="accent-serif on-dark">quer</span>.</h2>
        <p class="lede reveal d2">Escreva o resultado comercial que você quer e a linha de base atual. É a conversa que a PiaR prefere ter antes de propor qualquer pauta. O investimento é sob consulta, definido conforme cada caso.</p>
        <div class="cta-row reveal d3">
          <a href="/contato" class="btn btn-accent">Agendar conversa<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
          <a href="/relacoes-publicas" class="btn btn-ghost-d">Ver relações públicas<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
        </div>
        <p class="ds-mono reveal d4" style="color:rgba(255,255,255,.4); margin-top:3rem; font-family:var(--font-mono); font-size:.72rem; letter-spacing:.1em;">/// {site.email} · {site.brandDomain}</p>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- Lenis + ScrollTrigger (globais via bootstrap.ts) ---- */
      try {
        if (window.gsap && window.ScrollTrigger) window.gsap.registerPlugin(window.ScrollTrigger);
        if (!prefersReduced && window.Lenis) {
          var lenis = new window.Lenis({ duration: 1.15, easing: function (t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); }, smooth: true, lerp: 0.1 });
          if (window.ScrollTrigger) { lenis.on('scroll', window.ScrollTrigger.update); window.gsap.ticker.add(function (time) { lenis.raf(time * 1000); }); window.gsap.ticker.lagSmoothing(0); }
          else { var raf = function (t) { lenis.raf(t); requestAnimationFrame(raf); }; requestAnimationFrame(raf); }
        }
      } catch (e) { /* noop */ }

      /* ---- reveal ---- */
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('active'); io.unobserve(en.target); } });
      }, { threshold: 0.14 });
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

      /* ---- scroll progress ---- */
      var bar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', function () {
        var h = document.documentElement;
        var p = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
        if (bar) bar.style.width = p + '%';
      }, { passive: true });

      /* ---- parallax de profundidade ---- */
      if (!prefersReduced && window.gsap && window.ScrollTrigger) {
        window.gsap.utils.toArray('[data-parallax-y]').forEach(function (el) {
          var yp = parseFloat(el.getAttribute('data-parallax-y')) || 0;
          window.gsap.fromTo(el, { yPercent: 0 }, { yPercent: yp, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } });
        });
      }

      /* ---- lerp mouse-parallax no heroi (Tres Mares) ---- */
      if (!prefersReduced && window.gsap) {
        var heroFloats = window.gsap.utils.toArray('[class*="hero-float"]');
        if (heroFloats.length) {
          var movers = heroFloats.map(function (el, i) {
            return {
              depth: (i % 2 ? 1 : -1) * (16 + i * 8),
              qx: window.gsap.quickTo(el, 'x', { duration: 0.7, ease: 'power3' }),
              qy: window.gsap.quickTo(el, 'y', { duration: 0.7, ease: 'power3' })
            };
          });
          window.addEventListener('mousemove', function (e) {
            var nx = (e.clientX / window.innerWidth - 0.5);
            var ny = (e.clientY / window.innerHeight - 0.5);
            for (var k = 0; k < movers.length; k++) { movers[k].qx(nx * movers[k].depth); movers[k].qy(ny * movers[k].depth); }
          }, { passive: true });
        }
      }

      /* ========================================================
         HERO · vetores convergindo para o ponto de lancamento (canvas 2D)
         setas de produto, mercado e PR convergem; ao alinhar, o ponto pulsa.
         ======================================================== */
      (function convergeField() {
        var canvas = document.getElementById('gtm-hero-canvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) { canvas.style.background = 'radial-gradient(70% 90% at 78% 38%, #2a2305 0%, #14110a 55%, #0A0A0C 100%)'; return; }
        var dpr = Math.min(window.devicePixelRatio || 1, 1.75);
        var W = 0, H = 0, cx = 0, cy = 0;

        // tres familias de vetores: produto, mercado, PR (cores PiaR: amarelo + preto)
        var families = [
          { tone: '254,209,54', n: 9 },   // PR sincronizado (assinatura amarela)
          { tone: '255,176,32', n: 8 },   // mercado
          { tone: '120,120,128', n: 8 }   // produto (cinza neutro sobre preto)
        ];
        var arrows = [];
        var pulses = [];

        function build() {
          var rect = canvas.getBoundingClientRect();
          W = rect.width; H = rect.height;
          canvas.width = Math.max(1, Math.floor(W * dpr));
          canvas.height = Math.max(1, Math.floor(H * dpr));
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          // ponto de lancamento: a direita, acima do centro (atras do texto a esquerda)
          cx = W * 0.74; cy = H * 0.42;
          arrows = [];
          families.forEach(function (fam, fi) {
            for (var i = 0; i < fam.n; i++) {
              var ang = (fi / families.length) * Math.PI * 2 + (i / fam.n) * (Math.PI * 0.6) + Math.random() * 0.4;
              var dist = Math.max(W, H) * (0.32 + Math.random() * 0.5);
              arrows.push({
                tone: fam.tone,
                ang: ang,
                dist: dist,
                // posicao do progresso 0..1 ao longo do raio rumo ao centro
                t: Math.random(),
                sp: 0.0016 + Math.random() * 0.0028,
                len: 26 + Math.random() * 34,
                w: 1 + Math.random() * 1.4
              });
            }
          });
        }
        build();
        window.addEventListener('resize', build, { passive: true });

        function pos(a, tt) {
          // do raio externo (t=0) ao centro (t=1)
          var d = a.dist * (1 - tt);
          return { x: cx + Math.cos(a.ang) * d, y: cy + Math.sin(a.ang) * d };
        }

        function draw() {
          ctx.clearRect(0, 0, W, H);

          // halo do ponto de lancamento
          var glow = ctx.createRadialGradient(cx, cy, 0, cx, cy, Math.max(W, H) * 0.5);
          glow.addColorStop(0, 'rgba(254,209,54,.10)');
          glow.addColorStop(0.4, 'rgba(254,209,54,.03)');
          glow.addColorStop(1, 'rgba(254,209,54,0)');
          ctx.fillStyle = glow;
          ctx.fillRect(0, 0, W, H);

          // setas convergindo
          for (var i = 0; i < arrows.length; i++) {
            var a = arrows[i];
            a.t += a.sp;
            if (a.t >= 1) {
              // alcancou o launch: dispara um pulso de pipeline e reinicia
              if (!prefersReduced && Math.random() < 0.6) pulses.push({ ang: Math.random() * Math.PI * 2, r: 0, sp: 1.4 + Math.random() * 1.6 });
              a.t = 0;
              a.ang += (Math.random() - 0.5) * 0.5;
            }
            var head = pos(a, a.t);
            var tailT = Math.max(0, a.t - a.len / a.dist);
            var tail = pos(a, tailT);
            var prox = a.t;            // perto do centro fica mais brilhante
            var alpha = 0.12 + prox * 0.6;

            ctx.strokeStyle = 'rgba(' + a.tone + ',' + alpha.toFixed(3) + ')';
            ctx.lineWidth = a.w;
            ctx.lineCap = 'round';
            ctx.beginPath();
            ctx.moveTo(tail.x, tail.y);
            ctx.lineTo(head.x, head.y);
            ctx.stroke();

            // ponta da seta
            var ah = Math.atan2(cy - head.y, cx - head.x);
            var hs = 4 + prox * 4;
            ctx.fillStyle = 'rgba(' + a.tone + ',' + Math.min(1, alpha + 0.15).toFixed(3) + ')';
            ctx.beginPath();
            ctx.moveTo(head.x + Math.cos(ah) * hs, head.y + Math.sin(ah) * hs);
            ctx.lineTo(head.x + Math.cos(ah + 2.5) * hs, head.y + Math.sin(ah + 2.5) * hs);
            ctx.lineTo(head.x + Math.cos(ah - 2.5) * hs, head.y + Math.sin(ah - 2.5) * hs);
            ctx.closePath();
            ctx.fill();
          }

          // pulsos de pipeline saindo do launch
          for (var k = pulses.length - 1; k >= 0; k--) {
            var pu = pulses[k];
            pu.r += pu.sp;
            var rad = pu.r * 14;
            var pa = Math.max(0, 0.5 - pu.r * 0.012);
            if (pa <= 0) { pulses.splice(k, 1); continue; }
            ctx.strokeStyle = 'rgba(254,209,54,' + pa.toFixed(3) + ')';
            ctx.lineWidth = 1.2;
            ctx.beginPath();
            ctx.arc(cx, cy, rad, 0, Math.PI * 2);
            ctx.stroke();
          }

          // nucleo do ponto de lancamento
          var beat = (Math.sin(Date.now() / 520) + 1) * 0.5;
          ctx.beginPath();
          ctx.arc(cx, cy, 5 + beat * 2.5, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(254,209,54,.95)';
          ctx.fill();
          ctx.beginPath();
          ctx.arc(cx, cy, 12 + beat * 6, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(254,209,54,.16)';
          ctx.fill();

          if (!prefersReduced) raf = requestAnimationFrame(draw);
        }

        var raf;
        if (prefersReduced) {
          // estado estatico: setas a meio caminho
          for (var j = 0; j < arrows.length; j++) arrows[j].t = 0.62;
          draw();
        } else {
          raf = requestAnimationFrame(draw);
        }
      })();

      /* ========================================================
         DATAVIZ · convergencia no launch (canvas 2D)
         tres trilhos (produto, mercado, PR) avancam; ao alinhar no
         ponto de lancamento, dispara um pulso de pipeline.
         ======================================================== */
      (function launchConverge() {
        var canvas = document.getElementById('gtm-launch-canvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0, lx = 0, ly = 0;

        var lanes = [
          { name: 'Produto', tone: '154,160,170', y: 0.26 },
          { name: 'Mercado', tone: '255,176,32', y: 0.50 },
          { name: 'PR', tone: '254,209,54', y: 0.74 }
        ];
        var dots = [];
        var pulses = [];
        var sweep = 0;

        function layout() {
          var rect = canvas.getBoundingClientRect();
          W = rect.width; H = rect.height;
          canvas.width = Math.floor(W * dpr); canvas.height = Math.floor(H * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          lx = W * 0.80; ly = H * 0.5;   // ponto de lancamento
          lanes.forEach(function (ln) { ln.py = H * ln.y; });
        }
        layout();

        function spawn() {
          if (prefersReduced) return;
          var li = Math.floor(Math.random() * lanes.length);
          dots.push({ lane: li, p: 0, sp: 0.004 + Math.random() * 0.005 });
        }

        function lerp(a, b, t) { return a + (b - a) * t; }

        function path(ln, t) {
          // do x inicial (0.08W) ate o launch, curvando para convergir em ly
          var x0 = W * 0.08, y0 = ln.py;
          var cx1 = lerp(x0, lx, 0.55), cy1 = y0;
          var cx2 = lerp(x0, lx, 0.78), cy2 = ly;
          var u = 1 - t;
          var x = u * u * u * x0 + 3 * u * u * t * cx1 + 3 * u * t * t * cx2 + t * t * t * lx;
          var y = u * u * u * y0 + 3 * u * u * t * cy1 + 3 * u * t * t * cy2 + t * t * t * ly;
          return { x: x, y: y };
        }

        function draw() {
          ctx.clearRect(0, 0, W, H);

          // trilhos
          lanes.forEach(function (ln) {
            ctx.beginPath();
            var s = path(ln, 0);
            ctx.moveTo(s.x, s.y);
            for (var t = 0.04; t <= 1.0001; t += 0.04) { var pt = path(ln, t); ctx.lineTo(pt.x, pt.y); }
            ctx.strokeStyle = 'rgba(' + ln.tone + ',.18)';
            ctx.lineWidth = 1;
            ctx.stroke();
          });

          // varredura de sincronia que percorre os trilhos
          if (!prefersReduced) sweep = (sweep + 0.004) % 1;
          lanes.forEach(function (ln) {
            var sp = path(ln, sweep);
            ctx.beginPath();
            ctx.arc(sp.x, sp.y, 2, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(' + ln.tone + ',.4)';
            ctx.fill();
          });

          // dots viajando
          for (var k = dots.length - 1; k >= 0; k--) {
            var d = dots[k];
            d.p += d.sp;
            if (d.p >= 1) {
              if (!prefersReduced) pulses.push({ r: 0, sp: 1.3 + Math.random() });
              dots.splice(k, 1);
              continue;
            }
            var ln = lanes[d.lane];
            var pt = path(ln, d.p);
            ctx.beginPath(); ctx.arc(pt.x, pt.y, 3, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(' + ln.tone + ',.95)'; ctx.fill();
            ctx.beginPath(); ctx.arc(pt.x, pt.y, 7, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(' + ln.tone + ',.18)'; ctx.fill();
          }

          // pulsos de pipeline a partir do launch
          for (var j = pulses.length - 1; j >= 0; j--) {
            var pu = pulses[j];
            pu.r += pu.sp;
            var rad = pu.r * 12;
            var pa = Math.max(0, 0.5 - pu.r * 0.014);
            if (pa <= 0) { pulses.splice(j, 1); continue; }
            ctx.strokeStyle = 'rgba(255,176,32,' + pa.toFixed(3) + ')';
            ctx.lineWidth = 1.3;
            ctx.beginPath(); ctx.arc(lx, ly, rad, 0, Math.PI * 2); ctx.stroke();
          }

          // lane labels
          ctx.font = '600 11px "JetBrains Mono", monospace';
          ctx.textBaseline = 'middle';
          ctx.textAlign = 'left';
          lanes.forEach(function (ln) {
            ctx.fillStyle = 'rgba(' + ln.tone + ',.85)';
            ctx.fillText(ln.name, W * 0.08, ln.py - 14);
          });

          // ponto de lancamento
          var beat = (Math.sin(Date.now() / 560) + 1) * 0.5;
          ctx.beginPath(); ctx.arc(lx, ly, 8, 0, Math.PI * 2);
          ctx.fillStyle = '#FED136'; ctx.fill();
          ctx.beginPath(); ctx.arc(lx, ly, 12 + beat * 5, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(254,209,54,.4)'; ctx.lineWidth = 1; ctx.stroke();
          ctx.textAlign = 'center';
          ctx.fillStyle = 'rgba(255,255,255,.92)';
          ctx.fillText('Launch', lx, ly + 22);

          requestAnimationFrame(draw);
        }

        window.addEventListener('resize', layout, { passive: true });

        if (prefersReduced) {
          dots.push({ lane: 0, p: 0.55, sp: 0 });
          dots.push({ lane: 1, p: 0.62, sp: 0 });
          dots.push({ lane: 2, p: 0.7, sp: 0 });
          layout();
          draw();
        } else {
          setInterval(spawn, 760);
          spawn();
          requestAnimationFrame(draw);
        }
      })();
    });
  </script>
</BaseLayout>
