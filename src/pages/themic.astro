                <span class="err">Informe um e-mail válido.</span>
              </div>

              <div class="field" id="f-personal_phone">
                <label for="personal_phone">Telefone / WhatsApp</label>
                <input type="tel" id="personal_phone" name="personal_phone" autocomplete="tel" placeholder="(11) 99999-9999" inputmode="numeric" required>
                <span class="err">Informe um telefone com DDD.</span>
              </div>

              <div class="field" id="f-company_name">
                <label for="company_name">Empresa</label>
                <input type="text" id="company_name" name="company_name" autocomplete="organization" placeholder="Nome da empresa" required>
                <span class="err">Informe o nome da empresa.</span>
              </div>

              <div class="field field-consent" id="f-consent">
                <div class="consent">
                  <input type="checkbox" id="consent" name="consent" required>
                  <label for="consent">
                    Concordo em compartilhar meus dados com a PiaR Group para entrar na fila do THE MIC.
                    Os dados são tratados nas ferramentas que operam a nosso pedido, nunca são vendidos
                    nem cedidos a terceiros, e você pode pedir a exclusão quando quiser, conforme a
                    <a href="/privacidade" target="_blank" rel="noopener">Política de Privacidade</a> e os
                    <a href="/termos" target="_blank" rel="noopener">Termos de Uso</a>.
                  </label>
                </div>
                <span class="err">Precisamos do seu aceite para entrar na fila.</span>
              </div>

              <!-- Origem do lead: preenchido automaticamente por script, ver capturaOrigem() abaixo -->
              <input type="hidden" name="cf_utm_source" id="h-utm-source">
              <input type="hidden" name="cf_utm_medium" id="h-utm-medium">
              <input type="hidden" name="cf_utm_campaign" id="h-utm-campaign">
              <input type="hidden" name="cf_utm_content" id="h-utm-content">
              <input type="hidden" name="cf_landing_page" id="h-landing-page">
              <input type="hidden" name="cf_referrer" id="h-referrer">
              <input type="hidden" name="cf_pagina_conversao" id="h-pagina-conversao">
              <input type="hidden" name="cf_produto_interesse" value="THE MIC · Edição 1">
              <!-- Anti-spam: campo invisível, humanos não preenchem -->
              <input type="text" name="botcheck" id="botcheck" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" aria-hidden="true">

              <button type="submit" class="btn" id="submitBtn">Entrar na fila da Edição 1</button>
              <div class="form-error" id="formError"></div>
            </form>
          </div>

          <div class="form-done" id="formDone">
            <div class="waveform" id="doneWave" aria-hidden="true"></div>
            <h3>Você está na fila.</h3>
            <p>Assim que a Edição 1 for aberta, você recebe antes do anúncio público, com prioridade no processo de aplicação.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <footer>
