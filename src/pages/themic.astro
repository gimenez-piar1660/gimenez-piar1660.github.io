<script is:inline define:vars={{ RD_PUBLIC_KEY, RD_ID_PARCIAL, RD_ID_THEMIC, CHECKOUT_URL, PRODUTO }}>
(function () {
  /* ---------- Waveforms ---------- */
  function makeWave(el, count, minH, maxH) {
    if (!el) return;
    el.innerHTML = '';
    for (let i = 0; i < count; i++) {
      const bar = document.createElement('span');
      bar.className = 'bar';
      bar.style.height = Math.floor(Math.random() * (maxH - minH) + minH) + 'px';
      bar.style.animationDelay = (Math.random() * 1.2).toFixed(2) + 's';
      bar.style.animationDuration = (0.9 + Math.random() * 0.9).toFixed(2) + 's';
      el.appendChild(bar);
    }
  }
  makeWave(document.getElementById('heroWave'), 64, 20, 260);
  makeWave(document.getElementById('closingWave'), 64, 20, 220);
  makeWave(document.getElementById('doneWave'), 26, 6, 38);

  /* ---------- Números que contam do zero ---------- */
  (function contagem() {
    const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const formata = (v, dec, prefixo) => {
      const n = dec ? v.toFixed(dec).replace('.', ',') : Math.round(v).toString();
      return (prefixo || '') + n;
    };
    const anima = (el) => {
      const alvo = parseFloat(el.dataset.to);
      const dec = el.dataset.dec ? parseInt(el.dataset.dec) : 0;
      const prefixo = el.dataset.prefix || '';
      if (semMovimento) { el.textContent = formata(alvo, dec, prefixo); return; }
      const duracao = 1100;
      const inicio = performance.now();
      const passo = (agora) => {
        const t = Math.min((agora - inicio) / duracao, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = formata(alvo * eased, dec, prefixo);
        if (t < 1) requestAnimationFrame(passo);
        else el.textContent = formata(alvo, dec, prefixo);
      };
      requestAnimationFrame(passo);
    };
    const obs = new IntersectionObserver((entradas) => {
      entradas.forEach((e) => {
        if (e.isIntersecting) { anima(e.target); obs.unobserve(e.target); }
      });
    }, { threshold: 0.6 });
    document.querySelectorAll('.lp-themic .count').forEach((el) => obs.observe(el));
  })();

  /* ---------- Mini-waveform dos cards de "o que destrava" ---------- */
  document.querySelectorAll('.lp-themic .unlock .wave').forEach((w, k) => {
    for (let i = 0; i < 22; i++) {
      const bar = document.createElement('i');
      bar.style.height = (4 + Math.abs(Math.sin(i * 0.6 + k)) * 20) + 'px';
      w.appendChild(bar);
    }
  });

  /* ---------- Reveal on scroll ---------- */
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.lp-themic .reveal').forEach((el) => io.observe(el));

  /* ---------- Barra fixa ---------- */
  const sticky = document.getElementById('stickybar');
  const lista = document.getElementById('lista');
  window.addEventListener('scroll', () => {
    if (!sticky || !lista) return;
    const passouHero = window.scrollY > window.innerHeight * 0.8;
    const chegouNoForm = lista.getBoundingClientRect().top < window.innerHeight * 0.9;
    sticky.classList.toggle('show', passouHero && !chegouNoForm);
  }, { passive: true });

  /* ---------- Máscara de telefone ---------- */
  const tel = document.getElementById('personal_phone');
  if (tel) {
    tel.addEventListener('input', () => {
      let v = tel.value.replace(/\D/g, '').slice(0, 11);
      if (v.length > 6) v = `(${v.slice(0,2)}) ${v.slice(2, v.length === 11 ? 7 : 6)}-${v.slice(v.length === 11 ? 7 : 6)}`;
      else if (v.length > 2) v = `(${v.slice(0,2)}) ${v.slice(2)}`;
      else if (v.length > 0) v = `(${v}`;
      tel.value = v;
    });
  }

  /* ---------- Origem do lead: mesmo mecanismo de /contato ----------
     Cookie piar_atrib (gravado só após consentimento de marketing, ver
     ConsentimentoCookies.astro) → sessionStorage → query string desta
     própria visita. Cobre quem converte na hora, antes de decidir sobre
     cookies, e quem chega pela home com UTM e converte aqui depois. */
  (function capturaOrigem() {
    let atrib = {};
    const bruto = document.cookie.split('; ').find((c) => c.indexOf('piar_atrib=') === 0);
    if (bruto) {
      try { atrib = JSON.parse(decodeURIComponent(bruto.slice('piar_atrib='.length))); } catch (err) { atrib = {}; }
    }
    if (!Object.keys(atrib).length) {
      try {
        const sessao = sessionStorage.getItem('piar_atrib');
        if (sessao) atrib = JSON.parse(sessao);
      } catch (err) { atrib = {}; }
    }
    const qs = new URLSearchParams(location.search);
    const set = (id, valor) => { const el = document.getElementById(id); if (el) el.value = valor || ''; };
    set('h-utm-source', atrib.utm_source || qs.get('utm_source'));
    set('h-utm-medium', atrib.utm_medium || qs.get('utm_medium'));
    set('h-utm-campaign', atrib.utm_campaign || qs.get('utm_campaign'));
    set('h-utm-content', atrib.utm_content || qs.get('utm_content'));
    set('h-landing-page', atrib.landing_page || (location.pathname + location.search));
    set('h-referrer', atrib.referrer || (document.referrer && document.referrer.indexOf(location.origin) !== 0 ? document.referrer : ''));
    set('h-pagina-conversao', location.pathname);
  })();

  /* ---------- Etapas e validação ---------- */
  const form = document.getElementById('micForm');
  if (!form) return;

  const erroBox = document.getElementById('formError');
  const step1 = document.getElementById('step1');
  const step2 = document.getElementById('step2');
  const bar2 = document.getElementById('bar2');
  const toStep2 = document.getElementById('toStep2');

  const RD_ATIVO = RD_PUBLIC_KEY && RD_PUBLIC_KEY.indexOf('COLE-SUA') !== 0;

  function valida(id, teste) {
    const campo = document.getElementById('f-' + id);
    const input = document.getElementById(id);
    const ok = teste(input);
    if (campo) campo.classList.toggle('invalid', !ok);
    input.setAttribute('aria-invalid', ok ? 'false' : 'true');
    return ok;
  }

  function checa(id) {
    if (id === 'name')           return valida('name', (i) => i.value.trim().length >= 3 && i.value.trim().includes(' '));
    if (id === 'email')          return valida('email', (i) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(i.value.trim()));
    if (id === 'personal_phone') return valida('personal_phone', (i) => i.value.replace(/\D/g,'').length >= 10);
    if (id === 'company_name')   return valida('company_name', (i) => i.value.trim().length >= 2);
    if (id === 'consent')        return valida('consent', (i) => i.checked);
  }

  ['name','email','personal_phone','company_name'].forEach((id) => {
    document.getElementById(id).addEventListener('blur', () => checa(id));
  });
  document.getElementById('consent').addEventListener('change', () => checa('consent'));

  /* destaque visual das opções marcadas */
  document.querySelectorAll('.lp-themic .opt input').forEach((inp) => {
    inp.addEventListener('change', () => {
      if (inp.type === 'radio') {
        document.querySelectorAll('.lp-themic .opt input[name="' + inp.name + '"]')
          .forEach((o) => o.closest('.opt').classList.remove('sel'));
      }
      inp.closest('.opt').classList.toggle('sel', inp.checked);
    });
  });

  /* Campos de rastreio + identificação, comuns às duas etapas */
  function dadosBase() {
    const dados = {};
    ['name','email','personal_phone','company_name'].forEach((id) => {
      const v = document.getElementById(id).value.trim();
      if (v) dados[id] = v;
    });
    form.querySelectorAll('input[type="hidden"]').forEach((el) => {
      if (el.value) dados[el.name] = el.value;
    });
    return dados;
  }

  // RD Station · API de conversões com chave pública (mesmo padrão de /contato)
  async function enviarRD(dados, identificador) {
    const resp = await fetch('https://api.rd.services/platform/conversions?api_key=' + encodeURIComponent(RD_PUBLIC_KEY), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        event_type: 'CONVERSION',
        event_family: 'CDP',
        payload: Object.assign({}, dados, {
          conversion_identifier: identificador,
          traffic_source: dados.cf_utm_source || '',
          traffic_medium: dados.cf_utm_medium || '',
          traffic_campaign: dados.cf_utm_campaign || '',
        }),
      }),
    });
    if (!resp.ok) throw new Error('RD Station respondeu ' + resp.status);
    return true;
  }

  /* ---------- Etapa 1: grava o lead parcial e avança ----------
     O envio acontece aqui de propósito: quem abandonar a etapa 2 já entrou
     na base, com origem e produto de interesse. Falha de rede não trava a
     navegação, porque a etapa 2 reenvia tudo. */
  toStep2.addEventListener('click', async () => {
    if (form.botcheck && form.botcheck.value) return;

    const campos = ['name','email','personal_phone','company_name','consent'];
    const tudoOk = campos.map(checa).every(Boolean);
    if (!tudoOk) {
      const primeiroInvalido = document.querySelector('.lp-themic .field.invalid input');
      if (primeiroInvalido) primeiroInvalido.focus();
      return;
    }

    toStep2.disabled = true;
    toStep2.textContent = 'Salvando…';
    try {
      if (RD_ATIVO) await enviarRD(dadosBase(), RD_ID_PARCIAL);
      else console.log('[THE MIC] RD_PUBLIC_KEY ausente, modo demonstração.', dadosBase());
    } catch (err) {
      console.error('[THE MIC] etapa 1 não gravou', err);
    }
    toStep2.disabled = false;
    toStep2.textContent = 'Continuar';

    step1.classList.remove('on');
    step2.classList.add('on');
    bar2.classList.add('on');
    lista.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  document.getElementById('backStep1').addEventListener('click', () => {
    step2.classList.remove('on');
    step1.classList.add('on');
    bar2.classList.remove('on');
  });

  /* ---------- Etapa 2: envia tudo ---------- */
  let acao = 'pagamento';
  document.querySelectorAll('#step2 button[type="submit"]').forEach((b) => {
    b.addEventListener('click', () => { acao = b.dataset.acao; });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    erroBox.classList.remove('show');
    if (form.botcheck && form.botcheck.value) return;

    const obrigatorias = ['job_title','cf_estagio_empresa','cf_disponibilidade_data','cf_poder_decisao'];
    const faltando = obrigatorias.find((n) => !form.querySelector('input[name="' + n + '"]:checked'));
    if (faltando) {
      erroBox.textContent = 'Responda todas as perguntas para continuar.';
      erroBox.classList.add('show');
      form.querySelector('[data-q="' + faltando + '"]').scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    const dados = dadosBase();
    obrigatorias.forEach((n) => { dados[n] = form.querySelector('input[name="' + n + '"]:checked').value; });
    const objetivos = [...form.querySelectorAll('input[name="cf_objetivo_imersao"]:checked')].map((i) => i.value);
    if (objetivos.length) dados.cf_objetivo_imersao = objetivos.join('; ');
    const linkedin = document.getElementById('linkedin').value.trim();
    if (linkedin) dados.linkedin = linkedin;
    dados.cf_acao_final = acao === 'contato' ? 'Prefere falar antes' : 'Seguiu para pagamento';

    const btns = [...document.querySelectorAll('#step2 button[type="submit"]')];
    const alvo = btns.find((b) => b.dataset.acao === acao);
    const textoOriginal = alvo.textContent;
    btns.forEach((b) => { b.disabled = true; });
    alvo.textContent = 'Enviando…';

    try {
      if (RD_ATIVO) {
        await enviarRD(dados, RD_ID_THEMIC);
      } else {
        console.log('[THE MIC] RD_PUBLIC_KEY ausente, modo demonstração.', dados);
        await new Promise((res) => setTimeout(res, 600));
      }

      // Com checkout configurado, quem escolheu pagar vai direto para a cobrança.
      // Sem ele, a página confirma o recebimento e o comercial assume daqui.
      if (acao === 'pagamento' && CHECKOUT_URL) {
        window.location.href = CHECKOUT_URL;
        return;
      }
      if (acao === 'contato') {
        document.getElementById('doneTitle').textContent = 'Recebemos seus dados.';
        document.getElementById('doneText').textContent =
          'Nossa equipe entra em contato para falar sobre a sua vaga na Edição 1.';
      }

      document.getElementById('formWrap').style.display = 'none';
      document.getElementById('formDone').classList.add('show');
      if (sticky) sticky.classList.remove('show');

    } catch (err) {
      console.error('[THE MIC]', err);
      erroBox.textContent = 'Não foi possível enviar agora. Tente de novo em instantes ou escreva para ' + 'contato@piar.group' + '.';
      erroBox.classList.add('show');
      btns.forEach((b) => { b.disabled = false; });
      alvo.textContent = textoOriginal;
    }
  });
})();
</script>
</BaseLayout>
