                </div>

                <div class="btn-row">
                  <button type="submit" class="btn" id="submitBtn" data-acao="pagamento">Ir para o pagamento</button>
                  <button type="submit" class="btn btn-outline" id="talkBtn" data-acao="contato">Prefiro falar com alguém antes</button>
                </div>
                <button type="button" class="backlink" id="backStep1">← Voltar</button>
                <div class="form-error" id="formError"></div>
