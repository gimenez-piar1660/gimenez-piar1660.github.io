      <div class="brands">
        <div class="eyebrow on-dark" style="margin-bottom:0;">PROVA, NÃO PROMESSA · {site.brandsServed} MARCAS PASSARAM POR AQUI</div>
        <div class="brand-list">
          <span>Sambatech</span><span>LIGA Ventures</span><span>Printi</span><span>Qranio</span>
          <span>Unifisa</span><span>Liv Up</span><span>Investidores.vc</span><span>VTEX</span>
          <span>InovAtiva</span><span>Wylinka</span><span>Doctoralia</span><span>Unlimitail</span>
          <span>Sidia</span><span>ABStartups</span><span>Corning</span><span>Fluencypass</span>
