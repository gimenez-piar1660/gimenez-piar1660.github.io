  .lp-themic .chair .cno { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); display: block; margin-bottom: 16px; }
  .lp-themic .chair h3 { font-size: 19.5px; color: var(--white); margin-bottom: 10px; letter-spacing: -0.01em; line-height: 1.2; }
