  .lp-themic .field input:focus { border-color: var(--gold); outline: none; }
  .lp-themic .field input[aria-invalid="true"] { border-color: var(--on-air); }
  .lp-themic .field .err { display: none; margin-top: 7px; font-family: var(--mono); font-size: 11.5px; color: var(--on-air); }
  .lp-themic .field.invalid .err { display: block; }
  .lp-themic .form-card .btn { width: 100%; margin-top: 10px; }
  .lp-themic .form-card .btn[disabled] { opacity: 0.6; cursor: wait; transform: none; }

  .lp-themic .field-consent { margin-bottom: 20px; }
