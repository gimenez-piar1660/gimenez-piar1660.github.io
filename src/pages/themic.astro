<style>
  .lp-themic {
    /* ---------- Tokens locais, mapeados para o design system PiaR ----------
       Nomes mantidos iguais aos do arquivo recebido (facilita comparar), mas
       os VALORES agora apontam para src/styles/tokens.css. --gold-deep usa
       --accent-deep (não --yellow-700): é o par eyebrow/label sobre fundo
       claro já usado em dezenas de páginas do site (privacidade, contato,
       cases, blog...), então é essa a consistência que importa aqui, não o
       contraste técnico perfeito de um tom alternativo nunca usado. */
    /* --ink, --ink-soft, --paper e --white NÃO são redeclarados: já existem
       com este nome e este valor exato em tokens.css e chegam por herança.
       Redeclarar var(--ink) dentro de --ink criaria uma referência circular
       (spec resolve isso caindo pro valor herdado, mas é frágil depender
       disso; mais simples não escrever a linha). */
    --ink-line: var(--hairline-d);
    --paper-dim: var(--gray-100);
    --paper-line: var(--hairline-strong);
    --gold: var(--yellow);
    --gold-deep: var(--accent-deep);
    --graphite: var(--text-muted);
    --graphite-soft: var(--text-faint);
    --on-air: #A83232;
    --display: var(--font-display);
    --body: var(--font-sans);
    --mono: var(--font-mono);

    display: block;
    font-family: var(--body);
    background: var(--paper);
    color: var(--ink);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  .lp-themic * { margin: 0; padding: 0; box-sizing: border-box; }
  .lp-themic img, .lp-themic svg { display: block; max-width: 100%; }
  .lp-themic a { color: inherit; }
  .lp-themic ::selection { background: var(--gold); color: var(--ink); }
  .lp-themic :focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }

  .lp-themic .wrap { max-width: 1180px; margin: 0 auto; padding: 0 32px; }
  .lp-themic .block { padding: 104px 0; }
  .lp-themic .block-dark { background: var(--ink); color: var(--white); }
  .lp-themic .block-dim { background: var(--paper-dim); }
  /* Sangra para fora do .wrap sem criar barra horizontal (o container tem
     overflow-x: hidden), usada pela faixa de fotos da seção do método. */
  .lp-themic .bleed { width: 100vw; margin-left: calc(50% - 50vw); }

  /* ---------- Marca PiaR discreta (hero + rodapé) ---------- */
  .lp-themic .piar-mark { display: inline-flex; opacity: .8; transition: opacity .2s ease; }
  .lp-themic .piar-mark:hover { opacity: 1; }
  .lp-themic .piar-mark img { width: 14px; height: 14px; }
  .lp-themic .fmark-link { display: inline-flex; align-items: center; gap: 9px; text-decoration: none; }
  .lp-themic .fmark-piar { opacity: .55; transition: opacity .2s ease; }
  .lp-themic .fmark-link:hover .fmark-piar { opacity: .85; }

  /* ---------- Eyebrow ---------- */
  .lp-themic .eyebrow {
    display: inline-flex; align-items: center; gap: 9px;
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--gold-deep);
    margin-bottom: 22px;
  }
  .lp-themic .eyebrow.on-dark { color: var(--gold); }
  .lp-themic .dot {
    width: 7px; height: 7px; border-radius: 50%; background: var(--on-air);
    animation: pulse 1.9s infinite; flex-shrink: 0;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(168,50,50,0.55); }
    70% { box-shadow: 0 0 0 9px rgba(168,50,50,0); }
    100% { box-shadow: 0 0 0 0 rgba(168,50,50,0); }
  }

  /* ---------- Escala tipográfica ---------- */
  .lp-themic .title {
    font-family: var(--display); font-weight: 800;
    font-size: clamp(30px, 4.2vw, 54px);
    line-height: 1.03;
    letter-spacing: -0.015em;
    margin-bottom: 24px;
  }
  .lp-themic .title .gold { color: var(--gold); }
  .lp-themic .title .deep { color: var(--gold-deep); }
  .lp-themic .lede { font-size: 19px; color: var(--graphite); max-width: 660px; }
  .lp-themic .block-dark .lede { color: #c6c6c6; }

  /* ---------- Waveform ---------- */
  .lp-themic .waveform { display: flex; align-items: center; gap: 3px; height: 44px; }
  .lp-themic .waveform .bar {
    width: 3px; background: var(--gold); border-radius: 2px;
    animation: wave 1.2s ease-in-out infinite; transform-origin: center;
  }
  .lp-themic .waveform.muted .bar { background: var(--graphite-soft); animation: none; height: 4px !important; }
  @keyframes wave {
    0%, 100% { transform: scaleY(0.22); }
    50% { transform: scaleY(1); }
  }

  /* ---------- Botões ---------- */
  .lp-themic .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    background: var(--gold); color: var(--ink);
    font-family: var(--body); font-weight: 700; font-size: 15px;
    padding: 18px 34px; border: 1px solid var(--gold); border-radius: 999px;
    cursor: pointer; text-decoration: none;
    transition: transform 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .lp-themic .btn:hover { transform: translateY(-2px); background: var(--white); border-color: var(--white); }
  .lp-themic .btn-lg { padding: 20px 40px; font-size: 16.5px; }

  /* ---------- Barra fixa ---------- */
  .lp-themic .stickybar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 90;
    background: var(--ink); border-top: 1px solid var(--ink-line);
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding: 14px 32px; transform: translateY(110%);
    transition: transform 0.35s cubic-bezier(.2,.7,.3,1);
  }
  .lp-themic .stickybar.show { transform: translateY(0); }
  .lp-themic .stickybar p {
    font-family: var(--mono); font-size: 12.5px; color: #b9b9b9;
    letter-spacing: 0.04em; text-transform: uppercase;
    display: flex; align-items: center; gap: 9px;
  }
  .lp-themic .stickybar .btn { padding: 13px 24px; font-size: 14px; }

  /* ---------- Hero ---------- */
  .lp-themic .hero {
    background: var(--ink); color: var(--white);
    /* topo folgado: a nav fixa do site (87px) agora fica sobre o hero */
    padding: 132px 0 84px; position: relative; overflow: hidden;
  }
  .lp-themic .hero .wrap { position: relative; z-index: 2; }
  .lp-themic .hero-wave-bg {
    position: absolute; inset: 0; display: flex; align-items: flex-end;
    justify-content: center; gap: 5px; opacity: 0.13; z-index: 1;
  }
  .lp-themic .hero-wave-bg .bar { width: 6px; background: var(--gold); animation: wave 2.6s ease-in-out infinite; }
  .lp-themic .hero-mark {
    font-family: var(--display); font-weight: 800;
    font-size: clamp(58px, 11.5vw, 138px);
    line-height: 0.86; letter-spacing: -0.015em;
    color: var(--gold); margin-bottom: 30px;
  }
  .lp-themic .hero-mark .the {
    display: block; font-size: 0.26em; letter-spacing: 0.42em;
    color: var(--white); margin-bottom: 10px;
  }
  .lp-themic .hero-tagline {
    font-size: clamp(21px, 2.7vw, 33px);
    font-weight: 600; line-height: 1.24; letter-spacing: -0.015em;
    max-width: 760px; margin-bottom: 22px;
  }
  .lp-themic .hero-tagline mark { background: var(--gold); color: var(--ink); padding: 0 6px; }
  .lp-themic .hero-sub { font-size: 17.5px; color: #c2c2c2; max-width: 620px; margin-bottom: 34px; }
  .lp-themic .hero-urgency {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--mono); font-size: 12.5px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--gold);
    border: 1px solid rgba(254,209,54,0.35); border-radius: 999px;
    padding: 10px 18px; margin-bottom: 30px;
  }
  .lp-themic .cta-row { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .lp-themic .cta-note { font-family: var(--mono); font-size: 12px; color: var(--white); letter-spacing: 0.06em; }
  .lp-themic .hero-strip {
    margin-top: 54px; padding-top: 22px; border-top: 1px solid var(--ink-line);
    font-family: var(--mono); font-size: 12px; color: var(--white);
    letter-spacing: 0.14em; text-transform: uppercase;
  }

  /* ---------- Pilares ---------- */
  .lp-themic .pillars {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
    background: var(--paper-line); border: 1px solid var(--paper-line); margin-top: 52px;
  }
  .lp-themic .pillar { background: var(--paper); padding: 30px 26px; }
  .lp-themic .pillar span {
    font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--gold-deep); display: block; margin-bottom: 12px;
  }
  .lp-themic .pillar strong { font-size: 18px; font-weight: 700; letter-spacing: -0.01em; }

  /* ---------- Alcance ---------- */
  .lp-themic .reach { margin-top: 50px; display: grid; max-width: 780px; }
  .lp-themic .reach-row {
    display: grid; grid-template-columns: 230px 1fr; gap: 26px; align-items: baseline;
    padding: 24px 0; border-top: 1px solid var(--ink-line);
  }
  .lp-themic .reach-row:last-child { border-bottom: 1px solid var(--ink-line); }
  .lp-themic .reach-key {
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--gold);
  }
  .lp-themic .reach-val { font-size: 20px; font-weight: 600; color: var(--white); letter-spacing: -0.01em; }

  /* ---------- Dores ---------- */
  .lp-themic .pain-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px;
    background: var(--paper-line); border: 1px solid var(--paper-line); margin-top: 48px;
  }
  .lp-themic .pain {
    background: var(--white); padding: 30px; font-size: 16.5px; color: var(--ink);
    display: flex; gap: 15px; align-items: flex-start; line-height: 1.45;
  }
  .lp-themic .pain .q { font-family: var(--mono); color: var(--gold-deep); font-size: 15px; flex-shrink: 0; }

  /* ---------- Declaração em escala ---------- */
  .lp-themic .statement { background: var(--gold); color: var(--ink); padding: 120px 0; }
  .lp-themic .statement .wrap { text-align: center; }
  .lp-themic .statement h2 {
    font-family: var(--display); font-weight: 800;
    font-size: clamp(38px, 8vw, 108px);
    line-height: 0.95; letter-spacing: -0.03em; max-width: 15ch; margin: 0 auto;
  }
  .lp-themic .statement p {
    margin: 34px auto 0; max-width: 620px; font-size: 19px;
    color: rgba(15,15,17,.74); line-height: 1.55;
  }

  /* ---------- Prova · números em escala ---------- */
  .lp-themic .figs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin-top: 64px; }
  .lp-themic .fig-cell { padding: 0 40px; border-left: 1px solid var(--ink-line); }
  .lp-themic .fig-cell:first-child { padding-left: 0; border-left: none; }
  .lp-themic .fig-cell .big {
    font-family: var(--display); font-weight: 800;
    font-size: clamp(64px, 9vw, 132px);
    line-height: 0.9; letter-spacing: -0.03em; color: var(--gold); margin-bottom: 20px;
    font-variant-numeric: tabular-nums; font-feature-settings: "tnum";
  }
  .lp-themic .fig-cell .count { display: inline-block; }
  .lp-themic .fig-cell .big sup { font-size: 0.34em; vertical-align: super; }
  .lp-themic .fig-cell .cap {
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--white); margin-bottom: 12px;
  }
  .lp-themic .fig-cell p { font-size: 15px; color: #a3a3a3; line-height: 1.55; }
  .lp-themic .source {
    margin-top: 34px; font-family: var(--mono); font-size: 11.5px;
    color: var(--graphite-soft); line-height: 1.6; max-width: 900px;
  }
  /* Sobre var(--ink) o --graphite-soft some (ver 56f1fa7): na seção escura da
     prova, a fonte precisa de um cinza que apareça. */
  .lp-themic .block-dark .source { color: #a3a3a3; }

  /* ---------- O que não é ---------- */
  .lp-themic .notlist { list-style: none; display: grid; gap: 2px; margin: 40px 0; max-width: 720px; }
  .lp-themic .notlist li {
    display: flex; align-items: center; gap: 16px;
    font-weight: 600; font-size: clamp(18px, 2.3vw, 26px);
    color: var(--graphite-soft); padding: 15px 0;
    border-bottom: 1px solid var(--paper-line);
    text-decoration: line-through; text-decoration-thickness: 2px;
  }
  .lp-themic .notlist .x {
    font-family: var(--mono); color: var(--on-air); font-size: 15px;
    text-decoration: none; flex-shrink: 0;
  }
  .lp-themic .yes-line {
    font-family: var(--display); font-weight: 700; font-size: clamp(21px, 2.9vw, 33px);
    line-height: 1.26; max-width: 820px; margin-top: 56px;
  }
  .lp-themic .yes-line .accent { color: var(--gold-deep); }

  /* ---------- Método ---------- */
  .lp-themic .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--ink-line); margin-top: 50px; border: 1px solid var(--ink-line); }
  .lp-themic .step { background: var(--ink); padding: 34px 28px; }
  .lp-themic .step .n { font-family: var(--display); font-weight: 800; font-size: 30px; color: var(--gold); display: block; margin-bottom: 16px; }
  .lp-themic .step .when {
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--white); display: block; margin-bottom: 8px;
  }
  .lp-themic .step h3 { font-size: 19px; margin-bottom: 12px; letter-spacing: -0.01em; }
  .lp-themic .step p { font-size: 14.5px; color: #b6b6b6; }

  .lp-themic .days-title {
    margin-top: 66px; font-family: var(--display); font-weight: 800;
    font-size: clamp(21px, 2.9vw, 32px); color: var(--white);
    line-height: 1.2; max-width: 820px;
  }
  .lp-themic .days-title span { color: var(--gold); }
  .lp-themic .days { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--ink-line);
          border: 1px solid var(--ink-line); margin-top: 32px; }
  .lp-themic .day { background: var(--ink); padding: 38px 38px 40px; }
  .lp-themic .day-head { padding-bottom: 24px; margin-bottom: 4px; border-bottom: 1px solid rgba(255,255,255,.16); }
  .lp-themic .day-head .n { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.14em;
                 text-transform: uppercase; color: var(--gold); display: block; margin-bottom: 10px; }
  .lp-themic .day-head h3 { font-size: 20px; color: var(--white); letter-spacing: -0.015em; line-height: 1.25; font-weight: 600; }
  .lp-themic .day-block { padding: 26px 0 0; }
  .lp-themic .day-block + .day-block { border-top: 1px solid rgba(255,255,255,.10); margin-top: 26px; }
  .lp-themic .day-block strong { display: block; font-size: 17px; color: var(--white); font-weight: 600;
                      letter-spacing: -0.01em; margin-bottom: 7px; }
  .lp-themic .day-block span { font-size: 14.5px; color: #a3a3a3; line-height: 1.5; }
  /* var(--white), não --graphite-soft: sobre var(--ink) o segundo some (ver 56f1fa7) */
  .lp-themic .day-foot { margin-top: 32px; padding-top: 22px; border-top: 1px solid rgba(255,255,255,.16);
              display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
              font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em;
              text-transform: uppercase; color: var(--white); }

  /* ---------- Ativos ---------- */
  .lp-themic .assets-list { display: grid; grid-template-columns: 1fr 1fr; gap: 0 56px; margin-top: 46px; }
  .lp-themic .asset-row { display: grid; grid-template-columns: 34px 1fr; gap: 14px; padding: 22px 0; border-bottom: 1px solid var(--paper-line); }
  .lp-themic .asset-row .n { font-family: var(--mono); font-size: 12.5px; color: var(--gold-deep); padding-top: 3px; }
  .lp-themic .asset-row strong { display: block; font-size: 17.5px; letter-spacing: -0.01em; margin-bottom: 4px; }
  .lp-themic .asset-row span { font-size: 14.5px; color: var(--graphite); line-height: 1.5; }
  .lp-themic .asset-note {
    margin-top: 26px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    font-size: 15px; color: var(--graphite);
  }
  .lp-themic .tag {
    font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase;
    background: var(--gold); color: var(--ink); padding: 7px 14px; border-radius: 999px; font-weight: 500;
  }

  /* ---------- O que destrava ---------- */
  .lp-themic .unlocks { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--paper-line);
             border: 1px solid var(--paper-line); margin-top: 50px; }
  .lp-themic .unlock { background: var(--white); padding: 40px 36px 42px; position: relative; overflow: hidden; }
  .lp-themic .unlock .n {
    font-family: var(--display); font-weight: 800; font-size: 72px; line-height: 0.8;
    color: var(--gold); display: block; margin-bottom: 22px;
    -webkit-text-stroke: 1.5px var(--gold-deep);
  }
  .lp-themic .unlock h3 { font-size: 22px; letter-spacing: -0.015em; line-height: 1.24; margin-bottom: 14px; }
  .lp-themic .unlock p { font-size: 16px; color: var(--graphite); line-height: 1.6; }
  .lp-themic .unlock .wave { display: flex; align-items: flex-end; gap: 3px; height: 26px; margin-top: 26px; opacity: .5; }
  .lp-themic .unlock .wave i { width: 3px; background: var(--gold-deep); border-radius: 2px; display: block; }

  /* ---------- Cadeiras ---------- */
  .lp-themic .chairs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--ink-line); margin-top: 50px; border: 1px solid var(--ink-line); }
  .lp-themic .chair { background: var(--ink); padding: 34px 28px; }
  .lp-themic .chair .cno { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); display: block; margin-bottom: 16px; }
  .lp-themic .chair h3 { font-size: 19.5px; color: var(--white); margin-bottom: 10px; letter-spacing: -0.01em; line-height: 1.2; }
  .lp-themic .chair .disc { font-family: var(--mono); font-size: 11px; letter-spacing: 0.09em; text-transform: uppercase; color: var(--white); margin-bottom: 14px; }
  .lp-themic .chair p { font-size: 14.5px; color: #b6b6b6; }
  .lp-themic .chairs-note {
    margin-top: 26px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    font-size: 15.5px; color: #c0c0c0;
  }

  /* ---------- Cadeiras confirmadas ---------- */
  .lp-themic .chairs-lead { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 46px; }
  .lp-themic .chair-card { border: 1px solid var(--ink-line); background: var(--ink-soft); overflow: hidden; }
  .lp-themic .chair-card .shot { height: 280px; overflow: hidden; background: var(--ink); }
  .lp-themic .chair-card .shot img { width: 100%; height: 100%; object-fit: cover; display: block; object-position: center 30%; }
  .lp-themic .chair-card .shot img.face { object-position: center 26%; }
  .lp-themic .chair-card .body { padding: 30px 30px 34px; }
  .lp-themic .chair-card .row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .lp-themic .chair-card .cno { font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); }
  .lp-themic .stamp {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
    background: var(--gold); color: var(--ink); padding: 5px 11px; border-radius: 999px; font-weight: 500;
  }
  /* display/margin resetam o .who da seção "Pra quem é", que é um grid */
  .lp-themic .chair-card .who {
    display: block; margin-top: 0; margin-bottom: 8px;
    font-family: var(--display); font-weight: 800; font-size: 25px;
    color: var(--gold); letter-spacing: -0.015em;
  }
  .lp-themic .chair-card .creds { font-size: 13.5px; color: #a1a1a1; margin-bottom: 16px; line-height: 1.5; }
  .lp-themic .chair-card .bio { font-size: 15.5px; color: #d2d2d2; line-height: 1.55; }
  .lp-themic .chairs.two { grid-template-columns: repeat(2, 1fr); margin-top: 24px; }
  .lp-themic .chair .pending {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--white); border: 1px solid #35353a; padding: 5px 11px; border-radius: 999px; white-space: nowrap;
  }
  .lp-themic .chair .row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }

  /* ---------- Pra quem é ---------- */
  .lp-themic .who { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 50px; }
  .lp-themic .who-card { background: var(--white); border: 1px solid var(--paper-line); padding: 36px 32px; }
  .lp-themic .who-card span {
    font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--gold-deep); display: block; margin-bottom: 16px;
  }
  .lp-themic .who-card h3 { font-size: 21px; letter-spacing: -0.015em; margin-bottom: 12px; line-height: 1.25; }
  .lp-themic .who-card p { font-size: 16.5px; color: var(--graphite); }
  .lp-themic .who-note {
    margin-top: 24px; background: var(--ink); color: #d6d6d6; padding: 30px 32px;
    font-size: 16.5px; line-height: 1.55;
  }
  .lp-themic .who-note b { color: var(--gold); font-weight: 600; }

  /* ---------- Ficha técnica da edição ---------- */
  .lp-themic .sheet-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 40px; margin-top: 48px; align-items: start; }
  .lp-themic .sheet-rows { border-top: 1px solid var(--ink-line); }
  .lp-themic .sheet-row { display: grid; grid-template-columns: 150px 1fr; gap: 24px; padding: 22px 0;
               border-bottom: 1px solid var(--ink-line); align-items: baseline; }
  .lp-themic .sheet-row .k { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.14em;
                  text-transform: uppercase; color: var(--gold); }
  .lp-themic .sheet-row .v { font-size: 17.5px; color: var(--white); font-weight: 500; line-height: 1.45; }
  .lp-themic .sheet-row .v small { display: block; font-size: 14.5px; color: #a0a0a0; font-weight: 400; margin-top: 5px; }
  .lp-themic .price-card { border: 1px solid var(--gold); border-radius: 3px; padding: 34px 32px; }
  .lp-themic .price-card .cap { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.14em;
                     text-transform: uppercase; color: var(--gold); margin-bottom: 16px; }
  .lp-themic .price-card .fig { font-family: var(--display); font-weight: 800; font-size: clamp(38px, 5vw, 56px); line-height: 1;
                     color: var(--white); letter-spacing: -0.02em; }
  .lp-themic .price-card .fig sup { font-size: 0.4em; vertical-align: super; color: var(--gold); margin-right: 4px; }
  .lp-themic .price-card .per { font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em;
                     text-transform: uppercase; color: #a0a0a0; margin: 12px 0 20px; }
  .lp-themic .price-card .inc { font-size: 15px; color: #c4c4c4; line-height: 1.6; padding-top: 18px;
                     border-top: 1px solid var(--ink-line); }
  .lp-themic .price-card .btn { width: 100%; margin-top: 22px; }
  .lp-themic .corp { margin-top: 20px; background: var(--ink-soft); padding: 24px 28px; border-left: 3px solid var(--gold); }
  .lp-themic .corp strong { display: block; font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.12em;
                 text-transform: uppercase; color: var(--gold); margin-bottom: 10px; }
  .lp-themic .corp p { font-size: 15.5px; color: #c4c4c4; line-height: 1.55; }

  /* ---------- Quem conduz ---------- */
  .lp-themic .credentials { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-top: 50px; padding-top: 38px; border-top: 1px solid var(--ink-line); }
  .lp-themic .cred .fig { font-family: var(--display); font-weight: 800; font-size: clamp(36px, 4.6vw, 54px); line-height: 1; color: var(--white); margin-bottom: 10px; }
  .lp-themic .cred .fig small { font-size: 0.38em; font-family: var(--body); font-weight: 600; margin-left: 4px; color: var(--white); }
  .lp-themic .cred .cap { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); margin-bottom: 8px; }
  .lp-themic .cred p { font-size: 14.5px; color: #b0b0b0; }
  .lp-themic .pull {
    margin-top: 46px; border-left: 3px solid var(--gold); padding: 6px 0 6px 26px;
    font-family: var(--display); font-weight: 700; font-size: clamp(19px, 2.5vw, 28px); line-height: 1.3;
    color: var(--white); max-width: 860px;
  }

  /* ---------- Marcas ---------- */
  .lp-themic .brands { margin-top: 56px; padding-top: 40px; border-top: 1px solid var(--ink-line); }
  .lp-themic .brand-list { display: flex; flex-wrap: wrap; gap: 10px 12px; margin-top: 20px; }
  .lp-themic .brand-list span {
    font-family: var(--mono); font-size: 13px; letter-spacing: 0.04em;
    color: #a5a5a5; border: 1px solid var(--ink-line);
    padding: 9px 15px; border-radius: 2px; white-space: nowrap;
  }
