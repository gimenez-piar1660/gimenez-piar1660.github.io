  .lp-themic .consent input[type="checkbox"] { width: 19px; height: 19px; flex-shrink: 0; accent-color: var(--gold); margin-top: 2px; }
  .lp-themic .consent label {
    font-family: var(--body); font-size: 12.5px; font-weight: 400; text-transform: none;
    letter-spacing: normal; color: #a9a9ac; line-height: 1.55; cursor: pointer;
  }
  .lp-themic .consent label a { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }
  .lp-themic .field-consent.invalid .consent label { color: #ffb4b1; }

  .lp-themic .form-done { display: none; text-align: center; padding: 26px 0 10px; }
  .lp-themic .form-done.show { display: block; }
  .lp-themic .form-done .waveform { justify-content: center; margin-bottom: 24px; }
  .lp-themic .form-done h3 { color: var(--gold); font-size: 23px; margin-bottom: 12px; }
  .lp-themic .form-done p { color: #c2c2c2; font-size: 15.5px; }
  .lp-themic .form-error {
    display: none; margin-top: 16px; padding: 14px 16px; border: 1px solid var(--on-air);
    color: #ffb4b1; font-size: 14px; border-radius: 2px;
  }
  .lp-themic .form-error.show { display: block; }

  /* ---------- Rodapé ---------- */
  .lp-themic footer { background: var(--ink); color: #767676; padding: 44px 0 96px; border-top: 1px solid var(--ink-line); }
  .lp-themic .footer-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 18px; }
  .lp-themic .footer-row .fmark { font-family: var(--display); font-weight: 800; color: var(--gold); font-size: 16px; letter-spacing: 0.04em; }
  .lp-themic footer p { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.06em; }

  /* ---------- Imagens ---------- */
  .lp-themic .hero-photo {
    position: absolute; top: 0; right: 0; bottom: 0; width: 52%;
    background-size: cover; background-position: center 30%;
    z-index: 1; opacity: 0.9;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.6) 32%, #000 72%);
    mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.6) 32%, #000 72%);
  }
  .lp-themic .figure { position: relative; border-radius: 3px; overflow: hidden; background: var(--ink); }
  .lp-themic .figure img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lp-themic .figure figcaption {
    position: absolute; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to top, rgba(15,15,17,0.94) 40%, rgba(15,15,17,0));
    padding: 30px 24px 20px; color: var(--white);
  }
  .lp-themic .figure figcaption strong { display: block; font-size: 16px; font-weight: 600; letter-spacing: -0.01em; margin-bottom: 6px; }
  .lp-themic .figure figcaption span {
    font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--gold);
  }

  .lp-themic .split { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: start; margin-top: 40px; }
  .lp-themic .split .notlist { margin-top: 0; }
  .lp-themic .split-figure { aspect-ratio: 4 / 3; }

  .lp-themic .room-shots { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
  .lp-themic .room-shots .figure { aspect-ratio: 16 / 10; }

  .lp-themic .conductor { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 48px; align-items: center; margin-top: 48px; }
  .lp-themic .conductor .figure { aspect-ratio: 4 / 3; }
  .lp-themic .conductor-name { font-family: var(--display); font-weight: 800; font-size: clamp(24px, 3vw, 36px); color: var(--white); line-height: 1.08; letter-spacing: -0.015em; margin-bottom: 10px; }
  .lp-themic .conductor-role { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); margin-bottom: 20px; }
  .lp-themic .conductor p { font-size: 16.5px; color: #c2c2c2; line-height: 1.6; }

  /* ---------- Reveal ---------- */
  .lp-themic .reveal { opacity: 0; transform: translateY(22px); transition: opacity 0.7s ease, transform 0.7s ease; }
  .lp-themic .reveal.in { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .lp-themic .waveform .bar, .lp-themic .hero-wave-bg .bar, .lp-themic .dot { animation: none !important; }
    .lp-themic .reveal { opacity: 1; transform: none; transition: none; }
    .lp-themic .stickybar { transition: none; }
  }

  /* ---------- Responsivo ---------- */
  @media (max-width: 980px) {
    .lp-themic .signup-grid { grid-template-columns: 1fr; gap: 40px; }
    .lp-themic .credentials, .lp-themic .facts { grid-template-columns: repeat(2, 1fr); gap: 28px; }
    .lp-themic .steps, .lp-themic .assets, .lp-themic .pillars, .lp-themic .chairs { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .lp-themic .wrap { padding: 0 20px; }
    .lp-themic .block, .lp-themic .closing, .lp-themic .signup { padding: 68px 0; }
    .lp-themic .hero { padding: 76px 0 60px; }
    .lp-themic .pain-grid, .lp-themic .room, .lp-themic .who, .lp-themic .swap { grid-template-columns: 1fr; }
    .lp-themic .hero-photo { display: none; }
    .lp-themic .split, .lp-themic .conductor { grid-template-columns: 1fr; gap: 34px; }
    .lp-themic .room-shots { grid-template-columns: 1fr; }
    .lp-themic .stat-grid { grid-template-columns: 1fr; gap: 34px; }
    .lp-themic .reach-row { grid-template-columns: 1fr; gap: 8px; }
    .lp-themic .stickybar { padding: 12px 20px; }
    .lp-themic .stickybar p { display: none; }
    .lp-themic .stickybar .btn { width: 100%; }
    .lp-themic .form-card { padding: 32px 24px; }
  }
  @media (max-width: 520px) {
    .lp-themic .steps, .lp-themic .assets, .lp-themic .pillars, .lp-themic .chairs, .lp-themic .credentials, .lp-themic .facts { grid-template-columns: 1fr; }
  }
</style>

<script is:inline define:vars={{ RD_PUBLIC_KEY, RD_ID_THEMIC }}>
(function () {
  /* ---------- Waveforms ---------- */
  function makeWave(el, count, minH, maxH) {
    if (!el) return;
    el.innerHTML = '';
    for (let i = 0; i < count; i++) {
      const bar = document.createElement('span');
      bar.className = 'bar';
      bar.style.height = Math.floor(Math.random() * (maxH - minH) + minH) + 'px';
      bar.style.animationDelay = (Math.random() * 1.2).toFixed(2) + 's';
      bar.style.animationDuration = (0.9 + Math.random() * 0.9).toFixed(2) + 's';
      el.appendChild(bar);
    }
  }
  makeWave(document.getElementById('heroWave'), 64, 20, 260);
  makeWave(document.getElementById('closingWave'), 64, 20, 220);
  makeWave(document.getElementById('swapWave'), 18, 8, 40);
  makeWave(document.getElementById('doneWave'), 26, 6, 38);

  /* ---------- Reveal on scroll ---------- */
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.lp-themic .reveal').forEach((el) => io.observe(el));

  /* ---------- Barra fixa ---------- */
  const sticky = document.getElementById('stickybar');
  const lista = document.getElementById('lista');
  window.addEventListener('scroll', () => {
    if (!sticky || !lista) return;
    const passouHero = window.scrollY > window.innerHeight * 0.8;
    const chegouNoForm = lista.getBoundingClientRect().top < window.innerHeight * 0.9;
    sticky.classList.toggle('show', passouHero && !chegouNoForm);
  }, { passive: true });

  /* ---------- Máscara de telefone ---------- */
  const tel = document.getElementById('personal_phone');
  if (tel) {
    tel.addEventListener('input', () => {
      let v = tel.value.replace(/\D/g, '').slice(0, 11);
      if (v.length > 6) v = `(${v.slice(0,2)}) ${v.slice(2, v.length === 11 ? 7 : 6)}-${v.slice(v.length === 11 ? 7 : 6)}`;
      else if (v.length > 2) v = `(${v.slice(0,2)}) ${v.slice(2)}`;
      else if (v.length > 0) v = `(${v}`;
      tel.value = v;
    });
  }

  /* ---------- Origem do lead: mesmo mecanismo de /contato ----------
     Cookie piar_atrib (gravado só após consentimento de marketing, ver
     ConsentimentoCookies.astro) → sessionStorage → query string desta
     própria visita. Cobre quem converte na hora, antes de decidir sobre
     cookies, e quem converte dias depois de ter clicado no link com UTM. */
  (function capturaOrigem() {
    let atrib = {};
    const bruto = document.cookie.split('; ').find((c) => c.indexOf('piar_atrib=') === 0);
    if (bruto) {
      try { atrib = JSON.parse(decodeURIComponent(bruto.slice('piar_atrib='.length))); } catch (err) { atrib = {}; }
    }
    if (!Object.keys(atrib).length) {
      try {
        const sessao = sessionStorage.getItem('piar_atrib');
        if (sessao) atrib = JSON.parse(sessao);
      } catch (err) { atrib = {}; }
    }
    const qs = new URLSearchParams(location.search);
    const set = (id, valor) => { const el = document.getElementById(id); if (el) el.value = valor || ''; };
    set('h-utm-source', atrib.utm_source || qs.get('utm_source'));
    set('h-utm-medium', atrib.utm_medium || qs.get('utm_medium'));
    set('h-utm-campaign', atrib.utm_campaign || qs.get('utm_campaign'));
    set('h-utm-content', atrib.utm_content || qs.get('utm_content'));
    set('h-landing-page', atrib.landing_page || (location.pathname + location.search));
    set('h-referrer', atrib.referrer || (document.referrer && document.referrer.indexOf(location.origin) !== 0 ? document.referrer : ''));
    set('h-pagina-conversao', location.pathname);
  })();

  /* ---------- Validação e envio ---------- */
  const form = document.getElementById('micForm');
  const btn = document.getElementById('submitBtn');
  const erroBox = document.getElementById('formError');
  if (!form) return;

  const RD_ATIVO = RD_PUBLIC_KEY && RD_PUBLIC_KEY.indexOf('COLE-SUA') !== 0;

  function valida(id, teste) {
    const campo = document.getElementById('f-' + id);
    const input = document.getElementById(id);
    const ok = teste(input);
    if (campo) campo.classList.toggle('invalid', !ok);
    input.setAttribute('aria-invalid', ok ? 'false' : 'true');
    return ok;
  }

  function checa(id) {
    if (id === 'name')           return valida('name', (i) => i.value.trim().length >= 3 && i.value.trim().includes(' '));
    if (id === 'email')          return valida('email', (i) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(i.value.trim()));
    if (id === 'personal_phone') return valida('personal_phone', (i) => i.value.replace(/\D/g,'').length >= 10);
    if (id === 'company_name')   return valida('company_name', (i) => i.value.trim().length >= 2);
    if (id === 'consent')        return valida('consent', (i) => i.checked);
  }

  ['name','email','personal_phone','company_name'].forEach((id) => {
    document.getElementById(id).addEventListener('blur', () => checa(id));
  });
  document.getElementById('consent').addEventListener('change', () => checa('consent'));

  function dadosDoForm() {
    const dados = {};
    new FormData(form).forEach((valor, chave) => {
      if (chave === 'botcheck' || chave === 'consent') return;
      if (typeof valor === 'string' && valor.trim()) dados[chave] = valor.trim();
    });
    return dados;
  }

  // RD Station · API de conversões com chave pública (mesmo padrão de /contato)
  async function enviarRD(dados) {
    const resp = await fetch('https://api.rd.services/platform/conversions?api_key=' + encodeURIComponent(RD_PUBLIC_KEY), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        event_type: 'CONVERSION',
        event_family: 'CDP',
        payload: Object.assign({}, dados, {
          conversion_identifier: RD_ID_THEMIC,
          traffic_source: dados.cf_utm_source || '',
          traffic_medium: dados.cf_utm_medium || '',
          traffic_campaign: dados.cf_utm_campaign || '',
        }),
      }),
    });
    if (!resp.ok) throw new Error('RD Station respondeu ' + resp.status);
    return true;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    erroBox.classList.remove('show');

    if (form.botcheck && form.botcheck.value) return;

    const campos = ['name','email','personal_phone','company_name','consent'];
    const tudoOk = campos.map(checa).every(Boolean);
    if (!tudoOk) {
      const primeiroInvalido = document.querySelector('.lp-themic .field.invalid input');
      if (primeiroInvalido) primeiroInvalido.focus();
      return;
    }

    const dados = dadosDoForm();

    btn.disabled = true;
    btn.textContent = 'Enviando…';

    try {
      if (RD_ATIVO) {
        await enviarRD(dados);
      } else {
        console.log('[THE MIC] RD_PUBLIC_KEY ausente, modo demonstração.', dados);
        await new Promise((res) => setTimeout(res, 600));
      }

      document.getElementById('formWrap').style.display = 'none';
      document.getElementById('formDone').classList.add('show');
      if (sticky) sticky.classList.remove('show');

    } catch (err) {
      console.error('[THE MIC]', err);
      erroBox.textContent = 'Não foi possível enviar agora. Tente de novo em instantes ou escreva para ' + 'contato@piar.group' + '.';
      erroBox.classList.add('show');
      btn.disabled = false;
      btn.textContent = 'Entrar na fila da Edição 1';
    }
