  .lp-themic .who-card h3 { font-size: 21px; letter-spacing: -0.015em; margin-bottom: 12px; line-height: 1.25; }
  .lp-themic .who-card p { font-size: 16.5px; color: var(--graphite); }
  .lp-themic .who-note {
    margin-top: 24px; background: var(--ink); color: #d6d6d6; padding: 30px 32px;
