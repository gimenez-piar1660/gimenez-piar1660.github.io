        <img src={withBase('/brand/piar-horizontal-negativo.png')} alt="" class="fmark-piar" width="82" height="27" loading="lazy" />
        <span class="fmark">THE MIC</span>
      </a>
      <p>IMERSÃO EM AUTORIDADE EXECUTIVA · PIAR GROUP · SÃO PAULO · 2026</p>
    </div>
  </footer>

  <!-- Barra fixa de CTA -->
  <div class="stickybar" id="stickybar">
    <p><span class="dot"></span> Edição 1 · 30 cadeiras · Sala em composição</p>
    <a href="#lista" class="btn" data-cta="sticky">Garantir prioridade</a>
  </div>

</div>

<style>
  .lp-themic {
    /* ---------- Tokens locais, mapeados para o design system PiaR ----------
       Nomes mantidos iguais aos do arquivo recebido (facilita comparar), mas
       os VALORES agora apontam para src/styles/tokens.css. --gold-deep usa
       --accent-deep (não --yellow-700): é o par eyebrow/label sobre fundo
       claro já usado em dezenas de páginas do site (privacidade, contato,
       cases, blog...), então é essa a consistência que importa aqui, não o
       contraste técnico perfeito de um tom alternativo nunca usado. */
    /* --ink, --ink-soft, --paper e --white NÃO são redeclarados: já existem
       com este nome e este valor exato em tokens.css e chegam por herança.
       Redeclarar var(--ink) dentro de --ink criaria uma referência circular
       (spec resolve isso caindo pro valor herdado, mas é frágil depender
       disso; mais simples não escrever a linha). */
    --ink-line: var(--hairline-d);
    --paper-dim: var(--gray-100);
    --paper-line: var(--hairline-strong);
    --gold: var(--yellow);
    --gold-deep: var(--accent-deep);
    --graphite: var(--text-muted);
    --graphite-soft: var(--text-faint);
    --on-air: #A83232;
    --display: var(--font-display);
    --body: var(--font-sans);
    --mono: var(--font-mono);

    display: block;
    font-family: var(--body);
    background: var(--paper);
    color: var(--ink);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  .lp-themic * { margin: 0; padding: 0; box-sizing: border-box; }
  .lp-themic img, .lp-themic svg { display: block; max-width: 100%; }
  .lp-themic a { color: inherit; }
  .lp-themic ::selection { background: var(--gold); color: var(--ink); }
  .lp-themic :focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }

  .lp-themic .wrap { max-width: 1180px; margin: 0 auto; padding: 0 32px; }
  .lp-themic .block { padding: 104px 0; }
  .lp-themic .block-dark { background: var(--ink); color: var(--white); }
  .lp-themic .block-dim { background: var(--paper-dim); }

  /* ---------- Marca PiaR discreta (hero + rodapé) ---------- */
  .lp-themic .piar-mark { display: inline-flex; opacity: .8; transition: opacity .2s ease; }
  .lp-themic .piar-mark:hover { opacity: 1; }
  .lp-themic .piar-mark img { width: 14px; height: 14px; }
  .lp-themic .fmark-link { display: inline-flex; align-items: center; gap: 9px; text-decoration: none; }
  .lp-themic .fmark-piar { opacity: .55; transition: opacity .2s ease; }
  .lp-themic .fmark-link:hover .fmark-piar { opacity: .85; }

  /* ---------- Eyebrow ---------- */
  .lp-themic .eyebrow {
    display: inline-flex; align-items: center; gap: 9px;
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--gold-deep);
    margin-bottom: 22px;
  }
  .lp-themic .eyebrow.on-dark { color: var(--gold); }
  .lp-themic .dot {
    width: 7px; height: 7px; border-radius: 50%; background: var(--on-air);
    animation: pulse 1.9s infinite; flex-shrink: 0;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(168,50,50,0.55); }
    70% { box-shadow: 0 0 0 9px rgba(168,50,50,0); }
    100% { box-shadow: 0 0 0 0 rgba(168,50,50,0); }
  }

  /* ---------- Escala tipográfica ---------- */
  .lp-themic .title {
    font-family: var(--display); font-weight: 800;
    font-size: clamp(30px, 4.2vw, 54px);
    line-height: 1.03;
    letter-spacing: -0.015em;
    margin-bottom: 24px;
  }
  .lp-themic .title .gold { color: var(--gold); }
  .lp-themic .title .deep { color: var(--gold-deep); }
  .lp-themic .lede { font-size: 19px; color: var(--graphite); max-width: 660px; }
  .lp-themic .block-dark .lede { color: #c6c6c6; }

  /* ---------- Waveform ---------- */
  .lp-themic .waveform { display: flex; align-items: center; gap: 3px; height: 44px; }
  .lp-themic .waveform .bar {
    width: 3px; background: var(--gold); border-radius: 2px;
    animation: wave 1.2s ease-in-out infinite; transform-origin: center;
  }
  .lp-themic .waveform.muted .bar { background: var(--graphite-soft); animation: none; height: 4px !important; }
  @keyframes wave {
    0%, 100% { transform: scaleY(0.22); }
    50% { transform: scaleY(1); }
  }

  /* ---------- Botões ---------- */
  .lp-themic .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    background: var(--gold); color: var(--ink);
    font-family: var(--body); font-weight: 700; font-size: 15px;
    padding: 18px 32px; border: 1px solid var(--gold); border-radius: 2px;
    cursor: pointer; text-decoration: none;
    transition: transform 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .lp-themic .btn:hover { transform: translateY(-2px); background: var(--white); border-color: var(--white); }
  .lp-themic .btn-lg { padding: 20px 40px; font-size: 16.5px; }

  /* ---------- Barra fixa ---------- */
  .lp-themic .stickybar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 90;
    background: var(--ink); border-top: 1px solid var(--ink-line);
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding: 14px 32px; transform: translateY(110%);
    transition: transform 0.35s cubic-bezier(.2,.7,.3,1);
  }
  .lp-themic .stickybar.show { transform: translateY(0); }
  .lp-themic .stickybar p {
    font-family: var(--mono); font-size: 12.5px; color: #b9b9b9;
    letter-spacing: 0.04em; text-transform: uppercase;
    display: flex; align-items: center; gap: 9px;
  }
  .lp-themic .stickybar .btn { padding: 13px 24px; font-size: 14px; }

  /* ---------- Hero ---------- */
  .lp-themic .hero {
    background: var(--ink); color: var(--white);
    padding: 108px 0 84px; position: relative; overflow: hidden;
  }
  .lp-themic .hero .wrap { position: relative; z-index: 2; }
  .lp-themic .hero-wave-bg {
    position: absolute; inset: 0; display: flex; align-items: flex-end;
    justify-content: center; gap: 5px; opacity: 0.13; z-index: 1;
  }
  .lp-themic .hero-wave-bg .bar { width: 6px; background: var(--gold); animation: wave 2.6s ease-in-out infinite; }
  .lp-themic .hero-mark {
    font-family: var(--display); font-weight: 800;
    font-size: clamp(58px, 11.5vw, 138px);
    line-height: 0.86; letter-spacing: -0.015em;
    color: var(--gold); margin-bottom: 30px;
  }
  .lp-themic .hero-mark .the {
    display: block; font-size: 0.26em; letter-spacing: 0.42em;
    color: var(--white); margin-bottom: 10px;
  }
  .lp-themic .hero-tagline {
    font-size: clamp(21px, 2.7vw, 33px);
    font-weight: 600; line-height: 1.24; letter-spacing: -0.015em;
    max-width: 760px; margin-bottom: 22px;
  }
  .lp-themic .hero-tagline mark { background: var(--gold); color: var(--ink); padding: 0 6px; }
  .lp-themic .hero-sub { font-size: 17.5px; color: #c2c2c2; max-width: 620px; margin-bottom: 34px; }
  .lp-themic .hero-urgency {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--mono); font-size: 12.5px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--gold);
    border: 1px solid rgba(254,209,54,0.35); border-radius: 999px;
    padding: 10px 18px; margin-bottom: 30px;
  }
  .lp-themic .cta-row { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .lp-themic .cta-note { font-family: var(--mono); font-size: 12px; color: var(--graphite-soft); letter-spacing: 0.06em; }
  .lp-themic .hero-strip {
    margin-top: 54px; padding-top: 22px; border-top: 1px solid var(--ink-line);
    font-family: var(--mono); font-size: 12px; color: var(--graphite-soft);
    letter-spacing: 0.14em; text-transform: uppercase;
  }

  /* ---------- Pilares ---------- */
  .lp-themic .pillars {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
    background: var(--paper-line); border: 1px solid var(--paper-line); margin-top: 52px;
  }
  .lp-themic .pillar { background: var(--paper); padding: 30px 26px; }
  .lp-themic .pillar span {
    font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--gold-deep); display: block; margin-bottom: 12px;
  }
  .lp-themic .pillar strong { font-size: 18px; font-weight: 700; letter-spacing: -0.01em; }

  /* ---------- Alcance ---------- */
  .lp-themic .reach { margin-top: 50px; display: grid; max-width: 780px; }
  .lp-themic .reach-row {
    display: grid; grid-template-columns: 230px 1fr; gap: 26px; align-items: baseline;
    padding: 24px 0; border-top: 1px solid var(--ink-line);
  }
  .lp-themic .reach-row:last-child { border-bottom: 1px solid var(--ink-line); }
  .lp-themic .reach-key {
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--gold);
  }
  .lp-themic .reach-val { font-size: 20px; font-weight: 600; color: var(--white); letter-spacing: -0.01em; }

  /* ---------- Dores ---------- */
  .lp-themic .pain-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px;
    background: var(--paper-line); border: 1px solid var(--paper-line); margin-top: 48px;
  }
  .lp-themic .pain {
    background: var(--white); padding: 30px; font-size: 16.5px; color: var(--ink);
    display: flex; gap: 15px; align-items: flex-start; line-height: 1.45;
  }
  .lp-themic .pain .q { font-family: var(--mono); color: var(--gold-deep); font-size: 15px; flex-shrink: 0; }

  /* ---------- Prova ---------- */
  .lp-themic .stat-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px;
    margin-top: 52px; padding-top: 40px; border-top: 1px solid var(--paper-line);
  }
  .lp-themic .stat .fig {
    font-family: var(--display); font-weight: 800; font-size: clamp(46px, 6vw, 68px);
    line-height: 1; letter-spacing: -0.02em; margin-bottom: 12px;
  }
  .lp-themic .stat .fig sup { font-size: 0.42em; vertical-align: super; margin-left: 2px; }
  .lp-themic .stat .cap {
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--gold-deep); margin-bottom: 10px;
  }
  .lp-themic .stat p { font-size: 15px; color: var(--graphite); }
  .lp-themic .source {
    margin-top: 34px; font-family: var(--mono); font-size: 11.5px;
    color: var(--graphite-soft); line-height: 1.6; max-width: 900px;
  }

  /* ---------- O que não é ---------- */
  .lp-themic .notlist { list-style: none; display: grid; gap: 2px; margin: 40px 0; max-width: 720px; }
  .lp-themic .notlist li {
    display: flex; align-items: center; gap: 16px;
    font-weight: 600; font-size: clamp(18px, 2.3vw, 26px);
    color: var(--graphite-soft); padding: 15px 0;
    border-bottom: 1px solid var(--paper-line);
    text-decoration: line-through; text-decoration-thickness: 2px;
  }
  .lp-themic .notlist .x {
    font-family: var(--mono); color: var(--on-air); font-size: 15px;
    text-decoration: none; flex-shrink: 0;
  }
  .lp-themic .yes-line {
    font-family: var(--display); font-weight: 700; font-size: clamp(21px, 2.9vw, 33px);
    line-height: 1.26; max-width: 820px;
  }
  .lp-themic .yes-line .accent { color: var(--gold-deep); }
  .lp-themic .facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-top: 54px; padding-top: 38px; border-top: 1px solid var(--paper-line); }
  .lp-themic .fact .fig { font-family: var(--display); font-weight: 800; font-size: clamp(34px, 4.4vw, 50px); line-height: 1; margin-bottom: 8px; }
  .lp-themic .fact .fig small { font-size: 0.36em; font-family: var(--body); font-weight: 600; margin-left: 5px; color: var(--graphite); }
  .lp-themic .fact .cap { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold-deep); margin-bottom: 8px; }
  .lp-themic .fact p { font-size: 14.5px; color: var(--graphite); }

  /* ---------- Antes x Depois ---------- */
  .lp-themic .swap { display: grid; grid-template-columns: 1fr 1fr; margin-top: 50px; border: 1px solid var(--paper-line); }
  .lp-themic .swap-col { padding: 40px 36px; }
  .lp-themic .swap-col.before { background: var(--white); }
  .lp-themic .swap-col.after { background: var(--ink); color: var(--white); }
  .lp-themic .swap-label {
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--graphite); display: block; margin-bottom: 20px;
  }
  .lp-themic .swap-col.after .swap-label { color: var(--gold); }
  .lp-themic .swap-col ul { list-style: none; display: grid; gap: 15px; margin-top: 20px; }
  .lp-themic .swap-col li { font-size: 16.5px; font-weight: 500; padding-left: 24px; position: relative; }
  .lp-themic .swap-col.before li::before { content: '×'; position: absolute; left: 0; color: var(--graphite-soft); font-size: 17px; }
  .lp-themic .swap-col.after li::before { content: '▲'; position: absolute; left: 0; top: 6px; font-size: 9px; color: var(--gold); }

  /* ---------- Método ---------- */
  .lp-themic .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--ink-line); margin-top: 50px; border: 1px solid var(--ink-line); }
  .lp-themic .step { background: var(--ink); padding: 34px 28px; }
  .lp-themic .step .n { font-family: var(--display); font-weight: 800; font-size: 30px; color: var(--gold); display: block; margin-bottom: 16px; }
  .lp-themic .step .when {
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--graphite-soft); display: block; margin-bottom: 8px;
  }
  .lp-themic .step h3 { font-size: 19px; margin-bottom: 12px; letter-spacing: -0.01em; }
  .lp-themic .step p { font-size: 14.5px; color: #b6b6b6; }

  .lp-themic .room-title {
    margin-top: 66px; font-family: var(--display); font-weight: 800;
    font-size: clamp(21px, 2.9vw, 32px); color: var(--white);
    line-height: 1.2; max-width: 820px;
  }
  .lp-themic .room-title span { color: var(--gold); }
  .lp-themic .room { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--ink-line); margin-top: 30px; border: 1px solid var(--ink-line); }
  .lp-themic .room-item { background: var(--ink); padding: 24px 28px; display: flex; gap: 14px; align-items: flex-start; }
