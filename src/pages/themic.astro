                    <label class="opt"><input type="checkbox" name="cf_objetivo_imersao" value="Vender mais usando minha imagem" /><span>Vender mais usando minha imagem</span></label>
                    <label class="opt"><input type="checkbox" name="cf_objetivo_imersao" value="Falar melhor em palco e reunião" /><span>Falar melhor em palco e reunião</span></label>
                    <label class="opt"><input type="checkbox" name="cf_objetivo_imersao" value="Captar investimento" /><span>Captar investimento</span></label>
                    <label class="opt"><input type="checkbox" name="cf_objetivo_imersao" value="Ser encontrado em busca e IA" /><span>Ser encontrado em busca e IA</span></label>
                    <label class="opt"><input type="checkbox" name="cf_objetivo_imersao" value="Perder o medo de me expor" /><span>Perder o medo de me expor</span></label>
                  </div>
                </div>

                <div class="qblock" data-q="cf_disponibilidade_data">
