            <p class="ds-body-sm text-stone-500 mb-8 max-w-[260px]">
              As três primeiras têm início e fim definidos; a quarta é contínua, em ciclos quinzenais,
              enquanto o projeto durar.
            </p>
          </div>
          <a href="/contato" class="pill-tag w-max">Agendar diagnóstico<iconify-icon icon="solar:arrow-right-up-linear"></iconify-icon></a>
        </div>

        <div class="md:col-span-3 flex flex-col">
          {etapas.map((e, i) => (
            <div class:list={['step-row', 'reveal', i === 1 && 'delay-100', i === 2 && 'delay-200', i === 3 && 'delay-300']}>
              <div class="step-num">
                <div class="step-icon"><iconify-icon height="22" icon={e.icon}></iconify-icon></div>
                <span class="ds-mono text-stone-300">{e.num}</span>
              </div>
              <div class="p-8 md:p-10 flex flex-col gap-5">
                <div>
                  <span class="ds-caption text-stone-400">{e.prazo}</span>
