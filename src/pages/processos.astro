    </section>

    <!-- OS DOIS COMPROMISSOS DE PRAZO -->
    <section class="relative z-20 bg-white border-t border-[var(--hairline)]">
      <div class="max-w-[1400px] mx-auto px-6 md:px-8 sec-pad">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-8 mb-12 reveal">
          <div>
            <span class="ds-mono text-stone-400 block mb-3">/// Governança de prazo</span>
            <h2 class="ds-h2 font-semibold tracking-tight">Dois números organizam a relação.</h2>
          </div>
          <a href="/contato" class="pill-tag hidden md:inline-flex">Agendar diagnóstico<iconify-icon icon="solar:arrow-right-up-linear"></iconify-icon></a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {compromissos.map((c, i) => (
            <div class:list={['gov-card', 'reveal', i === 1 && 'delay-100', i === 2 && 'delay-200']}>
