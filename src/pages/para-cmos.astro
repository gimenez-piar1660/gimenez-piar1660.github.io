            p.vy += (pdy / pd) * f + (pdx / pd) * f * 0.5;
            p.vx *= 0.992; p.vy *= 0.992;
            p.x += p.vx; p.y += p.vy;
            var heat = Math.max(0, Math.min(1, (1 - (pd - 30) / (Math.min(W, H) * 0.5)) * (0.4 + scrollP * 0.9)));
            p.heat += (heat - p.heat) * 0.05;
            if (pd < 22) { p.x = Math.random() * W; p.y = Math.random() * H; p.vx = 0; p.vy = 0; p.heat = 0; }
            var cr = Math.round(91 + 163 * p.heat), cg = Math.round(123 + 86 * p.heat), cb = Math.round(154 - 100 * p.heat);
            ctx.beginPath(); ctx.arc(p.x, p.y, 1 + p.m * 1.3, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(' + cr + ',' + cg + ',' + cb + ',' + (0.3 + 0.5 * p.heat) + ')'; ctx.fill();
          }

          // o corpo "mercado": orbita a marca e fecha o raio conforme o scroll
          mkAng += prefersReduced ? 0 : 0.011;
          var orbR = (0.30 - me * 0.17) * Math.min(W, H);
          if (orbR < 34) orbR = 34;
          // o angulo jornalistico muda: o plano da orbita inclina e gira com o scroll.
          // a camera arca por cima do sistema no meio e o plano gira pro outro lado.
          var orbTilt = 0.24 + 0.58 * Math.sin(scrollP * Math.PI);   // edge-on nas pontas, aberto no meio
          var orbRot = scrollP * 1.5;                                // o plano gira ~86deg ao longo da pagina
          orbR *= (1 - finale * 0.9);                  // no clima o mercado despenca pra dentro e e absorvido
          var ox = Math.cos(mkAng) * orbR, oy = Math.sin(mkAng) * orbR * orbTilt;
          var cr_ = Math.cos(orbRot), sr_ = Math.sin(orbRot);
          var mkx = bx + ox * cr_ - oy * sr_;
          var mky = by + ox * sr_ + oy * cr_;
          var mkFade = 1 - finale;                      // o mercado some ao se fundir com a marca
          // tether de atracao
          ctx.beginPath(); ctx.moveTo(bx, by); ctx.lineTo(mkx, mky);
          ctx.strokeStyle = 'rgba(254,209,54,' + ((0.08 + scrollP * 0.14) * mkFade) + ')'; ctx.lineWidth = 1; ctx.stroke();
          // o mercado esquenta conforme cai (scroll)
          var mh = Math.min(1, scrollP * 1.1);
          var mr = Math.round(91 + 163 * mh), mg = Math.round(123 + 86 * mh), mb = Math.round(154 - 100 * mh);
          ctx.beginPath(); ctx.arc(mkx, mky, 5.5 * (0.55 + 0.45 * mkFade), 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(' + mr + ',' + mg + ',' + mb + ',' + mkFade.toFixed(3) + ')';
          ctx.shadowColor = 'rgba(' + mr + ',' + mg + ',' + mb + ',' + (0.8 * mkFade).toFixed(3) + ')'; ctx.shadowBlur = 16; ctx.fill(); ctx.shadowBlur = 0;

          // a marca: nucleo quente. cresce com a massa e INCHA no clima, absorvendo o mercado.
          var coreR = 5 + mass * 3 + finale * finale * 30;
          // transicao: um halo de choque floresce e se dissipa na aproximacao do fim (reversivel)
          var bloom = Math.sin(finale * Math.PI);
          if (bloom > 0.002) {
            ctx.beginPath(); ctx.arc(bx, by, coreR + bloom * Math.max(W, H) * 0.2, 0, Math.PI * 2);
            ctx.strokeStyle = 'rgba(254,209,54,' + (bloom * 0.45).toFixed(3) + ')'; ctx.lineWidth = 1.5; ctx.stroke();
            ctx.beginPath(); ctx.arc(bx, by, coreR + bloom * Math.max(W, H) * 0.11, 0, Math.PI * 2);
            ctx.strokeStyle = 'rgba(255,236,176,' + (bloom * 0.3).toFixed(3) + ')'; ctx.lineWidth = 1; ctx.stroke();
          }
          ctx.beginPath(); ctx.arc(bx, by, coreR, 0, Math.PI * 2);
          ctx.fillStyle = '#FED136'; ctx.shadowColor = 'rgba(254,209,54,.95)'; ctx.shadowBlur = 24 + mass * 8 + finale * 34; ctx.fill(); ctx.shadowBlur = 0;
          // anel fino e brilhante na borda do sol inchado (definicao no fim)
          if (finale > 0.02) {
            ctx.beginPath(); ctx.arc(bx, by, coreR + 2.5, 0, Math.PI * 2);
            ctx.strokeStyle = 'rgba(255,243,205,' + (0.55 * finale).toFixed(3) + ')'; ctx.lineWidth = 1.3; ctx.stroke();
          }

          // etiquetas seguem os corpos, somem ao sair do herói
          heroFade += ((scrollP < 0.11 ? 1 : 0) - heroFade) * 0.07;
          if (lblMarca) { lblMarca.style.transform = 'translate(' + bx + 'px,' + by + 'px) translate(-50%, 16px)'; lblMarca.style.opacity = heroFade.toFixed(3); }
          if (lblMercado) { lblMercado.style.transform = 'translate(' + mkx + 'px,' + mky + 'px) translate(-50%, 16px)'; lblMercado.style.opacity = heroFade.toFixed(3); }

          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      })();

      /* ========================================================
         POCO GRAVITACIONAL (a virada: funil linear -> poco)
         ======================================================== */
      (function well() {
        var canvas = document.getElementById('well-canvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0;
        function resize() { var r = canvas.getBoundingClientRect(); W = r.width; H = r.height; canvas.width = W * dpr; canvas.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); }
        resize();
        window.addEventListener('resize', resize);
        var t = 0;
        function frame() {
          t += prefersReduced ? 0 : 0.006;
          ctx.clearRect(0, 0, W, H);
          var cx = W * 0.5, cy = H * 0.5, rings = 13;
          for (var i = rings; i >= 1; i--) {
            var pp = i / rings, rx = (W * 0.46) * pp, ry = rx * 0.42, yo = cy + (1 - pp) * H * 0.3;
            ctx.beginPath(); ctx.ellipse(cx, yo, rx, ry, 0, 0, Math.PI * 2);
            ctx.strokeStyle = 'rgba(' + Math.round(116 + 138 * (1 - pp)) + ',' + Math.round(146 + 63 * (1 - pp)) + ',' + Math.round(176 - 122 * (1 - pp)) + ',' + (0.05 + (1 - pp) * 0.18) + ')';
            ctx.lineWidth = 1; ctx.stroke();
          }
          var core = cy + H * 0.3;
          var cg = ctx.createRadialGradient(cx, core, 0, cx, core, W * 0.2);
          cg.addColorStop(0, 'rgba(254,209,54,.5)'); cg.addColorStop(0.4, 'rgba(254,209,54,.12)'); cg.addColorStop(1, 'rgba(254,209,54,0)');
          ctx.fillStyle = cg; ctx.beginPath(); ctx.arc(cx, core, W * 0.2, 0, Math.PI * 2); ctx.fill();
          ctx.beginPath(); ctx.arc(cx, core, 5, 0, Math.PI * 2); ctx.fillStyle = '#FED136'; ctx.shadowColor = 'rgba(254,209,54,.9)'; ctx.shadowBlur = 22; ctx.fill(); ctx.shadowBlur = 0;
          var prog = (t % 3) / 3, ang = t * 2.2, spiral = 1 - prog;
          var rx2 = (W * 0.46) * spiral, ry2 = rx2 * 0.42, yo2 = cy + (1 - spiral) * H * 0.3;
          var bxp = cx + Math.cos(ang) * rx2, byp = yo2 + Math.sin(ang) * ry2, heat = prog;
          var br = Math.round(91 + 163 * heat), bgc = Math.round(123 + 86 * heat), bb = Math.round(154 - 100 * heat);
          ctx.beginPath(); ctx.arc(bxp, byp, 4 + 2 * heat, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(' + br + ',' + bgc + ',' + bb + ',1)'; ctx.shadowColor = 'rgba(' + br + ',' + bgc + ',' + bb + ',.8)'; ctx.shadowBlur = 14; ctx.fill(); ctx.shadowBlur = 0;
          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      })();

      /* ========================================================
         O TRADUTOR · atividade -> impacto (cicla com crossfade)
         ======================================================== */
      (function translator() {
        var a = document.getElementById('tr-a-text'), b = document.getElementById('tr-b-text');
        if (!a || !b) return;
        var pairs = [
          ['Saímos em 15 veículos esta semana.', 'A marca ganhou massa na narrativa de liderança do setor.'],
          ['Número de publicações no mês.', 'Share of voice subindo contra os concorrentes.'],
          ['Lista de veículos e audiência somada.', 'Backlinks e palavras-chave que aproximam a marca da venda.']
        ];
        var i = 0;
        function set(n) { a.textContent = pairs[n][0]; b.textContent = pairs[n][1]; }
        set(0);
        if (prefersReduced) return;
        setInterval(function () {
          a.classList.add('swap'); b.classList.add('swap');
          setTimeout(function () { i = (i + 1) % pairs.length; set(i); a.classList.remove('swap'); b.classList.remove('swap'); }, 500);
        }, 3400);
      })();
    });
  </script>
</BaseLayout>
