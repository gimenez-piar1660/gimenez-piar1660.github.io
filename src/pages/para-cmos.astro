---
// ============================================================================
// NARRATIVA PARA CMOs · "O QUE UM CMO REALMENTE ESPERA DE PR"
// Conceito-assinatura: CAMPO GRAVITACIONAL DA MARCA.
//   PR não empurra (funil linear). Cria MASSA (reputação, autoridade, prova)
//   que gera GRAVIDADE e atrai o mercado.
// Inovação de storytelling: um único campo gravitacional FIXO, full-screen,
//   atrás da página inteira, cuja MASSA CRESCE conforme o scroll. O mercado é
//   um corpo que orbita a marca e vai caindo (esquentando) enquanto você lê.
//   Parallax full-screen atrás dos cards. Mouse move a massa de verdade.
// Voz institucional PiaR com a autoridade de quem já sentou dos dois lados.
// Fiel ao deck de Ana Flávia Carrilo.
// ============================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import { site } from '@/data/site';

const url = `${site.domain}/para-cmos`;

const motores = [
  { n: '01', t: 'Branding', d: 'Constrói a base. Consistência antes de escala.' },
  { n: '02', t: 'Conteúdo', d: 'Motor de aquisição, não peça isolada.' },
  { n: '03', t: 'Imprensa', d: 'Distribui autoridade além dos canais próprios.' },
  { n: '04', t: 'Tráfego', d: 'Alavanca o que já funciona. Não é a base.' },
];

const idioma = [
  { k: 'Receita', q: 'Quanto vendemos?' },
  { k: 'Pipeline', q: 'Quanto geramos?' },
  { k: 'ROI', q: 'Qual foi o retorno?' },
  { k: 'Crescimento', q: 'CAC, LTV, expansão.' },
];

const caminho = ['Publicação', 'Credibilidade', 'Confiança', 'Consideração', 'Venda'];

const corpos = [
  { ic: 'solar:cart-check-line-duotone', t: 'Vendas', d: 'Credibilidade que o time comercial usa para fechar com menos objeção.' },
  { ic: 'solar:chart-2-line-duotone', t: 'Investidores', d: 'Confiança de mercado que valida a empresa para fundos e parceiros.' },
  { ic: 'solar:crown-line-duotone', t: 'Liderança', d: 'Autoridade que posiciona CEO e founders como referência do setor.' },
  { ic: 'solar:users-group-rounded-line-duotone', t: 'Talentos', d: 'Atração e retenção de quem quer trabalhar numa empresa referência.' },
];

const reclamacoes = [
  { r: 'Ninguém conhece nossa marca.', o: 'Oportunidade de branding e distribuição.' },
  { r: 'As matérias não dão resultado.', o: 'Oportunidade de ativação e uso dos ativos.' },
  { r: 'Nosso CEO não aparece.', o: 'Oportunidade de posicionamento executivo.' },
  { r: 'Não entendem o que fazemos.', o: 'Oportunidade de narrativa e mensagem.' },
];

const argumentos = [
  { n: '01', t: 'Custo invisível da visibilidade', d: 'O custo de comprar o mesmo espaço em mídia paga transforma PR de centro de custo em centro de retorno.' },
  { n: '02', t: 'Impacto em SEO e tráfego', d: 'Backlinks de veículos relevantes, domain authority, tráfego orgânico, CAC. Conecta PR a uma métrica que a liderança já acompanha.' },
  { n: '03', t: 'Narrativa de awareness', d: 'Quais temas do negócio ganharam espaço na mídia, e como isso posiciona a empresa para vender.' },
];

// FAQ citável (alimenta a seção visível e o FAQPage JSON-LD).
const faq = [
  {
    q: 'PR é custo ou investimento?',
    a: 'PR é investimento quando a comunicação é tratada como construção de massa, reputação, autoridade e prova, que reduz o custo de aquisição e a resistência da venda. Vira custo quando fica presa no clipping, sem distribuição nem conexão com a meta de negócio.',
  },
  {
    q: 'Como medir o ROI de PR?',
    a: 'Conecte a comunicação a métricas que a liderança já acompanha: custo equivalente do espaço conquistado, backlinks e tráfego orgânico, share of voice e a redução de objeção no funil. O ponto não é contar matérias, e sim mostrar a massa que cada cobertura deixou. Veja <a href="/roi">como calcular o ROI de assessoria de imprensa</a>.',
  },
  {
    q: 'Qual a diferença entre PR e marketing?',
    a: 'Marketing responde por demanda e receita no curto prazo; PR constrói a reputação e a autoridade que tornam essa demanda mais barata de capturar. As duas querem a mesma coisa e rendem mais integradas. Veja <a href="/comunicacao-integrada">comunicação integrada</a>.',
  },
  {
    q: 'PR ajuda a vender?',
    a: 'Sim, de forma indireta e mensurável. O lead que chega depois de ler uma matéria em veículo confiável tem menos objeção e tende a pagar o preço cheio. A credibilidade que o comercial usa para fechar nasce da <a href="/reputacao">reputação</a> construída na imprensa.',
  },
  {
    q: 'PR ou mídia paga: o que vem primeiro?',
    a: 'PR constrói a base de credibilidade; a mídia paga alavanca o que já tem tração. Investir só em tráfego sobre uma marca sem reputação encarece o CAC. A sequência saudável é massa primeiro, alavanca depois.',
  },
];
---

<BaseLayout
  title="Para CMOs · O que marketing realmente espera de PR"
  description="Para o CMO, PR constrói a massa de reputação, autoridade e prova que reduz o custo de aquisição e a resistência da venda. A PiaR traduz comunicação para receita, pipeline e ROI desde 2013."
  canonical={url}
>
  <div id="scroll-progress" aria-hidden="true"></div>
  <Nav />

  <!-- Campo gravitacional fixo, full-screen, atrás de tudo. A massa cresce no scroll. -->
  <canvas id="field-bg" aria-hidden="true"></canvas>
  <span id="lbl-mercado" class="body-label cold" aria-hidden="true"><span class="cb-dot"></span>o mercado</span>
  <span id="lbl-marca" class="body-label warm" aria-hidden="true"><span class="wb-dot"></span>a marca</span>

  <main>
    <!-- ============ HERO ============ -->
    <section class="grav-hero">
      <div class="scrim" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <span class="eyebrow on-dark reveal"><span class="dot"></span>Para CMOs · O que marketing realmente espera de PR</span>
        <h1 class="reveal d1">PR não empurra a venda. Constrói a <span class="warm">massa</span> que a atrai.</h1>
        <p class="hero-sub reveal d2">
          Marketing e PR olham a mesma coisa de órbitas diferentes. O que une os dois é a massa que a marca acumula: reputação, autoridade, prova. Quanto mais massa, mais forte o campo, e mais o mercado é atraído sem ser perseguido.
        </p>
        <div class="cta-row reveal d3">
          <a href="#campo" class="btn btn-accent">Entender o campo<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
          <a href="#falar" class="btn btn-ghost-d">Falar com a PiaR</a>
        </div>
      </div>
      <span class="grav-cue" aria-hidden="true"><span class="l"></span>role</span>
    </section>

    <!-- ============ O QUE É (abstract answer-first p/ GEO) ============ -->
    <section class="section dark tight">
      <div class="wrap narrow">
        <span class="eyebrow on-dark reveal"><span class="dot"></span>O que um CMO espera de PR</span>
        <p class="lede on-dark reveal d1">Para um CMO, o valor de PR está na massa que a marca acumula, reputação, autoridade e prova, que reduz o custo de aquisição e a resistência da venda. Na PiaR, essa comunicação roda como sistema de crescimento há {site.yearsOperating} anos, ao lado de {site.brandsServed} marcas.</p>
      </div>
    </section>

    <!-- ============ O ATRITO ============ -->
    <section class="section dark tight">
      <div class="wrap narrow">
        <span class="eyebrow on-dark reveal"><span class="dot"></span>A reunião que você já teve</span>
        <p class="strike reveal d1">Saímos na Exame essa semana.</p>
        <p class="reply reveal d2">Ótimo. E daí?</p>
        <p class="lede on-dark reveal d3">Essa pergunta não é ingratidão. É uma diferença de perspectiva. PR fala em cobertura; a liderança fala em receita. O trabalho não está faltando. Está faltando tradução.</p>
      </div>
    </section>

    <!-- ============ AS DUAS ÓRBITAS ============ -->
    <section id="campo" class="section dark has-g">
      <span class="gword" data-parallax-y="-14" aria-hidden="true" style="top:8%; right:-3%">órbita</span>
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow on-dark"><span class="dot"></span>As duas órbitas</span>
          <h2>A mesma marca, observada de dois pontos da mesma órbita.</h2>
        </div>
        <div class="orbits">
          <div class="orbit-col reveal">
            <span class="oc-tag">Como CMO</span>
            <ul>
              <li>Responde por receita</li>
              <li>Defende orçamento</li>
              <li>Presta contas à liderança</li>
              <li>Mede por pipeline, ROI, CAC</li>
            </ul>
          </div>
          <div class="orbit-mid reveal d1" aria-hidden="true"><span class="om-core"></span></div>
          <div class="orbit-col warm-col reveal d2">
            <span class="oc-tag">Como PR</span>
            <ul>
              <li>Conquista matérias</li>
              <li>Constrói relacionamento</li>
              <li>Gera autoridade</li>
              <li>Entrega cobertura e narrativa</li>
            </ul>
          </div>
        </div>
        <p class="punch on-dark reveal">Quem já observou dos dois pontos sabe: marketing e PR querem a <span class="warm">mesma coisa</span>. Só medem por lentes diferentes.</p>
      </div>
    </section>

    <!-- ============ PR É UM DOS MOTORES ============ -->
    <section class="section warmer has-g">
      <span class="gword" data-parallax-y="16" aria-hidden="true" style="bottom:-4%; left:-2%">massa</span>
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow on-dark"><span class="dot"></span>O sistema</span>
          <h2>Nenhum corpo cresce sozinho. PR é um dos motores.</h2>
          <p class="lede on-dark">Branding, conteúdo, imprensa e tráfego não são peças isoladas. São corpos do mesmo sistema, e cada um adiciona massa ao conjunto.</p>
        </div>
        <div class="motores">
          {motores.map((m, i) => (
            <div class:list={['motor-card', 'reveal', i === 1 && 'd1', i === 2 && 'd2', i === 3 && 'd3']}>
              <span class="m-n">{m.n}</span>
              <h3>{m.t}</h3>
              <p>{m.d}</p>
            </div>
          ))}
        </div>
        <p class="punch on-dark reveal">PR é um dos motores que dão <span class="warm">massa</span> ao sistema, não um apêndice de marketing.</p>
      </div>
    </section>

    <!-- ============ A LENTE DO CMO ============ -->
    <section class="section dark">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow on-dark"><span class="dot"></span>O idioma da liderança</span>
          <h2>A liderança pergunta sobre receita, não sobre releases.</h2>
        </div>
        <div class="idioma">
          {idioma.map((x, i) => (
            <div class:list={['idioma-card', 'reveal', i === 1 && 'd1', i === 2 && 'd2', i === 3 && 'd3']}>
              <span class="ic-k">{x.k}</span>
              <span class="ic-q">{x.q}</span>
            </div>
          ))}
        </div>
        <p class="punch on-dark reveal">Esse é o idioma que a liderança fala. Quando PR não se conecta a ele, o que falta é <span class="warm">tradução</span>, não valor.</p>
      </div>
    </section>

    <!-- ============ O MITO vs O CAMPO · POÇO GRAVITACIONAL ============ -->
    <section class="section deep has-g">
      <span class="gword" data-parallax-y="-18" aria-hidden="true" style="top:6%; left:-2%">campo</span>
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow on-dark"><span class="dot"></span>O maior mito sobre assessoria</span>
          <h2>O mito é uma linha reta. O real é um campo.</h2>
          <p class="lede on-dark">O cliente imagina uma fila: release, publicação, lead, venda. O caminho real não é uma linha. É um poço de gravidade em que a marca, com massa, faz o mercado cair em direção à venda.</p>
        </div>
        <div class="well-stage reveal d1">
          <canvas id="well-canvas" role="img" aria-label="O funil linear desaba e vira um poço gravitacional: um corpo desce pelos estágios publicação, credibilidade, confiança, consideração e venda, atraído pela massa da marca."></canvas>
          <div class="well-path" aria-hidden="true">
            {caminho.map((c) => (<span class="wp">{c}</span>))}
          </div>
        </div>
        <p class="punch on-dark reveal">PR cria o <span class="warm">campo</span> que faz o lead cair em direção à venda, em vez de puxá-lo pela manga.</p>
      </div>
    </section>

    <!-- ============ A VIRADA ============ -->
    <section class="section dark tight">
      <div class="wrap narrow">
        <span class="eyebrow on-dark reveal"><span class="dot"></span>A virada de chave</span>
        <h2 class="reveal d1">Além de acelerar a aquisição, PR reduz a <span class="warm">resistência</span> da venda.</h2>
        <p class="lede on-dark reveal d2">O lead que fecha depois de ler uma matéria chega mais confiante, com menos objeções, mais propenso a pagar o preço cheio. É valor financeiro real, mesmo invisível no CRM. Na física do campo: quanto mais massa, menos esforço para o corpo cair.</p>
      </div>
    </section>

    <!-- ============ A DISTRIBUIÇÃO ============ -->
    <section class="section dark">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow on-dark"><span class="dot"></span>O alcance do campo</span>
          <h2>Saiu na Forbes. Agora começa a distribuição.</h2>
        </div>
        <div class="distrib reveal d1">
          <span class="dq">No LinkedIn</span>
          <span class="dq">No site</span>
          <span class="dq">Em conteúdo</span>
          <span class="dq">Em prova social</span>
          <span class="dq">No deck comercial</span>
        </div>
        <p class="punch on-dark reveal">Sem isso, o ativo morre no clipping. A publicação é o começo, não o fim. A distribuição é o alcance do campo: onde a massa vira gravidade que <span class="warm">aparece nos indicadores</span>.</p>
      </div>
    </section>

    <!-- ============ ALÉM DO CLIPPING ============ -->
    <section class="section warmer has-g">
      <span class="gword" data-parallax-y="14" aria-hidden="true" style="bottom:-5%; right:-3%">gravidade</span>
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow on-dark"><span class="dot"></span>Além do clipping</span>
          <h2>Uma matéria atrai mais do que leads.</h2>
        </div>
        <div class="corpos">
          {corpos.map((c, i) => (
            <div class:list={['corpo-card', 'reveal', i === 1 && 'd1', i === 2 && 'd2', i === 3 && 'd3']}>
              <span class="c-ic"><iconify-icon icon={c.ic}></iconify-icon></span>
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </div>
          ))}
        </div>
        <p class="punch on-dark reveal">Nem tudo aparece no CRM. Mas tudo <span class="warm">orbita</span> o negócio.</p>
      </div>
    </section>

    <!-- ============ TRADUZIR IMPACTO · O TRADUTOR ============ -->
    <section class="section deep">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow on-dark"><span class="dot"></span>Traduzir impacto</span>
          <h2>A publicação é o que foi feito. O impacto é a massa que ficou.</h2>
        </div>
        <div class="translator reveal d1" aria-hidden="true">
          <div class="tr-side tr-a">
            <span class="tr-tag">Relatório de atividade</span>
            <p id="tr-a-text" class="tr-text"></p>
          </div>
          <div class="tr-arrow"><iconify-icon icon="solar:arrow-right-linear"></iconify-icon></div>
          <div class="tr-side tr-b">
            <span class="tr-tag warm">Relatório de impacto</span>
            <p id="tr-b-text" class="tr-text"></p>
          </div>
        </div>
        <ul class="sr-only">
          <li>Saímos em 15 veículos esta semana traduz para: a marca ganhou massa na narrativa de liderança do setor.</li>
          <li>Número de publicações no mês traduz para: share of voice subindo contra os concorrentes.</li>
          <li>Lista de veículos e audiência somada traduz para: backlinks e palavras-chave que aproximam a marca da venda.</li>
        </ul>
        <p class="punch on-dark reveal">Relatório de atividade mostra o que foi feito. Relatório de impacto mostra o <span class="warm">campo que cresceu</span>.</p>
      </div>
    </section>

    <!-- ============ TODA RECLAMAÇÃO É UMA OPORTUNIDADE ============ -->
    <section class="section dark">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow on-dark"><span class="dot"></span>A mudança de chave</span>
          <h2>Toda reclamação revela uma necessidade.</h2>
          <p class="lede on-dark">Quem ouve como reclamação perde o contrato. Quem ouve como necessidade amplia o escopo.</p>
        </div>
        <div class="reclama">
          {reclamacoes.map((x, i) => (
            <div class:list={['recl-card', 'reveal', i === 1 && 'd1', i === 2 && 'd2', i === 3 && 'd3']}>
              <span class="rc-r">{x.r}</span>
              <span class="rc-o"><iconify-icon icon="solar:arrow-right-down-linear"></iconify-icon>{x.o}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ OS 3 ARGUMENTOS ============ -->
    <section class="section warmer">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow on-dark"><span class="dot"></span>Os argumentos que funcionam na sala</span>
          <h2>Três argumentos que a liderança reconhece como resultado.</h2>
        </div>
        <div class="args">
          {argumentos.map((a, i) => (
            <div class:list={['arg-card', 'reveal', i === 1 && 'd1', i === 2 && 'd2']}>
              <span class="a-n">{a.n}</span>
              <h3>{a.t}</h3>
              <p>{a.d}</p>
            </div>
          ))}
        </div>
        <p class="punch on-dark reveal">Juntos, viram a conversa de "quanto custa PR" para <span class="warm">"quanto custa não ter massa"</span>.</p>
      </div>
    </section>

    <!-- ============ FAQ (citável p/ GEO) ============ -->
    <section class="section dark">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow on-dark"><span class="dot"></span>Perguntas frequentes</span>
          <h2>O que dá para <span class="warm">responder por aqui</span>.</h2>
        </div>
        <div class="faq-wrap reveal d1">
          {faq.map((f) => (
            <details class="faq-item">
              <summary>{f.q}<iconify-icon icon="solar:add-square-linear"></iconify-icon></summary>
              <div class="faq-body" set:html={f.a}></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ FECHO / CTA ============ -->
    <section id="falar" class="grav-cta has-g">
      <span class="gword big" data-parallax-y="-10" aria-hidden="true" style="top:50%; left:50%; transform:translate(-50%,-50%)">PiaR</span>
      <div class="wrap cta-inner">
        <span class="eyebrow on-dark reveal"><span class="dot"></span>Vamos conversar</span>
        <h2 class="reveal d1">Quem enxerga a pauta vê um trabalho. Quem enxerga o <span class="warm">campo</span> vê o negócio sendo atraído.</h2>
        <p class="lede on-dark reveal d2">A PiaR conduz comunicação como construção de massa: reputação, autoridade e prova que viram gravidade para o seu mercado. Há {site.yearsOperating} anos, ao lado de {site.brandsServed} marcas.</p>
        <div class="cta-row reveal d3">
          <a href="/contato" class="btn btn-accent">Agendar conversa<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
          <a href="/metodo" class="btn btn-ghost-d">Ver o método</a>
        </div>
        <p class="cta-foot reveal d4">{site.email} · {site.brandDomain}</p>
      </div>
    </section>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'O que um CMO realmente espera de PR: o campo gravitacional da marca',
    description: 'Para o CMO, PR constrói a massa de reputação, autoridade e prova que reduz o custo de aquisição e a resistência da venda. A PiaR traduz comunicação para receita, pipeline e ROI desde 2013.',
    inLanguage: 'pt-BR',
    about: 'Relações públicas para marketing e crescimento',
    author: { '@id': `${site.domain}/#organization` },
    publisher: { '@id': `${site.domain}/#organization` },
    mainEntityOfPage: url,
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
    })),
  })} />

  <style is:global>
    :root {
      --space: #07080C;
      --space-2: #0B0D13;
      --cold: #5B7B9A;
      --warm: #FED136;
      --warm-deep: #E0B420;
      --text-d: #FFFFFF;
      --text-d-muted: rgba(255, 255, 255, .68);
      --text-d-faint: rgba(255, 255, 255, .42);
      --r-card: 22px;
      --ease: cubic-bezier(.16, 1, .3, 1);
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    h1, h2, h3 { font-family: var(--font-display); font-weight: 600; letter-spacing: -.03em; margin: 0; }
    body { font-family: var(--font-sans); background: var(--space); color: var(--text-d); overflow-x: hidden; -webkit-font-smoothing: antialiased; }

    #scroll-progress { position: fixed; top: 0; left: 0; height: 2px; background: var(--warm); z-index: 9999; width: 0; transition: width .1s linear; }

    /* Campo gravitacional fixo full-screen (inovação: massa cresce no scroll) */
    #field-bg { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; display: block; pointer-events: none; background: var(--space); }
    .body-label { position: fixed; left: 0; top: 0; z-index: 3; display: inline-flex; align-items: center; gap: .5rem; padding: .42rem .85rem; border-radius: var(--r-pill); font-family: var(--font-mono); font-size: .6rem; letter-spacing: .12em; text-transform: uppercase; backdrop-filter: blur(6px); pointer-events: none; white-space: nowrap; will-change: transform, opacity; }
    .body-label.cold { color: rgba(186,206,224,.9); background: rgba(91,123,154,.12); border: 1px solid rgba(110,147,184,.3); }
    .body-label.cold .cb-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--cold); box-shadow: 0 0 10px 1px rgba(110,147,184,.7); }
    .body-label.warm { color: rgba(255,236,176,.95); background: rgba(254,209,54,.1); border: 1px solid rgba(254,209,54,.34); }
