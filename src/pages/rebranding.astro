          <p>Rebranding não termina no dia do anúncio. Termina quando o mercado passa a usar a versão nova da sua história sozinho. A PiaR conduz essa transição com a frente de imprensa e reputação que sustenta o lançamento. Bruno Pinheiro, fundador e CEO, foi eleito Profissional de imprensa no Startup Awards da ABStartups (2018).</p>
        </div>
      </div>
    </section>

    <!-- 11 · FAQ -->
    <section class="section paper">
      <div class="wrap" style="max-width:1000px">
        <div class="sec-head reveal">
          <span class="eyebrow">Perguntas frequentes</span>
          <h2>O que dá para <span class="accent-serif">responder por aqui</span>.</h2>
        </div>
        <div class="reveal d1">
          {faq.map((f) => (
            <details class="faq-item">
              <summary>{f.q}<iconify-icon icon="solar:add-square-linear"></iconify-icon></summary>
              <div class="faq-body">{f.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 12 · CTA -->
    <section class="section dark cta-final has-ghost">
      <span class="ghost-mark bl px" data-parallax-y="12" aria-hidden="true">marca</span>
      <div class="wrap">
        <span class="eyebrow on-dark reveal" style="justify-content:center; display:inline-flex">Vamos conversar</span>
        <h2 class="reveal d1">Comece pelo diagnóstico de <span class="accent-serif on-dark">percepção</span>.</h2>
        <p class="lede reveal d2">Se a sua empresa está considerando mudar de marca, o risco maior não é o design. É como o mercado vai interpretar a mudança. O primeiro passo é um diagnóstico do que a busca, a imprensa e o público entendem sobre você hoje, para que o rebranding construa percepção em vez de destruir a que já existe.</p>
        <div class="cta-row reveal d3">
          <a href="/contato" class="btn btn-accent">Agendar diagnóstico<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
          <a href="/branding" class="btn btn-ghost-d">Ver branding<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
        </div>
        <p class="ds-mono reveal d4" style="color:rgba(255,255,255,.4); margin-top:3rem">/// {site.email} · {site.brandDomain}</p>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- Lenis + ScrollTrigger (globais via bootstrap.ts) ---- */
      try {
        if (window.gsap && window.ScrollTrigger) window.gsap.registerPlugin(window.ScrollTrigger);
        if (!prefersReduced && window.Lenis) {
          var lenis = new window.Lenis({ duration: 1.15, easing: function (t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); }, smooth: true, lerp: 0.1 });
          if (window.ScrollTrigger) { lenis.on('scroll', window.ScrollTrigger.update); window.gsap.ticker.add(function (time) { lenis.raf(time * 1000); }); window.gsap.ticker.lagSmoothing(0); }
          else { var raf = function (t) { lenis.raf(t); requestAnimationFrame(raf); }; requestAnimationFrame(raf); }
        }
      } catch (e) { /* noop */ }

      /* ---- reveal ---- */
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('active'); io.unobserve(en.target); } });
      }, { threshold: 0.14 });
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

      /* ---- scroll progress ---- */
      var bar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', function () {
        var h = document.documentElement;
        var p = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
        if (bar) bar.style.width = p + '%';
      }, { passive: true });

      /* ---- parallax de profundidade ---- */
      if (!prefersReduced && window.gsap && window.ScrollTrigger) {
        window.gsap.utils.toArray('[data-parallax-y]').forEach(function (el) {
          var yp = parseFloat(el.getAttribute('data-parallax-y')) || 0;
          window.gsap.fromTo(el, { yPercent: 0 }, { yPercent: yp, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } });
        });
      }

      /* ---- lerp mouse-parallax no herói (Três Mares) ---- */
      if (!prefersReduced && window.gsap) {
        var heroFloats = window.gsap.utils.toArray('[class*="hero-float"]');
        if (heroFloats.length) {
          var movers = heroFloats.map(function (el, i) {
            return {
              depth: (i % 2 ? 1 : -1) * (16 + i * 8),
              qx: window.gsap.quickTo(el, 'x', { duration: 0.7, ease: 'power3' }),
              qy: window.gsap.quickTo(el, 'y', { duration: 0.7, ease: 'power3' })
            };
          });
          window.addEventListener('mousemove', function (e) {
            var nx = (e.clientX / window.innerWidth - 0.5);
            var ny = (e.clientY / window.innerHeight - 0.5);
            for (var k = 0; k < movers.length; k++) { movers[k].qx(nx * movers[k].depth); movers[k].qy(ny * movers[k].depth); }
          }, { passive: true });
        }
      }

      /* ========================================================
         HERO · morph duotom (canvas 2D)
         uma forma "antiga" transiciona para uma "nova" sem perder
         continuidade. Os mesmos vértices se reconfiguram. Preto <-> amarelo.
         ======================================================== */
      (function heroMorph() {
        var canvas = document.getElementById('rb-hero-canvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) { canvas.style.background = 'radial-gradient(70% 90% at 75% 35%, #4a3a08 0%, #161206 55%, #0A0A0C 100%)'; return; }
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0, cx = 0, cy = 0, baseR = 0;
        var N = 64;

        function resize() {
          W = canvas.clientWidth; H = canvas.clientHeight;
          canvas.width = Math.max(1, Math.floor(W * dpr));
          canvas.height = Math.max(1, Math.floor(H * dpr));
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          cx = W * 0.68; cy = H * 0.46;
          baseR = Math.min(W, H) * 0.26;
        }
        resize();
        window.addEventListener('resize', resize, { passive: true });

        // forma "antiga": quadrado-ish anguloso. forma "nova": orgânica fluida.
        // Cada vértice tem um raio para A e um raio para B; interpolamos.
        function shapeOld(a) {
          // perfil retangular suave (4 lóbulos fortes)
          return 0.78 + 0.30 * Math.pow(Math.abs(Math.cos(a * 2)), 2.4);
        }
        function shapeNew(a, t) {
          // perfil orgânico que respira no tempo
          return 1.0 + 0.16 * Math.sin(a * 3 + t * 0.7) + 0.10 * Math.sin(a * 5 - t * 0.5);
        }

        var start = 0;
        function frame(now) {
          if (!start) start = now;
          var time = (now - start) / 1000;
          // ciclo de morph: 0 = antiga, 1 = nova, e volta (sem perder continuidade)
          var cycle = (Math.sin(time * 0.42) + 1) / 2; // 0..1 suave
          var ease = cycle * cycle * (3 - 2 * cycle);

          ctx.clearRect(0, 0, W, H);

          // gradiente duotom de fundo localizado atras da forma
          var bg = ctx.createRadialGradient(cx, cy, baseR * 0.2, cx, cy, baseR * 3.2);
          bg.addColorStop(0, 'rgba(28,24,10,0.55)');
          bg.addColorStop(1, 'rgba(10,10,12,0)');
          ctx.fillStyle = bg;
          ctx.fillRect(0, 0, W, H);

          // pontos interpolados (os mesmos vertices, reconfigurados)
          var pts = [];
          for (var i = 0; i < N; i++) {
            var a = (i / N) * Math.PI * 2;
            var rOld = shapeOld(a) * baseR;
            var rNew = shapeNew(a, time) * baseR;
            var r = rOld + (rNew - rOld) * ease;
            // leve rotacao durante a transicao
            var rot = ease * 0.6;
            var x = cx + Math.cos(a + rot) * r;
            var y = cy + Math.sin(a + rot) * r;
            pts.push({ x: x, y: y });
          }

          // preenchimento duotom: amarelo cresce com a transicao
          var fill = ctx.createLinearGradient(cx - baseR, cy - baseR, cx + baseR, cy + baseR);
          var k = ease;
          fill.addColorStop(0, 'rgba(' + Math.round(20 + 234 * k) + ',' + Math.round(20 + 189 * k) + ',' + Math.round(24 + 30 * k) + ',0.92)');
          fill.addColorStop(1, 'rgba(' + Math.round(12 + 224 * (1 - k * 0.3)) + ',' + Math.round(12 + 160 * (1 - k * 0.3)) + ',16,0.92)');

          ctx.beginPath();
          for (var j = 0; j <= N; j++) {
            var p0 = pts[(j) % N];
            var p1 = pts[(j + 1) % N];
            var mx = (p0.x + p1.x) / 2, my = (p0.y + p1.y) / 2;
            if (j === 0) ctx.moveTo(mx, my);
            else ctx.quadraticCurveTo(p0.x, p0.y, mx, my);
          }
          ctx.closePath();
          ctx.fillStyle = fill;
          ctx.fill();

          // contorno amarelo (a assinatura)
          ctx.strokeStyle = 'rgba(254,209,54,' + (0.35 + 0.45 * ease) + ')';
          ctx.lineWidth = 1.5;
          ctx.stroke();

          // fios de continuidade: vertices marcados que persistem na transicao
          for (var v = 0; v < N; v += 8) {
            var pv = pts[v];
            ctx.beginPath();
            ctx.arc(pv.x, pv.y, 2.4, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(255,176,32,' + (0.5 + 0.4 * Math.sin(time * 2 + v)) + ')';
            ctx.fill();
          }

          // nucleo: ponto fixo que nunca se move (o reconhecimento que permanece)
          ctx.beginPath();
          ctx.arc(cx, cy, 3.5 + Math.sin(time * 1.6) * 1.2, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(254,209,54,0.9)';
          ctx.fill();

          if (!prefersReduced) requestAnimationFrame(frame);
        }
        if (prefersReduced) { frame(0); } else { requestAnimationFrame(frame); }
      })();

      /* ========================================================
         DATAVIZ · antes para depois com fios de continuidade (canvas 2D)
         coluna esquerda = marca antiga, direita = marca nova.
         alguns nós mudam, outros sao "fios" que atravessam a transicao.
         ======================================================== */
      (function continuityViz() {
        var canvas = document.getElementById('rb-morph-canvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0;
        // cada item: { keep: mantem reconhecimento? , label }
        var rows = [
          { keep: true,  label: 'Nome' },
          { keep: false, label: 'Posicionamento' },
          { keep: true,  label: 'Voz' },
          { keep: false, label: 'Narrativa' },
          { keep: true,  label: 'Público' },
          { keep: false, label: 'Identidade' }
        ];
        var oldNodes = [], newNodes = [], threads = [];

        function layout() {
          var rect = canvas.getBoundingClientRect();
          W = rect.width; H = rect.height;
          canvas.width = Math.floor(W * dpr); canvas.height = Math.floor(H * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          var lx = W * 0.20, rx = W * 0.80, n = rows.length;
          oldNodes = []; newNodes = [];
          for (var i = 0; i < n; i++) {
            var y = H * (0.15 + (0.70 * i) / (n - 1));
            oldNodes.push({ x: lx, y: y, r: 5, keep: rows[i].keep });
            newNodes.push({ x: rx, y: y, r: 5, keep: rows[i].keep });
          }
          // fios: keep liga ao mesmo indice; nao-keep tambem liga ao mesmo
          // indice (a continuidade existe sempre), mas com cor diferente.
          threads = rows.map(function (rrow, i) {
            return { from: i, to: i, keep: rrow.keep, p: 0, sp: 0.004 + Math.random() * 0.005 };
          });
        }
        layout();

        function bez(x0, y0, cx1, cy1, cx2, cy2, x1, y1, t) {
          var u = 1 - t;
          var x = u * u * u * x0 + 3 * u * u * t * cx1 + 3 * u * t * t * cx2 + t * t * t * x1;
          var y = u * u * u * y0 + 3 * u * u * t * cy1 + 3 * u * t * t * cy2 + t * t * t * y1;
          return { x: x, y: y };
        }

        function draw() {
          ctx.clearRect(0, 0, W, H);

          // fios de continuidade (curvas atravessando o vão)
          threads.forEach(function (th) {
            var a = oldNodes[th.from], b = newNodes[th.to];
            var mx = (a.x + b.x) / 2;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.bezierCurveTo(mx, a.y, mx, b.y, b.x, b.y);
            if (th.keep) {
              ctx.strokeStyle = 'rgba(255,176,32,.45)';
              ctx.lineWidth = 1.6;
            } else {
              ctx.strokeStyle = 'rgba(255,255,255,.10)';
              ctx.lineWidth = 1;
            }
            ctx.stroke();

            // pulso viajando pelo fio (a transicao em curso)
            if (!prefersReduced) {
              th.p += th.sp;
              if (th.p > 1) th.p = 0;
              var pos = bez(a.x, a.y, mx, a.y, mx, b.y, b.x, b.y, th.p);
              var col = th.keep ? '255,176,32' : '110,114,120';
              ctx.beginPath(); ctx.arc(pos.x, pos.y, 2.4, 0, Math.PI * 2);
              ctx.fillStyle = 'rgba(' + col + ',.95)'; ctx.fill();
            }
          });

          ctx.font = '600 10px "JetBrains Mono", monospace';
          ctx.textBaseline = 'middle';

          // nós antigos (esquerda, cinza)
          oldNodes.forEach(function (nd) {
            ctx.beginPath(); ctx.arc(nd.x, nd.y, nd.r, 0, Math.PI * 2);
            ctx.fillStyle = '#6b7280'; ctx.fill();
          });

          // nós novos (direita): keep fica amarelo, troca fica claro
          newNodes.forEach(function (nd, i) {
            ctx.beginPath(); ctx.arc(nd.x, nd.y, nd.r + (nd.keep ? 1 : 0), 0, Math.PI * 2);
            ctx.fillStyle = nd.keep ? '#FED136' : 'rgba(255,255,255,.5)'; ctx.fill();
            ctx.textAlign = 'left';
            ctx.fillStyle = 'rgba(255,255,255,.6)';
            ctx.fillText(rows[i].label, nd.x + 12, nd.y);
          });

          // rótulos de coluna
          ctx.textAlign = 'center';
          ctx.fillStyle = 'rgba(255,255,255,.55)';
          ctx.font = '700 11px "JetBrains Mono", monospace';
          ctx.fillText('ANTES', oldNodes[0].x, H * 0.07);
          ctx.fillStyle = 'rgba(254,209,54,.9)';
          ctx.fillText('DEPOIS', newNodes[0].x, H * 0.07);

          requestAnimationFrame(draw);
        }

        window.addEventListener('resize', layout, { passive: true });
        if (prefersReduced) { layout(); draw(); } else { requestAnimationFrame(draw); }
      })();
    });
  </script>
</BaseLayout>
