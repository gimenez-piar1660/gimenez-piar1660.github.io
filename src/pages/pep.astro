            for (var s = 0; s < FADE.length; s++) {
              var ins = FEATHER * (1 - s / FADE.length);
              var w2 = R[2] - ins * 2, h2 = R[3] - ins * 2;
              if (w2 <= 0 || h2 <= 0) continue;
              c.globalAlpha = FADE[s];
              softRect(c, R[0] + ins, R[1] + ins, w2, h2, 18);
              c.fill();
            }
          }
          c.restore();
        }
        collectRead();
        window.addEventListener('load', collectRead);
        window.addEventListener('scroll', function () { readDirty = true; }, { passive: true });
        window.addEventListener('resize', resize);
        resize();

        var NM = 6, mods = [];
        for (var i = 0; i < NM; i++) {
          mods.push({ a: i * (Math.PI / 3), looseA: i * 1.7, plug: 0, prevPlug: 0, snap: 0, flow: ((i * 37) % 100) / 100 });
        }
        var spin = 0;

        // BRANCO E PRETO (como na home): faixas claras onde estao as secoes .light; o canvas pinta o creme e INVERTE os legos.
        var lightEls = ['vetores-sec', 'prova-sec'].map(function (id) { return document.getElementById(id); }).filter(Boolean);
        var bands = [];
        function isLight(yy) { for (var bi = 0; bi < bands.length; bi++) { if (yy >= bands[bi][0] && yy <= bands[bi][1]) return true; } return false; }
        // lupa: o hub central tinge o titulo que cruza, invertendo pra contrastar (igual a home)
        var lensEls = document.querySelectorAll('.section h2');

        function roundRectPath(x, y, w, h, r) {
          if (ctx.roundRect) { ctx.beginPath(); ctx.roundRect(x, y, w, h, r); return; }
          ctx.beginPath(); ctx.moveTo(x + r, y); ctx.arcTo(x + w, y, x + w, y + h, r); ctx.arcTo(x + w, y + h, x, y + h, r); ctx.arcTo(x, y + h, x, y, r); ctx.arcTo(x, y, x + w, y, r); ctx.closePath();
        }

        function frame() {
          spin += prefersReduced ? 0 : 0.0016;
          var S = smooth(scrollP);
          var finale = smooth((scrollP - 0.72) / 0.28);
          var base = Math.min(W, H);
          var bx = W * 0.5, by = H * (0.46 + 0.04 * Math.sin(scrollP * Math.PI));
          var rSlot = base * 0.24;
          var rLoose = base * 0.62;
          var tilt = 0.66;

          // faixas claras neste frame (coords da viewport, como o canvas fixo)
          bands.length = 0;
          for (var lb = 0; lb < lightEls.length; lb++) { var rb = lightEls[lb].getBoundingClientRect(); if (rb.bottom > 0 && rb.top < H) bands.push([rb.top, rb.bottom]); }
          var hubLight = isLight(by);

          // fundo (preto + faixas creme) no canvas principal: a mascara de leitura nao o toca
          ctx = mctx;
          mctx.clearRect(0, 0, W, H);
          mctx.fillStyle = '#07080C'; mctx.fillRect(0, 0, W, H);
          for (var cb2 = 0; cb2 < bands.length; cb2++) { mctx.fillStyle = '#fafafa'; mctx.fillRect(0, bands[cb2][0], W, bands[cb2][1] - bands[cb2][0]); }
          // daqui pra baixo tudo desenha na camada de decoracao
          if (readDirty) updateRects();
          ctx = dctx;
          dctx.clearRect(0, 0, W, H);

          // brilho do hub (cresce conforme as pecas plugam e estoura no fecho)
          var plugged = 0;
          for (var c = 0; c < NM; c++) plugged += mods[c].plug;
          var fill = plugged / NM;
          // SEM BRILHO (direcao do Danilo): halo radial do hub e lupa removidos. A animacao fica
          // sempre atras, matte — so o movimento das pecas/conexoes/hub, nada luminoso.

          // posicoes dos slots (vertices do hub) e estado de plug por modulo
          var slot = [];
          for (var m = 0; m < NM; m++) {
            var md = mods[m];
            // cada peca pluga (ou despluga ao voltar o scroll) em sequencia: a montagem peca por peca
            var paT = smooth((scrollP - 0.08 - m * 0.075) / 0.2);
            md.prevPlug = md.plug;
            // a peca acelera pra dentro do slot no frame do encaixe (md.snap ~0.9 logo apos cruzar 0.82):
            // 0.08 normal -> ate 0.26 no "click", sincronizado com o flash. fator < 1 = estavel, sem repique.
            md.plug += (paT - md.plug) * (0.08 + 0.2 * md.snap);
            // o "click" de encaixe/desencaixe (cruza 0.82) dispara o flash de snap
            if ((md.prevPlug < 0.82 && md.plug >= 0.82) || (md.prevPlug >= 0.82 && md.plug < 0.82)) md.snap = 1;
            md.snap *= 0.9;
            var pa = md.plug;
            var sa = md.a + spin;                 // angulo do slot (gira devagar = camera)
            var sx = bx + Math.cos(sa) * rSlot, sy = by + Math.sin(sa) * rSlot * tilt;
            slot.push([sx, sy, sa]);
            // posicao do modulo: a deriva quando solto, no slot quando plugado, com leve overshoot no encaixe
            var la = md.looseA + spin * 0.5;
            var lx = bx + Math.cos(la) * rLoose, ly = by + Math.sin(la) * rLoose * tilt;
            var settle = pa + md.snap * 0.12 * Math.sin(pa * Math.PI);
            md.x = lx + (sx - lx) * settle; md.y = ly + (sy - ly) * settle;
          }

          // conexoes: do hub a cada peca plugada, com conteudo circulando
          for (var n = 0; n < NM; n++) {
            var mo = mods[n], pa2 = mo.plug;
            if (pa2 > 0.02) {
              var midL = isLight((mo.y + by) / 2);
              ctx.beginPath(); ctx.moveTo(bx, by); ctx.lineTo(mo.x, mo.y);
              ctx.strokeStyle = midL ? 'rgba(224,180,32,' + (0.05 + 0.14 * pa2) + ')' : 'rgba(254,209,54,' + (0.06 + 0.22 * pa2) + ')'; ctx.lineWidth = 1; ctx.stroke();
              // conteudo viajando na conexao (um conteudo vira varios)
              if (!prefersReduced) mo.flow = (mo.flow + 0.006 + finale * 0.01) % 1;
              var fp = mo.flow;
              var cxp = bx + (mo.x - bx) * fp, cyp = by + (mo.y - by) * fp;
              ctx.beginPath(); ctx.arc(cxp, cyp, 1.6 + pa2, 0, Math.PI * 2);
              ctx.fillStyle = isLight(cyp) ? 'rgba(176,130,20,' + (0.3 * pa2) + ')' : 'rgba(255,224,130,' + (0.5 * pa2) + ')'; ctx.fill();
            }
          }

          // os modulos (as PECAS DE LEGO): brick maior com studs no topo e pino de encaixe apontando pro hub.
          // sobre o creme as pecas ficam escuras com contorno/studs amarelos (lego preto na mesa); sobre o preto, quentes.
          for (var p = 0; p < NM; p++) {
            var pm = mods[p], pa3 = pm.plug;
            var pieceLight = isLight(pm.y);
            var heat = 0.18 + 0.82 * pa3;          // solto = frio, plugado = quente
            var ang = Math.atan2(by - pm.y, bx - pm.x);   // aponta pro hub
            var w = 48, h = 32, r = 7;
            var bodyFill, edge, studFill, pinFill;
            if (pieceLight) {
              var dk = Math.round(40 - 26 * pa3);
              bodyFill = 'rgba(' + dk + ',' + dk + ',' + (dk + 4) + ',' + (0.8 + 0.18 * pa3) + ')';
              edge = 'rgba(224,180,32,' + (0.55 + 0.4 * pa3) + ')';
              studFill = 'rgba(224,180,32,' + (0.7 + 0.3 * pa3) + ')';
              pinFill = 'rgba(224,180,32,' + (0.7 + 0.3 * pa3) + ')';
            } else {
              var cr = Math.round(91 + 163 * heat), cg = Math.round(123 + 86 * heat), cb = Math.round(154 - 100 * heat);
              bodyFill = 'rgba(' + cr + ',' + cg + ',' + cb + ',' + (0.16 + 0.18 * pa3) + ')';
              edge = 'rgba(' + cr + ',' + cg + ',' + cb + ',' + (0.5 + 0.45 * pa3) + ')';
              studFill = 'rgba(' + cr + ',' + cg + ',' + cb + ',' + (0.5 + 0.4 * pa3) + ')';
              pinFill = 'rgba(' + cr + ',' + cg + ',' + cb + ',' + (0.6 + 0.4 * pa3) + ')';
            }
            ctx.save();
            ctx.translate(pm.x, pm.y);
            ctx.rotate(ang);
            // sobre o creme (faixas claras), a peca recua pra textura de fundo: nao competir com logos/texto
            if (pieceLight) ctx.globalAlpha = 0.4;
            // pino de encaixe (na borda voltada pro hub), cresce ao plugar
            var pinLen = 4 + 6 * pa3;
            ctx.beginPath(); ctx.moveTo(w / 2, -4); ctx.lineTo(w / 2 + pinLen, 0); ctx.lineTo(w / 2, 4); ctx.closePath();
            ctx.fillStyle = pinFill; ctx.fill();
            // corpo do brick
            roundRectPath(-w / 2, -h / 2, w, h, r);
            ctx.fillStyle = bodyFill; ctx.fill();
            ctx.lineWidth = 1.7; ctx.strokeStyle = edge;
            ctx.stroke();   // matte: sem glow de snap nem brilho de repouso
            // tres studs no topo (gesto lego, mais legivel)
            for (var st = 0; st < 3; st++) {
              ctx.beginPath(); ctx.arc(-w / 3 + st * (w / 3), -h / 2 - 3, 2.4, 0, Math.PI * 2);
              ctx.fillStyle = studFill; ctx.fill();
            }
            ctx.restore();
          }

          // o hub (a marca): hexagono central com 6 portas, brilha conforme enche. escuro sobre o creme, amarelo sobre o preto.
          ctx.save();
          if (hubLight) ctx.globalAlpha = 0.5;   // sobre o creme, o hub tambem recua pro fundo
          ctx.beginPath();
          for (var v = 0; v <= NM; v++) {
            var ha = (v % NM) * (Math.PI / 3) + spin;
            var hx = bx + Math.cos(ha) * (12 + fill * 6), hy = by + Math.sin(ha) * (12 + fill * 6) * tilt;
            if (v === 0) ctx.moveTo(hx, hy); else ctx.lineTo(hx, hy);
          }
          ctx.closePath();
          ctx.shadowBlur = 0;   // hub matte, sem halo de brilho
          ctx.fillStyle = hubLight ? 'rgba(20,20,24,' + (0.55 + 0.4 * fill) + ')' : 'rgba(254,209,54,' + (0.5 + 0.5 * fill) + ')';
          ctx.fill(); ctx.shadowBlur = 0;
          ctx.lineWidth = 1.6; ctx.strokeStyle = hubLight ? 'rgba(224,180,32,' + (0.5 + 0.5 * fill) + ')' : 'rgba(255,243,205,' + (0.3 + 0.6 * fill) + ')'; ctx.stroke();
          // as 6 portas acendem conforme cada peca pluga
          for (var pt = 0; pt < NM; pt++) {
            var pa5 = mods[pt].plug, pha = pt * (Math.PI / 3) + spin;
            var phx = bx + Math.cos(pha) * (12 + fill * 6), phy = by + Math.sin(pha) * (12 + fill * 6) * tilt;
            ctx.beginPath(); ctx.arc(phx, phy, 1.4 + 1.6 * pa5, 0, Math.PI * 2);
            ctx.fillStyle = hubLight ? 'rgba(224,180,32,' + (0.4 + 0.5 * pa5) + ')' : 'rgba(255,243,205,' + (0.4 + 0.5 * pa5) + ')'; ctx.fill();
          }
          ctx.restore();

          // LUPA removida: os titulos ficam na cor base (sem tinta do hub) — animacao sempre atras.

          // recorta a decoracao nas zonas de leitura e joga a camada sobre o fundo
          maskRead(dctx);
          mctx.drawImage(deco, 0, 0, W, H);
          ctx = mctx;

          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      })();
    });
  </script>
</BaseLayout>
