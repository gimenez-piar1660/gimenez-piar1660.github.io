---
// Template de artigo. Renderiza qualquer Markdown de src/content/pages/<slug>.md.
// URL = nome do arquivo. Ex.: rebranding.md -> /rebranding
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import { site } from '@/data/site';

export async function getStaticPaths() {
  // Slugs que ja tem pagina propria em src/pages/<slug>.astro (versao desenhada)
  // nao sao gerados aqui: a pagina estatica vence e o markdown vira apenas fonte
  // dos cards da /insights. A lista sai automaticamente dos .astro irmaos, entao
  // promover uma pagina nova ja a remove deste template sem edicao manual.
  // (Definido dentro da funcao: Astro ica getStaticPaths acima do frontmatter.)
  const bespoke = new Set(
    Object.keys(import.meta.glob('./*.astro')).map((p) => p.slice(2, -6)),
  );
  const pages = await getCollection('pages', (entry: CollectionEntry<'pages'>) => !entry.data.draft);
  return pages
    .filter((page: CollectionEntry<'pages'>) => !bespoke.has(page.id))
    .map((page: CollectionEntry<'pages'>) => ({
      params: { slug: page.id },
      props: { page },
    }));
}

const { page } = Astro.props as { page: CollectionEntry<'pages'> };
const { Content } = await render(page);
const { title, description, eyebrow, category, noindex } = page.data;
const url = `${site.domain}/${page.id}`;
---
<BaseLayout title={title} description={description} noindex={noindex} canonical={url}>
  <Fragment slot="head">
    <style is:global>
      :root {
        --primary: #0F0F11;
        --accent: #FED136;
        --accent-deep: #E0B420;
        --paper: #FAFAFA;
        --paper-lifted: #FCFBFA;
        --text-muted: rgba(15, 15, 17, .62);
        --text-faint: rgba(15, 15, 17, .42);
        --hairline: rgba(0, 0, 0, .08);
        --radius-btn: 20px;
        --radius-pill: 999px;
        --ease-out-expo: cubic-bezier(.16, 1, .3, 1);
        --t-smooth: all .6s var(--ease-out-expo);
        --font-sans: 'Open Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --font-serif: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body { font-family: var(--font-sans); background: var(--paper); color: var(--primary); -webkit-font-smoothing: antialiased; font-feature-settings: "ss01", "cv11"; }
      .ds-mono { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; }
      .italic-serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -.02em; }

      .article-main { background: var(--paper); }
      .article-shell { max-width: 760px; margin: 0 auto; padding: 9rem 1.5rem 4rem; }

      .back-link { display: inline-flex; align-items: center; gap: .4rem; font-family: var(--font-mono); font-size: .7rem; letter-spacing: .18em; text-transform: uppercase; color: var(--text-muted); text-decoration: none; transition: color .3s; }
      .back-link:hover { color: var(--primary); }
      .back-link iconify-icon { font-size: 1rem; }

      .article-eyebrow { display: inline-flex; align-items: center; gap: .5rem; margin-top: 2rem; color: var(--accent-deep); font-family: var(--font-mono); font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; font-weight: 600; }
      .article-eyebrow::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }

      .article-title { font-size: clamp(2.25rem, 5vw, 3.75rem); font-weight: 700; line-height: 1.04; letter-spacing: -.035em; margin: 1.25rem 0 0; max-width: 18ch; }
      .article-lede { font-size: 1.25rem; line-height: 1.5; letter-spacing: -.01em; color: var(--text-muted); margin: 1.5rem 0 0; max-width: 60ch; }
      .article-rule { height: 1px; background: var(--hairline); margin: 2.5rem 0; border: 0; }

      /* prosa do corpo Markdown */
      .prose-piar { font-size: 1.0625rem; line-height: 1.7; color: rgba(15,15,17,.78); }
      .prose-piar > :global(* + *) { margin-top: 1.25rem; }
      .prose-piar :global(h2) { font-size: clamp(1.6rem, 3vw, 2.1rem); font-weight: 600; color: var(--primary); margin-top: 3rem; margin-bottom: .25rem; letter-spacing: -.025em; line-height: 1.15; }
      .prose-piar :global(h3) { font-size: 1.35rem; font-weight: 600; color: var(--primary); margin-top: 2rem; margin-bottom: .25rem; letter-spacing: -.02em; }
      .prose-piar :global(p) { margin: 0; }
      .prose-piar :global(a) { color: var(--primary); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 4px; text-decoration-thickness: 2px; }
      .prose-piar :global(a:hover) { color: var(--accent-deep); }
      .prose-piar :global(ul), .prose-piar :global(ol) { padding-left: 1.4rem; margin: 1.25rem 0; }
      .prose-piar :global(li) { margin-bottom: .6rem; }
      .prose-piar :global(strong) { color: var(--primary); font-weight: 600; }
      .prose-piar :global(blockquote) { border-left: 3px solid var(--accent); padding-left: 1.5rem; margin: 2rem 0; font-family: var(--font-serif); font-style: italic; font-size: 1.5rem; line-height: 1.3; color: var(--primary); }
      .prose-piar :global(hr) { border: 0; height: 1px; background: var(--hairline); margin: 2.5rem 0; }

      /* CTA de rodapé do artigo */
      .article-cta { margin-top: 4rem; padding: 2.5rem; border-radius: 24px; background: var(--paper-lifted); border: 1px solid var(--hairline); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; }
      .article-cta .cta-copy { font-size: 1.15rem; font-weight: 600; letter-spacing: -.02em; max-width: 28ch; }
      .ink-pill { display: inline-flex; align-items: center; gap: .55rem; padding: .85rem 1.6rem; border-radius: var(--radius-btn); background: var(--accent); color: var(--primary); border: 1.5px solid var(--accent); font-size: .94rem; font-weight: 600; transition: var(--t-smooth); text-decoration: none; white-space: nowrap; }
      .ink-pill:hover { background: #FFD84A; transform: translateY(-2px); box-shadow: 0 14px 28px rgba(254,209,54,.32); }
    </style>

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        inLanguage: 'pt-BR',
        about: category,
        author: { '@id': `${site.domain}/#organization` },
        publisher: { '@id': `${site.domain}/#organization` },
        mainEntityOfPage: url,
        url,
      })}
    />
  </Fragment>

  <Nav current="insights" />

  <main id="main" class="article-main">
    <div class="article-shell">
      <a href="/insights" class="back-link"><iconify-icon icon="solar:arrow-left-linear"></iconify-icon>Insights</a>
      {(eyebrow || category) && <span class="article-eyebrow">{eyebrow || category}</span>}
      <h1 class="article-title">{title}</h1>
      <p class="article-lede">{description}</p>
      <hr class="article-rule" />

      <div class="prose-piar">
        <Content />
      </div>

      <div class="article-cta">
        <span class="cta-copy">Quer aplicar isso na sua marca? Comece pelo diagnóstico.</span>
        <a href="/contato" class="ink-pill">Agendar diagnóstico<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
