---
// ============================================================================
// Narrativa espetacular · BRANDED CONTENT
// Conteúdo voice-backed portado de:
//   src/content/pages/branded-content.md
// Original preservado. Esta é a versão "narrativa espetacular":
// herói com motor de tecido (canvas 2D, fios marca + conteúdo + audiência se
// entrelaçando) + dataviz "trama de temas" (onde interesse da audiência cruza
// a mensagem da marca) + scroll storytelling (GSAP/Lenis), sobre o DS da PiaR.
// ============================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import { site } from '@/data/site';

const url = `${site.domain}/branded-content`;

// Quatro termos que se confundem · objetivo e quem ocupa o centro.
const termos = [
  {
    id: 'Branded content',
    objetivo: 'Posicionamento e reputação. O foco é a experiência do público; a marca aparece sutil, às vezes só como quem assina.',
    centro: 'A audiência',
    metrica: 'Percepção e autoridade',
    icon: 'solar:heart-angle-line-duotone',
    featured: true,
  },
  {
    id: 'Marketing de conteúdo',
    objetivo: 'Conversão e geração de leads. O conteúdo é útil, mas existe para mover a pessoa por um funil até a compra.',
    centro: 'O funil',
    metrica: 'Lead e venda',
    icon: 'solar:filter-line-duotone',
  },
  {
    id: 'Publicidade tradicional',
    objetivo: 'Interrompe para vender. A marca é a protagonista explícita e o produto está no centro do quadro.',
    centro: 'O produto',
    metrica: 'Alcance e recall',
    icon: 'solar:tv-line-duotone',
  },
  {
    id: 'Publieditorial',
    objetivo: 'Publicidade que assume o formato de matéria, com a marca exposta de forma clara. Pago e identificado como tal.',
    centro: 'A marca',
    metrica: 'Exposição paga',
    icon: 'solar:document-add-line-duotone',
  },
];

// Passo a passo da produção · conteúdo antes do formato.
const passos = [
  {
    num: '01',
    titulo: 'Objetivo de reputação, não só de campanha',
    desc: 'Antes de qualquer ideia, responda o que a marca quer que o público sinta e pense ao final, e qual percepção esse conteúdo deve construir ou corrigir. Sem isso, o resto vira produção sem direção.',
  },
  {
    num: '02',
    titulo: 'Conheça a audiência de verdade',
    desc: 'Persona, dor real, contexto de consumo e canais que a pessoa frequenta. Branded content nasce do que importa ao público, não do que a marca quer dizer sobre si.',
  },
  {
    num: '03',
    titulo: 'A história, com o público no centro',
    desc: 'Defina o arco de transformação: de onde a pessoa parte, o que muda, onde chega. A marca entra como quem viabiliza ou ilumina essa mudança, não como protagonista.',
  },
  {
    num: '04',
    titulo: 'Garanta o valor de mão dupla',
    desc: 'Pergunte, de forma honesta, o que a audiência ganha com esse conteúdo. Se a resposta for fraca, volte ao passo da história. Esse é o filtro que separa narrativa de pitch de vendas.',
  },
  {
    num: '05',
    titulo: 'Só agora escolha o formato',
    desc: 'Vídeo, áudio, artigo, série editorial, documentário curto, infográfico ou post. O formato serve à mensagem e ao canal onde o público está, nunca o contrário.',
  },
  {
    num: '06',
    titulo: 'Sinalize patrocínio com transparência',
    desc: 'Conteúdo de marca honesto identifica que é conteúdo de marca. No Brasil, isso conversa com as recomendações do CONAR sobre publicidade não enganosa. Esconder o patrocínio vira passivo.',
  },
  {
    num: '07',
    titulo: 'Distribua pensando em mídia conquistada',
    desc: 'Uma boa história de marca tem ângulo de notícia. Estruture o conteúdo para que parte dele vire pauta jornalística espontânea, com dado, porta-voz e contexto de mercado prontos.',
  },
  {
    num: '08',
    titulo: 'Meça por impacto reputacional',
    desc: 'Likes e views contam audiência, não reputação. Acompanhe share of voice, sentimento, autoridade da fonte e qualidade dos veículos que repercutiram. Esse é o painel que mostra se construiu marca.',
  },
];

// Quando usar · cenários que mais se beneficiam.
const quando = [
  {
    nome: 'Construir ou reposicionar percepção',
    desc: 'Quando o objetivo é o que o mercado pensa e repete sobre você, não a venda da próxima semana.',
    icon: 'solar:refresh-circle-line-duotone',
  },
  {
    nome: 'Quando há história ou conhecimento que o público valoriza',
    desc: 'Dados de setor, expertise técnica, ponto de vista sobre uma transformação em curso. Material que sustenta autoridade.',
    icon: 'solar:book-bookmark-line-duotone',
  },
  {
    nome: 'Em setores regulados, com cuidado redobrado',
    desc: 'Fintech, banking as a service, saúde e segmentos sob compliance ganham com conteúdo que constrói confiança, desde que cada mensagem passe por controle de risco.',
    icon: 'solar:shield-check-line-duotone',
  },
  {
    nome: 'Para alongar o ciclo de vida da narrativa',
    desc: 'Em vez de um pico isolado de campanha, uma série editorial em ritmo constante sustenta a presença da marca entre uma ação e outra.',
    icon: 'solar:clock-circle-line-duotone',
  },
];

// Erros comuns que viram passivo.
const erros = [
  'Começar sem objetivo nem definição do que o público deve sentir ao final.',
  'Tratar o conteúdo como anúncio, com excesso de pitch de vendas.',
  'Colocar a marca como heroína da história, em vez da audiência.',
  'Sobrecarregar de logos e identidade visual, sacrificando credibilidade.',
  'Ignorar o valor para a audiência e quebrar a equação de mão dupla.',
  'Priorizar quantidade sobre qualidade e diluir tudo de uma vez.',
  'Decidir o formato antes do conteúdo.',
  'Forçar autenticidade que a marca não tem.',
  'Transformar press release em branded content.',
  'Confundir com publieditorial e não sinalizar patrocínio.',
];

const exits = site.exits;
const clientes = ['Endemol Shine Brasil', 'Solides', 'AgroSmart', 'Vila 11', 'Doctoralia'];

const faq = [
  {
    q: 'Qual a diferença entre branded content e marketing de conteúdo?',
    a: 'O objetivo. Marketing de conteúdo existe para converter e gerar leads, movendo a pessoa por um funil até a compra. Branded content existe para construir posicionamento e reputação, com foco na experiência do público e na percepção de longo prazo. Os dois são legítimos e podem conviver, mas medi-los pela mesma régua leva a frustração.',
  },
  {
    q: 'Branded content e publieditorial são a mesma coisa?',
    a: 'Não. Publieditorial e advertorial são publicidade que assume formato de matéria, com a marca exposta de forma explícita e identificada. Branded content é mais sutil, centrado na história e na experiência do público, com a marca aparecendo como quem assina ou patrocina. Despejar informação institucional sem contar uma história transforma branded content em publieditorial.',
  },
  {
    q: 'Preciso sinalizar que é conteúdo patrocinado?',
    a: 'Sim. Conteúdo de marca honesto identifica que é conteúdo de marca, e essa transparência conversa com as recomendações do CONAR sobre publicidade não enganosa no Brasil. Esconder o patrocínio gera risco ético e regulatório e, na prática, custa mais reputação do que o conteúdo constrói.',
  },
  {
    q: 'Como medir o resultado de branded content?',
    a: 'Por impacto reputacional, não só por likes e views. Acompanhe share of voice, análise de sentimento, autoridade das fontes que repercutiram e a qualidade dos veículos onde o conteúdo gerou cobertura. Métrica de vaidade conta audiência; métrica de reputação mostra se a marca foi construída.',
  },
  {
    q: 'Branded content serve para empresa de setor regulado, como fintech?',
    a: 'Sim, e tende a ser ainda mais relevante onde confiança é o ativo central, como em banking as a service e saúde. A condição é tratar cada peça com controle de risco, linguagem aprovada e revisão antes de publicar. É um território em que conteúdo de marca e PR estratégico trabalham juntos, não separados.',
  },
  {
    q: 'Branded content substitui assessoria de imprensa?',
    a: 'Não. Conteúdo de marca é mídia própria e paga; assessoria de imprensa gera mídia conquistada, a cobertura espontânea que carrega credibilidade de terceiro. A combinação mais forte usa o branded content para alimentar a pauta jornalística, somando a história da marca à validação independente da imprensa.',
  },
];
---
<BaseLayout
  title="Branded content: o que é e como produzir"
  description="Branded content é conteúdo de marca em padrão editorial, feito para informar o público e construir reputação. O que é, como produzir passo a passo e como vira pauta. Guia da PiaR Group, em PR desde 2013."
  canonical={url}
>
  <Fragment slot="head">
    <style is:global>
      :root {
        --accent: #FED136;
        --accent-deep: #E0B420;
        --paper-warm: #F4F1EA;       /* putty quente */
        --bc-ink: #0A0A0C;
        --bc-ink-2: #141417;
        --bc-amber: #FFB020;
        --bc-weave: #F2A93B;
        --bc-thread: #C77A14;
        --radius-card: 24px;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 700; }
      body { font-family: var(--font-sans); background: var(--paper); color: var(--primary); overflow-x: hidden; -webkit-font-smoothing: antialiased; font-feature-settings: "ss01", "cv11"; }

      #scroll-progress { position: fixed; top: 0; left: 0; height: 2px; background: var(--accent); z-index: 9999; width: 0; transition: width .1s linear; }

      .wrap { max-width: 1280px; margin: 0 auto; padding-inline: 1.5rem; position: relative; z-index: 1; }
      @media (min-width: 768px) { .wrap { padding-inline: 2rem; } }

      .eyebrow { display: inline-flex; align-items: center; gap: .6rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; color: var(--text-muted); font-weight: 600; }
      .eyebrow::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex-shrink: 0; box-shadow: 0 0 0 4px rgba(254,209,54,.18); }
      .eyebrow.on-dark { color: rgba(255,255,255,.72); }

      .accent-serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--accent-deep); letter-spacing: -.02em; }
      .accent-serif.on-dark { color: var(--accent); }

      /* botões */
      .btn { display: inline-flex; align-items: center; gap: .55rem; padding: .9rem 1.7rem; border-radius: var(--radius-btn); font-size: .95rem; font-weight: 600; letter-spacing: -.01em; text-decoration: none; transition: var(--t-smooth); cursor: pointer; border: 1.5px solid transparent; }
      .btn iconify-icon { transition: transform .4s var(--ease-out-expo); }
      .btn:hover iconify-icon { transform: translateX(4px); }
      .btn-accent { background: var(--accent); color: var(--primary); border-color: var(--accent); }
      .btn-accent:hover { background: #FFD84A; transform: translateY(-2px); box-shadow: 0 16px 32px rgba(254,209,54,.32); }
      .btn-ghost-d { background: transparent; color: #fff; border-color: rgba(255,255,255,.25); }
      .btn-ghost-d:hover { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.5); }
      .btn-ghost { background: transparent; color: var(--primary); border-color: rgba(0,0,0,.16); }
      .btn-ghost:hover { background: rgba(0,0,0,.04); border-color: rgba(0,0,0,.32); }

      /* ===========================================================
         1 · HERO · motor de tecido (canvas 2D, fios se entrelaçando)
         =========================================================== */
      .bc-hero { position: relative; min-height: 100vh; min-height: 100svh; background: var(--bc-ink); color: #fff; overflow: hidden; display: flex; align-items: center; isolation: isolate; }
      #bc-hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; display: block; }
      .bc-hero .scrim { position: absolute; inset: 0; z-index: 1; pointer-events: none;
        background:
          radial-gradient(120% 95% at 16% 38%, rgba(10,10,12,.84) 0%, rgba(10,10,12,.38) 46%, rgba(10,10,12,0) 72%),
          linear-gradient(180deg, rgba(10,10,12,.5) 0%, rgba(10,10,12,0) 30%, rgba(10,10,12,.2) 74%, rgba(10,10,12,.92) 100%);
      }
      .bc-hero .hero-inner { position: relative; z-index: 2; width: 100%; padding-block: 9rem 4rem; }
      .bc-hero-chip { display: inline-flex; align-items: center; gap: .5rem; padding: .5rem 1rem; border-radius: var(--radius-pill); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(6px); font-family: var(--font-mono); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.78); }
      .bc-hero-chip .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px 1px rgba(254,209,54,.7); }
      .bc-hero h1 { font-size: clamp(2.8rem, 8vw, 7.4rem); font-weight: 700; line-height: .94; letter-spacing: -.045em; margin: 1.6rem 0 0; max-width: 19ch; text-wrap: balance; }
      .bc-hero .sub { font-size: clamp(1.1rem, 1.7vw, 1.4rem); line-height: 1.5; color: rgba(255,255,255,.74); margin-top: 1.75rem; max-width: 50ch; }
      .bc-hero .cta-row { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2.5rem; }
      .bc-scroll-cue { position: absolute; left: 50%; bottom: 1.75rem; transform: translateX(-50%); z-index: 2; display: inline-flex; flex-direction: column; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .6rem; letter-spacing: .2em; text-transform: uppercase; color: rgba(255,255,255,.5); }
      .bc-scroll-cue .line { width: 1px; height: 38px; background: linear-gradient(180deg, rgba(255,255,255,.5), transparent); animation: cuePulse 2.2s var(--ease-out-expo) infinite; }
      @keyframes cuePulse { 0%,100% { opacity: .3; transform: scaleY(.7); transform-origin: top; } 50% { opacity: 1; transform: scaleY(1); } }

      /* parallax de profundidade */
      .px { will-change: transform; }
      .has-ghost { overflow: hidden; }
      .ghost-mark { position: absolute; z-index: 0; font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: clamp(7rem, 24vw, 24rem); line-height: .78; letter-spacing: -.04em; color: rgba(15,15,17,.045); pointer-events: none; user-select: none; white-space: nowrap; }
      .section.dark .ghost-mark { color: rgba(255,255,255,.04); }
      .ghost-mark.tr { top: -2rem; right: -1.5rem; }
      .ghost-mark.bl { bottom: -3rem; left: -2rem; }
      .bc-hero-float { position: absolute; z-index: 2; display: inline-flex; align-items: center; gap: .5rem; padding: .55rem 1rem; border-radius: var(--radius-pill); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(6px); font-family: var(--font-mono); font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.72); }
      .bc-hero-float .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--bc-weave); box-shadow: 0 0 8px 1px rgba(242,169,59,.7); }
      .bc-hero-float.f1 { right: 9%; top: 26%; }
      .bc-hero-float.f2 { right: 16%; bottom: 22%; }
      @media (max-width: 900px) { .bc-hero-float { display: none; } .ghost-mark { font-size: clamp(6rem, 30vw, 12rem); } }

      /* Três Mares · contorno em grade/tecido (a trama da marca) como camada de profundidade */
      .has-contour { overflow: hidden; }
      .contour-field {
        position: absolute; inset: -14% -10%; z-index: 0; pointer-events: none;
        --contour-line: rgba(255,176,32,.11);
        background:
          repeating-linear-gradient(90deg, transparent 0 40px, var(--contour-line) 40px 41px),
          repeating-linear-gradient(0deg, transparent 0 40px, var(--contour-line) 40px 41px);
        -webkit-mask-image: radial-gradient(circle at 50% 40%, #000 0%, rgba(0,0,0,.55) 42%, transparent 78%);
                mask-image: radial-gradient(circle at 50% 40%, #000 0%, rgba(0,0,0,.55) 42%, transparent 78%);
        will-change: transform;
      }
      @media (max-width: 760px) { .contour-field { opacity: .6; } }

      /* ===========================================================
         seções base
         =========================================================== */
      .section { padding-block: var(--sec-pad); position: relative; }
      .section.paper { background: var(--paper); border-top: 1px solid var(--hairline); }
      .section.warm { background: var(--paper-warm); border-top: 1px solid var(--hairline); }
      .section.dark { background: var(--bc-ink); color: #fff; border-top: 1px solid rgba(255,255,255,.06); }
      .section h2 { font-size: clamp(2.1rem, 4.6vw, 4rem); font-weight: 600; line-height: 1.03; letter-spacing: -.035em; margin: 1rem 0 0; max-width: 20ch; text-wrap: balance; }
      .section.dark h2 { color: #fff; }
      .lede { font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.55; color: var(--text-muted); margin-top: 1.5rem; max-width: 56ch; }
      .section.dark .lede { color: rgba(255,255,255,.72); }
      .sec-head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }

      /* compare 2 colunas (a regra de mão dupla) */
      .compare { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
      @media (min-width: 900px) { .compare { grid-template-columns: 1fr 1fr; gap: 1.5rem; } }
      .compare-card { padding: clamp(2rem, 3vw, 2.75rem); border-radius: var(--radius-card); border: 1px solid var(--hairline); background: #fff; min-height: 280px; display: flex; flex-direction: column; }
      .compare-card .ctag { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--text-faint); }
      .compare-card h3 { font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 600; letter-spacing: -.025em; margin: .9rem 0 0; line-height: 1.1; }
      .compare-card p { font-size: 1.0625rem; line-height: 1.6; color: var(--text-muted); margin-top: 1rem; }
      .compare-card .steps { margin-top: auto; padding-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; color: var(--text-faint); }
      .compare-card .steps iconify-icon { color: var(--accent-deep); }
      .compare-card.is-dark { background: var(--bc-ink-2); border-color: rgba(255,255,255,.12); color: #fff; }
      .compare-card.is-dark .ctag { color: rgba(255,255,255,.45); }
      .compare-card.is-dark p { color: rgba(255,255,255,.72); }
      .compare-card.is-dark .steps { color: rgba(255,255,255,.5); }
      .compare-card.is-dark .steps iconify-icon { color: var(--accent); }
      .punch { font-family: var(--font-serif); font-style: italic; font-size: clamp(1.6rem, 3.4vw, 2.9rem); line-height: 1.18; letter-spacing: -.02em; margin-top: clamp(2.5rem, 5vw, 3.5rem); max-width: 24ch; }
      .punch .hl { color: var(--accent-deep); font-style: italic; }
      .section.dark .punch .hl { color: var(--accent); }

      /* termos: branded content vs marketing vs publicidade vs publieditorial */
      .layers { display: grid; grid-template-columns: 1fr; gap: 1rem; }
      @media (min-width: 720px) { .layers { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
      @media (min-width: 1080px) { .layers { grid-template-columns: repeat(4, 1fr); gap: 1.25rem; } }
      .layer-card { position: relative; padding: clamp(1.75rem, 2.4vw, 2.1rem); border-radius: var(--radius-card); border: 1px solid var(--hairline); background: #fff; overflow: hidden; transition: var(--t-smooth); }
      .layer-card:hover { transform: translateY(-4px); box-shadow: 0 24px 48px rgba(0,0,0,.07); border-color: rgba(0,0,0,.14); }
      .layer-card .l-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: rgba(15,15,17,.05); color: var(--primary); font-size: 1.4rem; }
      .layer-card .l-name { font-size: 1.3rem; font-weight: 600; letter-spacing: -.025em; margin-top: 1.25rem; line-height: 1.12; }
      .layer-card .l-otimiza { font-size: .98rem; line-height: 1.55; color: var(--text-muted); margin-top: .85rem; }
      .layer-card .l-meta { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--hairline); display: flex; flex-direction: column; gap: .55rem; }
      .layer-card .l-meta .row { display: flex; justify-content: space-between; gap: 1rem; font-size: .82rem; }
      .layer-card .l-meta .k { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; color: var(--text-faint); }
      .layer-card .l-meta .v { font-weight: 600; text-align: right; letter-spacing: -.01em; }
      .layer-card.featured { background: var(--bc-ink); color: #fff; border-color: var(--bc-ink); }
      .layer-card.featured::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(90% 60% at 80% 0%, rgba(242,169,59,.22) 0%, transparent 60%), radial-gradient(70% 50% at 10% 100%, rgba(254,209,54,.14) 0%, transparent 60%); }
      .layer-card.featured .l-icon { background: rgba(255,255,255,.08); color: var(--accent); position: relative; z-index: 1; }
      .layer-card.featured .l-name, .layer-card.featured .l-otimiza { position: relative; z-index: 1; }
      .layer-card.featured .l-otimiza { color: rgba(255,255,255,.75); }
      .layer-card.featured .l-meta { border-color: rgba(255,255,255,.16); position: relative; z-index: 1; }
      .layer-card.featured .l-meta .k { color: rgba(255,255,255,.5); }
      .layer-card.featured .badge { position: absolute; top: 1.25rem; right: 1.25rem; z-index: 1; font-family: var(--font-mono); font-size: .56rem; letter-spacing: .14em; text-transform: uppercase; color: var(--primary); background: var(--accent); padding: .3rem .6rem; border-radius: var(--radius-pill); font-weight: 700; }

      /* ===========================================================
         4 · DATAVIZ · trama de temas (canvas 2D)
         interesse da audiência cruza a mensagem da marca
         =========================================================== */
      .viz-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center; }
      @media (min-width: 1024px) { .viz-grid { grid-template-columns: 1.05fr 1fr; gap: 3.5rem; } }
      .viz-stage { position: relative; aspect-ratio: 4 / 3; width: 100%; border-radius: var(--radius-card); overflow: hidden; background: linear-gradient(160deg, #141417 0%, #0A0A0C 70%); border: 1px solid rgba(255,255,255,.1); }
      #bc-weave-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
      .viz-legend { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; margin-top: 1.5rem; }
      .viz-legend .li { display: inline-flex; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .04em; text-transform: uppercase; color: rgba(255,255,255,.6); }
      .viz-legend .sw { width: 12px; height: 12px; border-radius: 3px; }

      /* passos (método de produção) */
      .steps-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
      @media (min-width: 720px) { .steps-grid { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
      @media (min-width: 1100px) { .steps-grid { grid-template-columns: repeat(4, 1fr); } }
      .step-card { padding: 1.85rem 1.6rem; border-radius: var(--radius-card); background: #fff; border: 1px solid var(--hairline); transition: var(--t-smooth); display: flex; flex-direction: column; min-height: 230px; }
      .step-card:hover { transform: translateY(-4px); box-shadow: 0 22px 44px rgba(0,0,0,.06); border-color: rgba(254,209,54,.45); }
      .step-card .s-num { font-family: var(--font-mono); font-size: .9rem; font-weight: 700; letter-spacing: .1em; color: var(--accent-deep); }
      .step-card .s-titulo { font-size: 1.12rem; font-weight: 600; letter-spacing: -.02em; margin-top: .65rem; line-height: 1.22; }
      .step-card .s-desc { font-size: .9rem; line-height: 1.55; color: var(--text-muted); margin-top: .7rem; }

      /* quando usar (frentes) */
      .frentes-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
      @media (min-width: 720px) { .frentes-grid { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
      .frente-card { padding: clamp(1.75rem, 2.2vw, 2.25rem); border-radius: var(--radius-card); background: #fff; border: 1px solid var(--hairline); transition: var(--t-smooth); }
      .frente-card:hover { transform: translateY(-4px); box-shadow: 0 22px 44px rgba(0,0,0,.06); border-color: rgba(0,0,0,.14); }
      .frente-card .f-icon { width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; background: rgba(254,209,54,.14); color: var(--accent-deep); font-size: 1.5rem; }
      .frente-card .f-name { font-size: 1.2rem; font-weight: 600; letter-spacing: -.02em; margin-top: 1.25rem; line-height: 1.2; }
      .frente-card .f-desc { font-size: .95rem; line-height: 1.6; color: var(--text-muted); margin-top: .7rem; }

      /* erros (lista densa) */
      .err-grid { display: grid; grid-template-columns: 1fr; gap: .75rem; }
      @media (min-width: 760px) { .err-grid { grid-template-columns: 1fr 1fr; gap: .75rem 1.5rem; } }
      .err-item { display: flex; gap: .85rem; align-items: flex-start; padding: 1.05rem 0; border-bottom: 1px solid var(--hairline); }
      .err-item iconify-icon { color: var(--bc-thread); font-size: 1.25rem; flex-shrink: 0; margin-top: .1rem; }
      .err-item span { font-size: 1rem; line-height: 1.5; color: var(--text-muted); }

      /* prova */
      .chips { display: flex; flex-wrap: wrap; gap: .5rem; }
      .chip { display: inline-flex; align-items: center; padding: .5rem 1rem; border-radius: var(--radius-pill); font-family: var(--font-mono); font-size: .68rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; background: rgba(255,255,255,.06); color: #fff; border: 1px solid rgba(255,255,255,.16); }
      .honesty { margin-top: 2.5rem; padding: 1.75rem 2rem; border-radius: var(--radius-card); border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.03); display: flex; gap: 1rem; align-items: flex-start; max-width: 64ch; }
      .honesty iconify-icon { color: var(--accent); font-size: 1.5rem; flex-shrink: 0; margin-top: .1rem; }
      .honesty p { font-size: 1rem; line-height: 1.6; color: rgba(255,255,255,.82); margin: 0; }

      /* faq */
      .faq-item { border-bottom: 1px solid var(--hairline); }
      .faq-item summary { list-style: none; cursor: pointer; padding: 1.6rem 0; display: flex; justify-content: space-between; align-items: center; gap: 2rem; font-size: 1.15rem; font-weight: 600; letter-spacing: -.01em; transition: color .3s; }
      .faq-item summary::-webkit-details-marker { display: none; }
      .faq-item summary:hover { color: var(--accent-deep); }
      .faq-item summary iconify-icon { transition: transform .4s var(--ease-out-expo); font-size: 1.5rem; color: var(--text-muted); flex-shrink: 0; }
      .faq-item[open] summary iconify-icon { transform: rotate(45deg); color: var(--accent-deep); }
      .faq-item .faq-body { padding: 0 0 1.6rem; color: var(--text-muted); max-width: 68ch; line-height: 1.65; }

      /* cta final */
      .cta-final { text-align: center; }
      .cta-final h2 { margin-inline: auto; max-width: 20ch; }
      .cta-final .lede { margin-inline: auto; }
      .cta-final .cta-row { justify-content: center; }

      /* reveal local */
      .reveal { opacity: 0; transform: translateY(2rem); transition: opacity .8s var(--ease-out-expo), transform .8s var(--ease-out-expo); }
      .reveal.active { opacity: 1; transform: none; }
      .d1 { transition-delay: .08s; } .d2 { transition-delay: .16s; } .d3 { transition-delay: .24s; } .d4 { transition-delay: .32s; }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
        .reveal { opacity: 1 !important; transform: none !important; }
        .bc-scroll-cue .line { animation: none; }
      }
    </style>

