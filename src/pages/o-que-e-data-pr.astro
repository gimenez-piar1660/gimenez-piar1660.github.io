---
// ============================================================================
// Narrativa espetacular · Data PR
// Conteúdo voice-backed portado de:
//   src/content/pages/o-que-e-data-pr.md
// Original preservado. Esta página é a versão "narrativa espetacular":
// herói canvas 2D (pontos de dado convergindo numa manchete) + dataviz
// "dataset vira manchete" (canvas 2D) + scroll storytelling (GSAP/Lenis),
// sobre o DS da PiaR (eyebrow-dot, watermarks, inversão dark, contorno).
// ============================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import { site } from '@/data/site';

const url = `${site.domain}/o-que-e-data-pr`;

// As quatro fontes de dado que viram pauta.
const fontes = [
  {
    id: 'F1',
    nome: 'Dados próprios de operação',
    desc: 'O que a sua empresa mede para funcionar: volume de transações, comportamento de uso, sazonalidade, ticket médio, taxa de adoção. São os mais valiosos porque ninguém mais tem.',
    tag: 'Exclusivo por natureza',
    icon: 'solar:database-line-duotone',
    featured: true,
  },
  {
    id: 'F2',
    nome: 'Pesquisa primária encomendada',
    desc: 'Levantamento desenhado para responder a uma pergunta de pauta, com amostra e metodologia declaradas. Custa mais e exige rigor, mas gera exclusividade.',
    tag: 'Custa, mas é seu',
    icon: 'solar:chart-2-line-duotone',
  },
  {
    id: 'F3',
    nome: 'Dados públicos recombinados',
    desc: 'Bases de governo, reguladores e institutos (IBGE, Banco Central, ministérios) cruzadas com a sua leitura de setor. O valor está na análise, não no dado bruto.',
    tag: 'Valor na leitura',
    icon: 'solar:layers-minimalistic-line-duotone',
  },
  {
    id: 'F4',
    nome: 'Dados de tendência e mercado',
    desc: 'O que a sua empresa observa no agregado dos clientes e que serve de termômetro para o setor inteiro.',
    tag: 'Termômetro de setor',
    icon: 'solar:graph-up-line-duotone',
  },
];

// O ciclo PEP aplicado a Data PR (8 passos).
const passos = [
  {
    num: '01',
    titulo: 'Defina a pergunta de pauta, não o dado',
    desc: 'Comece pela dúvida que interessa ao público ("o brasileiro mudou o jeito de pagar?", "o crédito para pequena empresa encolheu?"). O dado existe para responder a ela. Sem pergunta clara, o número não tem narrativa.',
  },
  {
    num: '02',
    titulo: 'Escolha e valide a fonte do dado',
    desc: 'Identifique de onde vem o número, qual o recorte temporal, qual a amostra ou universo, e o que ele não prova. Dado sem metodologia declarada não chega na redação sério.',
  },
  {
    num: '03',
    titulo: 'Submeta à revisão jurídica e de privacidade',
    desc: 'Dado próprio costuma envolver informação de cliente. Antes de publicar, confirme anonimização, agregação e conformidade com a LGPD. Na PiaR esse passo tem revisão jurídica no processo, e não é opcional.',
  },
  {
    num: '04',
    titulo: 'Construa a narrativa em volta do número',
    desc: 'Traduza o dado em frase de jornalista: o que mudou, em quanto, por que importa, e o que vem depois. Um gráfico não narra sozinho. O texto faz o trabalho.',
  },
  {
    num: '05',
    titulo: 'Defina o ângulo por veículo e por editor',
    desc: 'O mesmo dado vira três pautas diferentes para economia, tecnologia e PME. Aqui entra o relacionamento: você sabe quem cobre o que e o que cada editor procura agora.',
  },
  {
    num: '06',
    titulo: 'Ofereça com relacionamento, não com disparo em massa',
    desc: 'Encaminhamento segmentado, com exclusividade real quando ela existir, supera o envio para mailing inteiro. Mailing grande tende a ter taxa de abertura menor e queima a relação.',
  },
  {
    num: '07',
    titulo: 'Prepare o material de apoio',
    desc: 'Tabela limpa, gráfico em formato usável, nota metodológica e porta-voz disponível. Quanto menos atrito para o jornalista, maior a chance de publicação.',
  },
  {
    num: '08',
    titulo: 'Meça o resultado contra a meta',
    desc: 'Alcance, share of voice e, quando o objetivo é negócio, indicadores de conversão. Medição fecha o ciclo e alimenta a próxima pauta.',
  },
];

// As frentes de medição (Princípios de Barcelona, AMEC 4.0).
const metricas = [
  {
    nome: 'Resultado, não atividade',
    desc: 'Número de releases enviados não é resultado. Mudança de percepção, alcance qualificado e efeito no negócio são. É o primeiro princípio de Barcelona.',
    icon: 'solar:target-line-duotone',
  },
  {
    nome: 'Sem AVE',
    desc: 'Os Princípios de Barcelona desaconselham a equivalência em mídia paga há mais de uma década. Ela compara espaço editorial com anúncio e distorce o valor do earned media.',
    icon: 'solar:forbidden-circle-line-duotone',
  },
  {
    nome: 'Alcance qualificado',
    desc: 'Quantas pessoas foram expostas à pauta, por veículo e por relevância, não apenas o número bruto de impressões.',
    icon: 'solar:users-group-rounded-line-duotone',
  },
  {
    nome: 'Share of voice',
    desc: 'Sua presença no noticiário do setor frente aos concorrentes, no mesmo período. Menções da sua marca dividido pelo total do mercado, vezes cem.',
    icon: 'solar:chart-square-line-duotone',
  },
  {
    nome: 'Sentimento e mensagem-chave',
    desc: 'Se a cobertura passou o enquadramento certo, não só se citou a marca. A frase importa tanto quanto a aparição.',
    icon: 'solar:heart-pulse-line-duotone',
  },
  {
    nome: 'ROI e indicadores de negócio',
    desc: 'Quando o objetivo é venda, acompanhe tráfego de referência, qualidade de lead e, quando possível, receita atribuída. Amarre a métrica ao objetivo declarado no início.',
    icon: 'solar:dollar-minimalistic-line-duotone',
  },
];

const exits = site.exits;
const clientes = ['Sambatech', 'Liga Ventures', 'Doctoralia', 'Solides', 'PagBrasil', 'Corning', 'AgroSmart', 'Vila 11'];

const faq = [
  {
    q: 'Data PR é a mesma coisa que data storytelling?',
    a: 'São parentes, não sinônimos. Data storytelling é a técnica de narrar com dados, usada em vários contextos. Data PR aplica essa técnica especificamente para conquistar cobertura de imprensa e construir reputação, somando dado, relacionamento com a redação e medição de resultado.',
  },
  {
    q: 'Preciso de pesquisa cara para fazer Data PR?',
    a: 'Não necessariamente. Muita pauta forte nasce de dado próprio que você já coleta para operar, ou de dado público recombinado com a sua leitura de setor. Pesquisa encomendada é uma opção quando você precisa de exclusividade sobre uma pergunta específica, não um pré-requisito.',
  },
  {
    q: 'Como evito problema de LGPD com dado de cliente?',
    a: 'Trabalhe com dado agregado e anonimizado, nunca individualizado, e submeta o material à revisão jurídica antes de divulgar. Dado próprio que vira pauta deve descrever comportamento de conjunto, não identificar pessoas.',
  },
  {
    q: 'Qual a diferença entre Data PR e digital PR?',
    a: 'Digital PR é o conjunto de práticas de relacionamento e construção de presença em canais digitais. Data PR é uma abordagem que pode rodar dentro de earned media tradicional ou digital: o que a define é partir do dado como origem da narrativa, em qualquer canal.',
  },
  {
    q: 'Como provo o ROI de uma campanha de Data PR?',
    a: 'Defina a métrica antes de começar, alinhada ao objetivo. Para autoridade, acompanhe alcance qualificado e share of voice. Para negócio, tráfego de referência, qualidade de lead e receita atribuída quando possível. Siga os Princípios de Barcelona da AMEC: meça resultado, não atividade, e não use AVE.',
  },
  {
    q: 'Disparo em massa não garante mais publicação?',
    a: 'Volume não compensa falta de relevância. Mailing grande tende a ter abertura menor e desgasta a relação com a redação. Encaminhamento segmentado, com ângulo por veículo e exclusividade quando ela existe, rende mais publicação e melhor relação.',
  },
];
---
<BaseLayout
  title="Data PR: o dado que vira manchete"
  description="Data PR transforma dados próprios e de mercado em pauta noticiável, oferecida à imprensa por relacionamento, e medida por métricas de negócio: alcance, share of voice, ROI."
  canonical={url}
>
  <Fragment slot="head">
    <style is:global>
      :root {
        --accent: #FED136;
        --accent-deep: #E0B420;
        --paper-warm: #F4F1EA;
        --data-ink: #0A0A0C;
        --data-ink-2: #141417;
        --data-amber: #FFB020;
        --data-grid: #FFC93A;
        --radius-card: 24px;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 700; }
      body { font-family: var(--font-sans); background: var(--paper); color: var(--primary); overflow-x: hidden; -webkit-font-smoothing: antialiased; font-feature-settings: "ss01", "cv11"; }

      #scroll-progress { position: fixed; top: 0; left: 0; height: 2px; background: var(--accent); z-index: 9999; width: 0; transition: width .1s linear; }

      .wrap { max-width: 1280px; margin: 0 auto; padding-inline: 1.5rem; position: relative; z-index: 1; }
      @media (min-width: 768px) { .wrap { padding-inline: 2rem; } }

      .eyebrow { display: inline-flex; align-items: center; gap: .6rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; color: var(--text-muted); font-weight: 600; }
      .eyebrow::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex-shrink: 0; box-shadow: 0 0 0 4px rgba(254,209,54,.18); }
      .eyebrow.on-dark { color: rgba(255,255,255,.72); }

      .accent-serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--accent-deep); letter-spacing: -.02em; }
      .accent-serif.on-dark { color: var(--accent); }

      /* botões */
      .btn { display: inline-flex; align-items: center; gap: .55rem; padding: .9rem 1.7rem; border-radius: var(--radius-btn); font-size: .95rem; font-weight: 600; letter-spacing: -.01em; text-decoration: none; transition: var(--t-smooth); cursor: pointer; border: 1.5px solid transparent; }
      .btn iconify-icon { transition: transform .4s var(--ease-out-expo); }
      .btn:hover iconify-icon { transform: translateX(4px); }
      .btn-accent { background: var(--accent); color: var(--primary); border-color: var(--accent); }
      .btn-accent:hover { background: #FFD84A; transform: translateY(-2px); box-shadow: 0 16px 32px rgba(254,209,54,.32); }
      .btn-ghost-d { background: transparent; color: #fff; border-color: rgba(255,255,255,.25); }
      .btn-ghost-d:hover { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.5); }
      .btn-ghost { background: transparent; color: var(--primary); border-color: rgba(0,0,0,.16); }
      .btn-ghost:hover { background: rgba(0,0,0,.04); border-color: rgba(0,0,0,.32); }

      /* ===========================================================
         1 · HERO · pontos de dado que condensam numa manchete (canvas 2D)
         =========================================================== */
      .dpr-hero { position: relative; min-height: 100vh; min-height: 100svh; background: var(--data-ink); color: #fff; overflow: hidden; display: flex; align-items: center; isolation: isolate; }
      #dpr-hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; display: block; }
      .dpr-hero .scrim { position: absolute; inset: 0; z-index: 1; pointer-events: none;
        background:
          radial-gradient(120% 90% at 18% 38%, rgba(10,10,12,.84) 0%, rgba(10,10,12,.38) 46%, rgba(10,10,12,0) 72%),
          linear-gradient(180deg, rgba(10,10,12,.5) 0%, rgba(10,10,12,0) 30%, rgba(10,10,12,.2) 75%, rgba(10,10,12,.92) 100%);
      }
      .dpr-hero .hero-inner { position: relative; z-index: 2; width: 100%; padding-block: 9rem 4rem; }
      .dpr-hero-chip { display: inline-flex; align-items: center; gap: .5rem; padding: .5rem 1rem; border-radius: var(--radius-pill); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(6px); font-family: var(--font-mono); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.78); }
      .dpr-hero-chip .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px 1px rgba(254,209,54,.7); }
      .dpr-hero h1 { font-size: clamp(2.9rem, 8.5vw, 8rem); font-weight: 700; line-height: .92; letter-spacing: -.045em; margin: 1.6rem 0 0; max-width: 17ch; text-wrap: balance; }
      .dpr-hero .sub { font-size: clamp(1.1rem, 1.7vw, 1.4rem); line-height: 1.5; color: rgba(255,255,255,.74); margin-top: 1.75rem; max-width: 48ch; }
      .dpr-hero .cta-row { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2.5rem; }
      .dpr-scroll-cue { position: absolute; left: 50%; bottom: 1.75rem; transform: translateX(-50%); z-index: 2; display: inline-flex; flex-direction: column; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .6rem; letter-spacing: .2em; text-transform: uppercase; color: rgba(255,255,255,.5); }
      .dpr-scroll-cue .line { width: 1px; height: 38px; background: linear-gradient(180deg, rgba(255,255,255,.5), transparent); animation: cuePulse 2.2s var(--ease-out-expo) infinite; }
      @keyframes cuePulse { 0%,100% { opacity: .3; transform: scaleY(.7); transform-origin: top; } 50% { opacity: 1; transform: scaleY(1); } }

      /* parallax de profundidade */
      .px { will-change: transform; }
      .has-ghost { overflow: hidden; }
      .ghost-mark { position: absolute; z-index: 0; font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: clamp(7rem, 24vw, 24rem); line-height: .78; letter-spacing: -.04em; color: rgba(15,15,17,.045); pointer-events: none; user-select: none; white-space: nowrap; }
      .section.dark .ghost-mark { color: rgba(255,255,255,.04); }
      .ghost-mark.tr { top: -2rem; right: -1.5rem; }
      .ghost-mark.bl { bottom: -3rem; left: -2rem; }
      .dpr-hero-float { position: absolute; z-index: 2; display: inline-flex; align-items: center; gap: .5rem; padding: .55rem 1rem; border-radius: var(--radius-pill); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(6px); font-family: var(--font-mono); font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.72); }
      .dpr-hero-float .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--data-amber); box-shadow: 0 0 8px 1px rgba(255,176,32,.7); }
      .dpr-hero-float.f1 { right: 9%; top: 26%; }
      .dpr-hero-float.f2 { right: 16%; bottom: 22%; }
      @media (max-width: 900px) { .dpr-hero-float { display: none; } .ghost-mark { font-size: clamp(6rem, 30vw, 12rem); } }

      /* Três Mares · grade de dados (terreno de evidência) como camada de profundidade */
      .has-contour { overflow: hidden; }
      .contour-field {
        position: absolute; inset: -14% -10%; z-index: 0; pointer-events: none;
        --contour-line: rgba(254,209,54,.09);
        background:
          repeating-linear-gradient(90deg, transparent 0 38px, var(--contour-line) 38px 39px),
          repeating-linear-gradient(0deg, transparent 0 38px, var(--contour-line) 38px 39px);
        -webkit-mask-image: radial-gradient(circle at 78% 35%, #000 0%, rgba(0,0,0,.55) 42%, transparent 78%);
                mask-image: radial-gradient(circle at 78% 35%, #000 0%, rgba(0,0,0,.55) 42%, transparent 78%);
        will-change: transform;
      }
      @media (max-width: 760px) { .contour-field { opacity: .6; } }

      /* ===========================================================
         seções base
         =========================================================== */
      .section { padding-block: var(--sec-pad); position: relative; }
      .section.paper { background: var(--paper); border-top: 1px solid var(--hairline); }
      .section.warm { background: var(--paper-warm); border-top: 1px solid var(--hairline); }
      .section.dark { background: var(--data-ink); color: #fff; border-top: 1px solid rgba(255,255,255,.06); }
      .section h2 { font-size: clamp(2.1rem, 4.6vw, 4rem); font-weight: 600; line-height: 1.03; letter-spacing: -.035em; margin: 1rem 0 0; max-width: 20ch; text-wrap: balance; }
      .section.dark h2 { color: #fff; }
      .lede { font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.55; color: var(--text-muted); margin-top: 1.5rem; max-width: 58ch; }
      .section.dark .lede { color: rgba(255,255,255,.72); }
      .sec-head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }

      /* compare 2 colunas (o contraste) */
      .compare { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
      @media (min-width: 900px) { .compare { grid-template-columns: 1fr 1fr; gap: 1.5rem; } }
      .compare-card { padding: clamp(2rem, 3vw, 2.75rem); border-radius: var(--radius-card); border: 1px solid var(--hairline); background: #fff; min-height: 280px; display: flex; flex-direction: column; }
      .compare-card .ctag { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--text-faint); }
      .compare-card h3 { font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 600; letter-spacing: -.025em; margin: .9rem 0 0; line-height: 1.1; }
      .compare-card p { font-size: 1.0625rem; line-height: 1.6; color: var(--text-muted); margin-top: 1rem; }
      .compare-card .steps { margin-top: auto; padding-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; color: var(--text-faint); }
      .compare-card .steps iconify-icon { color: var(--accent-deep); }
      .compare-card.is-dark { background: var(--data-ink-2); border-color: rgba(255,255,255,.12); color: #fff; }
      .compare-card.is-dark .ctag { color: rgba(255,255,255,.45); }
      .compare-card.is-dark p { color: rgba(255,255,255,.72); }
      .compare-card.is-dark .steps { color: rgba(255,255,255,.5); }
      .compare-card.is-dark .steps iconify-icon { color: var(--accent); }
      .punch { font-family: var(--font-serif); font-style: italic; font-size: clamp(1.6rem, 3.4vw, 2.9rem); line-height: 1.18; letter-spacing: -.02em; margin-top: clamp(2.5rem, 5vw, 3.5rem); max-width: 26ch; }
      .punch .hl { color: var(--accent-deep); font-style: italic; }
      .section.dark .punch .hl { color: var(--accent); }

      /* fontes de dado */
      .layers { display: grid; grid-template-columns: 1fr; gap: 1rem; }
      @media (min-width: 720px) { .layers { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
      @media (min-width: 1100px) { .layers { grid-template-columns: repeat(4, 1fr); } }
      .layer-card { position: relative; padding: clamp(1.75rem, 2.4vw, 2.25rem); border-radius: var(--radius-card); border: 1px solid var(--hairline); background: #fff; overflow: hidden; transition: var(--t-smooth); }
      .layer-card:hover { transform: translateY(-4px); box-shadow: 0 24px 48px rgba(0,0,0,.07); border-color: rgba(0,0,0,.14); }
      .layer-card .l-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: rgba(15,15,17,.05); color: var(--primary); font-size: 1.4rem; }
      .layer-card .l-id { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text-faint); margin-top: 1.25rem; }
      .layer-card .l-name { font-size: 1.32rem; font-weight: 600; letter-spacing: -.025em; margin-top: .3rem; line-height: 1.12; }
      .layer-card .l-otimiza { font-size: .98rem; line-height: 1.55; color: var(--text-muted); margin-top: .85rem; }
      .layer-card .l-meta { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--hairline); }
      .layer-card .l-meta .k { font-family: var(--font-mono); font-size: .64rem; letter-spacing: .12em; text-transform: uppercase; color: var(--text-faint); }
      .layer-card .l-meta .v { font-weight: 600; letter-spacing: -.01em; display: block; margin-top: .3rem; }
      .layer-card.featured { background: var(--data-ink); color: #fff; border-color: var(--data-ink); }
      .layer-card.featured::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(90% 60% at 80% 0%, rgba(255,176,32,.2) 0%, transparent 60%), radial-gradient(70% 50% at 10% 100%, rgba(254,209,54,.14) 0%, transparent 60%); }
      .layer-card.featured .l-icon { background: rgba(255,255,255,.08); color: var(--accent); position: relative; z-index: 1; }
      .layer-card.featured .l-id { color: var(--accent); position: relative; z-index: 1; }
      .layer-card.featured .l-name, .layer-card.featured .l-otimiza { position: relative; z-index: 1; }
      .layer-card.featured .l-otimiza { color: rgba(255,255,255,.75); }
      .layer-card.featured .l-meta { border-color: rgba(255,255,255,.16); position: relative; z-index: 1; }
      .layer-card.featured .l-meta .k { color: rgba(255,255,255,.5); }

      /* ===========================================================
         4 · DATAVIZ · dataset vira manchete (canvas 2D)
         =========================================================== */
      .viz-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center; }
      @media (min-width: 1024px) { .viz-grid { grid-template-columns: 1.05fr 1fr; gap: 3.5rem; } }
      .viz-stage { position: relative; aspect-ratio: 4 / 3; width: 100%; border-radius: var(--radius-card); overflow: hidden; background: linear-gradient(160deg, #141417 0%, #0A0A0C 70%); border: 1px solid rgba(255,255,255,.1); }
      #dpr-pipeline-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
      .viz-legend { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; margin-top: 1.5rem; }
      .viz-legend .li { display: inline-flex; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .04em; text-transform: uppercase; color: rgba(255,255,255,.6); }
      .viz-legend .sw { width: 12px; height: 12px; border-radius: 50%; }

      /* passos (PEP) */
      .steps-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
      @media (min-width: 720px) { .steps-grid { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
      @media (min-width: 1100px) { .steps-grid { grid-template-columns: repeat(4, 1fr); } }
      .step-card { padding: 1.85rem 1.6rem; border-radius: var(--radius-card); background: #fff; border: 1px solid var(--hairline); transition: var(--t-smooth); display: flex; flex-direction: column; min-height: 230px; }
      .step-card:hover { transform: translateY(-4px); box-shadow: 0 22px 44px rgba(0,0,0,.06); border-color: rgba(254,209,54,.45); }
      .step-card .s-num { font-family: var(--font-mono); font-size: .9rem; font-weight: 700; letter-spacing: .1em; color: var(--accent-deep); }
      .step-card .s-titulo { font-size: 1.12rem; font-weight: 600; letter-spacing: -.02em; margin-top: .8rem; line-height: 1.2; }
      .step-card .s-desc { font-size: .9rem; line-height: 1.55; color: var(--text-muted); margin-top: .75rem; }

      /* métricas */
      .frentes-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
      @media (min-width: 720px) { .frentes-grid { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
      @media (min-width: 1100px) { .frentes-grid { grid-template-columns: repeat(3, 1fr); } }
      .frente-card { padding: clamp(1.75rem, 2.2vw, 2.25rem); border-radius: var(--radius-card); background: #fff; border: 1px solid var(--hairline); transition: var(--t-smooth); }
      .frente-card:hover { transform: translateY(-4px); box-shadow: 0 22px 44px rgba(0,0,0,.06); border-color: rgba(0,0,0,.14); }
      .frente-card .f-icon { width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; background: rgba(254,209,54,.14); color: var(--accent-deep); font-size: 1.5rem; }
      .frente-card .f-name { font-size: 1.22rem; font-weight: 600; letter-spacing: -.02em; margin-top: 1.25rem; }
      .frente-card .f-desc { font-size: .94rem; line-height: 1.6; color: var(--text-muted); margin-top: .7rem; }

      /* listas (use / pense duas vezes) */
      .usecase { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
      @media (min-width: 900px) { .usecase { grid-template-columns: 1fr 1fr; gap: 1.5rem; } }
      .usecase-card { padding: clamp(1.85rem, 2.6vw, 2.4rem); border-radius: var(--radius-card); border: 1px solid var(--hairline); background: #fff; }
      .usecase-card.warn { background: var(--data-ink-2); border-color: rgba(255,255,255,.12); color: #fff; }
      .usecase-card .uc-h { display: inline-flex; align-items: center; gap: .55rem; font-size: 1.2rem; font-weight: 600; letter-spacing: -.02em; }
      .usecase-card .uc-h iconify-icon { font-size: 1.4rem; color: var(--accent-deep); }
      .usecase-card.warn .uc-h iconify-icon { color: var(--accent); }
      .usecase-card ul { list-style: none; margin: 1.4rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
      .usecase-card li { display: flex; gap: .7rem; font-size: 1rem; line-height: 1.55; color: var(--text-muted); }
      .usecase-card.warn li { color: rgba(255,255,255,.74); }
      .usecase-card li iconify-icon { font-size: 1.1rem; color: var(--accent-deep); flex-shrink: 0; margin-top: .2rem; }
      .usecase-card.warn li iconify-icon { color: var(--accent); }

      /* erros comuns */
      .errors-grid { display: grid; grid-template-columns: 1fr; gap: .85rem; }
      @media (min-width: 720px) { .errors-grid { grid-template-columns: 1fr 1fr; } }
      .error-row { display: flex; gap: .9rem; padding: 1.3rem 1.4rem; border-radius: 16px; background: #fff; border: 1px solid var(--hairline); }
      .error-row iconify-icon { font-size: 1.3rem; color: var(--accent-deep); flex-shrink: 0; margin-top: .1rem; }
      .error-row .e-name { font-weight: 700; letter-spacing: -.01em; }
      .error-row .e-desc { font-size: .92rem; line-height: 1.5; color: var(--text-muted); margin-top: .3rem; }

      /* prova */
      .chips { display: flex; flex-wrap: wrap; gap: .5rem; }
      .chip { display: inline-flex; align-items: center; padding: .5rem 1rem; border-radius: var(--radius-pill); font-family: var(--font-mono); font-size: .68rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; background: rgba(255,255,255,.06); color: #fff; border: 1px solid rgba(255,255,255,.16); }
      .honesty { margin-top: 2.5rem; padding: 1.75rem 2rem; border-radius: var(--radius-card); border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.03); display: flex; gap: 1rem; align-items: flex-start; max-width: 64ch; }
      .honesty iconify-icon { color: var(--accent); font-size: 1.5rem; flex-shrink: 0; margin-top: .1rem; }
      .honesty p { font-size: 1rem; line-height: 1.6; color: rgba(255,255,255,.82); margin: 0; }

      /* faq */
      .faq-item { border-bottom: 1px solid var(--hairline); }
      .faq-item summary { list-style: none; cursor: pointer; padding: 1.6rem 0; display: flex; justify-content: space-between; align-items: center; gap: 2rem; font-size: 1.15rem; font-weight: 600; letter-spacing: -.01em; transition: color .3s; }
      .faq-item summary::-webkit-details-marker { display: none; }
      .faq-item summary:hover { color: var(--accent-deep); }
      .faq-item summary iconify-icon { transition: transform .4s var(--ease-out-expo); font-size: 1.5rem; color: var(--text-muted); flex-shrink: 0; }
      .faq-item[open] summary iconify-icon { transform: rotate(45deg); color: var(--accent-deep); }
      .faq-item .faq-body { padding: 0 0 1.6rem; color: var(--text-muted); max-width: 68ch; line-height: 1.65; }

      /* cta final */
      .cta-final { text-align: center; }
      .cta-final h2 { margin-inline: auto; max-width: 20ch; }
      .cta-final .lede { margin-inline: auto; }
      .cta-final .cta-row { justify-content: center; }

      /* reveal local */
      .reveal { opacity: 0; transform: translateY(2rem); transition: opacity .8s var(--ease-out-expo), transform .8s var(--ease-out-expo); }
      .reveal.active { opacity: 1; transform: none; }
      .d1 { transition-delay: .08s; } .d2 { transition-delay: .16s; } .d3 { transition-delay: .24s; } .d4 { transition-delay: .32s; }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
        .reveal { opacity: 1 !important; transform: none !important; }
        .dpr-scroll-cue .line { animation: none; }
      }
    </style>

