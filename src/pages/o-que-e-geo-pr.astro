         linhas, como uma frase citavel ganhando forma.
         ======================================================== */
      (function answerAssembling() {
        var canvas = document.getElementById('gp-hero-canvas');
        if (!canvas) {
          return;
        }
        var ctx = canvas.getContext('2d');
        if (!ctx) {
          canvas.style.background = 'radial-gradient(70% 90% at 72% 38%, #3a2606 0%, #160f06 55%, #0A0A0C 100%)';
          return;
        }
        var dpr = Math.min(window.devicePixelRatio || 1, 1.75);
        var W = 0, H = 0, t = 0;
        var tokens = [];
        var COUNT = 150;

        function rand(a, b) { return a + Math.random() * (b - a); }

        function build() {
          var rect = canvas.getBoundingClientRect();
          W = rect.width; H = rect.height;
          canvas.width = Math.max(1, Math.floor(W * dpr));
          canvas.height = Math.max(1, Math.floor(H * dpr));
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          // alvos: linhas de texto se formando no canto direito (a resposta).
          var lines = 5;
          var lineGapY = H * 0.072;
          var baseY = H * 0.34;
          var leftX = W * 0.46;
          tokens = [];
          for (var i = 0; i < COUNT; i++) {
            var li = i % lines;
            // cada linha tem largura propria, simulando texto justificado.
            var lineW = W * (0.30 + ((li * 0.11) % 0.34));
            var along = Math.random();
            var tx = leftX + along * lineW;
            var ty = baseY + li * lineGapY + rand(-2, 2);
            tokens.push({
              // posicao inicial: espalhada (o token solto, ainda nao citado).
              x: rand(0, W), y: rand(0, H),
              tx: tx, ty: ty,
              w: rand(7, 26), h: rand(3.5, 5.5),
              // fase de assentamento, ciclica, defasada por token.
              ph: Math.random(),
              sp: rand(0.045, 0.09),
              hue: rand(0, 1),
              line: li
            });
          }
        }
        build();

        function settleColor(s) {
          // do cinza-frio (token solto) ao ambar quente (frase citavel).
          var r = Math.round(110 + s * (255 - 110));
          var g = Math.round(116 + s * (176 - 116));
          var b = Math.round(130 + s * (32 - 130));
          return r + ',' + g + ',' + b;
        }

        function draw() {
          ctx.clearRect(0, 0, W, H);

          // veu de profundidade quente atras da "resposta".
          var grad = ctx.createRadialGradient(W * 0.72, H * 0.5, 0, W * 0.72, H * 0.5, W * 0.7);
          grad.addColorStop(0, 'rgba(60,40,8,.55)');
          grad.addColorStop(0.5, 'rgba(24,16,8,.2)');
          grad.addColorStop(1, 'rgba(10,10,12,0)');
          ctx.fillStyle = grad;
          ctx.fillRect(0, 0, W, H);

          for (var i = 0; i < tokens.length; i++) {
            var k = tokens[i];
            // s vai de 0 (solto) a 1 (assentado) e volta, em loop suave.
            var phase = (t * k.sp + k.ph) % 2;
            var s = phase < 1 ? phase : 2 - phase;
            var ease = s * s * (3 - 2 * s);

            var x = k.x + (k.tx - k.x) * ease;
            var y = k.y + (k.ty - k.y) * ease;

            // largura cresce ao assentar (vira "palavra").
            var w = k.w * (0.4 + 0.6 * ease);
            var alpha = 0.12 + 0.7 * ease;

            ctx.fillStyle = 'rgba(' + settleColor(ease) + ',' + alpha.toFixed(3) + ')';
            ctx.beginPath();
            roundRect(ctx, x, y - k.h / 2, w, k.h, k.h / 2);
            ctx.fill();

            // brilho do token quando quase assentado (fica citavel).
            if (ease > 0.82) {
              ctx.fillStyle = 'rgba(255,198,90,' + ((ease - 0.82) * 1.6).toFixed(3) + ')';
              ctx.beginPath();
              ctx.arc(x + w + 4, y, 1.5, 0, Math.PI * 2);
              ctx.fill();
            }
          }

          // cursor pulsante no fim da ultima linha (a resposta sendo escrita).
          var cy = H * 0.34 + 4 * (H * 0.072);
          var cx = W * 0.46 + W * 0.20;
          var blink = 0.4 + 0.6 * Math.abs(Math.sin(t * 1.6));
          ctx.fillStyle = 'rgba(255,176,32,' + blink.toFixed(3) + ')';
          ctx.fillRect(cx, cy - 7, 2, 14);

          t += prefersReduced ? 0 : 0.016;
          if (!prefersReduced) raf = requestAnimationFrame(draw);
        }

        function roundRect(c, x, y, w, h, r) {
          if (w < 2 * r) r = w / 2;
          c.moveTo(x + r, y);
          c.arcTo(x + w, y, x + w, y + h, r);
          c.arcTo(x + w, y + h, x, y + h, r);
          c.arcTo(x, y + h, x, y, r);
          c.arcTo(x, y, x + w, y, r);
        }

        window.addEventListener('resize', build, { passive: true });
        var raf;
        if (prefersReduced) {
          t = 0.5;
          draw();
        } else {
          raf = requestAnimationFrame(draw);
        }
      })();

      /* ========================================================
         DATAVIZ · fontes de autoridade -> resposta citada
         a imprensa cita fontes; a marca aparece nessa cobertura;
         a IA repete a afirmacao atribuivel. canvas 2D.
         ======================================================== */
      (function authorityFlow() {
        var canvas = document.getElementById('gp-network-canvas');
        if (!canvas) {
          return;
        }
        var ctx = canvas.getContext('2d');
        if (!ctx) {
          return;
        }
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0;
        var sources = ['Exame', 'Forbes', 'Valor', 'TechCrunch', 'Veja'];
        var srcNodes = [], brand = null, ai = null, pulses = [], hover = -1, mouse = { x: -1, y: -1 };

        function layout() {
          var rect = canvas.getBoundingClientRect();
          W = rect.width; H = rect.height;
          canvas.width = Math.floor(W * dpr); canvas.height = Math.floor(H * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          var lx = W * 0.18, n = sources.length;
          srcNodes = sources.map(function (name, i) {
            var y = H * (0.16 + (0.68 * i) / (n - 1));
            return { x: lx, y: y, name: name, r: 4.5 };
          });
          brand = { x: W * 0.54, y: H * 0.5, r: 9, name: 'Sua marca' };
          ai = { x: W * 0.86, y: H * 0.5, r: 7, name: 'Resposta da IA' };
        }
        layout();

        function spawn() {
          if (prefersReduced) return;
          var src = Math.floor(Math.random() * srcNodes.length);
          pulses.push({ src: src, seg: 0, p: 0, sp: 0.006 + Math.random() * 0.006 });
        }

        function lerp(a, b, t) { return a + (b - a) * t; }

        function bez(x0, y0, cx1, cy1, cx2, cy2, x1, y1, t) {
          var u = 1 - t;
          var x = u * u * u * x0 + 3 * u * u * t * cx1 + 3 * u * t * t * cx2 + t * t * t * x1;
          var y = u * u * u * y0 + 3 * u * u * t * cy1 + 3 * u * t * t * cy2 + t * t * t * y1;
          return { x: x, y: y };
        }

        function draw() {
          ctx.clearRect(0, 0, W, H);

          // arestas fonte -> marca
          srcNodes.forEach(function (pn, i) {
            var active = hover === i;
            ctx.beginPath();
            ctx.moveTo(pn.x, pn.y);
            ctx.bezierCurveTo(lerp(pn.x, brand.x, 0.5), pn.y, lerp(pn.x, brand.x, 0.5), brand.y, brand.x, brand.y);
            ctx.strokeStyle = active ? 'rgba(254,209,54,.55)' : 'rgba(255,255,255,.12)';
            ctx.lineWidth = active ? 1.6 : 1;
            ctx.stroke();
          });
          // aresta marca -> ia
          ctx.beginPath();
          ctx.moveTo(brand.x, brand.y);
          ctx.bezierCurveTo(lerp(brand.x, ai.x, 0.5), brand.y, lerp(brand.x, ai.x, 0.5), ai.y, ai.x, ai.y);
          ctx.strokeStyle = 'rgba(255,176,32,.35)';
          ctx.lineWidth = 1.4;
          ctx.stroke();

          // pulsos
          for (var k = pulses.length - 1; k >= 0; k--) {
            var pu = pulses[k];
            pu.p += pu.sp;
            var pos;
            if (pu.seg === 0) {
              var pn = srcNodes[pu.src];
              pos = bez(pn.x, pn.y, lerp(pn.x, brand.x, 0.5), pn.y, lerp(pn.x, brand.x, 0.5), brand.y, brand.x, brand.y, pu.p);
              if (pu.p >= 1) { pu.seg = 1; pu.p = 0; }
            } else {
              pos = bez(brand.x, brand.y, lerp(brand.x, ai.x, 0.5), brand.y, lerp(brand.x, ai.x, 0.5), ai.y, ai.x, ai.y, pu.p);
              if (pu.p >= 1) { pulses.splice(k, 1); continue; }
            }
            var col = pu.seg === 0 ? '254,209,54' : '255,176,32';
            ctx.beginPath(); ctx.arc(pos.x, pos.y, 2.6, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(' + col + ',.95)'; ctx.fill();
            ctx.beginPath(); ctx.arc(pos.x, pos.y, 6, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(' + col + ',.18)'; ctx.fill();
          }

          // nos de fonte + rotulos
          ctx.font = '600 11px "JetBrains Mono", monospace';
          ctx.textBaseline = 'middle';
          srcNodes.forEach(function (pn, i) {
            var active = hover === i;
            ctx.beginPath(); ctx.arc(pn.x, pn.y, pn.r + (active ? 1.5 : 0), 0, Math.PI * 2);
            ctx.fillStyle = active ? '#FED136' : '#9aa0aa'; ctx.fill();
            ctx.textAlign = 'right';
            ctx.fillStyle = active ? 'rgba(255,255,255,.95)' : 'rgba(255,255,255,.55)';
            ctx.fillText(pn.name, pn.x - 12, pn.y);
          });

          // no da marca (accent, anel pulsante)
          ctx.beginPath(); ctx.arc(brand.x, brand.y, brand.r, 0, Math.PI * 2);
          ctx.fillStyle = '#FED136'; ctx.fill();
          ctx.beginPath(); ctx.arc(brand.x, brand.y, brand.r + 6 + (Math.sin(Date.now() / 600) + 1) * 3, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(254,209,54,.35)'; ctx.lineWidth = 1; ctx.stroke();
          ctx.textAlign = 'center';
          ctx.fillStyle = 'rgba(255,255,255,.92)';
          ctx.fillText('Sua marca', brand.x, brand.y + brand.r + 16);

          // no da ia
          ctx.beginPath(); ctx.arc(ai.x, ai.y, ai.r, 0, Math.PI * 2);
          ctx.fillStyle = '#FFB020'; ctx.fill();
          ctx.textAlign = 'center';
          ctx.fillStyle = 'rgba(255,255,255,.92)';
          ctx.fillText('Resposta da IA', ai.x, ai.y + ai.r + 16);

          requestAnimationFrame(draw);
        }

        canvas.addEventListener('mousemove', function (e) {
          var rect = canvas.getBoundingClientRect();
          mouse.x = e.clientX - rect.left; mouse.y = e.clientY - rect.top;
          hover = -1;
          for (var i = 0; i < srcNodes.length; i++) {
            var pn = srcNodes[i];
            if (Math.hypot(pn.x - mouse.x, pn.y - mouse.y) < 26) { hover = i; break; }
          }
        });
        canvas.addEventListener('mouseleave', function () { hover = -1; });
        window.addEventListener('resize', layout, { passive: true });

        if (prefersReduced) {
          layout();
          draw();
        } else {
          setInterval(spawn, 850);
          spawn();
          requestAnimationFrame(draw);
        }
      })();
    });
  </script>
</BaseLayout>
