---
// ============================================================================
// Narrativa espetacular · O QUE E GEO PR
// Conteudo voice-backed portado de:
//   src/content/pages/o-que-e-geo-pr.md
// Original preservado. Esta pagina e a versao "narrativa espetacular":
// heroi canvas 2D (a resposta da IA se montando: tokens e fragmentos se
// juntando para formar uma frase citavel, ambar suave) + dataviz de
// fontes de autoridade que viram resposta citada + scroll storytelling
// (GSAP/Lenis) sobre o DS da PiaR. Angulo introdutorio: "o que e GEO PR".
// ============================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import { site } from '@/data/site';

const url = `${site.domain}/o-que-e-geo-pr`;

// As tres camadas: SEO / GEO / GEO PR (a fonte do sinal e o que separa).
const camadas = [
  {
    id: 'SEO',
    nome: 'Search Engine Optimization',
    otimiza: 'A sua própria página, para ranquear no buscador tradicional.',
    metrica: 'Posição e clique',
    sinal: 'O seu domínio',
    icon: 'solar:magnifer-line-duotone',
  },
  {
    id: 'GEO',
    nome: 'Generative Engine Optimization',
    otimiza: 'O conteúdo do seu próprio domínio, para ser citável pela IA.',
    metrica: 'A citação',
    sinal: 'O seu domínio',
    icon: 'solar:chat-square-code-line-duotone',
  },
  {
    id: 'GEO PR',
    nome: 'GEO operado por relações públicas',
    otimiza: 'O que terceiros de autoridade dizem sobre você.',
    metrica: 'A citação',
    sinal: 'Imprensa e especialistas',
    icon: 'solar:cpu-bolt-line-duotone',
    featured: true,
  },
];

// O framework de quatro passos (espelha as quatro etapas da PiaR).
const passos = [
  {
    num: '01',
    titulo: 'Medir a presença atual em IA',
    prazo: 'Linha de base',
    desc: 'Montamos as perguntas que o seu público de fato faria a um assistente, rodamos essas perguntas nos principais motores generativos e registramos se a marca aparece, em que posição, com que frase e ao lado de quais concorrentes. Esse é o diagnóstico que vira ponto de partida.',
  },
  {
    num: '02',
    titulo: 'Estruturar a sala de imprensa e os dados',
    prazo: 'Arrumar a casa',
    desc: 'Descrição factual e consistente da empresa em todo lugar onde ela aparece, dados que não se contradigam entre site, redes e materiais, e schema para organização, pessoas-chave e fatos verificáveis. Entidade consistente dá menos margem para a IA errar ou ignorar você.',
  },
  {
    num: '03',
    titulo: 'Transformar cobertura em citação',
    prazo: 'Ativação editorial',
    desc: 'Nem toda cobertura vira citação. O que vira é a menção factual e atribuível: a marca nomeada em contexto claro, em veículo que o modelo trata como confiável, com dado ou posição associada. É o oposto do disparo de release em massa.',
  },
  {
    num: '04',
    titulo: 'Monitorar e iterar',
    prazo: 'Ciclo contínuo',
    desc: 'Com a linha de base do passo 1, repetimos as mesmas perguntas em cadência fixa e observamos o que mudou. Cruzamos isso com a cobertura conquistada para entender qual menção moveu o ponteiro. Medição contínua, não foto única.',
  },
];

// As cinco frentes / capacidades que GEO PR coloca em jogo.
const frentes = [
  {
    nome: 'Diagnóstico de presença em IA',
    desc: 'Mapeamos as perguntas que decidem a compra no seu mercado, perguntamos a elas nos mecanismos generativos e medimos onde a marca aparece, onde não aparece e quem a IA cita no seu lugar.',
    icon: 'solar:chart-2-line-duotone',
  },
  {
    nome: 'Sala de imprensa legível para a máquina',
    desc: 'Uma sala de imprensa serve tanto para o jornalista quanto para o modelo que lê a sua página. Entidade consistente, dados sem contradição e schema correto reduzem o ruído que faz marcas sumirem das respostas.',
    icon: 'solar:server-square-line-duotone',
  },
  {
    nome: 'Cobertura que vira menção atribuível',
    desc: 'Pauta e relacionamento com a imprensa para mapear veículo e jornalista certos, construir ângulo de dado e garantir que a marca apareça nomeada e em contexto. A unidade de valor para a IA não é o link, é a afirmação atribuível.',
    icon: 'solar:document-text-line-duotone',
  },
  {
    nome: 'Representação correta da marca',
    desc: 'Monitoramento de como ChatGPT, Gemini e os resumos generativos descrevem a sua empresa e os seus porta-vozes, e plano de resposta quando a representação está errada ou desatualizada.',
    icon: 'solar:shield-check-line-duotone',
  },
  {
    nome: 'Revisão jurídica antes de publicar',
    desc: 'A revisão jurídica de todos os ativos, parte do nosso processo, importa ainda mais quando a afirmação pode ser reproduzida por um modelo em escala. Nada vai a público sem passar por ela.',
    icon: 'solar:scale-line-duotone',
  },
];

const exits = site.exits;
const clientes = ['Sambatech', 'Liga Ventures', 'Printi', 'Doctoralia', 'Solides', 'Corning', 'PagBrasil', 'Sidia', 'FluencyPass', 'Unlimitail'];

const faq = [
  {
    q: 'O que significa GEO PR?',
    a: 'GEO PR é Generative Engine Optimization aplicada a relações públicas: o trabalho de estruturar imprensa, conteúdo e dados para que a marca seja citada nas respostas de inteligência artificial, e não apenas listada em buscadores.',
  },
  {
    q: 'Qual a diferença entre GEO PR e SEO?',
    a: 'SEO otimiza páginas do seu próprio site para ranquear em buscadores, e a métrica é posição e clique. GEO PR trabalha o que fontes externas de autoridade, como a imprensa, dizem sobre a sua marca, e a métrica é a citação dentro de respostas geradas por IA. SEO atua sobre o seu domínio; GEO PR atua sobre o que terceiros confiáveis afirmam sobre você.',
  },
  {
    q: 'Qual a diferença entre GEO PR e GEO?',
    a: 'GEO é o conceito amplo de otimizar presença para motores generativos, focado principalmente no conteúdo do próprio domínio. GEO PR é o recorte operado por relações públicas, que constrói o sinal externo: menção em mídia de autoridade. As duas práticas se somam.',
  },
  {
    q: 'Por que menção na imprensa importaria mais que backlink para a IA?',
    a: 'É uma tese de mercado, não um fato fechado. A leitura é que modelos de linguagem reproduzem afirmações atribuíveis de fontes que tratam como confiáveis. Uma menção nominal e factual em veículo de autoridade é texto que tende a sobreviver à síntese de uma resposta, enquanto o backlink é um sinal de busca que move ranking, mas não vira frase gerada. Números que quantifiquem esse peso variam por método e por isso não os tratamos como universais.',
  },
  {
    q: 'Como medir a presença da minha marca em IA?',
    a: 'Monte as perguntas que o seu público faria a um assistente, rode essas perguntas nos principais motores generativos e registre se a marca aparece, em que posição, com que frase e ao lado de quais concorrentes. Isso vira linha de base e se repete em cadência fixa para medir movimento.',
  },
  {
    q: 'Disparo de release ajuda em GEO PR?',
    a: 'Não da forma como costuma ser feito. Disparo de release em massa produz volume sem afirmação nominal e atribuível, que é justamente o material que a IA usa para citar. GEO PR depende de menção factual, em contexto e em veículo certo, o que exige relacionamento com a imprensa, não envio em escala.',
  },
  {
    q: 'GEO PR substitui o trabalho de assessoria de imprensa tradicional?',
    a: 'Não. É uma extensão dele. O relacionamento com a imprensa continua sendo o ponto de partida. GEO PR adiciona a leitura de como essa cobertura se converte em citação por IA e a medição contínua dessa presença.',
  },
];
---
<BaseLayout
  title="O que é GEO PR: ser citável dentro da resposta da IA"
  description="GEO PR é estruturar relações com a imprensa para que marcas sejam citadas pelas respostas de IA, e não só listadas em uma página de busca. Guia introdutório pela ótica de relações públicas."
  canonical={url}
>
  <Fragment slot="head">
    <style is:global>
      :root {
        --accent: #FED136;
        --accent-deep: #E0B420;
        --paper-warm: #F4F1EA;
        --geo-ink: #0A0A0C;
        --geo-ink-2: #141417;
        --geo-amber: #FFB020;
        --geo-amber-soft: #FFC65A;
        --geo-honey: #F0A028;
        --radius-card: 24px;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 700; }
      body { font-family: var(--font-sans); background: var(--paper); color: var(--primary); overflow-x: hidden; -webkit-font-smoothing: antialiased; font-feature-settings: "ss01", "cv11"; }

      #scroll-progress { position: fixed; top: 0; left: 0; height: 2px; background: var(--accent); z-index: 9999; width: 0; transition: width .1s linear; }

      .wrap { max-width: 1280px; margin: 0 auto; padding-inline: 1.5rem; position: relative; z-index: 1; }
      @media (min-width: 768px) { .wrap { padding-inline: 2rem; } }

      .eyebrow { display: inline-flex; align-items: center; gap: .6rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; color: var(--text-muted); font-weight: 600; }
      .eyebrow::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex-shrink: 0; box-shadow: 0 0 0 4px rgba(254,209,54,.18); }
      .eyebrow.on-dark { color: rgba(255,255,255,.72); }

      .accent-serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--accent-deep); letter-spacing: -.02em; }
      .accent-serif.on-dark { color: var(--accent); }

      /* botoes */
      .btn { display: inline-flex; align-items: center; gap: .55rem; padding: .9rem 1.7rem; border-radius: var(--radius-btn); font-size: .95rem; font-weight: 600; letter-spacing: -.01em; text-decoration: none; transition: var(--t-smooth); cursor: pointer; border: 1.5px solid transparent; }
      .btn iconify-icon { transition: transform .4s var(--ease-out-expo); }
      .btn:hover iconify-icon { transform: translateX(4px); }
      .btn-accent { background: var(--accent); color: var(--primary); border-color: var(--accent); }
      .btn-accent:hover { background: #FFD84A; transform: translateY(-2px); box-shadow: 0 16px 32px rgba(254,209,54,.32); }
      .btn-ghost-d { background: transparent; color: #fff; border-color: rgba(255,255,255,.25); }
      .btn-ghost-d:hover { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.5); }
      .btn-ghost { background: transparent; color: var(--primary); border-color: rgba(0,0,0,.16); }
      .btn-ghost:hover { background: rgba(0,0,0,.04); border-color: rgba(0,0,0,.32); }

      /* ===========================================================
         1 · HERO · a resposta da IA se montando (canvas 2D, ambar)
         =========================================================== */
      .gp-hero { position: relative; min-height: 100vh; min-height: 100svh; background: var(--geo-ink); color: #fff; overflow: hidden; display: flex; align-items: center; isolation: isolate; }
      #gp-hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; display: block; }
      .gp-hero .scrim { position: absolute; inset: 0; z-index: 1; pointer-events: none;
        background:
          radial-gradient(120% 90% at 16% 38%, rgba(10,10,12,.84) 0%, rgba(10,10,12,.38) 46%, rgba(10,10,12,0) 72%),
          linear-gradient(180deg, rgba(10,10,12,.5) 0%, rgba(10,10,12,0) 30%, rgba(10,10,12,.2) 74%, rgba(10,10,12,.92) 100%);
      }
      .gp-hero .hero-inner { position: relative; z-index: 2; width: 100%; padding-block: 9rem 4rem; }
      .gp-hero-chip { display: inline-flex; align-items: center; gap: .5rem; padding: .5rem 1rem; border-radius: var(--radius-pill); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(6px); font-family: var(--font-mono); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.78); }
      .gp-hero-chip .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px 1px rgba(254,209,54,.7); }
      .gp-hero h1 { font-size: clamp(2.8rem, 8vw, 7.6rem); font-weight: 700; line-height: .93; letter-spacing: -.045em; margin: 1.6rem 0 0; max-width: 18ch; text-wrap: balance; }
      .gp-hero .sub { font-size: clamp(1.1rem, 1.7vw, 1.4rem); line-height: 1.5; color: rgba(255,255,255,.74); margin-top: 1.75rem; max-width: 48ch; }
      .gp-hero .cta-row { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2.5rem; }
      .gp-scroll-cue { position: absolute; left: 50%; bottom: 1.75rem; transform: translateX(-50%); z-index: 2; display: inline-flex; flex-direction: column; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .6rem; letter-spacing: .2em; text-transform: uppercase; color: rgba(255,255,255,.5); }
      .gp-scroll-cue .line { width: 1px; height: 38px; background: linear-gradient(180deg, rgba(255,255,255,.5), transparent); animation: cuePulse 2.2s var(--ease-out-expo) infinite; }
      @keyframes cuePulse { 0%,100% { opacity: .3; transform: scaleY(.7); transform-origin: top; } 50% { opacity: 1; transform: scaleY(1); } }

      /* parallax de profundidade */
      .px { will-change: transform; }
      .has-ghost { overflow: hidden; }
      .ghost-mark { position: absolute; z-index: 0; font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: clamp(7rem, 24vw, 24rem); line-height: .78; letter-spacing: -.04em; color: rgba(15,15,17,.045); pointer-events: none; user-select: none; white-space: nowrap; }
      .section.dark .ghost-mark { color: rgba(255,255,255,.04); }
      .ghost-mark.tr { top: -2rem; right: -1.5rem; }
      .ghost-mark.bl { bottom: -3rem; left: -2rem; }
      .gp-hero-float { position: absolute; z-index: 2; display: inline-flex; align-items: center; gap: .5rem; padding: .55rem 1rem; border-radius: var(--radius-pill); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(6px); font-family: var(--font-mono); font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.72); }
      .gp-hero-float .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--geo-amber); box-shadow: 0 0 8px 1px rgba(255,176,32,.7); }
      .gp-hero-float.f1 { right: 9%; top: 26%; }
      .gp-hero-float.f2 { right: 17%; bottom: 22%; }
      @media (max-width: 900px) { .gp-hero-float { display: none; } .ghost-mark { font-size: clamp(6rem, 30vw, 12rem); } }

      /* Tres Mares · contorno topografico (terreno de autoridade) */
      .has-contour { overflow: hidden; }
      .contour-field {
        position: absolute; inset: -14% -10%; z-index: 0; pointer-events: none;
        --contour-line: rgba(255,176,32,.10);
        background: repeating-radial-gradient(circle at 72% 38%, transparent 0 48px, var(--contour-line) 48px 49px);
        -webkit-mask-image: radial-gradient(circle at 72% 38%, #000 0%, rgba(0,0,0,.55) 42%, transparent 78%);
                mask-image: radial-gradient(circle at 72% 38%, #000 0%, rgba(0,0,0,.55) 42%, transparent 78%);
        will-change: transform;
      }
      @media (max-width: 760px) { .contour-field { opacity: .6; } }

      /* ===========================================================
         secoes base
         =========================================================== */
      .section { padding-block: var(--sec-pad); position: relative; }
      .section.paper { background: var(--paper); border-top: 1px solid var(--hairline); }
      .section.warm { background: var(--paper-warm); border-top: 1px solid var(--hairline); }
      .section.dark { background: var(--geo-ink); color: #fff; border-top: 1px solid rgba(255,255,255,.06); }
      .section h2 { font-size: clamp(2.1rem, 4.6vw, 4rem); font-weight: 600; line-height: 1.03; letter-spacing: -.035em; margin: 1rem 0 0; max-width: 20ch; text-wrap: balance; }
      .section.dark h2 { color: #fff; }
      .lede { font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.55; color: var(--text-muted); margin-top: 1.5rem; max-width: 58ch; }
      .section.dark .lede { color: rgba(255,255,255,.72); }
      .sec-head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }

      /* compare 2 colunas (a virada) */
      .compare { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
      @media (min-width: 900px) { .compare { grid-template-columns: 1fr 1fr; gap: 1.5rem; } }
      .compare-card { padding: clamp(2rem, 3vw, 2.75rem); border-radius: var(--radius-card); border: 1px solid var(--hairline); background: #fff; min-height: 280px; display: flex; flex-direction: column; }
      .compare-card .ctag { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--text-faint); }
      .compare-card h3 { font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 600; letter-spacing: -.025em; margin: .9rem 0 0; line-height: 1.1; }
      .compare-card p { font-size: 1.0625rem; line-height: 1.6; color: var(--text-muted); margin-top: 1rem; }
      .compare-card .steps { margin-top: auto; padding-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; color: var(--text-faint); }
      .compare-card .steps iconify-icon { color: var(--accent-deep); }
      .compare-card.is-dark { background: var(--geo-ink-2); border-color: rgba(255,255,255,.12); color: #fff; }
      .compare-card.is-dark .ctag { color: rgba(255,255,255,.45); }
      .compare-card.is-dark p { color: rgba(255,255,255,.72); }
      .compare-card.is-dark .steps { color: rgba(255,255,255,.5); }
      .compare-card.is-dark .steps iconify-icon { color: var(--accent); }
      .punch { font-family: var(--font-serif); font-style: italic; font-size: clamp(1.6rem, 3.4vw, 2.9rem); line-height: 1.18; letter-spacing: -.02em; margin-top: clamp(2.5rem, 5vw, 3.5rem); max-width: 24ch; }
      .punch .hl { color: var(--accent-deep); font-style: italic; }
      .section.dark .punch .hl { color: var(--accent); }

      /* camadas SEO/GEO/GEO PR */
      .layers { display: grid; grid-template-columns: 1fr; gap: 1rem; }
      @media (min-width: 980px) { .layers { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; } }
      .layer-card { position: relative; padding: clamp(1.75rem, 2.4vw, 2.25rem); border-radius: var(--radius-card); border: 1px solid var(--hairline); background: #fff; overflow: hidden; transition: var(--t-smooth); }
      .layer-card:hover { transform: translateY(-4px); box-shadow: 0 24px 48px rgba(0,0,0,.07); border-color: rgba(0,0,0,.14); }
      .layer-card .l-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: rgba(15,15,17,.05); color: var(--primary); font-size: 1.4rem; }
      .layer-card .l-id { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text-faint); margin-top: 1.25rem; }
      .layer-card .l-name { font-size: 1.4rem; font-weight: 600; letter-spacing: -.025em; margin-top: .3rem; line-height: 1.12; }
      .layer-card .l-otimiza { font-size: 1rem; line-height: 1.55; color: var(--text-muted); margin-top: .85rem; }
      .layer-card .l-meta { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--hairline); display: flex; flex-direction: column; gap: .55rem; }
      .layer-card .l-meta .row { display: flex; justify-content: space-between; gap: 1rem; font-size: .82rem; }
      .layer-card .l-meta .k { font-family: var(--font-mono); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: var(--text-faint); }
      .layer-card .l-meta .v { font-weight: 600; text-align: right; letter-spacing: -.01em; }
      .layer-card.featured { background: var(--geo-ink); color: #fff; border-color: var(--geo-ink); }
      .layer-card.featured::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(90% 60% at 80% 0%, rgba(255,176,32,.22) 0%, transparent 60%), radial-gradient(70% 50% at 10% 100%, rgba(254,209,54,.14) 0%, transparent 60%); }
      .layer-card.featured .l-icon { background: rgba(255,255,255,.08); color: var(--accent); position: relative; z-index: 1; }
      .layer-card.featured .l-id { color: var(--accent); position: relative; z-index: 1; }
      .layer-card.featured .l-name, .layer-card.featured .l-otimiza { position: relative; z-index: 1; }
      .layer-card.featured .l-otimiza { color: rgba(255,255,255,.75); }
      .layer-card.featured .l-meta { border-color: rgba(255,255,255,.16); position: relative; z-index: 1; }
      .layer-card.featured .l-meta .k { color: rgba(255,255,255,.5); }
      .layer-card.featured .badge { position: absolute; top: 1.25rem; right: 1.25rem; z-index: 1; font-family: var(--font-mono); font-size: .58rem; letter-spacing: .14em; text-transform: uppercase; color: var(--primary); background: var(--accent); padding: .3rem .6rem; border-radius: var(--radius-pill); font-weight: 700; }

      /* ===========================================================
         DATAVIZ · fontes de autoridade -> resposta citada (canvas)
         =========================================================== */
      .viz-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center; }
      @media (min-width: 1024px) { .viz-grid { grid-template-columns: 1.05fr 1fr; gap: 3.5rem; } }
      .viz-stage { position: relative; aspect-ratio: 4 / 3; width: 100%; border-radius: var(--radius-card); overflow: hidden; background: linear-gradient(160deg, #141417 0%, #0A0A0C 70%); border: 1px solid rgba(255,255,255,.1); }
      #gp-network-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
      .viz-legend { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; margin-top: 1.5rem; }
      .viz-legend .li { display: inline-flex; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .04em; text-transform: uppercase; color: rgba(255,255,255,.6); }
      .viz-legend .sw { width: 12px; height: 12px; border-radius: 50%; }

      /* passos (framework) */
      .steps-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
      @media (min-width: 720px) { .steps-grid { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
