          fBottom = rf.bottom; fTopo = rf.top; fAlt = rf.height || 1;
        }
        /* ---- A ATERRISSAGEM -------------------------------------------------
           A pista e a LINHA onde o filme preto acaba e o rodape branco comeca,
           nunca a beira da tela. A massa desce com o S; a linha branca sobe com o
           scroll ate encostar nela; do toque em diante a bola anda COLADA na linha,
           sempre com metade aparecendo, e corre para o centro, onde estaciona.
           Como ela so nao pode passar por baixo da linha (o min abaixo), o pouso
           acontece sozinho, sem numero magico de scroll e em qualquer altura de tela.
           O alinhamento comeca um pouco antes do toque (LAND_LEAD), entao ela ja
           chega planando para o lugar em vez de virar de lado depois de pousar. */
        var LAND_LEAD = 0.40, LAND_SPAN = 0.60, coreRNow = 0;
        function landedPos(base) {
