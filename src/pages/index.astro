        /* ---- CORREDOR DA MASSA ---------------------------------------------
           A massa ORBITA o bloco de conteudo pelas margens vazias da pagina, alternando
           os lados: desce pela direita, cruza, sobe pela esquerda, e assim por diante ate
           estacionar no centro, na linha do rodape. O trajeto nao foi inventado aqui: foi
           desenhado a mao em cima do print da home inteira (outputs/home-full-ball-animation-path.png)
           e lido ponto a ponto de la (ver ORBITA).
           Duas medidas continuam vivas no layout, nunca chutadas: as margens em que a
           orbita cabe (ela e reencaixada nelas em cada largura de tela) e a borda do
           conteudo na altura da bola, que empurra a bola para fora se o trajeto a jogaria
           em cima de texto. A POEIRA nao tem essa regra: ela orbita a bola e passa por
           onde a bola passa.
           Fallback: se a tela e estreita demais para haver margem (texto ocupando a
           largura toda), volta o recorte por zona de leitura, que e o unico jeito de
           manter o texto legivel quando nao ha espaco livre nenhum. */
        var COL_SEL = 'main .f-h2, main .f-lede, main .f-eyebrow, main .exit-chip, main .f-cta';
        var GAP = 28, EDGE = 34, MIN_MARGEM = 150;
        var corr = false;          // ha margem para orbitar? senao, cai no recorte antigo
        var colEls = [];
        function measureCorridor() {
          colEls = document.querySelectorAll(COL_SEL);
          var right = 0, left = 1e9;
          for (var ci0 = 0; ci0 < colEls.length; ci0++) {
            var rc0 = colEls[ci0].getBoundingClientRect();
            if (rc0.width < 2) continue;
            if (rc0.right > right) right = rc0.right;
            if (rc0.left < left) left = rc0.left;
          }
          // a coluna real do conteudo, para reencaixar o desenho nesta largura de tela.
          // tem de ser a coluna PADRAO: a .narrow (a voz, o clima) e mais estreita e
          // esticaria as margens, jogando a orbita para dentro da pagina.
          var fw = document.querySelector('.film .fwrap:not(.narrow)');
          if (fw) { var rf0 = fw.getBoundingClientRect(); colL = rf0.left; colR = rf0.right; }
          else { colL = (W - Math.min(1240, W)) / 2; colR = W - colL; }
