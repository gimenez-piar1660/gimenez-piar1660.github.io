        // lupa: os headlines do filme que a massa atravessa e acende
        var lensEls = document.querySelectorAll('.f-h2');

        /* A POEIRA ORBITA A MASSA. Antes ela era um campo espalhado pela tela, atraido
           pelo nucleo e recortado numa faixa. Agora cada particula tem raio, angulo e
           velocidade proprios em volta do nucleo: a nuvem viaja junto com a bola, entao
           nao precisa de recorte nenhum e nunca se desgarra dela. Ela pode passar por
           cima de texto; a regra de nao encostar vale so para a bola. */
        var N = 150, parts = [];
