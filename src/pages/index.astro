           As caixas sao remedidas so quando o scroll ou o resize sujam o cache. */
        var READ_SEL = ['h1', 'h2', 'h3', '.f-eyebrow', '.f-lede', '.n-title', '.n-sub', '.sn', '.sl', '.exit-chip', '.lp'];
        var CARD_SEL = '.corpo-card, .forca, .board-card, .leader, .pep-vetor, .btn, .beam-btn, .glass-hero';
        var PAD = 14, FEATHER = 30;
        var FADE = [0.10, 0.14, 0.2, 0.28, 0.4, 0.55, 0.75, 0.9];   // rampa da borda macia
        var readEls = [], readRects = [], readDirty = true;

        function collectRead() {
