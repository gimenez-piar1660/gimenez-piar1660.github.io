        // scroll e a massa so aparece depois dele.
        var filmProg = document.querySelector('.film');
        var fp = 0, fBottom = 0, fTopo = 0, fAlt = 1;
        function readFilm() {
          if (!filmProg) { fp = scrollP; fBottom = H; fTopo = 0; fAlt = 1; return; }
          var rf = filmProg.getBoundingClientRect(), spanF = rf.height - H;
          var pf = spanF > 0 ? -rf.top / spanF : 0;
