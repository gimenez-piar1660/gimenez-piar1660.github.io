---
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import CampoGravitacional from '@components/CampoGravitacional.astro';
import { site } from '@/data/site';
import { withBase } from '@/lib/base';

// O campo gravitacional (a massa que viaja pela pagina) esta DESLIGADO: o trajeto
// desenhado exigia deslocamentos horizontais rapidos demais e a bola nao ficou fluida,
// empacando ou saltando entre quadros durante a rolagem. A home roda limpa sem ele.
// Para religar: true aqui. O componente carrega junto o canvas, o CSS e o script, e
// as faixas claras voltam a ser pintadas por ele. Nada mais precisa mudar.
const CAMPO_GRAVITACIONAL = false;

// HOME · "A gravidade da marca" (espinha aprovada por Danilo em 2026-06-25).
// O filme e da VOZ (PR / assessoria de imprensa); a gravidade reforca a voz, e a
// IA fica so no fundo. Hero de video claro recortado, e o filme escuro em seguida.
// Branco e preto as vezes, como na Sobre: a voz, a prova e o metodo sao faixas claras;
// corpos, forcas, PEP, lideranca e climax sao escuros.
// O campo gravitacional (a massa que viajava por tras de tudo) esta desligado: ver a
// flag no topo e src/components/CampoGravitacional.astro.
// Fatos travados em site.ts: 13 anos, desde 2013, 470+ marcas, exits nomeados,
// premio ABStartups 2018, Bruno Pinheiro CEO. Sem travessao, acentos pt-BR completos
// inclusive no JSON-LD. Voz de primeira pessoa do plural, sem "a gente".

// Logos com asset PNG no repo (/brand/clients). Loop seamless do marquee.
const clienteLogos = [
  'sambatech', 'liga-ventures', 'printi', 'qranio',
  'unifisa', 'livup', 'investidores-vc', 'inovativa',
  'wylinka', 'doctoralia', 'unlimitail',
  'sidia', 'corning', 'fluencypass',
  'solides', 'layer-up', 'pagbrasil',
];

// Os corpos que a gravidade puxa (o mercado). Beneficio antes do nome.
const corpos = [
  { ic: 'solar:cart-check-line-duotone', t: 'O comprador', d: 'Chega convencido, e a venda fecha com menos objeção. A reputação trabalha antes da reunião.' },
  { ic: 'solar:chart-2-line-duotone', t: 'O investidor', d: 'Valida a empresa porque o mercado já fala dela. Confiança pública abre a mesa.' },
  { ic: 'solar:crown-line-duotone', t: 'A liderança', d: 'O fundador vira referência do setor, procurado pela imprensa pelo nome dele.' },
  { ic: 'solar:users-group-rounded-line-duotone', t: 'O talento', d: 'As pessoas certas querem entrar onde a marca já é uma referência.' },
];

// As sete forcas que geram a massa (servicos canonicos), agrupadas por funcao.
const forcas = [
  { g: 'A pauta', ic: 'solar:document-add-line-duotone', t: 'Relações Públicas', d: 'A citação primária: pauta e cobertura nos veículos que decidem o seu mercado.', href: '/relacoes-publicas' },
  { g: 'A pauta', ic: 'solar:routing-3-line-duotone', t: 'Comunicação Integrada', d: 'As frentes conduzidas como um sistema só, cada peça puxando a próxima até o mercado ouvir uma mensagem inteira.', href: '/comunicacao-integrada' },
  { g: 'A presença', ic: 'solar:shield-network-line-duotone', t: 'Reputação Semântica', d: 'Como a marca aparece na busca, na mídia e na resposta da IA. Monitorar mostra o retrato; nós reescrevemos o que está dito sobre você.', href: '/reputacao' },
  { g: 'A presença', ic: 'solar:chart-2-line-duotone', t: 'GEO Consulting', d: 'Faz a marca ser citada por ChatGPT, Gemini e Perplexity quando perguntam do seu mercado.', href: '/geo' },
  { g: 'A voz', ic: 'solar:microphone-line-duotone', t: 'Media Training', d: 'Autoridade no porta-voz até a imprensa procurar ele pelo nome, com a frase certa pronta para virar manchete.', href: '/media-training' },
  { g: 'A voz', ic: 'solar:pen-new-square-line-duotone', t: 'Ghostwriting', d: 'A experiência do executivo vira artigo, post e palco, sempre na voz dele.', href: '/ghostwriting' },
];

// PEP: seis vetores editoriais. Menção honrosa própria na home; página completa em /pep.
const vetores = ['Palco', 'Conversa', 'Narrativa', 'Cadência', 'Alcance', 'Veículo'];

// Exits nomeados: fonte única em site.exits. Nunca redeclarar a lista aqui.
const exits = site.exits;

// Prova. Numeros com lastro em site.ts. Contador anima, mas o numero ja vem no texto (paridade IA).
const provas = [
  { n: site.yearsOperating, suf: '', tail: ' anos', l: 'Comunicando inovação desde ' + site.foundingYear + ', em São Paulo.' },
  { n: 470, suf: '+', tail: '', l: 'Marcas que confiaram sua reputação à PiaR ao longo dessa trajetória.' },
  { n: site.exitsSupported, suf: '', tail: '', l: 'Startups acompanhadas da primeira pauta ao exit.' },
];

// Quem lidera. FOTOS REAIS (mesmas de /sobre). Bruno tem a webp espelhada: flip corrige.
const lideranca = [
  { nome: site.founder.name, papel: 'Fundador e CEO', foto: '/brand/Brunotrofeu.webp', flip: true, desc: 'Dirige a estratégia desde 2013. Eleito profissional de imprensa no Startup Awards da ABStartups, em 2018.' },
  { nome: 'Renniê Paro', papel: 'COO', foto: '/brand/team/rennie.png', flip: false, desc: 'Responde pela operação e por manter a mesma qualidade de entrega em todas as frentes da casa.' },
  { nome: 'Gabriela Calencautcy', papel: 'Projetos Especiais', foto: '/brand/team/gabriela.png', flip: false, desc: 'Conduz o PEP e os trabalhos que vão além da cobertura de imprensa.' },
];

// PiaRBoard: o dashboard proprietario (a "caixa-preta aberta"). Dados reais da proposta (Adaflow, slides 6 e 7).
const piarboard = [
  { ic: 'solar:clock-circle-line-duotone', t: 'Acompanhamento em tempo real', d: 'Você vê os resultados no instante em que acontecem, sem esperar o relatório do mês.' },
  { ic: 'solar:chart-2-line-duotone', t: 'Métricas detalhadas', d: 'Alcance, engajamento e impacto de cada publicação, abertos número a número.' },
  { ic: 'solar:radar-2-line-duotone', t: 'Monitoramento de mídia', d: 'Onde a sua marca está sendo mencionada, no momento em que a menção sai.' },
  { ic: 'solar:tuning-2-line-duotone', t: 'Otimização contínua', d: 'A estratégia se ajusta com base em dado real, não em achismo.' },
  { ic: 'solar:graph-up-line-duotone', t: 'Gráficos interativos', d: 'Cada número é clicável, do panorama ao detalhe de uma publicação.' },
  { ic: 'solar:filter-line-duotone', t: 'Filtros que importam', d: 'Os resultados, filtráveis por veículo, mídia e audiência.' },
];

// Servicos para o JSON-LD (ItemList de Service). provider por @id (nao redeclara a org).
const servicosLd = [
  { name: 'Relações Públicas Estratégica', type: 'Public Relations', url: `${site.domain}/relacoes-publicas`, desc: 'Assessoria de imprensa e relações públicas que começa pelo dado, para empresas inovadoras.' },
  { name: 'Comunicação Integrada', type: 'Communications', url: `${site.domain}/comunicacao-integrada`, desc: 'PR, branding e reputação conduzidos como um sistema único.' },
  { name: 'Reputação Semântica', type: 'Reputation Management', url: `${site.domain}/reputacao`, desc: 'Gestão de como a marca aparece na busca, na mídia e nas respostas de IA.' },
  { name: 'GEO Consulting', type: 'Generative Engine Optimization', url: `${site.domain}/geo`, desc: 'Otimização para a marca ser citada nas respostas de IA como ChatGPT, Gemini e Perplexity.' },
  { name: 'Media e Audience Training', type: 'Media Training', url: `${site.domain}/media-training`, desc: 'Preparação de porta-vozes para construir autoridade junto à imprensa.' },
  { name: 'Ghostwriting', type: 'Ghostwriting', url: `${site.domain}/ghostwriting`, desc: 'Liderança de opinião para executivos em artigos, posts e palco.' },
  { name: 'Projetos Especiais de PR (PEP)', type: 'Public Relations', url: `${site.domain}/pep`, desc: 'Metodologia modular de seis vetores editoriais para presença contínua.' },
];

---
<BaseLayout
  title="Comunicação para empresas inovadoras"
  description="Agência de comunicação para empresas inovadoras desde 2013, em São Paulo. Construímos reputação na imprensa, no mercado e nas respostas de inteligência artificial: a marca que tem gravidade é a que a IA cita."
>
  <Fragment slot="head">
    <style is:global>
      :root {
        --primary: #0F0F11;
        --secondary: #F5F5F7;
        --bg-white: #FFFFFF;
        --accent: #FED136;
        --accent-deep: #E0B420;

        --text-muted: rgba(15, 15, 17, .6);
        --text-faint: rgba(15, 15, 17, .4);
        --hairline: rgba(0, 0, 0, .08);

        --radius-sm: 8px; --radius-md: 14px; --radius-lg: 24px; --radius-xl: 32px; --radius-full: 9999px;
        --ease-out-expo: cubic-bezier(.16, 1, .3, 1);
        --t-smooth: all .6s var(--ease-out-expo);

        --font-sans: 'Open Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --font-serif: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, monospace;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: var(--font-sans);
        background: #000000; color: var(--primary);
        overflow-x: hidden; -webkit-font-smoothing: antialiased;
        font-feature-settings: "ss01", "cv11";
      }
      ::selection { background: var(--accent); color: var(--primary); }
      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: rgba(255,255,255,.16); border-radius: 10px; }

      html.lenis { height: auto; }
      .lenis.lenis-smooth { scroll-behavior: auto; }

      .ds-mono { font-family: var(--font-mono); font-size: .72rem; letter-spacing: -.01em; text-transform: uppercase; }
      .ds-caption { font-size: .72rem; font-weight: 600; line-height: 1.4; text-transform: uppercase; letter-spacing: .2em; }
      .italic-serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -.02em; }

      /* reveals */
      .reveal { opacity: 0; transform: translateY(2.5rem); transition: var(--t-smooth); }
      .reveal.active { opacity: 1; transform: none; }
      .delay-100 { transition-delay: .1s; } .delay-200 { transition-delay: .2s; }
      .delay-300 { transition-delay: .3s; } .delay-400 { transition-delay: .4s; }

      /* Clientes marquee: faixa preta OPACA (bloqueia o brilho do campo atras, mata os quadradinhos) */
      .clients-marquee { position: relative; z-index: 20; isolation: isolate; background: #000000; color: #fff; padding: 1.75rem 0; border-top: 1px solid rgba(255,255,255,.06); border-bottom: 1px solid rgba(255,255,255,.06); }
      .clients-marquee-wrap { position: relative; overflow: hidden; width: 100%; }
      .clients-marquee-wrap::before, .clients-marquee-wrap::after { content: ''; position: absolute; top: 0; bottom: 0; width: 120px; z-index: 10; pointer-events: none; }
      .clients-marquee-wrap::before { left: 0; background: linear-gradient(to right, #000000, transparent); }
      .clients-marquee-wrap::after { right: 0; background: linear-gradient(to left, #000000, transparent); }
      .clients-marquee-track { display: flex; align-items: center; width: max-content; animation: clients-scroll 50s linear infinite; }
      @keyframes clients-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
      .clients-marquee-track:hover { animation-play-state: paused; }
      .client-logo { height: 74px; width: auto; max-width: 210px; margin-right: 3.5rem; flex-shrink: 0; object-fit: contain; opacity: .85; mix-blend-mode: lighten; transition: opacity .35s var(--ease-out-expo), transform .35s var(--ease-out-expo); }
      .client-logo:hover { opacity: 1; transform: scale(1.08); }
      @media (max-width: 768px) { .client-logo { height: 56px; margin-right: 2.25rem; } }

      /* ===== HERO video-scrub (claro, 5 atos) ===== */
      #narrative-hero { position: relative; width: 100vw; height: 500vh; background: #fafafa; z-index: 10; }
      .hero-sticky { position: sticky; top: 0; width: 100vw; height: 100vh; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #fafafa; }

      .video-scrub { position: absolute; inset: 0; width: 100vw; height: 100vh; z-index: 10; will-change: transform; transform: translateZ(0); }
      .video-scrub video { width: 100%; height: 100%; object-fit: cover; transform: translateZ(0) scale(1.02); will-change: transform; -webkit-backface-visibility: hidden; backface-visibility: hidden; }
      .hero-center { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; z-index: 30; pointer-events: none; }
      .glass-hero { background: rgba(255,255,255,.75); backdrop-filter: blur(25px) saturate(180%); -webkit-backdrop-filter: blur(25px) saturate(180%); border: 1px solid rgba(255,255,255,.6); border-radius: var(--radius-xl); padding: 2.75rem 3.5rem; box-shadow: 0 40px 80px rgba(0,0,0,.06), inset 0 0 0 1px rgba(255,255,255,.8); display: inline-flex; flex-direction: column; align-items: center; text-align: center; width: 90vw; max-width: 90vw; will-change: transform, opacity; }
      /* Medida do titulo travada na faixa central das guias (60vw): o texto quebra
         dentro dela em vez de esticar ate a borda do card. text-wrap: balance equilibra
         as linhas em vez de deixar uma orfa curta no fim. */
      .n-title { font-family: var(--font-serif); font-size: clamp(2rem, 3.75vw, 4.5rem); font-weight: 700; letter-spacing: -.04em; line-height: 1.08; text-transform: uppercase; color: var(--primary); max-width: min(60vw, 100%); margin-inline: auto; text-wrap: balance; }
      .n-title em { font-style: normal; }
      .n-sub { font-family: var(--font-serif); font-size: clamp(1.05rem, 1.75vw, 1.65rem); font-weight: 400; letter-spacing: -.01em; color: var(--text-muted); margin-top: .5rem; max-width: min(60vw, 100%); margin-inline: auto; text-wrap: balance; }
      .hero-cta { display: flex; gap: 1rem; margin-top: 1.5rem; justify-content: center; flex-wrap: wrap; pointer-events: auto; }

      /* buttons */
      .btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; padding: .85rem 1.8rem; border-radius: var(--radius-full); font-size: .9375rem; font-weight: 500; transition: var(--t-smooth); cursor: pointer; position: relative; overflow: hidden; letter-spacing: -.01em; border: 1px solid transparent; text-decoration: none; }
      .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
      .btn-ghost { background: transparent; color: var(--primary); border-color: rgba(0,0,0,.12); }
      .btn-ghost:hover { background: rgba(0,0,0,.04); border-color: rgba(0,0,0,.25); }
      .btn-ghost iconify-icon { transition: transform .4s var(--ease-out-expo); }
      .btn-ghost:hover iconify-icon { transform: translateX(4px); }
      .btn-ghost.on-dark { color: #fff; border-color: rgba(255,255,255,.25); }
      .btn-ghost.on-dark:hover { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.5); }
      .beam-btn { position: relative; padding: 2px; border-radius: var(--radius-full); display: inline-block; isolation: isolate; text-decoration: none; transform-origin: center; transition: transform .45s var(--ease-out-expo); }
      .beam-btn .beam-inner { display: inline-flex; align-items: center; gap: .5rem; background: var(--accent); color: var(--primary); padding: .9rem 1.9rem; border-radius: inherit; font-weight: 600; font-size: .94rem; transition: box-shadow .45s var(--ease-out-expo); }
      /* Destaque no desktop: o botão cresce de leve, sem giro. Toque não dispara. */
      @media (hover: hover) and (min-width: 769px) {
        .beam-btn:hover { transform: scale(1.05); }
        .beam-btn:hover .beam-inner { box-shadow: 0 12px 32px -10px rgba(254, 209, 54, .55); }
      }

      #scroll-progress { position: fixed; top: 0; left: 0; height: 2px; background: var(--accent); z-index: 9999; width: 0; transition: width .1s linear; }

      /* ===== FILME DARK ===== */
      .film { position: relative; z-index: 1; }
      .fsec { position: relative; z-index: 1; padding-block: var(--sec-pad); color: #fff; overflow: hidden; }
      .fsec.tight { padding-block: var(--sec-pad); }
      .fwrap { max-width: 1240px; margin-inline: auto; padding-inline: clamp(1.25rem, 4vw, 2.5rem); position: relative; z-index: 2; }
      .fwrap.narrow { max-width: 880px; }
      .f-eyebrow { display: inline-flex; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; color: rgba(255,255,255,.6); }
      .f-eyebrow .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px rgba(254,209,54,.18); }
      .f-h2 { font-family: var(--font-serif); font-weight: 600; font-size: clamp(2.1rem, 5vw, 4rem); line-height: 1.02; letter-spacing: -.035em; margin: 1.1rem 0 0; max-width: 20ch;
        /* lupa (lente de aumento): a bola cruza o texto e o que fica sob ela INVERTE para contrastar com a massa,
           seguindo legivel (escuro sobre a bola amarela, claro sobre a bola preta). vars de posicao setadas no rAF.
           a palavra-destaque (warm-t) fica fixa no acento, independente da lupa. */
        --lens-base: #fff; --lens-hot: #15130C; --lens-x: -9999px; --lens-y: -9999px; --lens-r: 150px;
        color: var(--lens-base);
        background-image: radial-gradient(circle var(--lens-r) at var(--lens-x) var(--lens-y), var(--lens-hot) 0%, var(--lens-hot) 30%, var(--lens-base) 72%);
        -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
      /* Segundo tempo do h2: vira bloco proprio e pula uma linha, para a frase depois
         dos dois-pontos entrar destacada. A lupa continua sendo pintada pelo h2. */
      .f-h2-beat { display: block; margin-top: 1em; }
      .f-h2 .warm-t { -webkit-text-fill-color: var(--accent); }
      .f-lede { font-size: clamp(1.05rem, 1.5vw, 1.3rem); line-height: 1.55; color: rgba(255,255,255,.72); margin: 1.2rem 0 0; max-width: 54ch; }
      .warm-t { color: var(--accent); }
      .serif-i { font-family: var(--font-serif); font-style: italic; font-weight: 400; }
      .ghost-word { position: absolute; top: 8%; font-family: var(--font-serif); font-weight: 800; font-size: clamp(6rem, 19vw, 17rem); color: rgba(255,255,255,.035); pointer-events: none; z-index: 0; line-height: .8; letter-spacing: -.04em; }

      /* secoes claras: a banda creme e da propria secao. Com o campo ligado quem pinta a
         banda e o canvas (para a massa aparecer dentro dela, invertida), e o componente
         devolve esta secao para transparente. */
      .fsec.light { background: #fafafa; color: var(--primary); z-index: 2; }
      .fsec.light .f-eyebrow { color: var(--text-muted); }
      .fsec.light .f-eyebrow .dot { background: var(--accent-deep); box-shadow: 0 0 0 4px rgba(224,180,32,.16); }
      .fsec.light .f-h2 { --lens-base: var(--primary); --lens-hot: #fafafa; }
      /* clima: garante texto escuro legivel sobre a bola amarela grande (nao a mesma cor) */
      .f-climax .f-h2 { --lens-base: #fff; --lens-hot: #15130C; }
      /* sem lupa/bola-glow: o destaque do clima fica branco (era escuro so pra contrastar com a bola) */
      .f-climax .f-h2 .warm-t { -webkit-text-fill-color: #fff; }
      .fsec.light .f-h2 .warm-t { -webkit-text-fill-color: var(--yellow-ink); }
      .fsec.light .f-lede { color: var(--text-muted); }
      .fsec.light .warm-t { color: var(--yellow-ink); }
      .fsec.light .ln { color: var(--yellow-ink); }
      /* a voz na luz: microfone amarelo com halo quente em vez do glow sobre o preto */
      .fsec.light .voz-mic { color: var(--accent-deep); filter: drop-shadow(0 0 22px rgba(254,209,54,.5)); }
      /* a prova na luz: numeros e chips invertidos para o creme */
      .fsec.light .f-stat { border-left-color: rgba(224,180,32,.55); }
      .fsec.light .f-stat .sn { color: var(--primary); }
      .fsec.light .f-stat .sl { color: var(--text-muted); }
      .fsec.light .exit-chip { background: rgba(0,0,0,.04); border-color: rgba(0,0,0,.1); color: var(--text-muted); }

      /* a voz (o coracao do filme): microfone com glow, centralizado */
      .voz-sec { text-align: center; }
      .voz-sec .fwrap { text-align: center; }
      .voz-sec .f-eyebrow, .voz-sec .f-h2, .voz-sec .f-lede { margin-inline: auto; justify-content: center; }
      .voz-sec .f-h2 { max-width: 18ch; }
      .voz-mic { font-size: clamp(3.5rem, 8vw, 6rem); color: var(--accent); line-height: 1; margin-bottom: 1rem; filter: drop-shadow(0 0 30px rgba(254,209,54,.45)); }

      /* PiaRboard (a caixa-preta aberta): grade de dados do dashboard, na faixa clara */
      .board { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 2.4rem; }
      @media (min-width: 680px) { .board { grid-template-columns: repeat(2,1fr); } }
      @media (min-width: 1040px) { .board { grid-template-columns: repeat(3,1fr); } }
      .board-card { padding: 1.5rem; border-radius: var(--radius-lg); border: 1px solid rgba(0,0,0,.1); background: rgba(255,255,255,.6); transition: var(--t-smooth); }
      .board-card:hover { border-color: rgba(224,180,32,.45); transform: translateY(-4px); box-shadow: 0 18px 40px rgba(0,0,0,.06); }
      .board-card .b-ic { display: inline-flex; width: 44px; height: 44px; border-radius: 12px; align-items: center; justify-content: center; background: rgba(224,180,32,.14); color: var(--accent-deep); font-size: 1.35rem; }
      .board-card h3 { font-size: 1.1rem; font-weight: 600; letter-spacing: -.02em; color: var(--primary); margin: .8rem 0 0; }
      .board-card p { font-size: .9rem; line-height: 1.5; color: var(--text-muted); margin: .45rem 0 0; }
      .board-link { display: inline-flex; align-items: center; gap: .5rem; margin-top: 2rem; font-size: .92rem; font-weight: 600; color: var(--accent-deep); text-decoration: none; }
      .board-link iconify-icon { transition: transform .4s var(--ease-out-expo); }
      .board-link:hover iconify-icon { transform: translateX(4px); }

      /* corpos / forcas cards */
      .corpos { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 2.2rem; }
      @media (min-width: 560px) { .corpos { grid-template-columns: repeat(2,1fr); } }
      @media (min-width: 980px) { .corpos { grid-template-columns: repeat(4,1fr); } }
      .corpo-card { padding: clamp(1.4rem,2vw,1.8rem); border-radius: var(--radius-lg); border: 1px solid rgba(255,255,255,.1); background: rgba(13,15,22,.55); transition: border-color .5s var(--ease-out-expo), transform .35s var(--ease-out-expo), background .4s var(--ease-out-expo); }
      .corpo-card:hover { border-color: rgba(254,209,54,.28); transform: translateY(-4px); }
      .corpo-card .c-ic { display: inline-flex; width: 46px; height: 46px; border-radius: 12px; align-items: center; justify-content: center; background: rgba(254,209,54,.1); color: var(--accent); font-size: 1.4rem; }
      .corpo-card h3 { font-size: 1.15rem; font-weight: 600; letter-spacing: -.02em; margin: .8rem 0 0; color: #fff; }
      .corpo-card p { font-size: .92rem; line-height: 1.5; color: rgba(255,255,255,.6); margin: .5rem 0 0; }
      .corpo-slot > .corpo-card { height: 100%; }

      .forcas { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 2.4rem; }
      @media (min-width: 680px) { .forcas { grid-template-columns: repeat(2,1fr); } }
      @media (min-width: 1040px) { .forcas { grid-template-columns: repeat(3,1fr); } }
      .forca { display: flex; flex-direction: column; padding: 1.6rem; border-radius: var(--radius-lg); border: 1px solid rgba(255,255,255,.1); background: rgba(13,15,22,.5); text-decoration: none; transition: border-color .5s var(--ease-out-expo), transform .35s var(--ease-out-expo), background .4s var(--ease-out-expo); }
      .forca:hover { border-color: rgba(254,209,54,.3); transform: translateY(-4px); background: rgba(20,22,30,.6); }
      .forca .fg { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }
      .forca .f-ic { color: var(--accent); font-size: 1.5rem; margin-top: .9rem; }
      .forca h3 { font-size: 1.2rem; font-weight: 600; letter-spacing: -.02em; color: #fff; margin: .6rem 0 0; }
      .forca p { font-size: .9rem; line-height: 1.5; color: rgba(255,255,255,.6); margin: .5rem 0 0; flex: 1; }
      .forca .f-go { display: inline-flex; align-items: center; gap: .4rem; margin-top: 1rem; font-size: .8rem; font-weight: 600; color: rgba(255,255,255,.75); }
      .forca:hover .f-go { color: var(--accent); }

      /* PEP: mencao honrosa (painel destacado, amarelo) */
      .pep-panel { position: relative; overflow: hidden; border: 1px solid rgba(254,209,54,.28); border-radius: var(--radius-xl); background: linear-gradient(155deg, rgba(254,209,54,.08) 0%, rgba(13,15,22,.5) 55%); padding: clamp(2rem, 4vw, 3.4rem); }
      .pep-panel .f-eyebrow, .pep-panel .f-h2, .pep-panel .f-lede { position: relative; z-index: 2; }
      .pep-panel .f-h2 { max-width: 17ch; }
      .pep-glow { position: absolute; top: -30%; right: -10%; width: 60%; height: 160%; background: radial-gradient(circle, rgba(254,209,54,.16) 0%, transparent 60%); pointer-events: none; z-index: 1; }
      .pep-vetores { position: relative; z-index: 2; display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.8rem; }
      .pep-vetor { display: inline-flex; padding: .5rem 1rem; border-radius: 999px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.13); font-family: var(--font-mono); font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.8); }
      .pep-cta { position: relative; z-index: 2; display: inline-flex; align-items: center; gap: .5rem; margin-top: 2rem; padding: .85rem 1.7rem; border-radius: 999px; background: var(--accent); color: var(--primary); font-weight: 600; font-size: .92rem; text-decoration: none; transition: var(--t-smooth); }
      .pep-cta:hover { transform: translateY(-2px); box-shadow: 0 14px 30px rgba(254,209,54,.32); }
      .pep-cta iconify-icon { transition: transform .4s var(--ease-out-expo); }
      .pep-cta:hover iconify-icon { transform: translateX(4px); }

      /* prova */
      .f-stats { display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-top: 2.4rem; }
      @media (min-width: 720px) { .f-stats { grid-template-columns: repeat(3,1fr); } }
      .f-stat { border-left: 2px solid rgba(254,209,54,.4); padding-left: 1.2rem; }
      .f-stat .sn { display: block; font-family: var(--font-serif); font-weight: 700; font-size: clamp(2.8rem,6vw,4.6rem); line-height: .9; letter-spacing: -.04em; color: #fff; }
      .f-stat .sl { display: block; font-size: .9rem; color: rgba(255,255,255,.6); margin-top: .6rem; max-width: 28ch; }
      .exits-line { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: .5rem; }
      .exit-chip { display: inline-flex; padding: .45rem .85rem; border-radius: 999px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); font-family: var(--font-mono); font-size: .66rem; letter-spacing: .04em; color: rgba(255,255,255,.7); }

      /* lideranca */
      .leaders { display: grid; grid-template-columns: 1fr; gap: 1.25rem; margin-top: 2.4rem; }
      @media (min-width: 760px) { .leaders { grid-template-columns: repeat(3,1fr); } }
      .leader { border-radius: var(--radius-lg); border: 1px solid rgba(255,255,255,.1); background: rgba(13,15,22,.55); overflow: hidden; transition: var(--t-smooth); padding-bottom: 1.4rem; }
      .leader:hover { border-color: rgba(255,255,255,.2); transform: translateY(-4px); box-shadow: 0 24px 48px rgba(0,0,0,.3); }
      .leader-photo { aspect-ratio: 1/1; overflow: hidden; background: #0d0f16; }
      .leader-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 22%; filter: grayscale(.15) contrast(1.02); }
      .leader-photo img.flip { transform: scaleX(-1); }
      .leader h3 { font-size: 1.3rem; font-weight: 600; letter-spacing: -.02em; margin: 1rem 1.4rem 0; color: #fff; }
      .leader .lp { display: block; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); margin: 1rem 1.4rem 0; }
      .leader p { font-size: .9rem; line-height: 1.5; color: rgba(255,255,255,.6); margin: .5rem 1.4rem 0; }

      /* climax + CTA */
      .f-climax { text-align: center; padding-block: var(--sec-pad); }
      .f-climax .f-h2 { margin-inline: auto; max-width: 24ch; }
      .f-climax .f-lede { margin-inline: auto; }
      /* (o scrim atras do texto do clima mora no CampoGravitacional: ele so existe para
         devolver contraste quando a massa passa por tras da leitura) */
      .f-cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 2rem; }
      .f-slogan { font-family: var(--font-serif); font-style: italic; font-size: clamp(1.1rem,1.6vw,1.35rem); color: rgba(255,255,255,.62); margin-top: 2.6rem; max-width: 42ch; margin-inline: auto; line-height: 1.4; }
      .ln { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

      @media (max-width: 768px) {
        .glass-hero { padding: 1.5rem 1.75rem; }
        #narrative-hero { height: 400vh; }
        /* No celular a faixa de 60vw seria estreita demais: o texto volta a usar a largura do card. */
        .n-title, .n-sub { max-width: 100%; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
        .reveal { opacity: 1 !important; transform: none !important; }
      }
    </style>

