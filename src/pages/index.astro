        // Sem corredor (fallback): a massa viaja pela homepage inteira (esquerda, direita,
        // muda o angulo), cruzando a leitura, e o recorte por zona de texto a segura. [scrollP, x, y].
        // o ultimo ponto desce ao centro-baixo (nao ao meio da tela) pelo mesmo motivo do S:
        // e ali que a linha branca alcanca a bola, entao o pouso tambem vale sem corredor.
        var PATH = [[0.00, 0.64, 0.46], [0.38, 0.66, 0.44], [0.55, 0.30, 0.52], [0.70, 0.68, 0.46], [0.85, 0.36, 0.50], [1.00, 0.50, 0.95]];
        function corePath(pp) { var a = PATH[0], b = PATH[PATH.length - 1]; for (var ci = 0; ci < PATH.length - 1; ci++) { if (pp >= PATH[ci][0] && pp <= PATH[ci + 1][0]) { a = PATH[ci]; b = PATH[ci + 1]; break; } } var span = (b[0] - a[0]) || 1, lt = smooth((pp - a[0]) / span); return [a[1] + (b[1] - a[1]) * lt, a[2] + (b[2] - a[2]) * lt]; }
