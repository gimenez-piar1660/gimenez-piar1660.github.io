        }

        /* O TRAJETO DESENHADO. Lido do traco amarelo do print, reamostrado em 48 pontos:
           posicao no filme (0 a 1) -> fracao da largura, na referencia de 1920. Os extremos
           (0.037 e 0.948) caem nas margens vazias da coluna de conteudo. */
        var ORBITA = [
          0.851, 0.859, 0.853, 0.818, 0.727, 0.375, 0.161, 0.082, 0.046, 0.041, 0.066, 0.129,
          0.277, 0.783, 0.899, 0.943, 0.940, 0.885, 0.736, 0.190, 0.072, 0.039, 0.067, 0.182,
          0.702, 0.836, 0.885, 0.886, 0.844, 0.714, 0.214, 0.096, 0.046, 0.037, 0.063, 0.137,
          0.296, 0.641, 0.790, 0.861, 0.899, 0.919, 0.925, 0.915, 0.889, 0.833, 0.528, 0.505
