  <div id="scroll-progress"></div>

  <Nav current="home" />

  {CAMPO_GRAVITACIONAL && <CampoGravitacional />}

  <main id="main">
    <!-- 1 · HERO video-scrub (claro, recortado para a tese da gravidade) -->
    <section id="narrative-hero" aria-label="Abertura">
      <div class="hero-sticky">
        <div class="video-scrub">
          <video id="hero-video" src={withBase('/videos/hero.mp4')} muted playsinline preload="metadata" poster=""></video>
        </div>

        <div class="hero-center"><div class="animate-target text-1"><div class="glass-hero"><h1 class="n-title">Identificamos o <em>ativo raro</em> de cada marca e o transformamos em reputação.</h1></div></div></div>
        <div class="hero-center"><div class="animate-target text-2"><div class="glass-hero"><h2 class="n-title">Transformamos a sua marca em algo <em>inevitável.</em></h2></div></div></div>
        <div class="hero-center"><div class="animate-target text-3"><div class="glass-hero"><h2 class="n-title">O que a imprensa procura, <em>colocamos entre aspas.</em></h2></div></div></div>
        <div class="hero-center"><div class="animate-target text-4">
          <div class="glass-hero">
            <h2 class="n-title">Vamos transformar a sua <em>marca.</em></h2>
            <p class="n-sub">Conte a sua história e mostramos as oportunidades.</p>
            <div class="hero-cta">
              <a href="/contato" class="beam-btn"><span class="beam-inner">Agende seu diagnóstico<iconify-icon icon="solar:calendar-mark-linear"></iconify-icon></span></a>
              <a href="#virada" class="btn btn-ghost">Conheça a PiaR<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
            </div>
          </div>
        </div></div>
      </div>
    </section>

    <!-- 2 · CLIENTES MARQUEE (faixa fina, so logos) -->
    <section class="clients-marquee" style="z-index:20" aria-label="Marcas que confiam na PiaR">
      <div class="clients-marquee-wrap">
        <div class="clients-marquee-track">
          {[...Array(2)].flatMap((_, copy) => (
            clienteLogos.map((slug) => (
              <img src={withBase(`/brand/clients/${slug}.png`)} alt={copy === 0 ? `Cliente PiaR: ${slug.replace(/-/g, ' ')}` : ''} class="client-logo" loading="lazy" aria-hidden={copy === 1 ? 'true' : undefined} />
            ))
          ))}
        </div>
      </div>
    </section>

    <!-- ===== FILME DARK · A GRAVIDADE DA MARCA (sobre o campo fixo) ===== -->
    <div class="film">
      <!-- 3 · A VOZ (abre o filme: toda gravidade comeca numa voz; e o marcador que acende o campo) -->
      <section class="fsec voz-sec light" id="virada">
        <div class="fwrap narrow">
          <div class="voz-mic reveal" aria-hidden="true"><iconify-icon icon="solar:microphone-line-duotone"></iconify-icon></div>
          <span class="f-eyebrow reveal"><span class="dot"></span>Onde tudo começa</span>
          <h2 class="f-h2 reveal delay-100">Toda atração começa com uma <span class="warm-t">voz.</span></h2>
          <p class="f-lede reveal delay-200">Há {site.yearsOperating} anos que ouvimos o mesmo silêncio: empresas extraordinárias que passam despercebidas porque seus fundadores nunca aprenderam a transformar valor em uma mensagem clara.</p>
          <p class="f-lede reveal delay-300">A imprensa presta atenção em quem tem algo único a dizer. Nosso trabalho é encontrar essa frase e colocá-la na voz certa, na hora certa, antes de todo mundo.</p>
        </div>
      </section>

      <!-- 4 · OS CORPOS QUE A GRAVIDADE PUXA -->
      <section class="fsec tight" id="corpos">
        <span class="ghost-word" data-parallax-y="-14" aria-hidden="true" style="right:-3%">massa</span>
        <div class="fwrap">
          <div class="reveal">
            <span class="f-eyebrow"><span class="dot"></span>A gravidade da marca</span>
            <h2 class="f-h2">Toda marca quer ser desejada. Poucas entendem que desejo é gravidade:<span class="f-h2-beat">Quanto mais massa uma marca acumula, menos ela precisa correr, porque o mercado passa a entrar na órbita dela.</span></h2>
            <p class="f-lede">Há {site.yearsOperating} anos construímos esse tipo de gravidade, marca por marca. Já são mais de 470 empresas ajudadas a alcançar o ponto em que comprador, investidor, talento e imprensa chegam naturalmente, sem precisar ser chamados.</p>
          </div>
          <div class="corpos">
            {corpos.map((c) => (
              <div class="corpo-slot">
                <div class="corpo-card">
                  <span class="c-ic"><iconify-icon icon={c.ic}></iconify-icon></span>
                  <h3>{c.t}</h3>
                  <p>{c.d}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 6 · AS FORÇAS QUE GERAM A MASSA · 7 SERVIÇOS -->
      <section class="fsec" id="forcas">
        <div class="fwrap">
          <div class="reveal">
            <span class="f-eyebrow"><span class="dot"></span>O que fazemos</span>
            <h2 class="f-h2">Seis forças geram essa gravidade.</h2>
            <p class="f-lede">Nenhuma entra no atacado: cada força responde a um diagnóstico. Juntas, somam a massa que a imprensa cita pelo nome e que o mercado passa a procurar sozinho.</p>
          </div>
          <div class="forcas">
            {forcas.map((f) => (
              <a href={f.href} class="forca">
                <span class="fg">{f.g}</span>
                <iconify-icon class="f-ic" icon={f.ic}></iconify-icon>
                <h3>{f.t}</h3>
                <p>{f.d}</p>
                <span class="f-go">Ver a frente<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- 6b · PEP · MENÇÃO HONROSA (painel destacado, leva para /pep) -->
      <section class="fsec tight" id="pep">
        <div class="fwrap">
          <div class="pep-panel reveal">
            <div class="pep-glow" aria-hidden="true"></div>
            <span class="f-eyebrow"><span class="dot"></span>Projetos Especiais de PR · PEP</span>
            <h2 class="f-h2">Tem um trabalho que começa onde a cobertura termina.</h2>
            <p class="f-lede">PEP é a metodologia proprietária da PiaR para transformar cobertura em continuidade de marca. São seis frentes editoriais que se combinam conforme o objetivo, para ampliar alcance, reforçar narrativa e fazer cada aparição gerar impacto muito além da publicação.</p>
            <div class="pep-vetores">
              {vetores.map((v) => <span class="pep-vetor">{v}</span>)}
            </div>
            <a href="/pep" class="pep-cta">Conheça o PEP<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
          </div>
        </div>
      </section>

      <!-- 7 · A PROVA -->
      <section class="fsec light" id="prova">
        <div class="fwrap">
          <div class="reveal">
            <span class="f-eyebrow"><span class="dot"></span>A prova</span>
            <h2 class="f-h2">Treze anos de comunicação em números que você pode conferir.</h2>
          </div>
          <div class="f-stats">
            {provas.map((p, i) => (
              <div class:list={['f-stat', 'reveal', i === 1 && 'delay-100', i === 2 && 'delay-200']}>
                <span class="sn"><span data-count={String(p.n)} data-suffix={p.suf}>{p.n}{p.suf}</span>{p.tail}</span>
                <span class="sl">{p.l}</span>
              </div>
            ))}
          </div>
          <div class="exits-line reveal delay-200">
            {exits.map((e) => <span class="exit-chip">{e}</span>)}
          </div>
          <p class="f-lede reveal delay-300">Reputação não se compra à vista, ela se acumula. Desde {site.foundingYear}, já são mais de 470 marcas atendidas, {site.exitsSupported} startups acompanhadas até o exit e um reconhecimento que reforça essa trajetória: {site.founder.name}, eleito Profissional de Imprensa no Startup Awards da ABStartups em 2018. Números importam. Consistência importa ainda mais.</p>
        </div>
      </section>

      <!-- 8 · QUEM LIDERA (fotos reais) -->
      <section class="fsec tight" id="lideranca">
        <div class="fwrap">
          <div class="reveal">
            <span class="f-eyebrow"><span class="dot"></span>Quem lidera</span>
            <h2 class="f-h2">Quem dirige a estratégia está na sala.</h2>
            <p class="f-lede">Quem assina o seu trabalho é quem senta na reunião semanal, no funil e na edição de cada entrega. Aqui, a liderança não aparece apenas na proposta comercial, ela permanece presente na estratégia, e sua marca percebe isso desde a primeira semana.</p>
          </div>
          <div class="leaders">
            {lideranca.map((p, i) => (
              <div class:list={['leader', 'reveal', i === 1 && 'delay-100', i === 2 && 'delay-200']}>
                <div class="leader-photo"><img src={withBase(p.foto)} class:list={[p.flip && 'flip']} loading="lazy" alt={`${p.nome}, ${p.papel} da PiaR Group`} /></div>
                <span class="lp">{p.papel}</span>
                <h3>{p.nome}</h3>
                <p>{p.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 9 · TRANSPARÊNCIA · O PIARBOARD (a caixa-preta aberta) -->
      <section class="fsec light" id="metodo">
        <div class="fwrap">
          <div class="reveal" style="max-width:62ch">
            <span class="f-eyebrow"><span class="dot"></span>O PiaRBoard</span>
            <h2 class="f-h2">Transparência é inegociável.</h2>
            <p class="f-lede">A maioria das agências entrega o resultado e esconde o caminho. Abrimos a caixa-preta: o PiaRBoard é o nosso dashboard proprietário, que mostra em tempo real cada passo até a publicação.</p>
          </div>
          <div class="board">
            {piarboard.map((b, i) => (
              <div class:list={['board-card', 'reveal', i % 3 === 1 && 'delay-100', i % 3 === 2 && 'delay-200']}>
                <span class="b-ic"><iconify-icon icon={b.ic}></iconify-icon></span>
                <h3>{b.t}</h3>
                <p>{b.d}</p>
              </div>
            ))}
          </div>
          <a href="/processos" class="board-link reveal delay-200">Ver como medimos<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
        </div>
      </section>

      <!-- 10 · CLÍMAX + CTA -->
      <section class="fsec f-climax" id="climax">
        <div class="fwrap narrow">
          <span class="f-eyebrow reveal" style="justify-content:center"><span class="dot"></span>Vamos conversar</span>
          <h2 class="f-h2 reveal delay-100">A sua marca já tem um <span class="warm-t">ativo raro.</span></h2>
          <p class="f-lede reveal delay-200">O que está em jogo é se o mercado já descobriu isso. Conte o seu contexto e, em até um dia útil, devolvemos onde está a oportunidade: na busca, na imprensa e nas conversas que decidem o seu mercado. Sem proposta automática, sem script. Só o diagnóstico que 470 marcas nos ensinaram a enxergar.</p>
          <div class="f-cta reveal delay-300">
            <a href="/contato" class="beam-btn"><span class="beam-inner">Agende seu diagnóstico<iconify-icon icon="solar:calendar-mark-linear"></iconify-icon></span></a>
            <a href={`mailto:${site.email}`} class="btn btn-ghost on-dark">{site.email}<iconify-icon icon="solar:letter-linear"></iconify-icon></a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      try {
        if (window.gsap && window.ScrollTrigger) window.gsap.registerPlugin(window.ScrollTrigger);
        if (!prefersReduced && window.Lenis) {
          var lenis = new window.Lenis({ duration: 1.2, easing: function (t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); }, smooth: true, lerp: 0.1 });
          if (window.ScrollTrigger) { lenis.on('scroll', window.ScrollTrigger.update); window.gsap.ticker.add(function (time) { lenis.raf(time * 1000); }); window.gsap.ticker.lagSmoothing(0); }
          else { var raf0 = function (t) { lenis.raf(t); requestAnimationFrame(raf0); }; requestAnimationFrame(raf0); }
        }
      } catch (e) {}

      var progressBar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', function () {
        var h = document.documentElement;
        var p = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
        if (progressBar) progressBar.style.width = p + '%';
      }, { passive: true });

      // HERO video-scrub (5 atos)
      var video = document.getElementById('hero-video');
      var beats = ['.text-1', '.text-2', '.text-3', '.text-4'];
      function initHero() {
        var gsap = window.gsap, ScrollTrigger = window.ScrollTrigger;
        gsap.set('.animate-target', { y: 80, opacity: 0 });
        var tl = gsap.timeline({ scrollTrigger: { trigger: '#narrative-hero', start: 'top top', end: 'bottom bottom', scrub: 0.5, pin: '.hero-sticky' } });
        tl.to({}, { duration: 10 }, 0);
        // Slides SEQUENCIAIS, sem sobreposicao: cada card some por completo (opacity 0)
        // exatamente quando o proximo comeca a surgir. As ENTRADAS (in) ficam nos mesmos
        // pontos de antes (0.3, 2.3, 4.3, 6.3), entao o envelope total e o fim junto com o
        // video nao mudam; muda so a SAIDA de cada card, antecipada para terminar antes da
        // entrada do seguinte. Textos, sequencia, narrativa e layout permanecem intactos.
        var beatTimings = [[0.3, 1.8], [2.3, 3.8], [4.3, 5.8], [6.3, null]];
        beats.forEach(function (sel, i) {
          var t = beatTimings[i];
          // O DESLIZE (y) segue suave, na mesma janela de 0.5 de antes.
          tl.to(sel, { y: 0, duration: 0.5, ease: 'power2.out' }, t[0]);
          // A OPACIDADE liga quase instantaneamente (0.08) e SEGURA. O esmaecimento fica
          // quase imperceptivel (o card so "aparece"), e, como o backdrop-filter (blur)
          // acompanha a opacidade, o card fica em 1 praticamente o tempo todo: blur uniforme
          // e cheio em todos os slides.
          tl.fromTo(sel, { opacity: 0 }, { opacity: 1, duration: 0.08, ease: 'power2.out' }, t[0]);
          if (t[1] !== null) {
            tl.to(sel, { y: -80, duration: 0.5, ease: 'power2.in' }, t[1]);
            // Saida da opacidade so no fim da janela, terminando em t[1]+0.5 (= entrada do
            // proximo card), preservando a nao sobreposicao.
            tl.to(sel, { opacity: 0, duration: 0.08, ease: 'power2.in' }, t[1] + 0.42);
          }
        });
        if (video) {
          video.pause();
          var primeFirstFrame = function () { var doSeek = function () { try { video.currentTime = 0.04; } catch (e) {} }; if (video.readyState >= 1) requestAnimationFrame(doSeek); else video.addEventListener('loadedmetadata', function () { requestAnimationFrame(doSeek); }, { once: true }); };
          primeFirstFrame();
          var applyScrub = function () {
            var dur = (!Number.isNaN(video.duration) && video.duration > 0) ? video.duration : 10;
            var state = { target: 0, current: 0 };
            ScrollTrigger.create({ trigger: '#narrative-hero', start: 'top top', end: 'bottom bottom', scrub: true, onUpdate: function (self) { state.target = dur * Math.min(self.progress / 0.88, 1); } });
            var rafId = null; var ease = 0.09;
            var tick = function () { if (video.readyState >= 2) { state.current += (state.target - state.current) * ease; if (Math.abs(state.target - state.current) < 0.002) state.current = state.target; try { video.currentTime = state.current; } catch (e) {} } rafId = requestAnimationFrame(tick); };
            tick();
            ScrollTrigger.create({ trigger: '#narrative-hero', start: 'top bottom', end: 'bottom top', onLeave: function () { if (rafId) { cancelAnimationFrame(rafId); rafId = null; } }, onLeaveBack: function () { if (rafId) { cancelAnimationFrame(rafId); rafId = null; } }, onEnter: function () { if (!rafId) tick(); }, onEnterBack: function () { if (!rafId) tick(); } });
          };
          if (video.readyState >= 1) applyScrub(); else { video.addEventListener('loadedmetadata', applyScrub, { once: true }); video.load(); }
          var once = false;
          var unlock = function () { if (!once) { once = true; var pr = video.play(); if (pr && typeof pr.then === 'function') pr.then(function () { video.pause(); }).catch(function () {}); } };
          window.addEventListener('touchstart', unlock, { once: true });
          window.addEventListener('click', unlock, { once: true });
        }
      }
      if (!prefersReduced && window.gsap && window.ScrollTrigger) initHero();
      else { document.querySelectorAll('.animate-target').forEach(function (el, i) { el.style.opacity = '1'; el.style.transform = 'none'; if (i < 3) el.style.display = 'none'; }); }

      // reveals
      var io = new IntersectionObserver(function (entries) { entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('active'); io.unobserve(e.target); } }); }, { threshold: 0.15 });
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

      // contadores (o numero ja vem no HTML; aqui so anima de 0 ate ele)
      document.querySelectorAll('[data-count]').forEach(function (el) {
        var target = parseFloat(el.getAttribute('data-count')); var suffix = el.getAttribute('data-suffix') || ''; var done = false;
        var ob = new IntersectionObserver(function (ents) {
          ents.forEach(function (en) {
            if (en.isIntersecting && !done) {
              done = true; var t0 = null;
              function step(ts) { if (!t0) t0 = ts; var pr = Math.min((ts - t0) / 1500, 1); var eased = 1 - Math.pow(1 - pr, 3); el.textContent = Math.round(target * eased) + suffix; if (pr < 1) requestAnimationFrame(step); }
              if (!prefersReduced) requestAnimationFrame(step);
              ob.unobserve(en.target);
            }
          });
        }, { threshold: 0.5 });
        ob.observe(el);
      });

      // parallax scrub (Mastercard) nos ghost-words
      if (!prefersReduced && window.gsap && window.ScrollTrigger) {
        window.gsap.utils.toArray('[data-parallax-y]').forEach(function (el) {
          var v = parseFloat(el.getAttribute('data-parallax-y')) || -12;
          window.gsap.fromTo(el, { yPercent: 0 }, { yPercent: v, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } });
        });
      }

    });
  </script>
</BaseLayout>
