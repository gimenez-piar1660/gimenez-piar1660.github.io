        var bodies = [
          { ang: 0.3, rr: 0.26, sp: 0.40, col: [254, 209, 54] },
          { ang: 1.9, rr: 0.36, sp: -0.30, col: [235, 196, 86] },
          { ang: 3.3, rr: 0.30, sp: 0.24, col: [228, 205, 150] },
          { ang: 4.8, rr: 0.40, sp: -0.18, col: [255, 232, 150] }
