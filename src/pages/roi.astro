---
// ============================================================================
// Exemplar narrativo · ROI de assessoria de imprensa (Data PR)
// Conteúdo voice-backed portado de:
//   src/content/pages/roi.md (fonte; renomeado de roi-assessoria-de-imprensa.md)
// Original preservado. Esta página é a versão "narrativa espetacular":
// herói canvas 2D (o ledger: dígitos mono que acendem e sobem para uma cifra)
// + dataviz interativa (o AVE que esvazia: cifra oca que murcha a cada premissa)
// + scroll storytelling (GSAP/Lenis), sobre o DS da PiaR.
// Assinatura de cor: financeira/ledger, preto + amarelo, mono em destaque.
// ============================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import { site } from '@/data/site';

const url = `${site.domain}/roi`;

// As três exigências do ROI de PR.
const exigencias = [
  {
    id: '01',
    nome: 'Janela de tempo definida',
    desc: 'O retorno de uma matéria não acontece no instante da publicação. Escolha um período, trimestre ou semestre, e compare o que entrou e o que saiu dentro dele.',
    icon: 'solar:calendar-mark-line-duotone',
  },
  {
    id: '02',
    nome: 'Atribuição honesta',
    desc: 'A imprensa contribui para o resultado, mas dificilmente é a única causa. Quem credita 100% da venda ao PR está enganando a si mesmo.',
    icon: 'solar:scale-line-duotone',
    featured: true,
  },
  {
    id: '03',
    nome: 'Métrica conectada a negócio',
    desc: 'Número de matérias não é resultado. Resultado é o que muda no funil, na reputação ou na decisão de quem importa para a empresa.',
    icon: 'solar:graph-up-line-duotone',
  },
];

// Passo a passo do exemplo numérico ilustrativo.
const passos = [
  {
    num: '01',
    titulo: 'Defina o investimento no período',
    valor: 'R$ 100.000',
    desc: 'Um trimestre com R$ 90.000 de honorário de assessoria e R$ 10.000 em horas internas e produção. Investimento total no período.',
  },
  {
    num: '02',
    titulo: 'Isole o resultado que você consegue medir',
    valor: '50 leads',
    desc: 'Tráfego vindo de veículos onde a empresa foi pautada gerou 50 leads qualificados rastreáveis, por UTM, por pergunta no formulário ou por origem declarada.',
  },
  {
    num: '03',
    titulo: 'Converta em valor com a sua taxa real',
    valor: 'R$ 100.000',
    desc: 'Taxa de fechamento de 8% e ticket médio de R$ 25.000: 50 leads vezes 8% igual a 4 contratos, vezes R$ 25.000 igual a R$ 100.000 de resultado bruto atribuível.',
  },
  {
    num: '04',
    titulo: 'Aplique a atribuição e calcule',
    valor: 'ROI menos 50%',
    desc: 'Atribuindo ao PR metade do resultado, o retorno atribuível é R$ 50.000. No trimestre: (50.000 menos 100.000) dividido por 100.000, vezes 100, igual a menos 50%.',
  },
];

// Métodos de valoração (a tabela limpa).
const metodos = [
  {
    nome: 'Centimetragem / AVE',
    mede: 'Espaço ocupado em mídia convertido em preço de anúncio equivalente',
    quando: 'Quase nunca. Evite como prova de retorno',
    limite: 'Confunde espaço com resultado e ignora tom, contexto e credibilidade',
    evite: true,
  },
  {
    nome: 'Share of voice',
    mede: 'Sua presença na cobertura de um tema frente a concorrentes',
    quando: 'Disputa de narrativa, lançamento de categoria, posicionamento',
    limite: 'Mede presença relativa, não decisão de compra nem qualidade da menção',
  },
  {
    nome: 'Leads atribuídos',
    mede: 'Contatos qualificados originados de cobertura rastreável',
    quando: 'Funil B2B com origem rastreável: UTM, formulário, declaração',
    limite: 'Captura só a parcela rastreável; subestima o efeito reputacional e o boca a boca',
  },
  {
    nome: 'Receita influenciada',
    mede: 'Negócio fechado em que a cobertura participou da decisão',
    quando: 'Ciclo de venda médio com CRM que registra o histórico de contato',
    limite: 'Exige atribuição multi-toque e disciplina de dados; raramente isola o PR sozinho',
  },
];

// As quatro etapas da medição na PiaR.
const etapas = [
  {
    num: '01',
    titulo: 'Diagnóstico e Mapeamento',
    prazo: 'Semanas 1 e 2',
    desc: 'Levantamos a situação atual, os objetivos de negócio e quais métricas vão valer como prova de retorno antes de qualquer publicação. Sem linha de base, não há ROI possível.',
  },
  {
    num: '02',
    titulo: 'Messaging Framework',
    prazo: 'Semanas 3 e 4',
    desc: 'Estruturamos as mensagens e os ângulos. Aqui se define o que é share of voice relevante para a sua categoria e qual narrativa vamos disputar.',
  },
  {
    num: '03',
    titulo: 'Ativação Editorial',
    prazo: 'Semanas 5 a 12',
    desc: 'Execução com a imprensa, sempre por relacionamento e pauta, nunca por disparo em massa. 100% dos ativos passam por revisão jurídica antes de ir para fora.',
  },
  {
    num: '04',
    titulo: 'Monitoramento e Escala',
    prazo: 'Ciclos quinzenais',
    desc: 'O que foi publicado, em que tom, com que presença relativa, e o que disso conversou com o funil. O número é revisitado, não apresentado uma vez e esquecido.',
  },
];

const exits = ['Axado', 'Trustvox', 'ViaNuvem', 'Konduto', 'Getrak', 'GrandChef', 'Xtech Commerce', 'Supermercado Now'];

const faq = [
  {
    q: 'Dá para calcular ROI de assessoria de imprensa de verdade?',
    a: 'Dá, desde que você aceite duas condições: janela de tempo longa o suficiente para o efeito reputacional aparecer, e atribuição honesta, reconhecendo que o PR contribui para o resultado sem ser a única causa. O que não dá é produzir um número exato fingindo que a matéria vendeu sozinha.',
  },
  {
    q: 'Quanto tempo leva para PR mostrar retorno?',
    a: 'Depende do objetivo e do ciclo de venda. Resultados de presença na narrativa, como share of voice, aparecem em semanas. Efeito sobre funil e reputação se acumula ao longo de meses. Por isso medimos em cadência quinzenal e olhamos a tendência, não um print isolado.',
  },
  {
    q: 'Por que vocês não usam equivalência publicitária, se o número fica alto?',
    a: 'Porque o número alto não se sustenta. AVE confunde espaço com resultado, ignora o tom da cobertura e inventa um preço de anúncio que você nunca pagaria. Apresentar AVE como ROI é entregar uma conta que não resiste à primeira pergunta de quem aprova o orçamento.',
  },
  {
    q: 'Qual métrica eu deveria pedir para a minha assessoria?',
    a: 'Peça a combinação: share of voice para saber se você está ganhando a conversa na sua categoria, qualidade da cobertura (veículo, posicionamento da mensagem, tom) e métricas de funil rastreáveis (tráfego, leads, conversão). Desconfie de quem entrega só volume de matérias ou só AVE.',
  },
  {
    q: 'Vocês têm uma planilha para eu calcular isso?',
    a: 'Estamos produzindo um mini-modelo de cálculo de ROI de PR com os campos deste guia: investimento, resultado atribuível, taxa de conversão, janela e atribuição.',
  },
];
---
<BaseLayout
  title="ROI de assessoria de imprensa: como calcular"
  description="Como calcular o ROI de assessoria de imprensa com método honesto: janela de tempo, atribuição e métricas conectadas a negócio, sem AVE."
  canonical={url}
>
  <Fragment slot="head">
    <style is:global>
      :root {
        --accent: #FED136;
        --accent-deep: #E0B420;
        --paper-warm: #F4F1EA;
        --ledger-ink: #0A0A0C;
        --ledger-ink-2: #141417;
        --ledger-grid: rgba(255,255,255,.045);
        --neg: #C44536;          /* vermelho-ledger sóbrio para o número negativo */
        --radius-card: 24px;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 700; }
      body { font-family: var(--font-sans); background: var(--paper); color: var(--primary); overflow-x: hidden; -webkit-font-smoothing: antialiased; font-feature-settings: "ss01", "cv11", "tnum"; }

      #scroll-progress { position: fixed; top: 0; left: 0; height: 2px; background: var(--accent); z-index: 9999; width: 0; transition: width .1s linear; }

      .wrap { max-width: 1280px; margin: 0 auto; padding-inline: 1.5rem; position: relative; z-index: 1; }
      @media (min-width: 768px) { .wrap { padding-inline: 2rem; } }

      .eyebrow { display: inline-flex; align-items: center; gap: .6rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; color: var(--text-muted); font-weight: 600; }
      .eyebrow::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex-shrink: 0; box-shadow: 0 0 0 4px rgba(254,209,54,.18); }
      .eyebrow.on-dark { color: rgba(255,255,255,.72); }

      .accent-serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--accent-deep); letter-spacing: -.02em; }
      .accent-serif.on-dark { color: var(--accent); }

      /* botões */
      .btn { display: inline-flex; align-items: center; gap: .55rem; padding: .9rem 1.7rem; border-radius: var(--radius-btn); font-size: .95rem; font-weight: 600; letter-spacing: -.01em; text-decoration: none; transition: var(--t-smooth); cursor: pointer; border: 1.5px solid transparent; }
      .btn iconify-icon { transition: transform .4s var(--ease-out-expo); }
      .btn:hover iconify-icon { transform: translateX(4px); }
      .btn-accent { background: var(--accent); color: var(--primary); border-color: var(--accent); }
      .btn-accent:hover { background: #FFD84A; transform: translateY(-2px); box-shadow: 0 16px 32px rgba(254,209,54,.32); }
      .btn-ghost-d { background: transparent; color: #fff; border-color: rgba(255,255,255,.25); }
      .btn-ghost-d:hover { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.5); }
      .btn-ghost { background: transparent; color: var(--primary); border-color: rgba(0,0,0,.16); }
      .btn-ghost:hover { background: rgba(0,0,0,.04); border-color: rgba(0,0,0,.32); }

      /* ===========================================================
         1 · HERO · canvas 2D "o ledger"
         =========================================================== */
      .roi-hero { position: relative; min-height: 100vh; min-height: 100svh; background: var(--ledger-ink); color: #fff; overflow: hidden; display: flex; align-items: center; isolation: isolate; }
      .hero-bg-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
      #roi-hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; display: block; }
      .roi-hero .scrim { position: absolute; inset: 0; z-index: 1; pointer-events: none;
        background:
          radial-gradient(120% 90% at 22% 40%, rgba(10,10,12,.85) 0%, rgba(10,10,12,.4) 46%, rgba(10,10,12,0) 72%),
          linear-gradient(180deg, rgba(10,10,12,.55) 0%, rgba(10,10,12,0) 28%, rgba(10,10,12,.2) 74%, rgba(10,10,12,.92) 100%);
      }
      .roi-hero .hero-inner { position: relative; z-index: 2; width: 100%; padding-block: 9rem 4rem; }
      .roi-hero-chip { display: inline-flex; align-items: center; gap: .5rem; padding: .5rem 1rem; border-radius: var(--radius-pill); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(6px); font-family: var(--font-mono); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.78); }
      .roi-hero-chip .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px 1px rgba(254,209,54,.7); }
      .roi-hero h1 { font-size: clamp(2.6rem, 7.4vw, 7rem); font-weight: 700; line-height: .96; letter-spacing: -.04em; margin: 1.6rem 0 0; max-width: 18ch; text-wrap: balance; }
      .roi-hero .sub { font-size: clamp(1.1rem, 1.7vw, 1.4rem); line-height: 1.5; color: rgba(255,255,255,.74); margin-top: 1.75rem; max-width: 52ch; }
      .roi-hero .cta-row { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2.5rem; }
      .roi-scroll-cue { position: absolute; left: 50%; bottom: 1.75rem; transform: translateX(-50%); z-index: 2; display: inline-flex; flex-direction: column; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .6rem; letter-spacing: .2em; text-transform: uppercase; color: rgba(255,255,255,.5); }
      .roi-scroll-cue .line { width: 1px; height: 38px; background: linear-gradient(180deg, rgba(255,255,255,.5), transparent); animation: cuePulse 2.2s var(--ease-out-expo) infinite; }
      @keyframes cuePulse { 0%,100% { opacity: .3; transform: scaleY(.7); transform-origin: top; } 50% { opacity: 1; transform: scaleY(1); } }

      /* parallax de profundidade */
      .px { will-change: transform; }
      .has-ghost { overflow: hidden; }
      .ghost-mark { position: absolute; z-index: 0; font-family: var(--font-mono); font-weight: 700; font-size: clamp(7rem, 24vw, 22rem); line-height: .78; letter-spacing: -.06em; color: rgba(15,15,17,.04); pointer-events: none; user-select: none; white-space: nowrap; }
      .section.dark .ghost-mark { color: rgba(255,255,255,.038); }
      .ghost-mark.tr { top: -2rem; right: -1.5rem; }
      .ghost-mark.bl { bottom: -3rem; left: -2rem; }

      /* Três Mares · contorno topográfico (densidade de ledger) */
      .has-contour { overflow: hidden; }
      .contour-field {
        position: absolute; inset: -14% -10%; z-index: 0; pointer-events: none;
        --contour-line: rgba(254,209,54,.10);
        background: repeating-radial-gradient(circle at 84% 32%, transparent 0 38px, var(--contour-line) 38px 39px);
        -webkit-mask-image: radial-gradient(circle at 84% 32%, #000 0%, rgba(0,0,0,.5) 40%, transparent 76%);
                mask-image: radial-gradient(circle at 84% 32%, #000 0%, rgba(0,0,0,.5) 40%, transparent 76%);
        will-change: transform;
      }
      @media (max-width: 760px) { .contour-field { opacity: .55; } }
      .roi-hero-float { position: absolute; z-index: 2; display: inline-flex; align-items: center; gap: .5rem; padding: .55rem 1rem; border-radius: var(--radius-pill); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(6px); font-family: var(--font-mono); font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.72); }
      .roi-hero-float .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px 1px rgba(254,209,54,.7); }
      .roi-hero-float.f1 { right: 9%; top: 26%; }
      .roi-hero-float.f2 { right: 16%; bottom: 22%; }
      @media (max-width: 900px) { .roi-hero-float { display: none; } .ghost-mark { font-size: clamp(6rem, 30vw, 12rem); } }

      /* ===========================================================
         seções base
         =========================================================== */
      .section { padding-block: clamp(5rem, 10vw, 9rem); position: relative; }
      .section.paper { background: var(--paper); border-top: 1px solid var(--hairline); }
      .section.warm { background: var(--paper-warm); border-top: 1px solid var(--hairline); }
      .section.dark { background: var(--ledger-ink); color: #fff; border-top: 1px solid rgba(255,255,255,.06); }
      .section h2 { font-size: clamp(2.1rem, 4.6vw, 4rem); font-weight: 600; line-height: 1.03; letter-spacing: -.035em; margin: 1rem 0 0; max-width: 20ch; text-wrap: balance; }
      .section.dark h2 { color: #fff; }
      .lede { font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.55; color: var(--text-muted); margin-top: 1.5rem; max-width: 58ch; }
      .section.dark .lede { color: rgba(255,255,255,.72); }
      .sec-head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
      .punch { font-family: var(--font-serif); font-style: italic; font-size: clamp(1.6rem, 3.4vw, 2.9rem); line-height: 1.18; letter-spacing: -.02em; margin-top: clamp(2.5rem, 5vw, 3.5rem); max-width: 26ch; }
      .punch .hl { color: var(--accent-deep); font-style: italic; }
      .section.dark .punch .hl { color: var(--accent); }

      /* exigências (3 cards) */
      .reqs { display: grid; grid-template-columns: 1fr; gap: 1rem; }
      @media (min-width: 980px) { .reqs { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; } }
      .req-card { position: relative; padding: clamp(1.75rem, 2.4vw, 2.25rem); border-radius: var(--radius-card); border: 1px solid var(--hairline); background: #fff; overflow: hidden; transition: var(--t-smooth); display: flex; flex-direction: column; }
      .req-card:hover { transform: translateY(-4px); box-shadow: 0 24px 48px rgba(0,0,0,.07); border-color: rgba(0,0,0,.14); }
      .req-card .r-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: rgba(254,209,54,.14); color: var(--accent-deep); font-size: 1.4rem; position: relative; z-index: 1; }
      .req-card .r-id { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text-faint); margin-top: 1.25rem; position: relative; z-index: 1; }
      .req-card .r-name { font-size: 1.32rem; font-weight: 600; letter-spacing: -.025em; margin-top: .3rem; line-height: 1.14; position: relative; z-index: 1; }
      .req-card .r-desc { font-size: 1rem; line-height: 1.6; color: var(--text-muted); margin-top: .85rem; position: relative; z-index: 1; }
      .req-card.featured { background: var(--ledger-ink); color: #fff; border-color: var(--ledger-ink); }
      .req-card.featured::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(90% 60% at 80% 0%, rgba(254,209,54,.18) 0%, transparent 60%), radial-gradient(70% 50% at 10% 100%, rgba(254,209,54,.10) 0%, transparent 60%); }
      .req-card.featured .r-icon { background: rgba(255,255,255,.08); color: var(--accent); }
      .req-card.featured .r-id { color: var(--accent); }
      .req-card.featured .r-desc { color: rgba(255,255,255,.75); }

      /* fórmula + exemplo passo a passo */
      .formula-bar { font-family: var(--font-mono); font-size: clamp(.95rem, 1.7vw, 1.35rem); line-height: 1.5; letter-spacing: -.01em; background: var(--ledger-ink); color: #fff; border-radius: var(--radius-card); padding: clamp(1.5rem, 3vw, 2.25rem); margin-top: 1.75rem; border: 1px solid rgba(255,255,255,.1); }
      .formula-bar .fx { color: var(--accent); }
      .formula-bar .fm { color: rgba(255,255,255,.55); }
      .illus-tag { display: inline-flex; align-items: center; gap: .5rem; margin-top: 2.25rem; padding: .55rem 1rem; border-radius: var(--radius-pill); background: rgba(196,69,54,.1); border: 1px solid rgba(196,69,54,.25); font-family: var(--font-mono); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: var(--neg); font-weight: 600; }
      .illus-tag iconify-icon { font-size: 1rem; }
      .steps-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 1.5rem; }
      @media (min-width: 720px) { .steps-grid { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
      @media (min-width: 1100px) { .steps-grid { grid-template-columns: repeat(4, 1fr); } }
      .step-card { padding: 1.85rem 1.6rem; border-radius: var(--radius-card); background: #fff; border: 1px solid var(--hairline); transition: var(--t-smooth); display: flex; flex-direction: column; min-height: 270px; }
      .step-card:hover { transform: translateY(-4px); box-shadow: 0 22px 44px rgba(0,0,0,.06); border-color: rgba(254,209,54,.45); }
      .step-card .s-num { font-family: var(--font-mono); font-size: .9rem; font-weight: 700; letter-spacing: .1em; color: var(--accent-deep); }
      .step-card .s-valor { font-family: var(--font-mono); font-size: 1.35rem; font-weight: 700; letter-spacing: -.02em; margin-top: .75rem; line-height: 1; font-variant-numeric: tabular-nums; }
      .step-card.is-neg .s-valor { color: var(--neg); }
      .step-card .s-titulo { font-size: 1.05rem; font-weight: 600; letter-spacing: -.02em; margin-top: .85rem; line-height: 1.2; }
      .step-card .s-desc { font-size: .9rem; line-height: 1.55; color: var(--text-muted); margin-top: .7rem; }

      /* ===========================================================
         5 · DATAVIZ · "o AVE que esvazia" (DOM interativo, seção escura)
         =========================================================== */
      .ave-stage { position: relative; }
      .ave-figure { position: relative; text-align: center; padding: clamp(2rem, 5vw, 3.5rem) 0 clamp(1rem, 3vw, 2rem); }
      .ave-label { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: rgba(255,255,255,.4); }
      .ave-number {
        font-family: var(--font-mono); font-weight: 800; letter-spacing: -.04em; line-height: .9;
        font-size: clamp(3rem, 13vw, 11rem); margin: .5rem 0 0; font-variant-numeric: tabular-nums;
        color: transparent;
        -webkit-text-stroke: 2px rgba(254,209,54,.85);
        text-stroke: 2px rgba(254,209,54,.85);
        transition: transform 1s var(--ease-out-expo), opacity 1s var(--ease-out-expo), -webkit-text-stroke-width .8s var(--ease-out-expo);
        transform-origin: center top;
        display: inline-block;
      }
      .ave-number.deflated { opacity: .28; -webkit-text-stroke-width: 1px; }
      .ave-strut { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.32); margin-top: .9rem; min-height: 1.2em; transition: color .5s; }
      .ave-strut.warned { color: var(--neg); }

      .ave-premises { display: grid; grid-template-columns: 1fr; gap: .75rem; margin-top: 2.5rem; }
      @media (min-width: 720px) { .ave-premises { grid-template-columns: repeat(3, 1fr); } }
      .premise {
        text-align: left; cursor: pointer; padding: 1.25rem 1.35rem; border-radius: var(--radius-card);
        background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.14); color: #fff;
        font-family: inherit; transition: var(--t-smooth);
      }
      .premise:hover { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.3); transform: translateY(-3px); }
