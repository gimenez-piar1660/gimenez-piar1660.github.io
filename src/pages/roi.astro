          <p>A PiaR não publica número de retorno que não consegue comprovar. Cada métrica de prova separa o que é resultado observado do que é estimativa, e declara a fonte. Bruno Pinheiro, fundador e CEO, foi eleito Profissional de imprensa no Startup Awards da ABStartups (2018).</p>
        </div>
      </div>
    </section>

    <!-- 9 · FAQ -->
    <section class="section paper">
      <div class="wrap" style="max-width:1000px">
        <div class="sec-head reveal">
          <span class="eyebrow">Perguntas frequentes</span>
          <h2>O que dá para <span class="accent-serif">responder por aqui</span>.</h2>
        </div>
        <div class="reveal d1">
          {faq.map((f) => (
            <details class="faq-item">
              <summary>{f.q}<iconify-icon icon="solar:add-square-linear"></iconify-icon></summary>
              <div class="faq-body">{f.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 10 · CTA -->
    <section class="section dark cta-final has-ghost">
      <span class="ghost-mark bl px" data-parallax-y="12" aria-hidden="true">ROI</span>
      <div class="wrap">
        <span class="eyebrow on-dark reveal" style="justify-content:center; display:inline-flex">Vamos conversar</span>
        <h2 class="reveal d1">Comece pelo <span class="accent-serif on-dark">diagnóstico</span>.</h2>
        <p class="lede reveal d2">Se você precisa defender o orçamento de comunicação com um número que resiste a perguntas, o ponto de partida é definir o que conta como resultado antes de publicar qualquer coisa. É isso que fazemos no diagnóstico, com resposta em até 1 dia útil.</p>
        <div class="cta-row reveal d3">
          <a href="/contato" class="btn btn-accent">Agendar diagnóstico<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
          <a href="/relacoes-publicas" class="btn btn-ghost-d">Ver relações públicas<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
        </div>
        <p class="ds-mono reveal d4" style="color:rgba(255,255,255,.4); margin-top:3rem">/// {site.email} · {site.brandDomain}</p>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- Lenis + ScrollTrigger (globais via bootstrap.ts) ---- */
      try {
        if (window.gsap && window.ScrollTrigger) window.gsap.registerPlugin(window.ScrollTrigger);
        if (!prefersReduced && window.Lenis) {
          var lenis = new window.Lenis({ duration: 1.15, easing: function (t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); }, smooth: true, lerp: 0.1 });
          if (window.ScrollTrigger) { lenis.on('scroll', window.ScrollTrigger.update); window.gsap.ticker.add(function (time) { lenis.raf(time * 1000); }); window.gsap.ticker.lagSmoothing(0); }
          else { var raf = function (t) { lenis.raf(t); requestAnimationFrame(raf); }; requestAnimationFrame(raf); }
        }
      } catch (e) { /* noop */ }

      /* ---- reveal ---- */
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('active'); io.unobserve(en.target); } });
      }, { threshold: 0.14 });
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

      /* ---- scroll progress ---- */
      var bar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', function () {
        var h = document.documentElement;
        var p = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
        if (bar) bar.style.width = p + '%';
      }, { passive: true });

      /* ---- parallax de profundidade ---- */
      if (!prefersReduced && window.gsap && window.ScrollTrigger) {
        window.gsap.utils.toArray('[data-parallax-y]').forEach(function (el) {
          var yp = parseFloat(el.getAttribute('data-parallax-y')) || 0;
          window.gsap.fromTo(el, { yPercent: 0 }, { yPercent: yp, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } });
        });
      }

      /* ---- lerp mouse-parallax no herói (Três Mares) ---- */
      if (!prefersReduced && window.gsap) {
        var heroFloats = window.gsap.utils.toArray('[class*="hero-float"]');
        if (heroFloats.length) {
          var movers = heroFloats.map(function (el, i) {
            return {
              depth: (i % 2 ? 1 : -1) * (16 + i * 8),
              qx: window.gsap.quickTo(el, 'x', { duration: 0.7, ease: 'power3' }),
              qy: window.gsap.quickTo(el, 'y', { duration: 0.7, ease: 'power3' })
            };
          });
          window.addEventListener('mousemove', function (e) {
            var nx = (e.clientX / window.innerWidth - 0.5);
            var ny = (e.clientY / window.innerHeight - 0.5);
            for (var k = 0; k < movers.length; k++) { movers[k].qx(nx * movers[k].depth); movers[k].qy(ny * movers[k].depth); }
          }, { passive: true });
        }
      }

      /* ========================================================
         HERO · o ledger (canvas 2D)
         dígitos mono caindo, quase todos apagados (grafite, baixo alpha).
         alguns acendem em amarelo e convergem/sobem para uma cifra no canto.
         ======================================================== */
      (function ledgerField() {
        var canvas = document.getElementById('roi-hero-canvas');
        if (!canvas) { return; }
        var ctx = null;
        try { ctx = canvas.getContext('2d'); } catch (e) { ctx = null; }
        if (!ctx) {
          canvas.style.background = 'radial-gradient(70% 90% at 78% 32%, #1c1c22 0%, #101014 55%, #0A0A0C 100%)';
          return;
        }

        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0;
        var cols = [];          // colunas de dígitos derivando
        var sparks = [];        // dígitos que acenderam e sobem para a cifra
        var target = { x: 0, y: 0 };   // canto onde mora a cifra que se torna visível
        var glyphSize = 16;
        var spawnAcc = 0;

        function rand(a, b) { return a + Math.random() * (b - a); }

        function layout() {
          W = canvas.clientWidth; H = canvas.clientHeight;
          canvas.width = Math.max(1, Math.floor(W * dpr));
          canvas.height = Math.max(1, Math.floor(H * dpr));
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          target.x = W * 0.84; target.y = H * 0.30;
          glyphSize = Math.max(13, Math.min(20, Math.floor(W / 70)));
          buildColumns();
        }

        function buildColumns() {
          cols = [];
          var step = glyphSize * 1.5;
          var n = Math.max(8, Math.floor(W / step));
          for (var i = 0; i < n; i++) {
            cols.push({
              x: (i + 0.5) * (W / n),
              y: rand(-H, H),
              speed: rand(8, 26),
              ch: String(Math.floor(rand(0, 10))),
              alpha: rand(0.05, 0.16),
              swap: rand(0.6, 2.2),
              t: 0,
            });
          }
        }
        layout();

        function spawnSpark() {
          if (cols.length === 0) { return; }
          var c = cols[Math.floor(rand(0, cols.length))];
          sparks.push({
            x: c.x, y: c.y,
            ch: String(Math.floor(rand(0, 10))),
            p: 0,
            sp: rand(0.004, 0.0085),
            sx: c.x, sy: c.y,
            wob: rand(-18, 18),
          });
        }

        function paintFrame(dt) {
          ctx.clearRect(0, 0, W, H);
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.font = '600 ' + glyphSize + 'px "JetBrains Mono", ui-monospace, monospace';

          // colunas apagadas = valor invisível
          for (var i = 0; i < cols.length; i++) {
            var c = cols[i];
            c.y += c.speed * dt;
            c.t += dt;
            if (c.t > c.swap) { c.t = 0; c.ch = String(Math.floor(rand(0, 10))); }
            if (c.y > H + glyphSize) { c.y = -glyphSize; c.x = rand(0, W); c.alpha = rand(0.05, 0.16); }
            ctx.fillStyle = 'rgba(150,156,166,' + c.alpha + ')';
            ctx.fillText(c.ch, c.x, c.y);
          }

          // faísca de luz fraca atrás da cifra-alvo
          var glow = ctx.createRadialGradient(target.x, target.y, 0, target.x, target.y, glyphSize * 7);
          glow.addColorStop(0, 'rgba(254,209,54,0.16)');
          glow.addColorStop(1, 'rgba(254,209,54,0)');
          ctx.fillStyle = glow;
          ctx.fillRect(target.x - glyphSize * 7, target.y - glyphSize * 7, glyphSize * 14, glyphSize * 14);

          // sparks: dígitos que acenderam e sobem/convergem para a cifra
          for (var k = sparks.length - 1; k >= 0; k--) {
            var s = sparks[k];
            s.p += s.sp * (dt * 60);
            if (s.p >= 1) { sparks.splice(k, 1); continue; }
            var ease = 1 - Math.pow(1 - s.p, 3);
            var cx = s.sx + (target.x - s.sx) * ease + Math.sin(s.p * Math.PI) * s.wob;
            var cy = s.sy + (target.y - s.sy) * ease;
            var a = 0.35 + 0.6 * Math.sin(s.p * Math.PI);
            ctx.fillStyle = 'rgba(254,209,54,' + a.toFixed(3) + ')';
            ctx.fillText(s.ch, cx, cy);
          }

          // a cifra que se torna visível e defensável (canto)
          ctx.font = '700 ' + (glyphSize * 1.55) + 'px "JetBrains Mono", ui-monospace, monospace';
          ctx.fillStyle = 'rgba(254,209,54,0.92)';
          ctx.fillText('R$', target.x - glyphSize * 2.2, target.y);
          ctx.fillStyle = 'rgba(255,255,255,0.95)';
          ctx.fillText('+50k', target.x + glyphSize * 0.9, target.y);
          ctx.font = '600 ' + Math.max(9, glyphSize * 0.6) + 'px "JetBrains Mono", ui-monospace, monospace';
          ctx.fillStyle = 'rgba(255,255,255,0.4)';
          ctx.fillText('RETORNO ATRIBUÍVEL', target.x, target.y + glyphSize * 1.5);
        }

        function paintStatic() {
          // reduced-motion: um quadro estático com alguns dígitos amarelos
          ctx.clearRect(0, 0, W, H);
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.font = '600 ' + glyphSize + 'px "JetBrains Mono", ui-monospace, monospace';
          var step = glyphSize * 1.6;
          for (var y = glyphSize; y < H; y += step) {
            for (var x = glyphSize; x < W; x += step) {
              var lit = (Math.abs(Math.sin(x * 0.21 + y * 0.13)) > 0.93);
              ctx.fillStyle = lit ? 'rgba(254,209,54,0.7)' : 'rgba(150,156,166,0.10)';
              ctx.fillText(String(Math.floor(Math.abs(Math.sin(x * y)) * 10) % 10), x, y);
            }
          }
          var glow = ctx.createRadialGradient(target.x, target.y, 0, target.x, target.y, glyphSize * 7);
          glow.addColorStop(0, 'rgba(254,209,54,0.16)');
          glow.addColorStop(1, 'rgba(254,209,54,0)');
          ctx.fillStyle = glow;
          ctx.fillRect(target.x - glyphSize * 7, target.y - glyphSize * 7, glyphSize * 14, glyphSize * 14);
          ctx.font = '700 ' + (glyphSize * 1.55) + 'px "JetBrains Mono", ui-monospace, monospace';
          ctx.fillStyle = 'rgba(254,209,54,0.92)';
          ctx.fillText('R$', target.x - glyphSize * 2.2, target.y);
          ctx.fillStyle = 'rgba(255,255,255,0.95)';
          ctx.fillText('+50k', target.x + glyphSize * 0.9, target.y);
        }

        var last = 0;
        function frame(now) {
          if (!last) last = now;
          var dt = Math.min(0.05, (now - last) / 1000);
          last = now;
          spawnAcc += dt;
          if (spawnAcc > 0.42) { spawnAcc = 0; spawnSpark(); }
          paintFrame(dt);
          raf = requestAnimationFrame(frame);
        }

        var raf;
        window.addEventListener('resize', function () {
          layout();
          if (prefersReduced) paintStatic();
        }, { passive: true });

        if (prefersReduced) {
          paintStatic();
        } else {
          for (var s0 = 0; s0 < 5; s0++) spawnSpark();
          raf = requestAnimationFrame(frame);
        }
      })();

      /* ========================================================
         DATAVIZ · o AVE que esvazia (DOM interativo)
         cada premissa acionada murcha a cifra e revela o método honesto.
         ======================================================== */
      (function aveDeflate() {
        var numberEl = document.getElementById('ave-number');
        var strutEl = document.getElementById('ave-strut');
        var honestEl = document.getElementById('ave-honest');
        var premises = Array.prototype.slice.call(document.querySelectorAll('.premise'));
        if (!numberEl || premises.length === 0) { return; }

        // estágios de murchamento: a cifra inflada deflaciona a cada premissa.
        var stages = ['R$ 1.200.000', 'R$ 520.000', 'R$ 180.000', 'R$ 0'];
        var scales = [1, 0.74, 0.52, 0.34];
        var struts = [
          'Cifra cheia, sustentação vazia',
          'Tira o espaço puro, e ela cai',
          'Tira o tom, e cai mais',
          'Sem o preço inventado, sobra zero',
        ];
        var fired = [false, false, false];

        function update() {
          var count = fired.filter(Boolean).length;
          numberEl.textContent = stages[count];
          numberEl.style.transform = 'scale(' + scales[count] + ')';
          numberEl.classList.toggle('deflated', count > 0);
          strutEl.textContent = struts[count];
          strutEl.classList.toggle('warned', count >= 1);
          if (count >= 3 && honestEl) { honestEl.classList.add('revealed'); }
        }

        premises.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var idx = parseInt(btn.getAttribute('data-prem'), 10);
            if (isNaN(idx) || fired[idx]) { return; }
            fired[idx] = true;
            btn.classList.add('active');
            btn.setAttribute('aria-pressed', 'true');
            btn.disabled = false;
            update();
          });
        });
      })();
    });
  </script>
</BaseLayout>
