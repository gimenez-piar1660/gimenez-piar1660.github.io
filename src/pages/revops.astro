  <Footer />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- Lenis + ScrollTrigger (globais via bootstrap.ts) ---- */
      try {
        if (window.gsap && window.ScrollTrigger) window.gsap.registerPlugin(window.ScrollTrigger);
        if (!prefersReduced && window.Lenis) {
          var lenis = new window.Lenis({ duration: 1.15, easing: function (t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); }, smooth: true, lerp: 0.1 });
          if (window.ScrollTrigger) { lenis.on('scroll', window.ScrollTrigger.update); window.gsap.ticker.add(function (time) { lenis.raf(time * 1000); }); window.gsap.ticker.lagSmoothing(0); }
          else { var raf = function (t) { lenis.raf(t); requestAnimationFrame(raf); }; requestAnimationFrame(raf); }
        }
      } catch (e) { /* noop */ }

      /* ---- reveal ---- */
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('active'); io.unobserve(en.target); } });
      }, { threshold: 0.14 });
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

      /* ---- scroll progress ---- */
      var bar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', function () {
        var h = document.documentElement;
        var p = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
        if (bar) bar.style.width = p + '%';
      }, { passive: true });

      /* ---- parallax de profundidade ---- */
      if (!prefersReduced && window.gsap && window.ScrollTrigger) {
        window.gsap.utils.toArray('[data-parallax-y]').forEach(function (el) {
          var yp = parseFloat(el.getAttribute('data-parallax-y')) || 0;
          window.gsap.fromTo(el, { yPercent: 0 }, { yPercent: yp, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } });
        });
      }

      /* ---- lerp mouse-parallax no herói (Três Mares) ---- */
      if (!prefersReduced && window.gsap) {
        var heroFloats = window.gsap.utils.toArray('[class*="hero-float"]');
        if (heroFloats.length) {
          var movers = heroFloats.map(function (el, i) {
            return {
              depth: (i % 2 ? 1 : -1) * (16 + i * 8),
              qx: window.gsap.quickTo(el, 'x', { duration: 0.7, ease: 'power3' }),
              qy: window.gsap.quickTo(el, 'y', { duration: 0.7, ease: 'power3' })
            };
          });
          window.addEventListener('mousemove', function (e) {
            var nx = (e.clientX / window.innerWidth - 0.5);
            var ny = (e.clientY / window.innerHeight - 0.5);
            for (var k = 0; k < movers.length; k++) { movers[k].qx(nx * movers[k].depth); movers[k].qy(ny * movers[k].depth); }
          }, { passive: true });
        }
      }

      /* ========================================================
         HERO · fluxo PR -> funil -> receita (canvas 2D)
         partículas de PR (grafite) caem por um funil e saem
         convertidas em receita (amarelo), à direita do herói.
         ======================================================== */
      (function heroFunnel() {
        var canvas = document.getElementById('rev-hero-canvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) { canvas.style.background = 'radial-gradient(72% 90% at 72% 32%, #1c2530 0%, #11161c 55%, #0B0D10 100%)'; return; }

        var dpr = Math.min(window.devicePixelRatio || 1, 1.6);
        var W = 0, H = 0;
        var parts = [];
        var MAX = 150;

        // geometria do funil, em coordenadas normalizadas (0..1) sobre a metade direita
        var fx = 0.72;          // centro horizontal do funil
        var topY = 0.16, neckY = 0.56, outY = 0.92;
        var topHalf = 0.18;     // meia-largura no topo do funil
        var neckHalf = 0.028;   // meia-largura no gargalo

        function resize() {
          var w = canvas.clientWidth, h = canvas.clientHeight;
          W = Math.max(1, Math.floor(w * dpr));
          H = Math.max(1, Math.floor(h * dpr));
          canvas.width = W; canvas.height = H;
        }
        resize();
        window.addEventListener('resize', resize, { passive: true });

        function halfAt(ny) {
          // largura do funil em y (parte cônica do topo até o gargalo, depois reto)
          if (ny <= topY) return topHalf;
          if (ny >= neckY) return neckHalf;
          var t = (ny - topY) / (neckY - topY);
          return topHalf + (neckHalf - topHalf) * t;
        }

        function spawn() {
          // nasce no campo de PR (esquerda do funil), migra para a boca do funil
          var fromX = 0.06 + Math.random() * 0.5;
          var fromY = topY + Math.random() * 0.05 - 0.05;
          parts.push({
            x: fromX, y: fromY,
            tx: fx + (Math.random() - 0.5) * topHalf * 1.6,
            phase: 0,                    // 0 = atraído pela boca, 1 = descendo, 2 = receita
            v: 0.0016 + Math.random() * 0.0016,
            wob: Math.random() * Math.PI * 2,
            converted: false
          });
        }

        function step(p) {
          if (p.phase === 0) {
            // migra horizontalmente para a boca do funil
            p.x += (p.tx - p.x) * 0.045;
            p.y += (topY - p.y) * 0.05;
            if (Math.abs(p.x - p.tx) < 0.01 && Math.abs(p.y - topY) < 0.02) { p.phase = 1; }
          } else if (p.phase === 1) {
            // desce pelo funil, comprimido para o gargalo
            p.y += p.v * 1.4;
            var hh = halfAt(p.y);
            var off = (p.x - fx);
            // empurra para dentro das paredes
            if (off > hh) p.x = fx + hh - 0.002;
            if (off < -hh) p.x = fx - hh + 0.002;
            // afunila suavemente em direção ao centro conforme aperta
            p.x += (fx - p.x) * (0.04 + (1 - hh / topHalf) * 0.06);
            p.wob += 0.2;
            if (p.y >= neckY) { p.phase = 2; p.converted = true; }
          } else {
            // sai convertido em receita, espalha levemente para baixo
            p.y += p.v * 2.2;
            p.x += Math.sin(p.wob) * 0.0016;
            p.wob += 0.08;
            if (p.y > 1.06) return false;
          }
          return true;
        }

        function draw() {
          ctx.clearRect(0, 0, W, H);

          // paredes do funil (grafite frio)
          ctx.save();
          ctx.lineWidth = Math.max(1.2, 1.4 * dpr);
          ctx.strokeStyle = 'rgba(147,163,180,.34)';
          // parede esquerda
          ctx.beginPath();
          ctx.moveTo((fx - topHalf) * W, topY * H);
          ctx.lineTo((fx - neckHalf) * W, neckY * H);
          ctx.lineTo((fx - neckHalf) * W, outY * H);
          ctx.stroke();
          // parede direita
          ctx.beginPath();
          ctx.moveTo((fx + topHalf) * W, topY * H);
          ctx.lineTo((fx + neckHalf) * W, neckY * H);
          ctx.lineTo((fx + neckHalf) * W, outY * H);
          ctx.stroke();
          // linha de conversão (gargalo) em amarelo
          ctx.strokeStyle = 'rgba(254,209,54,.5)';
          ctx.lineWidth = Math.max(1, 1 * dpr);
          ctx.beginPath();
          ctx.moveTo((fx - neckHalf - 0.01) * W, neckY * H);
          ctx.lineTo((fx + neckHalf + 0.01) * W, neckY * H);
          ctx.stroke();
          ctx.restore();

          // partículas
          for (var i = parts.length - 1; i >= 0; i--) {
            var p = parts[i];
            var alive = step(p);
            if (!alive) { parts.splice(i, 1); continue; }
            var px = p.x * W, py = p.y * H;
            var r = (p.converted ? 2.4 : 1.8) * dpr;
            if (p.converted) {
              ctx.beginPath(); ctx.arc(px, py, r, 0, Math.PI * 2);
              ctx.fillStyle = 'rgba(254,209,54,.95)'; ctx.fill();
              ctx.beginPath(); ctx.arc(px, py, r * 2.6, 0, Math.PI * 2);
              ctx.fillStyle = 'rgba(254,209,54,.14)'; ctx.fill();
            } else {
              var a = p.phase === 0 ? 0.42 : 0.7;
              ctx.beginPath(); ctx.arc(px, py, r, 0, Math.PI * 2);
              ctx.fillStyle = 'rgba(147,163,180,' + a + ')'; ctx.fill();
            }
          }

          if (!prefersReduced) raf = requestAnimationFrame(draw);
        }

        var spawnTimer = 0;
        function loop() {
          spawnTimer++;
          if (spawnTimer % 5 === 0 && parts.length < MAX) spawn();
          if (!prefersReduced) requestAnimationFrame(loop);
        }

        // semeia algumas partículas iniciais
        for (var s = 0; s < 40; s++) spawn();

        var raf;
        if (prefersReduced) {
          // estado estático: avança alguns frames para mostrar o funil cheio
          for (var f = 0; f < 220; f++) { for (var j = parts.length - 1; j >= 0; j--) { if (!step(parts[j])) parts.splice(j, 1); } if (parts.length < MAX && f % 5 === 0) spawn(); }
          draw();
        } else {
          raf = requestAnimationFrame(draw);
          requestAnimationFrame(loop);
        }
      })();

      /* ========================================================
         DATAVIZ · pipeline PR -> receita (canvas 2D)
         fontes de PR (esquerda) -> funil de qualificação ->
         barra de receita acumulada (direita)
         ======================================================== */
      (function pipelineViz() {
        var canvas = document.getElementById('rev-pipeline-canvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0;
        var sources = ['Imprensa', 'Earned media', 'Data PR', 'Clipping', 'Liderança'];
        var srcNodes = [], stages = [], pulses = [], revenue = 0, revTarget = 0, hover = -1, mouse = { x: -1, y: -1 };

        function layout() {
          var rect = canvas.getBoundingClientRect();
          W = rect.width; H = rect.height;
          canvas.width = Math.floor(W * dpr); canvas.height = Math.floor(H * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          var lx = W * 0.15, n = sources.length;
          srcNodes = sources.map(function (name, i) {
            var y = H * (0.14 + (0.72 * i) / (n - 1));
            return { x: lx, y: y, name: name, r: 4.5 };
          });
          // estágios do funil
          stages = [
            { x: W * 0.46, y: H * 0.5, w: H * 0.46, label: 'Topo' },
            { x: W * 0.60, y: H * 0.5, w: H * 0.30, label: 'Meio' },
            { x: W * 0.73, y: H * 0.5, w: H * 0.16, label: 'Decisão' }
          ];
        }
        layout();

        function spawn() {
          if (prefersReduced) return;
          var src = Math.floor(Math.random() * srcNodes.length);
          pulses.push({ src: src, p: 0, sp: 0.006 + Math.random() * 0.005, seg: 0 });
        }

        function lerp(a, b, t) { return a + (b - a) * t; }

        function bez(x0, y0, cx1, cy1, cx2, cy2, x1, y1, t) {
          var u = 1 - t;
          var x = u * u * u * x0 + 3 * u * u * t * cx1 + 3 * u * t * t * cx2 + t * t * t * x1;
          var y = u * u * u * y0 + 3 * u * u * t * cy1 + 3 * u * t * t * cy2 + t * t * t * y1;
          return { x: x, y: y };
        }

        var funnelX = W * 0.46;
        function draw() {
          funnelX = W * 0.46;
          var mouthY = H * 0.5;
          ctx.clearRect(0, 0, W, H);

          // funil (trapézio) em grafite
          var fLeft = W * 0.40, fRight = W * 0.80;
          var topHalf = H * 0.30, botHalf = H * 0.07;
          ctx.beginPath();
          ctx.moveTo(fLeft, mouthY - topHalf);
          ctx.lineTo(fRight, mouthY - botHalf);
          ctx.lineTo(fRight, mouthY + botHalf);
          ctx.lineTo(fLeft, mouthY + topHalf);
          ctx.closePath();
          ctx.fillStyle = 'rgba(108,124,142,.08)';
          ctx.fill();
          ctx.strokeStyle = 'rgba(147,163,180,.34)';
          ctx.lineWidth = 1.2;
          ctx.stroke();

          // edges fontes -> boca do funil
          srcNodes.forEach(function (sn, i) {
            var active = hover === i;
            ctx.beginPath();
            ctx.moveTo(sn.x, sn.y);
            ctx.bezierCurveTo(lerp(sn.x, fLeft, 0.55), sn.y, lerp(sn.x, fLeft, 0.55), mouthY, fLeft, lerp(sn.y, mouthY, 0.5));
            ctx.strokeStyle = active ? 'rgba(254,209,54,.55)' : 'rgba(255,255,255,.12)';
            ctx.lineWidth = active ? 1.6 : 1;
            ctx.stroke();
          });

          // barra de receita (direita)
          var barX = W * 0.9, barTop = H * 0.18, barBot = H * 0.82, barW = W * 0.05;
          ctx.strokeStyle = 'rgba(255,255,255,.18)';
          ctx.lineWidth = 1;
          ctx.strokeRect(barX, barTop, barW, barBot - barTop);
          revenue += (revTarget - revenue) * 0.04;
          var fillH = (barBot - barTop) * Math.min(1, revenue);
          var grad = ctx.createLinearGradient(0, barBot, 0, barTop);
          grad.addColorStop(0, 'rgba(254,209,54,.95)');
          grad.addColorStop(1, 'rgba(255,255,255,.9)');
          ctx.fillStyle = grad;
          ctx.fillRect(barX, barBot - fillH, barW, fillH);

          // pulses: fonte -> boca -> gargalo -> receita
          for (var k = pulses.length - 1; k >= 0; k--) {
            var pu = pulses[k];
            pu.p += pu.sp;
            var sn = srcNodes[pu.src];
            var pos;
            if (pu.seg === 0) {
              pos = bez(sn.x, sn.y, lerp(sn.x, fLeft, 0.55), sn.y, lerp(sn.x, fLeft, 0.55), mouthY, fLeft, lerp(sn.y, mouthY, 0.5), pu.p);
              if (pu.p >= 1) { pu.seg = 1; pu.p = 0; pu.entryY = lerp(sn.y, mouthY, 0.5); }
            } else if (pu.seg === 1) {
              // dentro do funil: converge para o gargalo
              var fx2 = lerp(fLeft, fRight, pu.p);
              var fy2 = lerp(pu.entryY, mouthY, pu.p);
              pos = { x: fx2, y: fy2 };
              if (pu.p >= 1) { pu.seg = 2; pu.p = 0; }
            } else {
              // gargalo -> barra de receita
              pos = { x: lerp(fRight, barX, pu.p), y: lerp(mouthY, barBot - fillH - 4, pu.p) };
              if (pu.p >= 1) {
                revTarget = Math.min(1, revTarget + 0.012);
                pulses.splice(k, 1);
                continue;
              }
            }
            var conv = pu.seg >= 1;
            ctx.beginPath(); ctx.arc(pos.x, pos.y, 2.6, 0, Math.PI * 2);
            ctx.fillStyle = conv ? 'rgba(254,209,54,.95)' : 'rgba(147,163,180,.9)';
            ctx.fill();
            ctx.beginPath(); ctx.arc(pos.x, pos.y, 6, 0, Math.PI * 2);
            ctx.fillStyle = conv ? 'rgba(254,209,54,.16)' : 'rgba(147,163,180,.14)';
            ctx.fill();
          }

          // fontes + labels
          ctx.font = '600 11px "JetBrains Mono", monospace';
          ctx.textBaseline = 'middle';
          srcNodes.forEach(function (sn, i) {
            var active = hover === i;
            ctx.beginPath(); ctx.arc(sn.x, sn.y, sn.r + (active ? 1.5 : 0), 0, Math.PI * 2);
            ctx.fillStyle = active ? '#FED136' : '#93A3B4'; ctx.fill();
            ctx.textAlign = 'right';
            ctx.fillStyle = active ? 'rgba(255,255,255,.95)' : 'rgba(255,255,255,.55)';
            ctx.fillText(sn.name, sn.x - 12, sn.y);
          });

          // label receita
          ctx.textAlign = 'center';
          ctx.fillStyle = 'rgba(255,255,255,.92)';
          ctx.fillText('Receita', barX + barW / 2, barTop - 14);
          ctx.fillStyle = 'rgba(254,209,54,.95)';
          ctx.font = '700 13px "JetBrains Mono", monospace';
          ctx.fillText(Math.round(revenue * 100) + '%', barX + barW / 2, barBot + 18);

          requestAnimationFrame(draw);
        }

        canvas.addEventListener('mousemove', function (e) {
          var rect = canvas.getBoundingClientRect();
          mouse.x = e.clientX - rect.left; mouse.y = e.clientY - rect.top;
          hover = -1;
          for (var i = 0; i < srcNodes.length; i++) {
            var sn = srcNodes[i];
            if (Math.hypot(sn.x - mouse.x, sn.y - mouse.y) < 26) { hover = i; break; }
          }
        });
        canvas.addEventListener('mouseleave', function () { hover = -1; });
        window.addEventListener('resize', layout, { passive: true });

        if (prefersReduced) {
          revenue = 0.62; revTarget = 0.62;
          layout();
          draw();
        } else {
          setInterval(spawn, 720);
          spawn();
          requestAnimationFrame(draw);
        }
      })();
    });
  </script>
</BaseLayout>
