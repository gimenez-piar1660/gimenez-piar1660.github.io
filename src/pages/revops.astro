      .step-card .s-desc { font-size: .92rem; line-height: 1.55; color: var(--text-muted); margin-top: .7rem; }

      /* stats RevOps */
      .stats-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
      @media (min-width: 720px) { .stats-grid { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; } }
      .stat-card { padding: clamp(1.75rem, 2.4vw, 2.25rem); border-radius: var(--radius-card); border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.03); }
      .stat-card .st-num { font-family: var(--font-display); font-size: clamp(2.6rem, 5vw, 3.6rem); font-weight: 700; letter-spacing: -.04em; line-height: 1; color: var(--accent); }
      .stat-card .st-desc { font-size: .98rem; line-height: 1.55; color: rgba(255,255,255,.72); margin-top: 1rem; }

      /* duas listas (quando usar / quando não) */
      .when-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
      @media (min-width: 900px) { .when-grid { grid-template-columns: 1fr 1fr; gap: 1.5rem; } }
      .when-card { padding: clamp(2rem, 3vw, 2.5rem); border-radius: var(--radius-card); border: 1px solid var(--hairline); background: #fff; }
      .when-card.is-dark { background: var(--rev-ink-2); border-color: rgba(255,255,255,.12); color: #fff; }
      .when-card .w-tag { display: inline-flex; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--accent-deep); }
      .when-card.is-dark .w-tag { color: var(--accent); }
