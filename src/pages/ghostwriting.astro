    .c-ic { display: inline-flex; width: 46px; height: 46px; border-radius: 12px; align-items: center; justify-content: center; background: rgba(254,209,54,.1); color: var(--warm); font-size: 1.4rem; }

    /* dataviz: a multiplicacao da voz */
    .viz-stage { position: relative; border-radius: var(--r-card); overflow: hidden; border: 1px solid var(--hairline-d); background: rgba(4,5,7,.7); aspect-ratio: 16 / 9; max-height: 64vh; }
    #multiply-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

    .grav-cta { position: relative; z-index: 1; overflow: hidden; background: rgba(7,8,12,.5); padding-block: var(--sec-pad); border-top: 1px solid var(--hairline-d); }
    .cta-inner { text-align: center; display: flex; flex-direction: column; align-items: center; position: relative; z-index: 2; }
    .grav-cta h2 { font-size: clamp(2rem, 4.6vw, 3.8rem); font-weight: 600; line-height: 1.08; letter-spacing: -.035em; margin-top: 1.2rem; max-width: 22ch; }
    .grav-cta .lede { margin-inline: auto; }
    .grav-cta .cta-row { justify-content: center; }
    .cta-foot { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .1em; color: var(--text-d-faint); margin-top: 2.6rem; }

    .reveal { opacity: 0; transform: translateY(2rem); transition: opacity .8s var(--ease), transform .8s var(--ease); }
    .reveal.active { opacity: 1; transform: none; }
    .reveal.d1 { transition-delay: .1s; } .reveal.d2 { transition-delay: .2s; } .reveal.d3 { transition-delay: .3s; } .reveal.d4 { transition-delay: .4s; }

