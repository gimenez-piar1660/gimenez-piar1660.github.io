  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- Lenis + ScrollTrigger ---- */
      try {
        if (window.gsap && window.ScrollTrigger) window.gsap.registerPlugin(window.ScrollTrigger);
        if (!prefersReduced && window.Lenis) {
          var lenis = new window.Lenis({ duration: 1.15, easing: function (t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); }, smooth: true, lerp: 0.1 });
          if (window.ScrollTrigger) { lenis.on('scroll', window.ScrollTrigger.update); window.gsap.ticker.add(function (time) { lenis.raf(time * 1000); }); window.gsap.ticker.lagSmoothing(0); }
          else { var raf0 = function (t) { lenis.raf(t); requestAnimationFrame(raf0); }; requestAnimationFrame(raf0); }
        }
      } catch (e) { /* noop */ }

      /* ---- reveal ---- */
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('active'); io.unobserve(en.target); } });
      }, { threshold: 0.14 });
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

      /* ---- scroll progress + progresso global (alimenta a lente) ---- */
      var bar = document.getElementById('scroll-progress');
      var scrollP = 0;
      function onScroll() {
        var h = document.documentElement;
        scrollP = h.scrollTop / ((h.scrollHeight - h.clientHeight) || 1);
        if (bar) bar.style.width = (scrollP * 100) + '%';
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      /* ---- parallax de scroll (palavras-fantasma) ---- */
      if (!prefersReduced && window.gsap && window.ScrollTrigger) {
        window.gsap.utils.toArray('[data-parallax-y]').forEach(function (el) {
          var yp = parseFloat(el.getAttribute('data-parallax-y')) || 0;
          window.gsap.fromTo(el, { yPercent: 0 }, { yPercent: yp, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } });
        });
      }

      /* ========================================================
         CAMPO FIXO: A LENTE GRAVITACIONAL
         A fonte (a sua autoridade) brilha forte e espalhada. O ghostwriter
         e uma massa escura: nao emite luz, mas dobra a luz da fonte. No topo,
         a fonte aparece torta e dispersa. Conforme o scroll, a lente foca: os
         raios curvam e dois arcos crescem ate fechar um anel de Einstein.
         Clima no fecho: o anel floresce, a fonte some atras do ghost.
         Sem mouse: quem comanda e o scroll.
         ======================================================== */
      (function lensField() {
        var canvas = document.getElementById('field-bg');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0;
        function resize() { W = window.innerWidth; H = window.innerHeight; canvas.width = W * dpr; canvas.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); }
        resize();
        window.addEventListener('resize', resize);
        function smooth(t) { return t < 0 ? 0 : t > 1 ? 1 : t * t * (3 - 2 * t); }

        // constelacao de fundo: ideias soltas antes de focar
        var stars = [];
        for (var s = 0; s < 64; s++) { stars.push([Math.random(), Math.random(), 0.3 + Math.random() * 0.7]); }

        var T = 0;
        var lblVoz = document.getElementById('lbl-voz');
        var lblGhost = document.getElementById('lbl-ghost');
        var heroFade = 1;

        function frame() {
          T += prefersReduced ? 0 : 0.004;
          var S = smooth(scrollP);
          var finale = smooth((scrollP - 0.72) / 0.28);
          var base = Math.min(W, H);
          var lx = W * (0.5 + 0.04 * Math.sin(scrollP * Math.PI * 1.2)); // leve deslocamento de camera
          var ly = H * (0.46 + 0.04 * Math.sin(scrollP * Math.PI));

          ctx.clearRect(0, 0, W, H);
          ctx.fillStyle = '#07080C'; ctx.fillRect(0, 0, W, H);

          // estrelas de fundo (somem um pouco quando a lente foca)
          for (var si = 0; si < stars.length; si++) {
            var st = stars[si];
            var tw = 0.5 + 0.5 * Math.sin(T * 2 + si * 1.3);
            ctx.beginPath();
            ctx.arc(st[0] * W, st[1] * H, st[2] * 1.1, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(200,214,232,' + (0.05 + 0.05 * tw) * (1 - S * 0.5) + ')';
            ctx.fill();
          }

          // alinhamento fonte<->lente: de torto (luz espalhada) a alinhado (anel cheio)
          var align = S * 0.7 + finale * 0.3;
          var off = base * 0.24 * (1 - align);
          var srcA = -0.7 + 0.5 * Math.sin(scrollP * 1.7); // direcao do desalinhamento varia (camera)
          var sx = lx + Math.cos(srcA) * off, sy = ly + Math.sin(srcA) * off;
          var axis = Math.atan2(sy - ly, sx - lx);
          var thetaE = base * (0.085 + S * 0.075 + finale * 0.05);

          // brilho difuso da fonte (some atras do ghost ao alinhar)
          var srcVis = (1 - align) * 0.9 + 0.06;
          var gs = ctx.createRadialGradient(sx, sy, 0, sx, sy, base * 0.32);
          gs.addColorStop(0, 'rgba(254,209,54,' + (0.05 + srcVis * 0.13).toFixed(3) + ')');
          gs.addColorStop(0.4, 'rgba(254,209,54,' + (srcVis * 0.03).toFixed(3) + ')');
          gs.addColorStop(1, 'rgba(254,209,54,0)');
          ctx.fillStyle = gs; ctx.fillRect(0, 0, W, H);

          // a propria fonte (estrela), visivel quando desalinhada
          if (srcVis > 0.08) {
            ctx.beginPath(); ctx.arc(sx, sy, 2.4 + (1 - align) * 3, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(255,236,176,' + srcVis.toFixed(3) + ')';
            ctx.shadowColor = 'rgba(254,209,54,.8)'; ctx.shadowBlur = 14; ctx.fill(); ctx.shadowBlur = 0;
          }

          // raios de luz dobrando ao redor da lente
          var NR = 30;
          for (var r = 0; r < NR; r++) {
            var a0 = (r / NR) * Math.PI * 2;
            var ix = lx + Math.cos(a0) * thetaE, iy = ly + Math.sin(a0) * thetaE;
            var mx = (sx + ix) / 2, my = (sy + iy) / 2;
            var pull = 0.45 + S * 0.4;
            var cx = mx + (lx - mx) * pull, cy = my + (ly - my) * pull;
            var lobe = Math.pow(Math.abs(Math.cos(a0 - axis)), 6);
            var bright = (align * 0.5 + (1 - align) * lobe) * (0.10 + S * 0.12 + finale * 0.2);
            if (bright < 0.01) continue;
            ctx.beginPath(); ctx.moveTo(sx, sy); ctx.quadraticCurveTo(cx, cy, ix, iy);
            ctx.strokeStyle = 'rgba(254,209,54,' + bright.toFixed(3) + ')';
            ctx.lineWidth = 0.8 + S * 0.5; ctx.stroke();
          }

          // o anel de Einstein: a voz multiplicada (dois arcos que viram anel)
          var NA = 170;
          for (var k = 0; k < NA; k++) {
            var a = (k / NA) * Math.PI * 2;
            var lob = Math.pow(Math.abs(Math.cos(a - axis)), 6);
            var ba = align + (1 - align) * lob;
            var aA = ba * (0.12 + S * 0.5 + finale * 0.5);
            if (aA < 0.015) continue;
            var rr = thetaE * (1 + 0.012 * Math.sin(a * 7 + T * 2));
            var x = lx + Math.cos(a) * rr, y = ly + Math.sin(a) * rr;
            var sz = 0.8 + ba * (1.4 + finale * 2.2);
            ctx.beginPath(); ctx.arc(x, y, sz, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(254,209,54,' + Math.min(1, aA).toFixed(3) + ')';
            ctx.fill();
          }
          // halo do anel no clima
          if (finale > 0.01) {
            ctx.beginPath(); ctx.arc(lx, ly, thetaE, 0, Math.PI * 2);
            ctx.strokeStyle = 'rgba(254,209,54,' + (finale * 0.5).toFixed(3) + ')';
            ctx.lineWidth = 1 + finale * 2.5; ctx.shadowColor = 'rgba(254,209,54,.7)'; ctx.shadowBlur = 10 + finale * 30; ctx.stroke(); ctx.shadowBlur = 0;
          }

          // a lente: o ghostwriter (massa escura que nao brilha)
          var lensR = thetaE * 0.6;
          for (var w = 1; w <= 3; w++) {
            ctx.beginPath(); ctx.arc(lx, ly, lensR + w * base * 0.018 * (1 + S), 0, Math.PI * 2);
            ctx.strokeStyle = 'rgba(120,150,184,' + (0.05 * (1 - w / 4)).toFixed(3) + ')'; ctx.lineWidth = 1; ctx.stroke();
          }
          var gd = ctx.createRadialGradient(lx, ly, 0, lx, ly, lensR * 1.6);
          gd.addColorStop(0, 'rgba(4,5,7,0.96)');
          gd.addColorStop(0.7, 'rgba(4,5,7,0.7)');
          gd.addColorStop(1, 'rgba(4,5,7,0)');
          ctx.fillStyle = gd; ctx.beginPath(); ctx.arc(lx, ly, lensR * 1.6, 0, Math.PI * 2); ctx.fill();
          ctx.beginPath(); ctx.arc(lx, ly, lensR, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(235,196,86,' + (0.10 + S * 0.12).toFixed(3) + ')'; ctx.lineWidth = 1; ctx.stroke();

          // labels do heroi (somem ao rolar)
          heroFade += ((scrollP < 0.11 ? 1 : 0) - heroFade) * 0.07;
          if (lblVoz) { lblVoz.style.transform = 'translate(' + sx + 'px,' + sy + 'px) translate(-50%, 16px)'; lblVoz.style.opacity = (heroFade * Math.min(1, srcVis)).toFixed(3); }
          if (lblGhost) { lblGhost.style.transform = 'translate(' + lx + 'px,' + ly + 'px) translate(-50%, 16px)'; lblGhost.style.opacity = heroFade.toFixed(3); }

          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      })();

      /* ========================================================
         DATAVIZ: A MULTIPLICACAO DA VOZ
         Uma conversa (fonte) atravessa a lente (o ghostwriter) e se
         multiplica em varias pecas assinadas: artigo, post, palco,
         newsletter, entrevista, livro. Loop continuo de particulas.
         ======================================================== */
      (function multiplyViz() {
        var canvas = document.getElementById('multiply-canvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0;
        function resize() { var r = canvas.getBoundingClientRect(); W = r.width; H = r.height; canvas.width = W * dpr; canvas.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); }
        resize();
        window.addEventListener('resize', resize);

        var outs = ['Artigo assinado', 'LinkedIn', 'Palco', 'Newsletter', 'Entrevista', 'Livro'];
        var NO = outs.length;
        var glow = []; for (var i = 0; i < NO; i++) glow.push(prefersReduced ? 0.7 : 0);
        var parts = [];
        var emitT = 0, cnt = 0;

        function outPos(i) { var top = H * 0.16, bot = H * 0.84; return [W * 0.84, top + (bot - top) * (i / (NO - 1))]; }

        function frame() {
          var sx = W * 0.13, sy = H * 0.5, lx = W * 0.5;

          if (!prefersReduced) {
            emitT++;
            if (emitT >= 9) { emitT = 0; parts.push({ p: 0, tgt: cnt % NO }); cnt++; }
          }

          ctx.clearRect(0, 0, W, H);

          // base: linhas da lente para cada saida + linha da fonte ate a lente
          for (var i2 = 0; i2 < NO; i2++) {
            var po = outPos(i2);
            ctx.beginPath(); ctx.moveTo(lx, sy); ctx.lineTo(po[0], po[1]);
            ctx.strokeStyle = 'rgba(254,209,54,' + (0.05 + glow[i2] * 0.18).toFixed(3) + ')'; ctx.lineWidth = 1; ctx.stroke();
          }
          ctx.beginPath(); ctx.moveTo(sx, sy); ctx.lineTo(lx, sy);
          ctx.strokeStyle = 'rgba(254,209,54,.16)'; ctx.lineWidth = 1.5; ctx.stroke();

          // a lente (o ghostwriter): linha vertical no centro
          ctx.beginPath(); ctx.moveTo(lx, H * 0.12); ctx.lineTo(lx, H * 0.88);
          ctx.strokeStyle = 'rgba(235,196,86,.28)'; ctx.lineWidth = 1.5; ctx.stroke();
          ctx.font = '600 10px JetBrains Mono, ui-monospace, monospace'; ctx.textAlign = 'center';
          ctx.fillStyle = 'rgba(235,196,86,.6)'; ctx.fillText('a lente', lx, H * 0.12 - 8);

          // a fonte: uma conversa
          ctx.beginPath(); ctx.arc(sx, sy, 6, 0, Math.PI * 2);
          ctx.fillStyle = '#FED136'; ctx.shadowColor = 'rgba(254,209,54,.8)'; ctx.shadowBlur = 16; ctx.fill(); ctx.shadowBlur = 0;
          ctx.font = '600 11px Open Sans, sans-serif'; ctx.textAlign = 'left'; ctx.fillStyle = 'rgba(255,236,176,.9)';
          ctx.fillText('uma conversa', sx + 14, sy + 4);

          // as saidas (pecas assinadas)
          for (var o = 0; o < NO; o++) {
            var p = outPos(o); var g = glow[o];
            ctx.beginPath(); ctx.arc(p[0], p[1], 4 + g * 3, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(254,209,54,' + (0.32 + g * 0.68).toFixed(3) + ')';
            if (g > 0.05) { ctx.shadowColor = 'rgba(254,209,54,.7)'; ctx.shadowBlur = g * 16; }
            ctx.fill(); ctx.shadowBlur = 0;
            ctx.font = '600 11px Open Sans, sans-serif'; ctx.textAlign = 'left';
            ctx.fillStyle = 'rgba(255,255,255,' + (0.4 + g * 0.5).toFixed(3) + ')';
            ctx.fillText(outs[o], p[0] + 12, p[1] + 4);
            if (!prefersReduced) glow[o] *= 0.96;
          }

          // particulas: fonte -> lente -> saida
          for (var pi = parts.length - 1; pi >= 0; pi--) {
            var pt = parts[pi];
            pt.p += 0.012;
            var px, py; var dst = outPos(pt.tgt);
            if (pt.p < 0.5) { var u = pt.p / 0.5; px = sx + (lx - sx) * u; py = sy; }
            else { var v = (pt.p - 0.5) / 0.5; px = lx + (dst[0] - lx) * v; py = sy + (dst[1] - sy) * v; }
            ctx.beginPath(); ctx.arc(px, py, 2.4, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(255,236,176,.9)'; ctx.fill();
            if (pt.p >= 1) { glow[pt.tgt] = 1; parts.splice(pi, 1); }
          }

          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      })();
    });
  </script>
