  <script is:inline define:vars={{ WEB3FORMS_KEY, RD_PUBLIC_KEY, RD_ID_PARCIAL, RD_ID_COMPLETO }}>
    document.addEventListener('DOMContentLoaded', function () {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      gsap.registerPlugin(ScrollTrigger);
      if (!prefersReduced) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smooth: true,
          lerp: 0.1,
        });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);
      }

      const progressBar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', () => {
        const h = document.documentElement;
        const p = (h.scrollTop) / (h.scrollHeight - h.clientHeight) * 100;
        if (progressBar) progressBar.style.width = p + '%';
      }, { passive: true });

      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('active'); io.unobserve(e.target); }
        });
      }, { threshold: 0.15 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // ============================================================
      // FORMULÁRIO · dois passos, gravação parcial, classificação MQL
      // ============================================================
      const form = document.getElementById('contato-form');
      const formCard = document.getElementById('form-card');
      const formProgress = document.getElementById('form-progress');
      const successScreen = document.getElementById('success-screen');
      const submitBtn = document.getElementById('submit-btn');
      const nextBtn = document.getElementById('next-btn');
      const backBtn = document.getElementById('back-btn');
      const feedback = document.getElementById('form-feedback');
      if (!form) return;

      const RD_ATIVO = RD_PUBLIC_KEY && RD_PUBLIC_KEY.indexOf('COLE-SUA') !== 0;
      const WEB3_ATIVO = WEB3FORMS_KEY && WEB3FORMS_KEY.indexOf('COLE-SUA') !== 0;

      // ---- 1. Rastreio: lê o cookie de atribuição gravado no BaseLayout ----
      // O cookie guarda o primeiro toque (90 dias). A página de conversão é
      // sempre a atual, por isso ela não vem do cookie.
      (function preencherRastreio() {
        let atrib = {};
        const bruto = document.cookie.split('; ').find((c) => c.indexOf('piar_atrib=') === 0);
        if (bruto) {
          try { atrib = JSON.parse(decodeURIComponent(bruto.slice('piar_atrib='.length))); } catch (err) { atrib = {}; }
        }
        // Se o cookie não existir (bloqueio de cookies), usa a URL desta visita.
        const qs = new URLSearchParams(location.search);
        const set = (id, valor) => { const el = document.getElementById(id); if (el) el.value = valor || ''; };
        set('h-utm-source', atrib.utm_source || qs.get('utm_source'));
        set('h-utm-medium', atrib.utm_medium || qs.get('utm_medium'));
        set('h-utm-campaign', atrib.utm_campaign || qs.get('utm_campaign'));
        set('h-utm-content', atrib.utm_content || qs.get('utm_content'));
        set('h-landing-page', atrib.landing_page || (location.pathname + location.search));
        set('h-referrer', atrib.referrer || (document.referrer && document.referrer.indexOf(location.origin) !== 0 ? document.referrer : ''));
        set('h-pagina-conversao', location.pathname);
      })();

      // ---- 2. Regra de MQL · calculada, sem julgamento humano ----
      const DOMINIOS_GRATUITOS = [
        'gmail.com', 'googlemail.com', 'hotmail.com', 'hotmail.com.br', 'outlook.com',
        'outlook.com.br', 'live.com', 'msn.com', 'yahoo.com', 'yahoo.com.br', 'ymail.com',
        'icloud.com', 'me.com', 'mac.com', 'aol.com', 'bol.com.br', 'uol.com.br',
        'terra.com.br', 'ig.com.br', 'globo.com', 'globomail.com', 'r7.com', 'zipmail.com.br',
        'protonmail.com', 'proton.me', 'gmx.com', 'gmx.net', 'yandex.com', 'zoho.com', 'mail.com',
      ];
      const CARGOS_MQL = [
        'CEO, fundador ou sócio',
        'CMO ou diretor de marketing',
        'Diretor de comunicação',
        'Head ou gerente de marketing / comunicação',
      ];
      const dominioDe = (email) => (email || '').trim().toLowerCase().split('@')[1] || '';
      const ehCorporativo = (email) => {
        const d = dominioDe(email);
        return !!d && DOMINIOS_GRATUITOS.indexOf(d) === -1;
      };
      const classificar = () =>
        ehCorporativo(form.email.value) && CARGOS_MQL.indexOf(form.cf_cargo.value) !== -1 ? 'MQL' : 'Lead';

      // ---- 3. Validação inline · erro no campo, nunca em bloco no topo ----
      function mensagemDe(campo) {
        if (campo.validity.valueMissing) {
          if (campo.type === 'checkbox') return 'Precisamos do seu aceite para seguir.';
          if (campo.tagName === 'SELECT') return 'Escolha uma opção.';
          return 'Preencha este campo.';
        }
        if (campo.validity.typeMismatch && campo.type === 'email') return 'Confira o e-mail: parece faltar alguma coisa.';
        return campo.validationMessage || 'Confira este campo.';
      }
      function caixaDe(campo, classe) {
        const wrap = campo.closest('.field');
        if (!wrap) return null;
        let box = wrap.querySelector('.' + classe);
        if (!box) {
          box = document.createElement('p');
          box.className = classe;
          wrap.appendChild(box);
        }
        return box;
      }
      function limparErro(campo) {
        const wrap = campo.closest('.field');
        if (!wrap) return;
        wrap.classList.remove('is-invalid');
        const box = wrap.querySelector('.field-error');
        if (box) box.remove();
        campo.removeAttribute('aria-invalid');
      }
      function mostrarErro(campo) {
        const wrap = campo.closest('.field');
        if (!wrap) return;
        wrap.classList.add('is-invalid');
        const box = caixaDe(campo, 'field-error');
        if (box) box.textContent = mensagemDe(campo);
        campo.setAttribute('aria-invalid', 'true');
      }
      function validarPasso(passo) {
        const campos = Array.from(passo.querySelectorAll('input, select, textarea'))
          .filter((c) => c.name !== 'botcheck' && !c.disabled && c.offsetParent !== null);
        let primeiroInvalido = null;
        campos.forEach((campo) => {
          if (campo.checkValidity()) { limparErro(campo); return; }
          mostrarErro(campo);
          if (!primeiroInvalido) primeiroInvalido = campo;
        });
        if (primeiroInvalido) {
          primeiroInvalido.focus({ preventScroll: true });
          primeiroInvalido.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return false;
        }
        return true;
      }
      // Erro some assim que a pessoa corrige
      form.addEventListener('input', (e) => { if (e.target.closest('.field.is-invalid')) limparErro(e.target); });
      form.addEventListener('change', (e) => { if (e.target.closest('.field.is-invalid')) limparErro(e.target); });

      // Aviso de e-mail gratuito · avisa, não bloqueia
      const campoEmail = form.email;
      campoEmail.addEventListener('blur', () => {
        const wrap = campoEmail.closest('.field');
        const existente = wrap.querySelector('.field-warn');
        const gratuito = campoEmail.value.indexOf('@') > -1 && !ehCorporativo(campoEmail.value);
        if (gratuito && !existente) {
          const box = caixaDe(campoEmail, 'field-warn');
          if (box) box.textContent = 'Se puder, use o e-mail da empresa. Ajuda a gente a chegar preparado na conversa.';
        } else if (!gratuito && existente) {
          existente.remove();
        }
      });

      // ---- 4. Campo condicional · quem indicou ----
      const campoOrigem = form.cf_origem_declarada;
      const blocoIndicacao = document.getElementById('field-indicacao');
      campoOrigem.addEventListener('change', () => {
        const abrir = campoOrigem.value === 'Indicação de alguém';
        blocoIndicacao.classList.toggle('is-visible', abrir);
        if (!abrir) form.cf_indicado_por.value = '';
      });

      // ---- 5. Navegação entre os passos ----
      const passos = { 1: document.getElementById('step-1'), 2: document.getElementById('step-2') };
      let passoAtual = 1;
      function irPara(n) {
        passoAtual = n;
        Object.keys(passos).forEach((k) => passos[k].classList.toggle('is-active', Number(k) === n));
        formProgress.querySelectorAll('.prog-step').forEach((el) => {
          const i = Number(el.dataset.prog);
          el.classList.toggle('is-current', i === n);
          el.classList.toggle('is-done', i < n);
        });
        formCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
        const primeiro = passos[n].querySelector('input, select, textarea');
        if (primeiro) primeiro.focus({ preventScroll: true });
      }
      if (backBtn) backBtn.addEventListener('click', () => irPara(1));

      // ---- 6. Envio ----
      function dadosDoForm() {
        const dados = {};
        new FormData(form).forEach((valor, chave) => {
          if (chave === 'botcheck' || chave === 'consent') return;
          if (typeof valor === 'string' && valor.trim()) dados[chave] = valor.trim();
        });
        return dados;
      }

      // RD Station · API de conversões com chave pública
      async function enviarRD(dados, identificador) {
        const resp = await fetch('https://api.rd.services/platform/conversions?api_key=' + encodeURIComponent(RD_PUBLIC_KEY), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            event_type: 'CONVERSION',
            event_family: 'CDP',
            payload: Object.assign({}, dados, {
              conversion_identifier: identificador,
              traffic_source: dados.cf_utm_source || '',
              traffic_medium: dados.cf_utm_medium || '',
              traffic_campaign: dados.cf_utm_campaign || '',
            }),
          }),
        });
        if (!resp.ok) throw new Error('RD Station respondeu ' + resp.status);
        return true;
      }

      // Web3Forms · cópia por e-mail, com rótulos legíveis
      const ROTULOS = {
        name: 'Nome', email: 'E-mail', company_name: 'Empresa', personal_phone: 'Telefone',
        cf_cargo: 'Cargo', cf_frente_interesse: 'Frente de interesse',
        cf_assessoria_previa: 'Histórico de assessoria', cf_gatilho: 'Gatilho',
        cf_faturamento_faixa: 'Faturamento', cf_origem_declarada: 'Como conheceu',
        cf_indicado_por: 'Quem indicou', cf_contexto: 'Contexto', cf_classificacao: 'Classificação',
        cf_pagina_conversao: 'Página de conversão', cf_landing_page: 'Página de entrada',
        cf_referrer: 'Referrer', cf_utm_source: 'UTM source', cf_utm_medium: 'UTM medium',
        cf_utm_campaign: 'UTM campaign', cf_utm_content: 'UTM content',
      };
      async function enviarWeb3(dados, parcial) {
        const corpo = { access_key: WEB3FORMS_KEY, from_name: 'Formulário PiaR Group' };
        corpo.subject = parcial
          ? 'Lead parcial (passo 1) · /contato · piar.group'
          : (dados.cf_classificacao || 'Lead') + ' · /contato · piar.group';
        Object.keys(dados).forEach((chave) => { corpo[ROTULOS[chave] || chave] = dados[chave]; });
        const resp = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(corpo),
        });
        const json = await resp.json();
        if (!resp.ok || !json.success) throw new Error(json.message || 'Web3Forms respondeu ' + resp.status);
        return true;
      }

      async function enviar(dados, { identificador, parcial }) {
        const tarefas = [];
        if (RD_ATIVO) tarefas.push(enviarRD(dados, identificador));
        if (WEB3_ATIVO) tarefas.push(enviarWeb3(dados, parcial));
        if (!tarefas.length) return { ok: false, motivo: 'demo' };
        const resultados = await Promise.allSettled(tarefas);
        resultados.forEach((r) => { if (r.status === 'rejected') console.warn('[form PiaR]', r.reason); });
        const algumOk = resultados.some((r) => r.status === 'fulfilled');
        return { ok: algumOk, motivo: algumOk ? '' : (resultados[0].reason && resultados[0].reason.message) || 'falha' };
      }

      const avisoDemo = '<strong>Formulário em modo demo.</strong>O envio ainda não foi conectado. Quem configura o site precisa colar a chave pública do RD Station (ou a do Web3Forms) no topo do arquivo src/pages/contato.astro.';

      // Passo 1 · grava parcial e avança. Falha de rede não trava a pessoa.
      let parcialEnviado = false;
      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          if (!validarPasso(passos[1])) return;
          feedback.classList.remove('is-visible');
          if (!RD_ATIVO && !WEB3_ATIVO) {
            feedback.className = 'form-feedback error is-visible';
            feedback.innerHTML = avisoDemo;
          } else if (!parcialEnviado) {
            parcialEnviado = true;
            const dados = dadosDoForm();
            dados.cf_classificacao = 'Parcial';
            enviar(dados, { identificador: RD_ID_PARCIAL, parcial: true }).catch(() => {});
          }
          irPara(2);
        });
      }

      // Passo 2 · envio completo
      const btnLabel = submitBtn ? submitBtn.querySelector('.btn-label') : null;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (passoAtual !== 2 || !validarPasso(passos[2])) return;
        if (form.botcheck && form.botcheck.checked) return;

        feedback.classList.remove('is-visible');
        if (!RD_ATIVO && !WEB3_ATIVO) {
          feedback.className = 'form-feedback error is-visible';
          feedback.innerHTML = avisoDemo;
          return;
        }

        const classificacao = classificar();
        document.getElementById('h-classificacao').value = classificacao;
        const dados = dadosDoForm();

        submitBtn.disabled = true;
        if (btnLabel) btnLabel.textContent = 'Enviando…';

        const resultado = await enviar(dados, { identificador: RD_ID_COMPLETO, parcial: false });

        if (resultado.ok) {
          formProgress.style.display = 'none';
          formCard.style.display = 'none';
          const caminho = document.getElementById(classificacao === 'MQL' ? 'confirm-mql' : 'confirm-lead');
          if (caminho) caminho.classList.add('is-visible');
          successScreen.classList.add('is-visible');
          successScreen.scrollIntoView({ behavior: 'smooth', block: 'center' });
          form.reset();
        } else {
          feedback.className = 'form-feedback error is-visible';
          feedback.innerHTML = '<strong>Algo deu errado no envio.</strong>Tente de novo em alguns minutos, ou fale direto no WhatsApp (11) 97563-3655.';
          submitBtn.disabled = false;
          if (btnLabel) btnLabel.textContent = 'Enviar pedido de diagnóstico';
        }
      });
    });
  </script>
</BaseLayout>
