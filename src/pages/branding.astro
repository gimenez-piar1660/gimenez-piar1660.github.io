  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- Lenis + ScrollTrigger (globais via bootstrap.ts) ---- */
      try {
        if (window.gsap && window.ScrollTrigger) window.gsap.registerPlugin(window.ScrollTrigger);
        if (!prefersReduced && window.Lenis) {
          var lenis = new window.Lenis({ duration: 1.15, easing: function (t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); }, smooth: true, lerp: 0.1 });
          if (window.ScrollTrigger) { lenis.on('scroll', window.ScrollTrigger.update); window.gsap.ticker.add(function (time) { lenis.raf(time * 1000); }); window.gsap.ticker.lagSmoothing(0); }
          else { var raf = function (t) { lenis.raf(t); requestAnimationFrame(raf); }; requestAnimationFrame(raf); }
        }
      } catch (e) { /* noop */ }

      /* ---- reveal ---- */
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('active'); io.unobserve(en.target); } });
      }, { threshold: 0.14 });
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

      /* ---- scroll progress ---- */
      var bar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', function () {
        var h = document.documentElement;
        var p = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
        if (bar) bar.style.width = p + '%';
      }, { passive: true });

      /* ---- parallax de profundidade ---- */
      if (!prefersReduced && window.gsap && window.ScrollTrigger) {
        window.gsap.utils.toArray('[data-parallax-y]').forEach(function (el) {
          var yp = parseFloat(el.getAttribute('data-parallax-y')) || 0;
          window.gsap.fromTo(el, { yPercent: 0 }, { yPercent: yp, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } });
        });
      }

      /* ---- lerp mouse-parallax no heroi (Tres Mares) ---- */
      if (!prefersReduced && window.gsap) {
        var heroFloats = window.gsap.utils.toArray('[class*="hero-float"]');
        if (heroFloats.length) {
          var movers = heroFloats.map(function (el, i) {
            return {
              depth: (i % 2 ? 1 : -1) * (16 + i * 8),
              qx: window.gsap.quickTo(el, 'x', { duration: 0.7, ease: 'power3' }),
              qy: window.gsap.quickTo(el, 'y', { duration: 0.7, ease: 'power3' })
            };
          });
          window.addEventListener('mousemove', function (e) {
            var nx = (e.clientX / window.innerWidth - 0.5);
            var ny = (e.clientY / window.innerHeight - 0.5);
            for (var k = 0; k < movers.length; k++) { movers[k].qx(nx * movers[k].depth); movers[k].qy(ny * movers[k].depth); }
          }, { passive: true });
        }
      }

      /* ========================================================
         HERO · campo de coerencia (canvas 2D)
         formas dispersas que convergem para um eixo central
         ======================================================== */
      (function coherenceField() {
        var canvas = document.getElementById('br-hero-canvas');
        if (!canvas) { return; }
        var ctx = canvas.getContext('2d');
        if (!ctx) { canvas.style.background = 'radial-gradient(70% 90% at 75% 30%, #3a2f08 0%, #14110a 55%, #0A0A0C 100%)'; return; }

        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0, axisX = 0;
        var N = 78;
        var shapes = [];
        var t0 = 0;

        function rand(a, b) { return a + Math.random() * (b - a); }

        function build() {
          var rect = canvas.getBoundingClientRect();
          W = rect.width; H = rect.height;
          canvas.width = Math.max(1, Math.floor(W * dpr));
          canvas.height = Math.max(1, Math.floor(H * dpr));
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          // eixo de coerencia: linha vertical no terco direito (atras do conteudo a esquerda)
          axisX = W * 0.72;
          shapes = [];
          for (var i = 0; i < N; i++) {
            var targetY = rand(H * 0.08, H * 0.92);
            shapes.push({
              // posicao dispersa de origem
              ox: rand(W * 0.42, W * 1.04),
              oy: rand(-H * 0.1, H * 1.1),
              // destino: alinhado no eixo
              tx: axisX + rand(-10, 10),
              ty: targetY,
              size: rand(2, 7),
              kind: Math.random() < 0.5 ? 0 : 1, // 0 ponto, 1 traco
              phase: rand(0, Math.PI * 2),
              speed: rand(0.18, 0.5),
              hue: Math.random() < 0.34 ? 1 : 0 // 1 dourado, 0 neutro
            });
          }
        }
        build();
        window.addEventListener('resize', build, { passive: true });

        function draw(now) {
          if (!t0) { t0 = now; }
          var t = (now - t0) / 1000;
          ctx.clearRect(0, 0, W, H);

          // ciclo de coerencia: 0 disperso -> 1 alinhado -> volta
          var cycle = (Math.sin(t * 0.22) * 0.5 + 0.5); // 0..1 suave
          var align = cycle * cycle * (3 - 2 * cycle); // smoothstep

          // eixo central luminoso, intensidade conforme alinhamento
          var axisGlow = 0.06 + align * 0.5;
          var grad = ctx.createLinearGradient(axisX, 0, axisX, H);
          grad.addColorStop(0, 'rgba(254,209,54,0)');
          grad.addColorStop(0.5, 'rgba(254,209,54,' + (axisGlow * 0.85).toFixed(3) + ')');
          grad.addColorStop(1, 'rgba(254,209,54,0)');
          ctx.strokeStyle = grad;
          ctx.lineWidth = 1 + align * 1.6;
          ctx.beginPath();
          ctx.moveTo(axisX, 0);
          ctx.lineTo(axisX, H);
          ctx.stroke();

          for (var i = 0; i < shapes.length; i++) {
            var s = shapes[i];
            // jitter organico quando disperso
            var jx = Math.sin(t * s.speed + s.phase) * (1 - align) * 36;
            var jy = Math.cos(t * s.speed * 0.8 + s.phase) * (1 - align) * 24;
            var x = s.ox + (s.tx - s.ox) * align + jx;
            var y = s.oy + (s.ty - s.oy) * align + jy;

            var op = 0.12 + align * 0.55;
            if (s.hue === 1) {
              ctx.fillStyle = 'rgba(254,209,54,' + (op).toFixed(3) + ')';
              ctx.strokeStyle = 'rgba(254,209,54,' + (op).toFixed(3) + ')';
            } else {
              ctx.fillStyle = 'rgba(214,214,222,' + (op * 0.7).toFixed(3) + ')';
              ctx.strokeStyle = 'rgba(214,214,222,' + (op * 0.7).toFixed(3) + ')';
            }

            if (s.kind === 0) {
              ctx.beginPath();
              ctx.arc(x, y, s.size * (0.55 + align * 0.6), 0, Math.PI * 2);
              ctx.fill();
            } else {
              // traco que rotaciona para vertical conforme alinha
              var ang = (1 - align) * (s.phase) ; // disperso: angulo solto
              var len = s.size * 2.4;
              var dx = Math.sin(ang) * len, dy = Math.cos(ang) * len;
              ctx.lineWidth = 1.4;
              ctx.beginPath();
              ctx.moveTo(x - dx, y - dy);
              ctx.lineTo(x + dx, y + dy);
              ctx.stroke();
            }

            // fio fino ligando ao eixo quando ja perto do alinhamento
            if (align > 0.55) {
              ctx.strokeStyle = 'rgba(254,209,54,' + ((align - 0.55) * 0.4).toFixed(3) + ')';
              ctx.lineWidth = 0.6;
              ctx.beginPath();
              ctx.moveTo(x, y);
              ctx.lineTo(axisX, y);
              ctx.stroke();
            }
          }

          if (!prefersReduced) { raf = requestAnimationFrame(draw); }
        }

        var raf;
        if (prefersReduced) {
          // estado alinhado estatico
          (function staticFrame() {
            ctx.clearRect(0, 0, W, H);
            ctx.strokeStyle = 'rgba(254,209,54,.4)';
            ctx.lineWidth = 1.6;
            ctx.beginPath(); ctx.moveTo(axisX, 0); ctx.lineTo(axisX, H); ctx.stroke();
            for (var i = 0; i < shapes.length; i++) {
              var s = shapes[i];
              ctx.fillStyle = s.hue === 1 ? 'rgba(254,209,54,.6)' : 'rgba(214,214,222,.4)';
              ctx.beginPath(); ctx.arc(s.tx, s.ty, s.size * 0.9, 0, Math.PI * 2); ctx.fill();
            }
          })();
        } else {
          raf = requestAnimationFrame(draw);
        }
      })();

      /* ========================================================
         DATAVIZ · eixos de percepcao (canvas 2D)
         o que voce diz x o que percebem; coerencia alinha os dois
         arraste para fechar a distancia
         ======================================================== */
      (function perceptionAxes() {
        var canvas = document.getElementById('br-perception-canvas');
        if (!canvas) { return; }
        var ctx = canvas.getContext('2d');
        if (!ctx) { return; }
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0;
        // coerencia: 0 totalmente divergente, 1 alinhado. auto-anima, mas o usuario pode arrastar.
        var coh = 0.32;
        var dragging = false, autoT = 0, userActive = false, lastUser = 0;

        var atributos = ['Confiável', 'Inovadora', 'Próxima', 'Líder', 'Clara'];

        function layout() {
          var rect = canvas.getBoundingClientRect();
          W = rect.width; H = rect.height;
          canvas.width = Math.floor(W * dpr); canvas.height = Math.floor(H * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        layout();
        window.addEventListener('resize', layout, { passive: true });

        function draw(now) {
          if (!userActive && !prefersReduced) {
            autoT += 0.0065;
            coh = 0.5 + 0.42 * Math.sin(autoT);
          }
          // se o usuario interagiu ha pouco, segura o valor dele por um tempo
          if (userActive && now - lastUser > 2600) { userActive = false; }

          var spanY = (1 - coh) * (H * 0.16); // separacao dos dois eixos

          // dois eixos horizontais: promessa (cinza, em cima) e percepcao (dourado, embaixo)
          var midY = H * 0.5;
          var yProm = midY - spanY;
          var yPerc = midY + spanY;
          var x0 = W * 0.12, x1 = W * 0.88;

          ctx.clearRect(0, 0, W, H);

          // faixa de coerencia entre os eixos (quando alinha, vira um corredor luminoso)
          var bandOp = coh * 0.22;
          var bg = ctx.createLinearGradient(0, yProm, 0, yPerc);
          bg.addColorStop(0, 'rgba(254,209,54,0)');
          bg.addColorStop(0.5, 'rgba(254,209,54,' + bandOp.toFixed(3) + ')');
          bg.addColorStop(1, 'rgba(254,209,54,0)');
          ctx.fillStyle = bg;
          ctx.fillRect(x0, Math.min(yProm, yPerc), x1 - x0, Math.abs(yPerc - yProm));

          // eixo promessa
          ctx.strokeStyle = 'rgba(154,160,170,.7)';
          ctx.lineWidth = 1.4;
          ctx.beginPath(); ctx.moveTo(x0, yProm); ctx.lineTo(x1, yProm); ctx.stroke();
          // eixo percepcao
          ctx.strokeStyle = 'rgba(254,209,54,.85)';
          ctx.beginPath(); ctx.moveTo(x0, yPerc); ctx.lineTo(x1, yPerc); ctx.stroke();

          // pontos de atributo: posicao horizontal igual; a coerencia aproxima o ponto de percepcao do de promessa
          var n = atributos.length;
          ctx.font = '600 11px "JetBrains Mono", monospace';
          ctx.textBaseline = 'middle';
          for (var i = 0; i < n; i++) {
            var px = x0 + (x1 - x0) * (i / (n - 1));
            // deriva: sem coerencia, percepcao escorrega no eixo X
            var drift = (1 - coh) * (W * 0.10) * Math.sin(i * 1.7 + 1.3);
            var ppx = px + drift;

            // linha conectando promessa -> percepcao do atributo
            var matched = Math.abs(drift) < 7 && coh > 0.78;
            ctx.strokeStyle = matched ? 'rgba(254,209,54,.6)' : 'rgba(255,255,255,.14)';
            ctx.lineWidth = matched ? 1.4 : 0.8;
            ctx.beginPath(); ctx.moveTo(px, yProm); ctx.lineTo(ppx, yPerc); ctx.stroke();

            // ponto promessa
            ctx.beginPath(); ctx.arc(px, yProm, 4, 0, Math.PI * 2);
            ctx.fillStyle = '#9aa0aa'; ctx.fill();
            // ponto percepcao
            ctx.beginPath(); ctx.arc(ppx, yPerc, matched ? 5.5 : 4.5, 0, Math.PI * 2);
            ctx.fillStyle = '#FED136'; ctx.fill();
            if (matched) {
              ctx.beginPath(); ctx.arc(ppx, yPerc, 9 + Math.sin(now / 360 + i) * 2, 0, Math.PI * 2);
              ctx.strokeStyle = 'rgba(254,209,54,.4)'; ctx.lineWidth = 1; ctx.stroke();
            }

            // rotulo do atributo abaixo do eixo de percepcao
            ctx.textAlign = 'center';
            ctx.fillStyle = matched ? 'rgba(255,255,255,.9)' : 'rgba(255,255,255,.5)';
            ctx.fillText(atributos[i], ppx, yPerc + 18);
          }

          // rotulos dos eixos
          ctx.textAlign = 'left';
          ctx.fillStyle = 'rgba(154,160,170,.85)';
          ctx.fillText('O QUE VOCÊ PROMETE', x0, yProm - 16);
          ctx.fillStyle = 'rgba(254,209,54,.95)';
          ctx.fillText('O QUE PERCEBEM', x0, yPerc + 36);

          // medidor de coerencia
          ctx.textAlign = 'right';
          ctx.fillStyle = coh > 0.78 ? 'rgba(254,209,54,.95)' : 'rgba(255,255,255,.6)';
          ctx.fillText('COERÊNCIA ' + Math.round(coh * 100) + '%', x1, H * 0.5);

          requestAnimationFrame(draw);
        }

        function setFromX(clientX) {
          var rect = canvas.getBoundingClientRect();
          var nx = (clientX - rect.left) / rect.width;
          coh = Math.max(0, Math.min(1, nx));
          userActive = true; lastUser = performance.now();
        }
        canvas.addEventListener('mousedown', function (e) { dragging = true; setFromX(e.clientX); });
        window.addEventListener('mouseup', function () { dragging = false; });
        canvas.addEventListener('mousemove', function (e) { if (dragging) setFromX(e.clientX); });
        canvas.addEventListener('touchstart', function (e) { if (e.touches[0]) setFromX(e.touches[0].clientX); }, { passive: true });
        canvas.addEventListener('touchmove', function (e) { if (e.touches[0]) setFromX(e.touches[0].clientX); }, { passive: true });

        if (prefersReduced) {
          coh = 0.92; userActive = true; lastUser = performance.now() + 1e9;
          requestAnimationFrame(function single(n) { draw(n); });
        } else {
          requestAnimationFrame(draw);
        }
      })();
    });
  </script>
</BaseLayout>
