      .erro-card .e-t { font-size: 1.08rem; font-weight: 600; letter-spacing: -.015em; display: flex; gap: .55rem; align-items: flex-start; line-height: 1.25; }
      .erro-card .e-t iconify-icon { color: var(--np-line); font-size: 1.2rem; flex-shrink: 0; margin-top: .12rem; }
      .erro-card .e-d { font-size: .92rem; line-height: 1.55; color: var(--text-muted); margin-top: .7rem; }

      /* sinalizacao · etiqueta de exemplo */
