    <!-- 10 · ERROS COMUNS -->
    <section class="section paper has-ghost">
      <span class="ghost-mark tr px" data-parallax-y="-14" aria-hidden="true">erros</span>
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">Erros comuns</span>
          <h2>O que separa o formato legítimo do <span class="accent-serif">disfarce</span>.</h2>
          <p class="lede">O formato editorial é legítimo. O que arrisca a confiança de quem lê é a falta de transparência, a métrica trocada e a pressa que pula a checagem.</p>
        </div>
        <div class="erros-grid">
          {erros.map((e, i) => (
            <div class:list={['erro-card', 'reveal', (i % 3 === 1) && 'd1', (i % 3 === 2) && 'd2']}>
              <div class="e-t"><iconify-icon icon="solar:danger-triangle-line-duotone"></iconify-icon>{e.t}</div>
              <p class="e-d">{e.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 11 · O MERCADO -->
    <section class="section warm">
      <div class="wrap">
        <div class="sec-head reveal" style="max-width:54ch">
          <span class="eyebrow">Por que o formato cresce</span>
          <h2>O formato editorial pago resolve o que o banner <span class="accent-serif">não resolve</span>.</h2>
          <p class="lede">O investimento em publicidade digital no Brasil somou R$ 37,9 bilhões em 2024, alta de 8% sobre 2023, segundo estudo do IAB Brasil com a Kantar Ibope Media. Portais de conteúdo e verticais responderam por 19% desse total. O publieditorial cresce porque entrega contexto e se hospeda no ambiente de credibilidade do veículo. Estudos de mercado citados pelo setor indicam recall assistido alto para branded content. Use esse argumento com cautela e sempre nomeando a fonte: a métrica só vale com origem pública nomeada.</p>
        </div>
      </div>
    </section>

    <!-- 12 · COMO A PiaR TRATA -->
    <section class="section dark">
      <div class="wrap">
        <div class="sec-head reveal" style="max-width:48ch">
          <span class="eyebrow on-dark">A posição da PiaR</span>
          <h2>Paga complementa earned, e <span class="accent-serif on-dark">nunca substitui</span>.</h2>
          <p class="lede">A PiaR é uma agência de comunicação em São Paulo desde {site.foundingYear}, com relações com a imprensa para clientes reais. Nossa posição sobre conteúdo pago é consistente com a metodologia PEP e com o processo que inclui revisão jurídica.</p>
        </div>
        <div class="reveal d1">
          <span class="ds-mono" style="color:rgba(255,255,255,.5); display:block; margin-bottom:.9rem">/// Entre os clientes atendidos em relações com a imprensa</span>
          <div class="chips">{clientes.map((c) => <span class="chip">{c}</span>)}</div>
        </div>
        <div class="honesty reveal d2">
          <iconify-icon icon="solar:shield-check-line-duotone"></iconify-icon>
          <p>Recusamos o disparo em massa. A pauta certa vai para a redação certa, e o formato pago entra quando resolve um problema que a mídia espontânea não resolve. A gestão de crise sustenta esse trabalho quando a pauta exige resposta rápida e coordenada. Bruno Pinheiro, fundador e CEO, foi eleito Profissional de imprensa no Startup Awards da ABStartups (2018).</p>
        </div>
      </div>
    </section>

    <!-- 13 · FAQ -->
    <section class="section paper">
      <div class="wrap" style="max-width:1000px">
        <div class="sec-head reveal">
          <span class="eyebrow">Perguntas frequentes</span>
          <h2>O que dá para <span class="accent-serif">responder por aqui</span>.</h2>
        </div>
        <div class="reveal d1">
          {faq.map((f) => (
            <details class="faq-item">
              <summary>{f.q}<iconify-icon icon="solar:add-square-linear"></iconify-icon></summary>
              <div class="faq-body">{f.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 14 · CTA -->
    <section class="section dark cta-final has-ghost">
      <span class="ghost-mark bl px" data-parallax-y="12" aria-hidden="true">rota</span>
      <div class="wrap">
        <span class="eyebrow on-dark reveal" style="justify-content:center; display:inline-flex">Vamos conversar</span>
        <h2 class="reveal d1">Mapeie a rota antes de <span class="accent-serif on-dark">investir</span>.</h2>
        <p class="lede reveal d2">Se você está avaliando onde o publieditorial encaixa no seu plano, e onde ele atrapalharia mais do que ajudaria, vale uma conversa para mapear a rota antes de gastar. O investimento da PiaR é sob consulta.</p>
        <div class="cta-row reveal d3">
          <a href="/contato" class="btn btn-accent">Falar com a PiaR<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
          <a href="/relacoes-publicas" class="btn btn-ghost-d">Ver relações públicas<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
        </div>
        <p class="ds-mono reveal d4" style="color:rgba(255,255,255,.4); margin-top:3rem">/// {site.email} · {site.brandDomain}</p>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- Lenis + ScrollTrigger (globais via bootstrap.ts) ---- */
      try {
        if (window.gsap && window.ScrollTrigger) window.gsap.registerPlugin(window.ScrollTrigger);
        if (!prefersReduced && window.Lenis) {
          var lenis = new window.Lenis({ duration: 1.15, easing: function (t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); }, smooth: true, lerp: 0.1 });
          if (window.ScrollTrigger) { lenis.on('scroll', window.ScrollTrigger.update); window.gsap.ticker.add(function (time) { lenis.raf(time * 1000); }); window.gsap.ticker.lagSmoothing(0); }
          else { var raf = function (t) { lenis.raf(t); requestAnimationFrame(raf); }; requestAnimationFrame(raf); }
        }
      } catch (e) { /* noop */ }

      /* ---- reveal ---- */
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('active'); io.unobserve(en.target); } });
      }, { threshold: 0.14 });
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

      /* ---- scroll progress ---- */
      var bar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', function () {
        var h = document.documentElement;
        var p = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
        if (bar) bar.style.width = p + '%';
      }, { passive: true });

      /* ---- parallax de profundidade ---- */
      if (!prefersReduced && window.gsap && window.ScrollTrigger) {
        window.gsap.utils.toArray('[data-parallax-y]').forEach(function (el) {
          var yp = parseFloat(el.getAttribute('data-parallax-y')) || 0;
          window.gsap.fromTo(el, { yPercent: 0 }, { yPercent: yp, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } });
        });
      }

      /* ---- lerp mouse-parallax no heroi (Tres Mares) ---- */
      if (!prefersReduced && window.gsap) {
        var heroFloats = window.gsap.utils.toArray('[class*="hero-float"]');
        if (heroFloats.length) {
          var movers = heroFloats.map(function (el, i) {
            return {
              depth: (i % 2 ? 1 : -1) * (16 + i * 8),
              qx: window.gsap.quickTo(el, 'x', { duration: 0.7, ease: 'power3' }),
              qy: window.gsap.quickTo(el, 'y', { duration: 0.7, ease: 'power3' })
            };
          });
          window.addEventListener('mousemove', function (e) {
            var nx = (e.clientX / window.innerWidth - 0.5);
            var ny = (e.clientY / window.innerHeight - 0.5);
            for (var k = 0; k < movers.length; k++) { movers[k].qx(nx * movers[k].depth); movers[k].qy(ny * movers[k].depth); }
          }, { passive: true });
        }
      }

      /* ========================================================
         HERO · canvas 2D · a fronteira earned x paga (duotom)
         Uma linha viva divide o territorio conquistado (verde) do
         territorio pago (amarelo). Pontos de cada lado pulsam,
         a fronteira ondula, e o titulo fica por cima.
         ======================================================== */
      (function frontierField() {
        var canvas = document.getElementById('np-hero-canvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) { canvas.style.background = 'radial-gradient(70% 90% at 70% 35%, #103a2c 0%, #0c1612 55%, #0A0A0C 100%)'; return; }
        var dpr = Math.min(window.devicePixelRatio || 1, 1.5);
        var W = 0, H = 0, t = 0;
        var EARNED = [61, 216, 164];   // verde · conquistado
        var PAID = [254, 209, 54];     // amarelo · pago
        var LINE = [255, 122, 91];     // a fronteira
        var earnedDots = [], paidDots = [];

        function seed() {
          earnedDots = []; paidDots = [];
          var n = Math.max(26, Math.floor(W / 26));
          for (var i = 0; i < n; i++) {
            earnedDots.push({ bx: Math.random(), by: Math.random(), ph: Math.random() * 6.28, sp: 0.4 + Math.random() * 0.8, r: 0.8 + Math.random() * 1.8 });
            paidDots.push({ bx: Math.random(), by: Math.random(), ph: Math.random() * 6.28, sp: 0.4 + Math.random() * 0.8, r: 0.8 + Math.random() * 1.8 });
          }
        }

        function resize() {
          W = canvas.clientWidth; H = canvas.clientHeight;
          canvas.width = Math.max(1, Math.floor(W * dpr));
          canvas.height = Math.max(1, Math.floor(H * dpr));
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          seed();
        }
        resize();
        window.addEventListener('resize', resize, { passive: true });

        // a fronteira: curva que desce a tela, ondulando no tempo.
        function frontierX(y, time) {
          var base = W * (0.52 + 0.13 * Math.sin(y * 0.0024 + time * 0.22));
          base += 26 * Math.sin(y * 0.011 - time * 0.4);
          return base;
        }

        function rgba(c, a) { return 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + a + ')'; }

        function draw() {
          ctx.clearRect(0, 0, W, H);

          // bandas de territorio (gradientes suaves dos dois lados)
          var gE = ctx.createLinearGradient(0, 0, W, 0);
          gE.addColorStop(0, rgba(EARNED, 0.10)); gE.addColorStop(0.5, rgba(EARNED, 0.02)); gE.addColorStop(1, rgba(EARNED, 0));
          ctx.fillStyle = gE; ctx.fillRect(0, 0, W, H);
          var gP = ctx.createLinearGradient(W, 0, 0, 0);
          gP.addColorStop(0, rgba(PAID, 0.09)); gP.addColorStop(0.5, rgba(PAID, 0.015)); gP.addColorStop(1, rgba(PAID, 0));
          ctx.fillStyle = gP; ctx.fillRect(0, 0, W, H);

          // dots conquistados (lado esquerdo da fronteira)
          for (var i = 0; i < earnedDots.length; i++) {
            var d = earnedDots[i];
            var x = d.bx * W * 0.46;
            var y = d.by * H;
            var pulse = 0.45 + 0.55 * (0.5 + 0.5 * Math.sin(t * d.sp + d.ph));
            ctx.beginPath(); ctx.arc(x, y, d.r, 0, 6.2832);
            ctx.fillStyle = rgba(EARNED, 0.22 + 0.5 * pulse); ctx.fill();
          }
          // dots pagos (lado direito da fronteira)
          for (var j = 0; j < paidDots.length; j++) {
            var p = paidDots[j];
            var px = W * 0.56 + p.bx * W * 0.44;
            var py = p.by * H;
            var pp = 0.45 + 0.55 * (0.5 + 0.5 * Math.sin(t * p.sp + p.ph));
            ctx.beginPath(); ctx.arc(px, py, p.r, 0, 6.2832);
            ctx.fillStyle = rgba(PAID, 0.20 + 0.5 * pp); ctx.fill();
          }

          // a fronteira (glow + linha)
          ctx.beginPath();
          for (var y2 = -10; y2 <= H + 10; y2 += 8) {
            var fx = frontierX(y2, t);
            if (y2 <= -10) ctx.moveTo(fx, y2); else ctx.lineTo(fx, y2);
          }
          ctx.lineWidth = 8; ctx.strokeStyle = rgba(LINE, 0.10);
          ctx.lineJoin = 'round'; ctx.stroke();
          ctx.lineWidth = 1.6; ctx.strokeStyle = rgba(LINE, 0.55); ctx.stroke();

          // marcador que desce a fronteira (a etiqueta cruzando o territorio)
          var my = (H * 0.5) + Math.sin(t * 0.5) * H * 0.34;
          var mx = frontierX(my, t);
          ctx.beginPath(); ctx.arc(mx, my, 3.2, 0, 6.2832);
          ctx.fillStyle = rgba(LINE, 0.95); ctx.fill();
          ctx.beginPath(); ctx.arc(mx, my, 9, 0, 6.2832);
          ctx.fillStyle = rgba(LINE, 0.16); ctx.fill();

          t += 0.016;
          if (!prefersReduced) requestAnimationFrame(draw);
        }

        if (prefersReduced) { t = 12; draw(); } else { requestAnimationFrame(draw); }
      })();

      /* ========================================================
         DATAVIZ · espectro earned x paga + transparencia (canvas 2D)
         Eixo de credibilidade (vertical) x controle (horizontal).
         Tres marcadores: earned (alto, esquerda), pago-honesto
         (medio), pago-velado (baixo). A etiqueta de transparencia
         puxa o pago para cima.
         ======================================================== */
      (function spectrumViz() {
        var canvas = document.getElementById('np-spectrum-canvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0, t = 0;
        var pad = { l: 56, r: 30, t: 28, b: 46 };
        var points = [
          { kx: 0.16, ky: 0.16, c: [61, 216, 164], label: 'Earned', sub: 'credibilidade alta' },
          { kx: 0.62, ky: 0.40, c: [254, 209, 54], label: 'Pago honesto', sub: 'etiqueta visível' },
          { kx: 0.84, ky: 0.84, c: [255, 122, 91], label: 'Pago velado', sub: 'sinalização some' }
        ];
        var hover = -1, mouse = { x: -1, y: -1 };

        function layout() {
          var rect = canvas.getBoundingClientRect();
          W = rect.width; H = rect.height;
          canvas.width = Math.floor(W * dpr); canvas.height = Math.floor(H * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        layout();

        function px(kx) { return pad.l + kx * (W - pad.l - pad.r); }
        function py(ky) { return pad.t + ky * (H - pad.t - pad.b); }
        function rgba(c, a) { return 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + a + ')'; }

        function draw() {
          ctx.clearRect(0, 0, W, H);

          // grade
          ctx.strokeStyle = 'rgba(255,255,255,.07)'; ctx.lineWidth = 1;
          for (var g = 0; g <= 4; g++) {
            var gx = px(g / 4);
            ctx.beginPath(); ctx.moveTo(gx, py(0)); ctx.lineTo(gx, py(1)); ctx.stroke();
            var gy = py(g / 4);
            ctx.beginPath(); ctx.moveTo(px(0), gy); ctx.lineTo(px(1), gy); ctx.stroke();
          }

          // eixos
          ctx.font = '600 10px "JetBrains Mono", monospace';
          ctx.fillStyle = 'rgba(255,255,255,.5)';
          ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
          ctx.save();
          ctx.translate(16, py(0.5)); ctx.rotate(-Math.PI / 2); ctx.textAlign = 'center';
          ctx.fillText('CREDIBILIDADE', 0, 0);
          ctx.restore();
          ctx.textAlign = 'center';
          ctx.fillText('CONTROLE DA MARCA', (px(0) + px(1)) / 2, H - 12);

          // a fronteira: linha diagonal viva que separa "perto da confianca"
          // de "publicidade velada"; a etiqueta honesta mantem o pago acima.
          ctx.beginPath();
          for (var s = 0; s <= 1.001; s += 0.04) {
            var fx = px(s);
            var fy = py(0.30 + s * 0.42 + 0.03 * Math.sin(s * 9 + t));
            if (s === 0) ctx.moveTo(fx, fy); else ctx.lineTo(fx, fy);
          }
          ctx.lineWidth = 1.4; ctx.strokeStyle = 'rgba(255,122,91,.5)'; ctx.stroke();
          ctx.font = '600 9px "JetBrains Mono", monospace';
          ctx.fillStyle = 'rgba(255,122,91,.7)'; ctx.textAlign = 'right';
          ctx.fillText('A ETIQUETA', px(0.98), py(0.30 + 0.42) - 8);

          // seta de transparencia: do pago-velado de volta para o pago-honesto
          var a0 = points[2], a1 = points[1];
          ctx.setLineDash([4, 4]);
          ctx.beginPath();
          ctx.moveTo(px(a0.kx), py(a0.ky));
          ctx.lineTo(px(a1.kx), py(a1.ky));
          ctx.strokeStyle = 'rgba(255,255,255,.28)'; ctx.lineWidth = 1.2; ctx.stroke();
          ctx.setLineDash([]);

          // pontos
          ctx.textBaseline = 'middle';
          for (var i = 0; i < points.length; i++) {
            var p = points[i];
            var X = px(p.kx), Y = py(p.ky);
            var active = hover === i;
            var ring = 7 + (Math.sin(t * 1.4 + i) + 1) * 2;
            ctx.beginPath(); ctx.arc(X, Y, ring + (active ? 3 : 0), 0, 6.2832);
            ctx.fillStyle = rgba(p.c, 0.14); ctx.fill();
            ctx.beginPath(); ctx.arc(X, Y, active ? 6.5 : 5, 0, 6.2832);
            ctx.fillStyle = rgba(p.c, 0.96); ctx.fill();
            ctx.font = '700 11px "JetBrains Mono", monospace';
            ctx.fillStyle = 'rgba(255,255,255,.94)';
            ctx.textAlign = X > W * 0.6 ? 'right' : 'left';
            var ox = X > W * 0.6 ? -12 : 12;
            ctx.fillText(p.label, X + ox, Y - 6);
            ctx.font = '600 9px "JetBrains Mono", monospace';
            ctx.fillStyle = 'rgba(255,255,255,.55)';
            ctx.fillText(p.sub, X + ox, Y + 8);
          }

          t += 0.02;
          if (!prefersReduced) requestAnimationFrame(draw);
        }

        canvas.addEventListener('mousemove', function (e) {
          var rect = canvas.getBoundingClientRect();
          mouse.x = e.clientX - rect.left; mouse.y = e.clientY - rect.top;
          hover = -1;
          for (var i = 0; i < points.length; i++) {
            if (Math.hypot(px(points[i].kx) - mouse.x, py(points[i].ky) - mouse.y) < 22) { hover = i; break; }
          }
        });
        canvas.addEventListener('mouseleave', function () { hover = -1; });
        window.addEventListener('resize', function () { layout(); }, { passive: true });

        if (prefersReduced) { t = 6; draw(); } else { requestAnimationFrame(draw); }
      })();
    });
  </script>
</BaseLayout>
