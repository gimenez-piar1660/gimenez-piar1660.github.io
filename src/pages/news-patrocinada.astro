---
// ============================================================================
// Exemplar narrativo · News patrocinada e publieditorial
// Conteudo voice-backed portado de:
//   src/content/pages/news-patrocinada.md
// Original preservado. Esta pagina e a versao "narrativa espetacular":
// heroi canvas 2D (a fronteira earned x paga, duotom) + dataviz de espectro
// earned/pago com transparencia (canvas 2D) + scroll storytelling (GSAP/Lenis),
// sobre o DS da PiaR (eyebrow-dot, watermarks, inversao dark, contorno,
// lerp mouse-parallax).
// ============================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import { site } from '@/data/site';

const url = `${site.domain}/news-patrocinada`;

// Os tres formatos: anuncio, news patrocinada, midia espontanea.
const formatos = [
  {
    id: 'PAGO',
    nome: 'Anúncio tradicional',
    tag: 'Display, banner',
    o: 'Espaço pago, formato declaradamente publicitário. Ninguém confunde com matéria.',
    fonte: 'A marca',
    decisao: 'Comercial',
    icon: 'solar:gallery-wide-line-duotone',
  },
  {
    id: 'HIBRIDO',
    nome: 'News patrocinada',
    tag: 'Publieditorial, branded content',
    o: 'Conteúdo pago em formato editorial, com sinalização clara de patrocínio. Fica entre o anúncio e a matéria.',
    fonte: 'A marca, com etiqueta',
    decisao: 'Comercial, sinalizada',
    icon: 'solar:feed-line-duotone',
    featured: true,
  },
  {
    id: 'EARNED',
    nome: 'Mídia espontânea',
    tag: 'Earned media',
    o: 'O veículo publica porque a pauta tem interesse jornalístico. Sem pagamento. Constrói credibilidade.',
    fonte: 'O jornalista',
    decisao: 'Editorial',
    icon: 'solar:medal-ribbons-star-line-duotone',
  },
];

// O passo a passo de producao com transparencia.
const passos = [
  {
    num: '01',
    titulo: 'Decida a rota antes de gastar',
    desc: 'Tem gancho jornalístico de verdade, a pauta vai à redação como earned media. Não tem gancho, mas tem valor real para o leitor, entra a rota paga. Essa triagem evita pagar pelo que sairia de graça.',
  },
  {
    num: '02',
    titulo: 'Escolha o veículo pelo público',
    desc: 'O leitor do veículo precisa ser seu público-alvo, não o alcance bruto. Verifique a política de sinalização antes de fechar: como ele etiqueta o patrocínio e onde a etiqueta aparece.',
  },
  {
    num: '03',
    titulo: 'Defina o ângulo por dado e utilidade',
    desc: 'O publieditorial bom entrega informação que serve ao leitor, não um folheto de vendas. Comece pela pergunta que o público tem, não pelo recado da marca.',
  },
  {
    num: '04',
    titulo: 'Produza no padrão editorial',
    desc: 'Estrutura de matéria, dados verificáveis, citação nomeada. Mas sem imitar a voz jornalística do veículo a ponto de enganar. O leitor deve reconhecer que é conteúdo de marca.',
  },
  {
    num: '05',
    titulo: 'Sinalize de forma ostensiva',
    desc: 'A etiqueta precisa estar visível e imediata, no topo, sem depender de interação do usuário. O guia do CONAR recomenda sinalização ostensiva, visível e imediata.',
  },
  {
    num: '06',
    titulo: 'Submeta à revisão jurídica',
    desc: 'Claims sobre produto, comparações, dados de mercado e setores regulados (saúde, finanças) passam por checagem antes de publicar. É o passo que a pressa costuma pular.',
  },
  {
    num: '07',
    titulo: 'Meça o que importa',
    desc: 'Defina antes se o objetivo é alcance, leitura qualificada ou conversão. Acompanhe e registre o resultado com clipping e dados do veículo, para alimentar a próxima decisão.',
  },
];

// Quando usar o formato pago.
const quandoUsar = [
  {
    nome: 'Controle de mensagem e timing',
    desc: 'Lançamento com data fixa, posicionamento sobre tema sensível, produto complexo que o jornalista não cobriria em profundidade. O pago garante espaço que a pauta espontânea não garante.',
    icon: 'solar:calendar-mark-line-duotone',
  },
  {
    nome: 'Pauta sem gancho, com valor',
    desc: 'Conteúdo educativo, guia técnico, contexto de mercado. Não vira matéria espontânea, mas serve à audiência do veículo.',
    icon: 'solar:book-2-line-duotone',
  },
  {
    nome: 'Presença em veículo de nicho',
    desc: 'Quando o público do veículo é exatamente seu público-alvo e a marca quer estar lá de forma recorrente.',
    icon: 'solar:target-line-duotone',
  },
  {
    nome: 'Amplificação de um earned',
    desc: 'Uma conquista real (prêmio, dado de mercado, estudo próprio) pode render matéria espontânea e, em paralelo, um publieditorial que aprofunda o tema.',
    icon: 'solar:volume-loud-line-duotone',
  },
];

// Quando NAO usar.
const quandoNao = [
  'Para fabricar autoridade que você não tem. Pagar por espaço editorial não constrói reputação se o conteúdo não se sustenta. O leitor percebe.',
  'Como substituto da assessoria de imprensa. Se a única presença da marca na mídia é paga, a ausência de cobertura espontânea fica evidente e enfraquece o posicionamento.',
  'Quando a pauta tem gancho noticioso real. Se o fato é notícia, leve à redação primeiro. Pagar por algo que sairia de graça desperdiça orçamento e retira a credibilidade da cobertura espontânea.',
  'Sem orçamento para sinalização honesta. Se o veículo se recusa a etiquetar com clareza, recuse a publicação. Publicidade velada é risco jurídico e reputacional, não economia.',
];

// Erros comuns.
const erros = [
  { t: 'Sinalização escondida ou ambígua', d: 'Etiqueta em cinza-claro no fim do texto, ou termos vagos como "em colaboração". O leitor precisa saber que é pago antes de começar a ler.' },
  { t: 'Imitar a voz do veículo para enganar', d: 'Copiar a identidade jornalística a ponto de o leitor não distinguir. O formato editorial é legítimo; o disfarce não.' },
  { t: 'Pagar pelo que sairia de graça', d: 'Transformar em publieditorial uma pauta que tem gancho noticioso real. Desperdício de orçamento e perda da credibilidade da cobertura espontânea.' },
  { t: 'Tratar o pago como atalho', d: 'Comprar espaço não constrói autoridade sozinho. Sem lastro de conteúdo e sem presença editorial espontânea, o efeito é raso.' },
  { t: 'Pular a revisão jurídica', d: 'Claims sem comprovação, comparações diretas com concorrentes, dados sem fonte. Em setores regulados, isso vira passivo.' },
  { t: 'Confundir a métrica', d: 'Cobrar de um publieditorial a credibilidade que só a mídia espontânea entrega, ou vice-versa. Cada formato cumpre um papel.' },
];

const clientes = ['Endemol Shine Brasil', 'Big Brother Brasil', 'Solides', 'Mastercard Agro', 'AgroSmart', 'Vila 11', 'Doctoralia'];

const faq = [
  {
    q: 'News patrocinada é a mesma coisa que publieditorial?',
    a: 'Na prática, sim. "Publieditorial" é o termo tradicional para conteúdo editorial pago em veículos; "news patrocinada", "branded content" e "native advertising" são variações mais recentes do mesmo princípio: conteúdo pago em formato editorial, com sinalização de patrocínio.',
  },
  {
    q: 'Publieditorial é jornalismo?',
    a: 'Não. Tem formato jornalístico, mas a decisão de publicar é comercial e o ângulo é definido pela marca. Por isso a sinalização de patrocínio é obrigatória: é o que diferencia publieditorial de publicidade velada.',
  },
  {
    q: 'Preciso sinalizar mesmo se não houve pagamento em dinheiro?',
    a: 'Sim. Segundo o guia do CONAR de 2026, a caracterização de publicidade independe de pagamento direto: permuta, benefício indireto ou qualquer relação comercial que influencie o conteúdo exige sinalização.',
  },
  {
    q: 'News patrocinada substitui assessoria de imprensa?',
    a: 'Não. Earned media constrói credibilidade porque a decisão de publicar é do jornalista. O pago garante espaço e controle, mas não entrega a mesma credibilidade. Os dois se complementam; um não troca pelo outro.',
  },
  {
    q: 'Onde a etiqueta de patrocínio deve aparecer?',
    a: 'No topo, de forma ostensiva, visível e imediata, sem depender de o leitor clicar ou rolar a página, conforme a orientação do CONAR. Termos inequívocos como "Conteúdo patrocinado" ou "Publicidade" funcionam melhor que expressões vagas.',
  },
  {
    q: 'Quanto custa um publieditorial?',
    a: 'Varia por veículo, formato, tempo de permanência e produção. Não há tabela única de mercado. O custo deve ser avaliado contra o objetivo definido (alcance, leitura qualificada ou conversão) e comparado ao que a rota earned entregaria pelo mesmo orçamento. O investimento da PiaR é sob consulta.',
  },
  {
    q: 'O publieditorial prejudica a credibilidade da marca?',
    a: 'Não, se for sinalizado com honestidade e tiver conteúdo que serve ao leitor. Prejudica quando tenta se passar por matéria espontânea. A transparência é o que preserva a confiança de quem lê.',
  },
];
---
<BaseLayout
  title="News patrocinada: a fronteira entre o que você conquista e o que você paga"
  description="News patrocinada (publieditorial) é conteúdo pago em formato editorial, com sinalização clara de patrocínio. O que é, quando usar, quando evitar e como manter a transparência. Na PiaR, paga complementa earned, nunca substitui."
  canonical={url}
>
  <Fragment slot="head">
    <style is:global>
      :root {
        --accent: #FED136;
        --accent-deep: #E0B420;
        --paper-warm: #F4F1EA;
        --np-ink: #0A0A0C;
        --np-ink-2: #141417;
        --np-earned: #3DD8A4;      /* territorio conquistado */
        --np-paid: #FED136;        /* territorio pago */
        --np-line: #FF7A5B;        /* a fronteira */
        --radius-card: 24px;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 700; }
      body { font-family: var(--font-sans); background: var(--paper); color: var(--primary); overflow-x: hidden; -webkit-font-smoothing: antialiased; font-feature-settings: "ss01", "cv11"; }

      #scroll-progress { position: fixed; top: 0; left: 0; height: 2px; background: var(--accent); z-index: 9999; width: 0; transition: width .1s linear; }

      .wrap { max-width: 1280px; margin: 0 auto; padding-inline: 1.5rem; position: relative; z-index: 1; }
      @media (min-width: 768px) { .wrap { padding-inline: 2rem; } }

      .eyebrow { display: inline-flex; align-items: center; gap: .6rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; color: var(--text-muted); font-weight: 600; }
      .eyebrow::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex-shrink: 0; box-shadow: 0 0 0 4px rgba(254,209,54,.18); }
      .eyebrow.on-dark { color: rgba(255,255,255,.72); }

      .accent-serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--accent-deep); letter-spacing: -.02em; }
      .accent-serif.on-dark { color: var(--accent); }

      /* botoes */
      .btn { display: inline-flex; align-items: center; gap: .55rem; padding: .9rem 1.7rem; border-radius: var(--radius-btn); font-size: .95rem; font-weight: 600; letter-spacing: -.01em; text-decoration: none; transition: var(--t-smooth); cursor: pointer; border: 1.5px solid transparent; }
      .btn iconify-icon { transition: transform .4s var(--ease-out-expo); }
      .btn:hover iconify-icon { transform: translateX(4px); }
      .btn-accent { background: var(--accent); color: var(--primary); border-color: var(--accent); }
      .btn-accent:hover { background: #FFD84A; transform: translateY(-2px); box-shadow: 0 16px 32px rgba(254,209,54,.32); }
      .btn-ghost-d { background: transparent; color: #fff; border-color: rgba(255,255,255,.25); }
      .btn-ghost-d:hover { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.5); }
      .btn-ghost { background: transparent; color: var(--primary); border-color: rgba(0,0,0,.16); }
      .btn-ghost:hover { background: rgba(0,0,0,.04); border-color: rgba(0,0,0,.32); }

      /* ===========================================================
         1 · HERO · canvas 2D · a fronteira earned x paga (duotom)
         =========================================================== */
      .np-hero { position: relative; min-height: 100vh; min-height: 100svh; background: var(--np-ink); color: #fff; overflow: hidden; display: flex; align-items: center; isolation: isolate; }
      #np-hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; display: block; }
      .np-hero .scrim { position: absolute; inset: 0; z-index: 1; pointer-events: none;
        background:
          radial-gradient(120% 90% at 20% 38%, rgba(10,10,12,.84) 0%, rgba(10,10,12,.36) 46%, rgba(10,10,12,0) 72%),
          linear-gradient(180deg, rgba(10,10,12,.5) 0%, rgba(10,10,12,0) 30%, rgba(10,10,12,.2) 74%, rgba(10,10,12,.92) 100%);
      }
      .np-hero .hero-inner { position: relative; z-index: 2; width: 100%; padding-block: 9rem 4rem; }
      .np-hero-chip { display: inline-flex; align-items: center; gap: .5rem; padding: .5rem 1rem; border-radius: var(--radius-pill); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(6px); font-family: var(--font-mono); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.78); }
      .np-hero-chip .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px 1px rgba(254,209,54,.7); }
      .np-hero h1 { font-size: clamp(2.8rem, 8vw, 7.4rem); font-weight: 700; line-height: .94; letter-spacing: -.045em; margin: 1.6rem 0 0; max-width: 18ch; text-wrap: balance; }
      .np-hero .sub { font-size: clamp(1.1rem, 1.7vw, 1.4rem); line-height: 1.5; color: rgba(255,255,255,.74); margin-top: 1.75rem; max-width: 50ch; }
      .np-hero .cta-row { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2.5rem; }
      .np-scroll-cue { position: absolute; left: 50%; bottom: 1.75rem; transform: translateX(-50%); z-index: 2; display: inline-flex; flex-direction: column; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .6rem; letter-spacing: .2em; text-transform: uppercase; color: rgba(255,255,255,.5); }
      .np-scroll-cue .line { width: 1px; height: 38px; background: linear-gradient(180deg, rgba(255,255,255,.5), transparent); animation: cuePulse 2.2s var(--ease-out-expo) infinite; }
      @keyframes cuePulse { 0%,100% { opacity: .3; transform: scaleY(.7); transform-origin: top; } 50% { opacity: 1; transform: scaleY(1); } }

      /* parallax de profundidade */
      .px { will-change: transform; }
      .has-ghost { overflow: hidden; }
      .ghost-mark { position: absolute; z-index: 0; font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: clamp(7rem, 24vw, 24rem); line-height: .78; letter-spacing: -.04em; color: rgba(15,15,17,.045); pointer-events: none; user-select: none; white-space: nowrap; }
      .section.dark .ghost-mark { color: rgba(255,255,255,.04); }
      .ghost-mark.tr { top: -2rem; right: -1.5rem; }
      .ghost-mark.bl { bottom: -3rem; left: -2rem; }
      .np-hero-float { position: absolute; z-index: 2; display: inline-flex; align-items: center; gap: .5rem; padding: .55rem 1rem; border-radius: var(--radius-pill); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(6px); font-family: var(--font-mono); font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.72); }
      .np-hero-float .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--np-earned); box-shadow: 0 0 8px 1px rgba(61,216,164,.7); }
      .np-hero-float.f2 .dot { background: var(--np-paid); box-shadow: 0 0 8px 1px rgba(254,209,54,.7); }
      .np-hero-float.f1 { right: 9%; top: 26%; }
      .np-hero-float.f2 { right: 16%; bottom: 22%; }
      @media (max-width: 900px) { .np-hero-float { display: none; } .ghost-mark { font-size: clamp(6rem, 30vw, 12rem); } }

      /* Tres Mares · contorno (a divisa earned/paga) como camada de profundidade */
      .has-contour { overflow: hidden; }
      .contour-field {
        position: absolute; inset: -14% -10%; z-index: 0; pointer-events: none;
        --contour-line: rgba(254,209,54,.09);
        background:
          linear-gradient(91deg, transparent 0 49.4%, rgba(255,122,91,.16) 49.4% 50.6%, transparent 50.6% 100%),
          repeating-linear-gradient(0deg, transparent 0 44px, var(--contour-line) 44px 45px);
        -webkit-mask-image: radial-gradient(circle at 50% 45%, #000 0%, rgba(0,0,0,.55) 44%, transparent 80%);
                mask-image: radial-gradient(circle at 50% 45%, #000 0%, rgba(0,0,0,.55) 44%, transparent 80%);
        will-change: transform;
      }
      @media (max-width: 760px) { .contour-field { opacity: .6; } }

      /* ===========================================================
         secoes base
         =========================================================== */
      .section { padding-block: var(--sec-pad); position: relative; }
      .section.paper { background: var(--paper); border-top: 1px solid var(--hairline); }
      .section.warm { background: var(--paper-warm); border-top: 1px solid var(--hairline); }
      .section.dark { background: var(--np-ink); color: #fff; border-top: 1px solid rgba(255,255,255,.06); }
      .section h2 { font-size: clamp(2.1rem, 4.6vw, 4rem); font-weight: 600; line-height: 1.03; letter-spacing: -.035em; margin: 1rem 0 0; max-width: 20ch; text-wrap: balance; }
      .section.dark h2 { color: #fff; }
      .lede { font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.55; color: var(--text-muted); margin-top: 1.5rem; max-width: 58ch; }
      .section.dark .lede { color: rgba(255,255,255,.72); }
      .sec-head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }

      /* compare 2 colunas (earned x paga) */
      .compare { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
      @media (min-width: 900px) { .compare { grid-template-columns: 1fr 1fr; gap: 1.5rem; } }
      .compare-card { padding: clamp(2rem, 3vw, 2.75rem); border-radius: var(--radius-card); border: 1px solid var(--hairline); background: #fff; min-height: 280px; display: flex; flex-direction: column; }
      .compare-card .ctag { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--text-faint); }
      .compare-card h3 { font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 600; letter-spacing: -.025em; margin: .9rem 0 0; line-height: 1.1; }
      .compare-card p { font-size: 1.0625rem; line-height: 1.6; color: var(--text-muted); margin-top: 1rem; }
      .compare-card .steps { margin-top: auto; padding-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; color: var(--text-faint); }
      .compare-card .steps iconify-icon { color: var(--accent-deep); }
      .compare-card.is-dark { background: var(--np-ink-2); border-color: rgba(255,255,255,.12); color: #fff; }
      .compare-card.is-dark .ctag { color: rgba(255,255,255,.45); }
      .compare-card.is-dark p { color: rgba(255,255,255,.72); }
      .compare-card.is-dark .steps { color: rgba(255,255,255,.5); }
      .compare-card.is-dark .steps iconify-icon { color: var(--accent); }
      .punch { font-family: var(--font-serif); font-style: italic; font-size: clamp(1.6rem, 3.4vw, 2.9rem); line-height: 1.18; letter-spacing: -.02em; margin-top: clamp(2.5rem, 5vw, 3.5rem); max-width: 26ch; }
      .punch .hl { color: var(--accent-deep); font-style: italic; }
      .section.dark .punch .hl { color: var(--accent); }

      /* tres formatos */
      .layers { display: grid; grid-template-columns: 1fr; gap: 1rem; }
      @media (min-width: 980px) { .layers { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; } }
      .layer-card { position: relative; padding: clamp(1.75rem, 2.4vw, 2.25rem); border-radius: var(--radius-card); border: 1px solid var(--hairline); background: #fff; overflow: hidden; transition: var(--t-smooth); }
      .layer-card:hover { transform: translateY(-4px); box-shadow: 0 24px 48px rgba(0,0,0,.07); border-color: rgba(0,0,0,.14); }
      .layer-card .l-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: rgba(15,15,17,.05); color: var(--primary); font-size: 1.4rem; }
      .layer-card .l-id { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text-faint); margin-top: 1.25rem; }
      .layer-card .l-name { font-size: 1.4rem; font-weight: 600; letter-spacing: -.025em; margin-top: .3rem; line-height: 1.12; }
      .layer-card .l-tag { font-family: var(--font-mono); font-size: .64rem; letter-spacing: .1em; text-transform: uppercase; color: var(--accent-deep); margin-top: .45rem; }
      .layer-card .l-otimiza { font-size: 1rem; line-height: 1.55; color: var(--text-muted); margin-top: .85rem; }
      .layer-card .l-meta { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--hairline); display: flex; flex-direction: column; gap: .55rem; }
      .layer-card .l-meta .row { display: flex; justify-content: space-between; gap: 1rem; font-size: .82rem; }
      .layer-card .l-meta .k { font-family: var(--font-mono); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: var(--text-faint); }
      .layer-card .l-meta .v { font-weight: 600; text-align: right; letter-spacing: -.01em; }
      .layer-card.featured { background: var(--np-ink); color: #fff; border-color: var(--np-ink); }
      .layer-card.featured::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(90% 60% at 80% 0%, rgba(254,209,54,.20) 0%, transparent 60%), radial-gradient(70% 50% at 8% 100%, rgba(61,216,164,.14) 0%, transparent 60%); }
      .layer-card.featured .l-icon { background: rgba(255,255,255,.08); color: var(--accent); position: relative; z-index: 1; }
      .layer-card.featured .l-id { color: var(--accent); position: relative; z-index: 1; }
      .layer-card.featured .l-tag { color: var(--np-earned); position: relative; z-index: 1; }
