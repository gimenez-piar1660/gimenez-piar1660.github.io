      window.addEventListener('scroll', function () {
        var h = document.documentElement;
        var p = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
        if (bar) bar.style.width = p + '%';
      }, { passive: true });

      /* ---- parallax de profundidade ---- */
      if (!prefersReduced && window.gsap && window.ScrollTrigger) {
        window.gsap.utils.toArray('[data-parallax-y]').forEach(function (el) {
          var yp = parseFloat(el.getAttribute('data-parallax-y')) || 0;
          window.gsap.fromTo(el, { yPercent: 0 }, { yPercent: yp, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } });
        });
      }

      /* ---- lerp mouse-parallax no herói (Três Mares) ---- */
      if (!prefersReduced && window.gsap) {
        var heroFloats = window.gsap.utils.toArray('[class*="hero-float"]');
        if (heroFloats.length) {
          var movers = heroFloats.map(function (el, i) {
            return {
              depth: (i % 2 ? 1 : -1) * (16 + i * 8),
              qx: window.gsap.quickTo(el, 'x', { duration: 0.7, ease: 'power3' }),
              qy: window.gsap.quickTo(el, 'y', { duration: 0.7, ease: 'power3' })
            };
          });
          window.addEventListener('mousemove', function (e) {
            var nx = (e.clientX / window.innerWidth - 0.5);
            var ny = (e.clientY / window.innerHeight - 0.5);
            for (var k = 0; k < movers.length; k++) { movers[k].qx(nx * movers[k].depth); movers[k].qy(ny * movers[k].depth); }
          }, { passive: true });
        }
      }

      /* ========================================================
         HERO · trajetória de rounds (canvas 2D)
         linha ascendente com marcos pre-seed, seed, A, B e a
         cobertura de imprensa acompanhando a curva. amarelo -> âmbar.
         ======================================================== */
      (function roundsTrajectory() {
        var canvas = document.getElementById('rp-hero-canvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) { canvas.style.background = 'radial-gradient(70% 90% at 75% 30%, #3a2c05 0%, #160f06 55%, #0A0A0C 100%)'; return; }
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0;

        // marcos de round em coordenadas normalizadas (x cresce, y sobe)
        var marks = [
          { t: 0.10, v: 0.12, label: 'Pre-seed' },
          { t: 0.36, v: 0.34, label: 'Seed' },
          { t: 0.64, v: 0.62, label: 'Series A' },
          { t: 0.90, v: 0.88, label: 'Series B' }
        ];

        function resize() {
          var rect = canvas.getBoundingClientRect();
          W = rect.width; H = rect.height;
          canvas.width = Math.max(1, Math.floor(W * dpr));
          canvas.height = Math.max(1, Math.floor(H * dpr));
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        resize();
        window.addEventListener('resize', resize, { passive: true });

        // smoothstep entre marcos para a curva ascendente
        function curveV(t) {
          if (t <= marks[0].t) return marks[0].v;
          if (t >= marks[marks.length - 1].t) return marks[marks.length - 1].v;
          for (var i = 0; i < marks.length - 1; i++) {
            var a = marks[i], b = marks[i + 1];
            if (t >= a.t && t <= b.t) {
              var u = (t - a.t) / (b.t - a.t);
              var s = u * u * (3 - 2 * u);
              return a.v + (b.v - a.v) * s;
            }
          }
          return marks[marks.length - 1].v;
        }

        // mapeia normalizado para tela. y sobe -> menor pixel
        function px(t) { return W * (0.06 + t * 0.9); }
        function py(v) { return H * (0.9 - v * 0.74); }

        var start = 0, raf = 0;

        function frame(now) {
          if (!start) start = now;
          var el = (now - start) / 1000;
          ctx.clearRect(0, 0, W, H);

          // grade sutil de fundo
          ctx.strokeStyle = 'rgba(255,255,255,.04)';
          ctx.lineWidth = 1;
          for (var g = 1; g < 5; g++) {
            var gy = H * (0.18 + g * 0.16);
            ctx.beginPath(); ctx.moveTo(W * 0.04, gy); ctx.lineTo(W * 0.97, gy); ctx.stroke();
          }

          // progressão animada de revelação da curva (loop suave)
          var prog = (Math.sin(el * 0.35 - Math.PI / 2) + 1) / 2;
          prog = 0.18 + prog * 0.82;
          if (prefersReduced) prog = 1;

          var steps = 120;
          var maxT = prog;

          // 1) faixa de cobertura de imprensa (área âmbar abaixo da curva)
          ctx.beginPath();
          ctx.moveTo(px(0), py(0));
          for (var k = 0; k <= steps; k++) {
            var tt = (k / steps) * maxT;
            ctx.lineTo(px(tt), py(curveV(tt)));
          }
          ctx.lineTo(px(maxT), py(0));
          ctx.closePath();
          var gradA = ctx.createLinearGradient(0, py(1), 0, py(0));
          gradA.addColorStop(0, 'rgba(255,176,32,.20)');
          gradA.addColorStop(0.55, 'rgba(255,176,32,.07)');
          gradA.addColorStop(1, 'rgba(255,176,32,0)');
          ctx.fillStyle = gradA;
          ctx.fill();

          // 2) linha de cobertura (oscila levemente acompanhando a curva, mais espessa onde há mais mídia)
          ctx.beginPath();
          for (var c = 0; c <= steps; c++) {
            var ct = (c / steps) * maxT;
            var jitter = Math.sin(ct * 26 + el * 1.4) * (3 + ct * 9);
            var cy = py(curveV(ct)) + 16 + ct * 10 + jitter;
            if (c === 0) ctx.moveTo(px(ct), cy); else ctx.lineTo(px(ct), cy);
          }
          ctx.strokeStyle = 'rgba(255,176,32,.55)';
          ctx.lineWidth = 1.4;
          ctx.stroke();

          // 3) curva de rounds (linha principal, gradiente amarelo -> âmbar)
          var gradL = ctx.createLinearGradient(px(0), 0, px(1), 0);
          gradL.addColorStop(0, '#FED136');
          gradL.addColorStop(1, '#FFB020');
          ctx.beginPath();
          for (var m = 0; m <= steps; m++) {
            var mt = (m / steps) * maxT;
            if (m === 0) ctx.moveTo(px(mt), py(curveV(mt))); else ctx.lineTo(px(mt), py(curveV(mt)));
          }
          ctx.strokeStyle = gradL;
          ctx.lineWidth = 3;
          ctx.lineJoin = 'round';
          ctx.shadowColor = 'rgba(254,209,54,.5)';
          ctx.shadowBlur = 18;
          ctx.stroke();
          ctx.shadowBlur = 0;

          // 4) marcos (círculos + label) revelados conforme a progressão
          ctx.font = '600 12px "JetBrains Mono", monospace';
          ctx.textBaseline = 'middle';
          for (var n = 0; n < marks.length; n++) {
            var mk = marks[n];
            if (mk.t > maxT + 0.02) continue;
            var mx = px(mk.t), myy = py(mk.v);
            var pulse = (Math.sin(el * 1.6 + n) + 1) * 3;
            ctx.beginPath(); ctx.arc(mx, myy, 9 + pulse, 0, Math.PI * 2);
            ctx.strokeStyle = 'rgba(254,209,54,.3)'; ctx.lineWidth = 1; ctx.stroke();
            ctx.beginPath(); ctx.arc(mx, myy, 5.5, 0, Math.PI * 2);
            ctx.fillStyle = '#FED136'; ctx.fill();
            ctx.beginPath(); ctx.arc(mx, myy, 2.4, 0, Math.PI * 2);
            ctx.fillStyle = '#0A0A0C'; ctx.fill();
            ctx.textAlign = 'left';
            ctx.fillStyle = 'rgba(255,255,255,.7)';
            ctx.fillText(mk.label, mx + 14, myy - 14);
          }

          // 5) ponto de cabeça brilhante na ponta da curva
          var ht = maxT, hx = px(ht), hy = py(curveV(ht));
          ctx.beginPath(); ctx.arc(hx, hy, 4, 0, Math.PI * 2);
          ctx.fillStyle = '#FFE89A'; ctx.fill();
          ctx.beginPath(); ctx.arc(hx, hy, 11, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(255,232,154,.16)'; ctx.fill();

          if (!prefersReduced) raf = requestAnimationFrame(frame);
        }
        raf = requestAnimationFrame(frame);
      })();

      /* ========================================================
         DATAVIZ · timeline de rounds x cobertura (canvas 2D)
         barras de cobertura por trimestre subindo junto dos rounds
         ======================================================== */
      (function roundsTimeline() {
        var canvas = document.getElementById('rp-timeline-canvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0;

        // 8 trimestres: cobertura crescente, com saltos nos rounds
        var bars = [
          { q: 'T1', cov: 0.10, round: null },
          { q: 'T2', cov: 0.16, round: null },
          { q: 'T3', cov: 0.30, round: 'Pre-seed' },
          { q: 'T4', cov: 0.34, round: null },
          { q: 'T5', cov: 0.52, round: 'Seed' },
          { q: 'T6', cov: 0.58, round: null },
          { q: 'T7', cov: 0.80, round: 'Series A' },
          { q: 'T8', cov: 0.92, round: null }
        ];

        function layout() {
          var rect = canvas.getBoundingClientRect();
          W = rect.width; H = rect.height;
          canvas.width = Math.floor(W * dpr); canvas.height = Math.floor(H * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        layout();

        var t0 = 0;

        function draw(now) {
          if (!t0) t0 = now;
          var el = (now - t0) / 1000;
          var grow = prefersReduced ? 1 : Math.min(1, el / 1.4);

          ctx.clearRect(0, 0, W, H);

          var padL = W * 0.08, padR = W * 0.06, padB = H * 0.16, padT = H * 0.12;
          var plotW = W - padL - padR, plotH = H - padB - padT;
          var n = bars.length;
          var slot = plotW / n;
          var bw = slot * 0.46;

          // baseline
          ctx.strokeStyle = 'rgba(255,255,255,.12)';
          ctx.lineWidth = 1;
          ctx.beginPath(); ctx.moveTo(padL, padT + plotH); ctx.lineTo(padL + plotW, padT + plotH); ctx.stroke();

          // barras de cobertura
          ctx.font = '600 10px "JetBrains Mono", monospace';
          ctx.textBaseline = 'middle';
          for (var i = 0; i < n; i++) {
            var b = bars[i];
            var cx = padL + slot * i + slot / 2;
            var hgt = plotH * b.cov * grow;
            var bx = cx - bw / 2, by = padT + plotH - hgt;

            var g = ctx.createLinearGradient(0, by, 0, padT + plotH);
            g.addColorStop(0, b.round ? '#FED136' : '#FFB020');
            g.addColorStop(1, 'rgba(255,176,32,.15)');
            ctx.fillStyle = g;
            var rr = Math.min(5, bw / 2);
            ctx.beginPath();
            ctx.moveTo(bx, by + rr);
            ctx.arcTo(bx, by, bx + rr, by, rr);
            ctx.arcTo(bx + bw, by, bx + bw, by + rr, rr);
            ctx.lineTo(bx + bw, padT + plotH);
            ctx.lineTo(bx, padT + plotH);
            ctx.closePath();
            ctx.fill();

            // rótulo do trimestre
            ctx.textAlign = 'center';
            ctx.fillStyle = 'rgba(255,255,255,.4)';
            ctx.fillText(b.q, cx, padT + plotH + 14);

            // marco de round
            if (b.round && grow > 0.85) {
              ctx.beginPath(); ctx.arc(cx, by - 12, 4, 0, Math.PI * 2);
              ctx.fillStyle = '#FED136'; ctx.fill();
              ctx.fillStyle = 'rgba(255,255,255,.8)';
              ctx.fillText(b.round, cx, by - 26);
            }
          }

          // linha de tendência da cobertura sobre os topos
          ctx.beginPath();
          for (var k = 0; k < n; k++) {
            var kx = padL + slot * k + slot / 2;
            var ky = padT + plotH - plotH * bars[k].cov * grow;
            if (k === 0) ctx.moveTo(kx, ky); else ctx.lineTo(kx, ky);
          }
          ctx.strokeStyle = 'rgba(254,209,54,.5)';
          ctx.lineWidth = 1.6;
          ctx.stroke();

          if (!prefersReduced && grow < 1) requestAnimationFrame(draw);
          else if (!prefersReduced) { /* mantém estático após crescer */ }
        }

        window.addEventListener('resize', function () { layout(); t0 = 0; requestAnimationFrame(draw); }, { passive: true });

        if (prefersReduced) { layout(); draw(performance.now()); }
        else requestAnimationFrame(draw);
      })();
    });
  </script>
</BaseLayout>
