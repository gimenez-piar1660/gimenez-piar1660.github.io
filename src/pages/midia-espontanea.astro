  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- Lenis + ScrollTrigger (globais via bootstrap.ts) ---- */
      try {
        if (window.gsap && window.ScrollTrigger) window.gsap.registerPlugin(window.ScrollTrigger);
        if (!prefersReduced && window.Lenis) {
          var lenis = new window.Lenis({ duration: 1.15, easing: function (t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); }, smooth: true, lerp: 0.1 });
          if (window.ScrollTrigger) { lenis.on('scroll', window.ScrollTrigger.update); window.gsap.ticker.add(function (time) { lenis.raf(time * 1000); }); window.gsap.ticker.lagSmoothing(0); }
          else { var raf = function (t) { lenis.raf(t); requestAnimationFrame(raf); }; requestAnimationFrame(raf); }
        }
      } catch (e) { /* noop */ }

      /* ---- reveal ---- */
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('active'); io.unobserve(en.target); } });
      }, { threshold: 0.14 });
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

      /* ---- scroll progress ---- */
      var bar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', function () {
        var h = document.documentElement;
        var p = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
        if (bar) bar.style.width = p + '%';
      }, { passive: true });

      /* ---- parallax de profundidade ---- */
      if (!prefersReduced && window.gsap && window.ScrollTrigger) {
        window.gsap.utils.toArray('[data-parallax-y]').forEach(function (el) {
          var yp = parseFloat(el.getAttribute('data-parallax-y')) || 0;
          window.gsap.fromTo(el, { yPercent: 0 }, { yPercent: yp, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } });
        });
      }

      /* ---- lerp mouse-parallax no heroi (Tres Mares) ---- */
      if (!prefersReduced && window.gsap) {
        var heroFloats = window.gsap.utils.toArray('[class*="hero-float"]');
        if (heroFloats.length) {
          var movers = heroFloats.map(function (el, i) {
            return {
              depth: (i % 2 ? 1 : -1) * (16 + i * 8),
              qx: window.gsap.quickTo(el, 'x', { duration: 0.7, ease: 'power3' }),
              qy: window.gsap.quickTo(el, 'y', { duration: 0.7, ease: 'power3' })
            };
          });
          window.addEventListener('mousemove', function (e) {
            var nx = (e.clientX / window.innerWidth - 0.5);
            var ny = (e.clientY / window.innerHeight - 0.5);
            for (var k = 0; k < movers.length; k++) { movers[k].qx(nx * movers[k].depth); movers[k].qy(ny * movers[k].depth); }
          }, { passive: true });
        }
      }

      /* ========================================================
         HERO · ondas earned (canvas 2D)
         ripples amarelos que se propagam de um ponto sobre o preto
         ======================================================== */
      (function earnedRipples() {
        var canvas = document.getElementById('me-hero-canvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) { canvas.style.background = 'radial-gradient(70% 90% at 70% 42%, #2a2206 0%, #120e04 55%, #0A0A0C 100%)'; return; }
        var dpr = Math.min(window.devicePixelRatio || 1, 1.75);
        var W = 0, H = 0, cx = 0, cy = 0;
        var rings = [];
        var sparks = [];
        var lastSpawn = 0;

        function resize() {
          W = canvas.clientWidth; H = canvas.clientHeight;
          canvas.width = Math.max(1, Math.floor(W * dpr));
          canvas.height = Math.max(1, Math.floor(H * dpr));
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          // origem da onda: a esquerda baixa, onde a mensagem nasce
          cx = W * 0.28; cy = H * 0.62;
        }
        resize();
        window.addEventListener('resize', resize, { passive: true });

        function spawnRing() {
          rings.push({ r: 0, life: 1 });
        }
        function spawnSpark() {
          var ang = Math.random() * Math.PI * 2;
          var sp = 0.4 + Math.random() * 0.9;
          sparks.push({ x: cx, y: cy, vx: Math.cos(ang) * sp, vy: Math.sin(ang) * sp, life: 1 });
        }

        var maxR = function () { return Math.hypot(Math.max(cx, W - cx), Math.max(cy, H - cy)) * 1.05; };

        function step(now) {
          ctx.clearRect(0, 0, W, H);

          if (now - lastSpawn > 1100) { spawnRing(); for (var s = 0; s < 5; s++) spawnSpark(); lastSpawn = now; }

          var mr = maxR();
          // aneis que se propagam
          for (var i = rings.length - 1; i >= 0; i--) {
            var rg = rings[i];
            rg.r += mr * 0.0019;
            rg.life = 1 - rg.r / mr;
            if (rg.life <= 0) { rings.splice(i, 1); continue; }
            var a = rg.life * rg.life * 0.5;
            ctx.beginPath();
            ctx.arc(cx, cy, rg.r, 0, Math.PI * 2);
            ctx.strokeStyle = 'rgba(254,209,54,' + a + ')';
            ctx.lineWidth = 1.4;
            ctx.stroke();
            // halo interno mais quente nos aneis jovens
            if (rg.life > 0.65) {
              ctx.beginPath();
              ctx.arc(cx, cy, rg.r, 0, Math.PI * 2);
              ctx.strokeStyle = 'rgba(255,216,74,' + (rg.life - 0.65) * 0.7 + ')';
              ctx.lineWidth = 3.2;
              ctx.stroke();
            }
          }

          // sparks que viajam para fora (a mensagem se espalhando)
          for (var k = sparks.length - 1; k >= 0; k--) {
            var sk = sparks[k];
            sk.x += sk.vx; sk.y += sk.vy; sk.life -= 0.006;
            if (sk.life <= 0) { sparks.splice(k, 1); continue; }
            ctx.beginPath();
            ctx.arc(sk.x, sk.y, 1.6, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(254,209,54,' + sk.life * 0.85 + ')';
            ctx.fill();
          }

          // nucleo emissor (a fonte)
          var pulse = 5 + (Math.sin(now / 420) + 1) * 2.4;
          ctx.beginPath();
          ctx.arc(cx, cy, pulse, 0, Math.PI * 2);
          ctx.fillStyle = '#FED136';
          ctx.fill();
          ctx.beginPath();
          ctx.arc(cx, cy, pulse + 6, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(254,209,54,.18)';
          ctx.fill();

          if (!prefersReduced) requestAnimationFrame(step);
        }

        if (prefersReduced) {
          // estado estatico: alguns aneis fixos
          rings = [{ r: maxR() * 0.18, life: 0.82 }, { r: maxR() * 0.42, life: 0.55 }, { r: maxR() * 0.68, life: 0.3 }];
          step(0);
        } else {
          requestAnimationFrame(step);
        }
      })();

      /* ========================================================
         DATAVIZ · propagacao e alcance (canvas 2D)
         espontanea (onda continua, longa) vs comprada (curta, decai)
         ======================================================== */
      (function reachViz() {
        var canvas = document.getElementById('me-reach-canvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0;
        var t0 = 0;

        function layout() {
          var rect = canvas.getBoundingClientRect();
          W = rect.width; H = rect.height;
          canvas.width = Math.floor(W * dpr); canvas.height = Math.floor(H * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        layout();

        // curva de alcance ao longo do tempo
        // espontanea: sobe e PERMANECE alto (indexada, citada pela IA)
        // comprada: pico rapido e cai a zero quando a verba acaba
        function earned(x) {
          // x em [0,1] -> alcance acumulado, satura alto e fica
          return 1 - Math.exp(-x * 3.4);
        }
        function paid(x) {
          // pico em ~0.22 e decai
          var peak = 0.22;
          var rise = Math.min(1, x / peak);
          var fall = Math.exp(-Math.max(0, x - peak) * 4.2);
          return rise * fall;
        }

        function curve(fn, prog, color, glow, width) {
          ctx.beginPath();
          var padL = W * 0.1, padR = W * 0.06, padT = H * 0.14, padB = H * 0.16;
          var gx0 = padL, gx1 = W - padR, gy0 = padT, gy1 = H - padB;
          var n = 90;
          for (var i = 0; i <= n; i++) {
            var xr = i / n;
            if (xr > prog) break;
            var v = fn(xr);
            var px = gx0 + (gx1 - gx0) * xr;
            var py = gy1 - (gy1 - gy0) * v;
            if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
          }
          ctx.strokeStyle = color;
          ctx.lineWidth = width;
          ctx.lineJoin = 'round';
          if (glow) { ctx.shadowColor = color; ctx.shadowBlur = 12; } else { ctx.shadowBlur = 0; }
          ctx.stroke();
          ctx.shadowBlur = 0;
        }

        function head(fn, prog, rgb) {
          if (prog <= 0 || prog > 1) return;
          var padL = W * 0.1, padR = W * 0.06, padT = H * 0.14, padB = H * 0.16;
          var gx0 = padL, gx1 = W - padR, gy0 = padT, gy1 = H - padB;
          var v = fn(prog);
          var px = gx0 + (gx1 - gx0) * prog;
          var py = gy1 - (gy1 - gy0) * v;
          ctx.beginPath(); ctx.arc(px, py, 4.5, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(' + rgb + ',1)'; ctx.fill();
          ctx.beginPath(); ctx.arc(px, py, 9, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(' + rgb + ',.18)';
          ctx.fill();
        }

        function draw(now) {
          if (!t0) t0 = now;
          var loop = ((now - t0) / 4200) % 1;
          var prog = prefersReduced ? 1 : Math.min(1, loop / 0.82);
          ctx.clearRect(0, 0, W, H);

          var padL = W * 0.1, padB = H * 0.16, padT = H * 0.14, padR = W * 0.06;
          // eixos
          ctx.strokeStyle = 'rgba(255,255,255,.12)';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(padL, padT - 6); ctx.lineTo(padL, H - padB); ctx.lineTo(W - padR, H - padB);
          ctx.stroke();
          // rotulos de eixo
          ctx.font = '600 9.5px "JetBrains Mono", monospace';
          ctx.fillStyle = 'rgba(255,255,255,.4)';
          ctx.textAlign = 'left';
          ctx.fillText('ALCANCE', padL, padT - 12);
          ctx.textAlign = 'right';
          ctx.fillText('TEMPO ->', W - padR, H - padB + 16);
          // marca "verba acaba"
          var gx0 = padL, gx1 = W - padR;
          var vx = gx0 + (gx1 - gx0) * 0.34;
          ctx.setLineDash([3, 4]);
          ctx.strokeStyle = 'rgba(255,255,255,.14)';
          ctx.beginPath(); ctx.moveTo(vx, padT); ctx.lineTo(vx, H - padB); ctx.stroke();
          ctx.setLineDash([]);
          ctx.fillStyle = 'rgba(255,255,255,.35)';
          ctx.textAlign = 'center';
          ctx.fillText('verba acaba', vx, padT - 2);

          // comprada (cinza, curta)
          curve(paid, prog, 'rgba(107,113,128,.9)', false, 2);
          head(paid, prog, '107,113,128');
          // espontanea (amarelo, longa) por cima
          curve(earned, prog, 'rgba(254,209,54,1)', true, 2.6);
          head(earned, prog, '254,209,54');

          requestAnimationFrame(draw);
        }

        window.addEventListener('resize', function () { layout(); t0 = 0; }, { passive: true });
        requestAnimationFrame(draw);
      })();
    });
  </script>
</BaseLayout>
