          '    vec2 c = vec2(0.62+0.22*sin(0.21*t+fi*1.9), 0.40+0.26*cos(0.17*t+fi*2.7));',
          '    float d = length((uv-c)*vec2(r.x/r.y,1.0));',
          '    float pulse = 0.45 + 0.55*sin(0.6*t + fi*1.6);',
          '    glow += pulse * 0.012 / (d*d + 0.004);',
          '  }',
          '  glow = clamp(glow, 0.0, 1.0);',
          '  col += amber * glow * 0.5;',
          // vinheta escura à esquerda (texto respira)
          '  float vleft = smoothstep(-0.15, 0.85, uv.x);',
          '  col *= 0.34 + 0.66*vleft;',
          '  float vig = smoothstep(1.30,0.25,length(uv-vec2(0.7,0.45)));',
          '  col *= 0.55 + 0.45*vig;',
          '  gl_FragColor = vec4(col,1.0);',
          '}'
        ].join('\n');

        function sh(type, src) { var s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s); return s; }
        var prog, ok = false;
        try {
          prog = gl.createProgram();
          gl.attachShader(prog, sh(gl.VERTEX_SHADER, vs));
          gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, fs));
          gl.linkProgram(prog);
          ok = gl.getProgramParameter(prog, gl.LINK_STATUS);
        } catch (e) { ok = false; }
        if (!ok) { canvas.style.background = fallbackBg; return; }
        gl.useProgram(prog);

        var buf = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, buf);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
        var loc = gl.getAttribLocation(prog, 'p');
        gl.enableVertexAttribArray(loc);
        gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
        var uR = gl.getUniformLocation(prog, 'r');
        var uT = gl.getUniformLocation(prog, 't');

        function resize() {
          var dpr = Math.min(window.devicePixelRatio || 1, 1.5);   // cap webgl <= 1.5
          var w = canvas.clientWidth, h = canvas.clientHeight;
          canvas.width = Math.max(1, Math.floor(w * dpr));
          canvas.height = Math.max(1, Math.floor(h * dpr));
          gl.viewport(0, 0, canvas.width, canvas.height);
        }
        resize();
        window.addEventListener('resize', resize, { passive: true });

        var start = 0, raf = 0, running = false;
        function frame(now) {
          if (!start) start = now;
          gl.uniform2f(uR, canvas.width, canvas.height);
          gl.uniform1f(uT, (now - start) / 1000);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
          if (running) raf = requestAnimationFrame(frame);
        }
        if (prefersReduced) {
          // pinta um quadro estático, sem rAF contínuo
          gl.uniform2f(uR, canvas.width, canvas.height);
          gl.uniform1f(uT, 2.0);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
        } else if ('IntersectionObserver' in window) {
          // só desenha enquanto o herói está na viewport (pausa o rAF fora da tela)
          var vio = new IntersectionObserver(function (ents) {
            if (ents[0].isIntersecting) {
              if (!running) { running = true; raf = requestAnimationFrame(frame); }
            } else {
              running = false;
              if (raf) { cancelAnimationFrame(raf); raf = 0; }
            }
          }, { rootMargin: '200px' });
          vio.observe(canvas);
        } else {
          running = true;
          raf = requestAnimationFrame(frame);
        }
      })();

      /* ========================================================
         DATAVIZ · os três planos da reputação (canvas 2D)
         BUSCA | MÍDIA | IA, com a marca ao centro. Quando há prova
         pública, a mesma descrição aparece consistente nos três
         planos e os indicadores de consistência sobem.
         ======================================================== */
      (function reputationPlanes() {
        var canvas = document.getElementById('rep-planes-canvas');
        if (!canvas) return;
        var ctx = null;
        try { ctx = canvas.getContext('2d'); } catch (e) { ctx = null; }
        if (!ctx) { canvas.style.background = 'linear-gradient(160deg,#20232A,#16181D)'; return; }
        var dpr = Math.min(window.devicePixelRatio || 1, 2);       // cap canvas <= 2
        var W = 0, H = 0, t0 = 0;
        var planes = [
          { id: 'BUSCA', icon: 'magnifer' },
          { id: 'MÍDIA', icon: 'doc' },
          { id: 'IA', icon: 'cpu' }
        ];
        var nodes = [];     // por plano: lista de pontos { y, proof, on }
        var brand = null;
        var hover = -1;     // índice do plano sob o mouse
        var consist = [0, 0, 0];
        var raf = 0, running = false;

        function layout() {
          var rect = canvas.getBoundingClientRect();
          W = rect.width; H = rect.height;
          canvas.width = Math.floor(W * dpr); canvas.height = Math.floor(H * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          brand = { x: W * 0.5, y: H * 0.5, r: 11 };
          var colX = [W * 0.16, W * 0.5, W * 0.84];
          nodes = planes.map(function (pl, ci) {
            var topY = H * 0.20, botY = H * 0.80, count = 4;
            var pts = [];
            for (var i = 0; i < count; i++) {
              var y = topY + (botY - topY) * (i / (count - 1));
              // alguns nós são "prova pública" (amarelos, consistentes)
              var proof = (i === 1 || i === 2);
              pts.push({ x: colX[ci], y: y, proof: proof, on: false });
            }
            return { x: colX[ci], topY: topY, botY: botY, pts: pts };
          });
        }
        layout();

        function lerp(a, b, t) { return a + (b - a) * t; }

        function drawPanel(ci) {
          var col = nodes[ci];
          var active = hover === ci || hover === -1;
          var px = col.x;
          // moldura vertical do plano
          ctx.beginPath();
          ctx.moveTo(px, col.topY - 26); ctx.lineTo(px, col.botY + 14);
          ctx.strokeStyle = (hover === ci) ? 'rgba(254,209,54,.35)' : 'rgba(255,255,255,.10)';
          ctx.lineWidth = 1;
          ctx.stroke();
          // rótulo
          ctx.font = '600 11px "JetBrains Mono", monospace';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'alphabetic';
          ctx.fillStyle = (hover === ci) ? 'rgba(255,255,255,.95)' : 'rgba(255,255,255,.6)';
          ctx.fillText(planes[ci].id, px, col.topY - 36);
        }

        function draw(now) {
          if (!t0) t0 = now;
          var tt = (now - t0) / 1000;
          ctx.clearRect(0, 0, W, H);

          // conexões marca -> cada nó
          nodes.forEach(function (col, ci) {
            var emphasize = hover === ci;
            col.pts.forEach(function (pt) {
              // pulso de consistência percorre as ligações de prova
              var lit = pt.proof;
              var base = lit ? 'rgba(254,209,54,' : 'rgba(255,255,255,';
              var alpha = emphasize ? (lit ? 0.55 : 0.22) : (lit ? 0.34 : 0.10);
              ctx.beginPath();
              ctx.moveTo(brand.x, brand.y);
              var midx = lerp(brand.x, pt.x, 0.5);
              ctx.bezierCurveTo(midx, brand.y, midx, pt.y, pt.x, pt.y);
              ctx.strokeStyle = base + alpha + ')';
              ctx.lineWidth = lit ? (emphasize ? 1.7 : 1.2) : 1;
              ctx.stroke();
            });
          });

          // nós dos planos
          nodes.forEach(function (col, ci) {
            drawPanel(ci);
            col.pts.forEach(function (pt, pi) {
              var emphasize = hover === ci || hover === -1;
              if (pt.proof) {
                // brilho de prova pública, pulsando devagar
                var pulse = 0.6 + 0.4 * Math.sin(tt * 1.4 + ci * 0.8 + pi);
                ctx.beginPath(); ctx.arc(pt.x, pt.y, 8, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(254,209,54,' + (0.12 * pulse) + ')'; ctx.fill();
                ctx.beginPath(); ctx.arc(pt.x, pt.y, 4.2, 0, Math.PI * 2);
                ctx.fillStyle = '#FED136'; ctx.fill();
              } else {
                ctx.beginPath(); ctx.arc(pt.x, pt.y, 3.4, 0, Math.PI * 2);
                ctx.fillStyle = emphasize ? '#8A93A6' : '#5a606e'; ctx.fill();
              }
            });
            // barra de consistência (sobe quando há prova)
            var target = 0.5 + 0.5 * (col.pts.filter(function (p) { return p.proof; }).length / col.pts.length);
            consist[ci] += (target - consist[ci]) * 0.04;
            var barW = 46, barH = 4, bx = col.x - barW / 2, by = col.botY + 26;
            ctx.fillStyle = 'rgba(255,255,255,.10)';
            ctx.fillRect(bx, by, barW, barH);
            ctx.fillStyle = 'rgba(254,209,54,.85)';
            ctx.fillRect(bx, by, barW * consist[ci], barH);
            ctx.font = '600 8px "JetBrains Mono", monospace';
            ctx.textAlign = 'center';
            ctx.fillStyle = 'rgba(255,255,255,.45)';
            ctx.fillText('consistência', col.x, by + 16);
          });

          // marca ao centro, anel pulsante
          ctx.beginPath(); ctx.arc(brand.x, brand.y, brand.r, 0, Math.PI * 2);
          ctx.fillStyle = '#FED136'; ctx.fill();
          var ring = brand.r + 6 + (Math.sin(tt * 1.6) + 1) * 3;
          ctx.beginPath(); ctx.arc(brand.x, brand.y, ring, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(254,209,54,.32)'; ctx.lineWidth = 1; ctx.stroke();
          ctx.font = '600 11px "JetBrains Mono", monospace';
          ctx.textAlign = 'center'; ctx.textBaseline = 'alphabetic';
          ctx.fillStyle = 'rgba(255,255,255,.92)';
          ctx.fillText('Sua marca', brand.x, brand.y + brand.r + 18);

          if (running) raf = requestAnimationFrame(draw);
        }

        canvas.addEventListener('mousemove', function (e) {
          var rect = canvas.getBoundingClientRect();
          var mx = e.clientX - rect.left;
          hover = -1;
          for (var i = 0; i < nodes.length; i++) {
            if (Math.abs(nodes[i].x - mx) < W * 0.16) { hover = i; break; }
          }
        });
        canvas.addEventListener('mouseleave', function () { hover = -1; });
        window.addEventListener('resize', layout, { passive: true });

        if (prefersReduced) {
          // quadro estático único, sem rAF contínuo
          consist = [0.75, 0.75, 0.75];
          draw(performance.now());
        } else if ('IntersectionObserver' in window) {
          // só desenha enquanto o gráfico está na viewport (pausa o rAF fora da tela)
          var vioP = new IntersectionObserver(function (ents) {
            if (ents[0].isIntersecting) {
              if (!running) { running = true; raf = requestAnimationFrame(draw); }
            } else {
              running = false;
              if (raf) { cancelAnimationFrame(raf); raf = 0; }
            }
          }, { rootMargin: '200px' });
          vioP.observe(canvas);
        } else {
          running = true;
          raf = requestAnimationFrame(draw);
        }
      })();
    });
  </script>
</BaseLayout>
