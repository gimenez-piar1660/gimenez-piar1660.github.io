            var nx = (e.clientX / window.innerWidth - 0.5);
            var ny = (e.clientY / window.innerHeight - 0.5);
            for (var k = 0; k < movers.length; k++) { movers[k].qx(nx * movers[k].depth); movers[k].qy(ny * movers[k].depth); }
          }, { passive: true });
        }
      }

      /* ========================================================
         HERO · campo de percepção em WebGL (fBm frio + brilhos)
         ardósia/grafite calmo, brilhos amarelos pulsando devagar,
         vinheta escura à esquerda para o texto respirar.
         ======================================================== */
      (function perceptionField() {
        var canvas = document.getElementById('rep-hero-canvas');
        if (!canvas) return;
        var fallbackBg = 'radial-gradient(120% 95% at 80% 35%, #2A2E37 0%, #20232A 45%, #16181D 100%)';
        var gl = null;
        try { gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl'); } catch (e) { gl = null; }
        if (!gl) { canvas.style.background = fallbackBg; return; }

        var vs = 'attribute vec2 p; void main(){ gl_Position = vec4(p,0.0,1.0); }';
        var fs = [
          'precision highp float;',
          'uniform vec2 r; uniform float t;',
          'float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7)))*43758.5453123); }',
          'float noise(vec2 p){ vec2 i=floor(p), f=fract(p); vec2 u=f*f*(3.0-2.0*f);',
          '  return mix(mix(hash(i),hash(i+vec2(1.0,0.0)),u.x), mix(hash(i+vec2(0.0,1.0)),hash(i+vec2(1.0,1.0)),u.x), u.y); }',
          'float fbm(vec2 p){ float v=0.0,a=0.5; for(int i=0;i<6;i++){ v+=a*noise(p); p*=2.02; a*=0.5; } return v; }',
          'void main(){',
          '  vec2 uv = gl_FragCoord.xy / r.xy;',
          '  vec2 p = (uv - 0.5) * vec2(r.x/r.y, 1.0) * 2.0;',
          '  float tt = t*0.018;',                       // muito mais lento e calmo que a GEO
          '  vec2 q = vec2(fbm(p + tt), fbm(p + vec2(3.4,1.7) - tt));',
          '  float f = fbm(p + 1.4*q + tt*0.5);',
          // paleta fria: grafite -> ardósia -> aço azulado
          '  vec3 ink   = vec3(0.086,0.094,0.114);',     // #16181D
          '  vec3 slate = vec3(0.169,0.184,0.220);',     // #2B2F38
          '  vec3 steel = vec3(0.290,0.330,0.400);',     // azulado-cinza frio
          '  vec3 col = mix(ink, slate, smoothstep(0.20,0.62,f));',
          '  col = mix(col, steel, smoothstep(0.58,0.92,f)*0.85);',
          '  col += vec3(0.012,0.018,0.030) * f;',       // leve viés azulado, nunca quente
          // brilhos pontuais amarelos (provas públicas) pulsando devagar
          '  vec3 amber = vec3(0.996,0.819,0.212);',     // #FED136
          '  float glow = 0.0;',
