---
// ============================================================================
// SOBRE · NARRATIVA "SER INEVITAVEL E RARO"
// Tese unica (livro Super Apresentacoes): uma mensagem, enquadrada como
//   beneficio, em tres atos. A PiaR existe para tornar a marca do cliente
//   inevitavel. Nada de "quem somos / missao / valores".
// Cinema claro->dark: o scroll comeca claro e barulhento (todo mundo aparece)
//   e escurece ate virar campo gravitacional (ser inevitavel e raro). A
//   transicao encena a tese. O canvas fixo faz o ruido virar gravidade.
// Voz: humano contando historia, 1a pessoa do plural (verbo carrega o nos),
//   sem "a gente", sem antitese empilhada, sem jargao, sem travessao.
//   Toda frase grande paga uma divida concreta (um fato da casa).
// Fatos travados em site.ts: 2013, 13 anos, 470+ marcas, exits nomeados,
//   premio ABStartups 2018. Sem Constellation/CS-pioneer (nao confirmados).
// Pagina indexada (nao e noindex). JSON-LD AboutPage + Breadcrumb + ItemList
//   + FAQPage. Vídeo entra depois, por cima da narrativa (dobra #manifesto).
// ============================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import { site } from '@/data/site';
import { withBase } from '@/lib/base';

const exits = site.exits;

const clientes = [
  'Sambatech', 'Liga Ventures', 'Printi', 'Qranio', 'Unifisa', 'Livup', 'Doctoralia',
  'Solides', 'Corning', 'PagBrasil', 'Sidia', 'Investidores.vc', 'FluencyPass',
  'Layer Up', 'Wylinka', 'Inovativa', 'Unlimitail', 'Endemol Shine Brasil',
  'Mastercard Agro', 'AgroSmart', 'Vila 11',
];

const verdades = [
  { n: '01', t: 'Tudo começa no dado', d: 'Antes de escrever a primeira linha, já mapeamos quem precisa ouvir a sua história, em que veículo e por quê. O texto vem depois que a estratégia está de pé.' },
  { n: '02', t: 'Quem dirige está na sala', d: 'Quem assina a estratégia está na reunião semanal, no funil e na edição de cada entrega. Sócio não terceiriza a sua conta para estagiário.' },
  { n: '03', t: 'A inteligência artificial virou leitora', d: 'Hoje a IA cita quem a imprensa já citou. Construímos a sua marca para ser a fonte que ela escolhe quando perguntam sobre o seu mercado.' },
];

const corpos = [
  { ic: 'solar:cart-check-line-duotone', t: 'O comprador', d: 'Chega já convencido, e o time comercial fecha com menos objeção. A reputação trabalha antes da reunião de venda.' },
  { ic: 'solar:chart-2-line-duotone', t: 'O investidor', d: 'Valida a empresa porque o mercado já fala dela. Confiança pública faz a due diligence começar com o sinal verde.' },
  { ic: 'solar:crown-line-duotone', t: 'A liderança', d: 'O CEO e os fundadores viram referência do setor, procurados pela imprensa pelo nome.' },
  { ic: 'solar:users-group-rounded-line-duotone', t: 'O talento', d: 'As pessoas certas querem trabalhar onde a marca já é uma referência. Reputação também contrata.' },
];

// a tradução de PR para a língua de quem aprova o orçamento (o que entregamos -> o que vira no relatório).
const traducoes = [
  { de: 'Cobertura relevante', para: 'Custo de mídia que você não pagou' },
  { de: 'Autoridade pública', para: 'Pipeline que chega com menos objeção' },
  { de: 'Confiança de mercado', para: 'Validação na frente de fundos e parceiros' },
  { de: 'Presença constante', para: 'Consideração de compra antes do primeiro contato' },
];

const lideranca = [
  { nome: 'Bruno Pinheiro', cargo: 'Fundador e CEO', foto: '/brand/Brunotrofeu.webp', flip: true, desc: 'Fundou a PiaR em 2013 e dirige a estratégia desde então. Eleito profissional de imprensa no Startup Awards da ABStartups, em 2018.' },
  { nome: 'Renniê Paro', cargo: 'COO', foto: '/brand/team/rennie.png', flip: false, desc: 'Cuida da operação e de manter a mesma qualidade de entrega em todas as frentes da casa.' },
  { nome: 'Gabriela Calencautcy', cargo: 'Projetos Especiais', foto: '/brand/team/gabriela.png', flip: false, desc: 'Conduz o PEP e os trabalhos que vão além da cobertura de imprensa.' },
];

const faq = [
  { q: 'O que a PiaR faz?', a: 'Construímos a reputação de empresas inovadoras em três lugares ao mesmo tempo: na imprensa, na percepção do mercado e nas respostas de inteligência artificial. Cada frente entra conforme o diagnóstico.' },
  { q: 'O que diferencia a PiaR de uma assessoria tradicional?', a: 'A ordem do trabalho. Começamos pelo dado e pela mídia certa, mapeamos jornalista e veículo antes de escrever, e só então definimos abordagem e conteúdo. Disparo de release em massa não é o que fazemos.' },
  { q: 'Desde quando a PiaR existe?', a: `Desde ${site.foundingYear}, em São Paulo. Ao longo desses ${site.yearsOperating} anos, acompanhamos a comunicação de ${site.exitsSupported} startups que chegaram ao exit.` },
  { q: 'A PiaR atende setores regulados como fintech e saúde?', a: 'Sim. Todo material passa por revisão jurídica antes de chegar ao jornalista, o que importa especialmente quando o tema é compliance, regulação ou dado sensível.' },
  { q: 'Como começa um trabalho com a PiaR?', a: 'Por um diagnóstico. Você conta o contexto da empresa e mostramos onde está a oportunidade na busca, na imprensa e na IA. Do briefing ao primeiro framework são 14 dias.' },
];

const url = `https://${site.brandDomain}/sobre`;
---
<BaseLayout
  title="Sobre a PiaR · 13 anos tornando marcas inevitáveis"
  description="A PiaR é uma agência de comunicação para empresas inovadoras, em São Paulo desde 2013. Construímos reputação na imprensa, no mercado e nas respostas de inteligência artificial."
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'AboutPage',
        name: 'Sobre a PiaR Group',
        url,
        description: 'Há 13 anos a PiaR constrói a reputação de empresas inovadoras na imprensa, no mercado e nas respostas de inteligência artificial. Agência de comunicação em São Paulo desde 2013.',
        about: { '@id': `${site.domain}/#organization` },
        mainEntity: { '@id': `${site.domain}/#organization` },
        inLanguage: 'pt-BR',
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'PiaR', item: `https://${site.brandDomain}/` },
          { '@type': 'ListItem', position: 2, name: 'Sobre', item: url },
        ],
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'Marcas atendidas pela PiaR Group',
        itemListElement: clientes.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c })),
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      })}
    />
  </Fragment>

  <div id="scroll-progress" aria-hidden="true"></div>
  <Nav current="sobre" />

  <!-- Campo fixo: ruido (claro) que vira gravidade (dark) conforme o scroll. -->
  <canvas id="field-bg" aria-hidden="true"></canvas>
  <!-- labels removidos de proposito: colidiam com o texto central. O campo gravitacional (nucleo + corpos em orbita) carrega a metafora sozinho, e a copy nomeia os corpos nos cards. -->


  <main id="main">
    <!-- ============ ATO 1 · HERO (claro) ============ -->
    <section class="sec clear hero" id="hero">
      <div class="hero-scrim light" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <span class="eyebrow reveal"><span class="dot"></span>Sobre a PiaR</span>
        <h1 class="reveal d1">Há 13 anos transformamos a marca dos outros em algo <span class="serif">inevitável</span>.</h1>
        <p class="hero-sub reveal d2">
          Começamos em São Paulo, em 2013, quando comunicação para startup ainda era terra de ninguém. Sair na imprensa todo mundo sai. Difícil é virar a marca que a imprensa procura, o mercado lembra e a inteligência artificial cita quando perguntam onde. É esse o trabalho da casa.
        </p>
        <div class="cta-row reveal d3">
          <a href="/contato" class="btn btn-accent">Agendar diagnóstico<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
          <a href="#turn" class="btn btn-ghost-l">Como chegamos aqui</a>
        </div>
      </div>
      <span class="cue" aria-hidden="true"><span class="l"></span>role</span>
    </section>

    <!-- ============ ATO 1 · O RUIDO (claro) ============ -->
    <section class="sec light tight" id="ruido">
      <div class="wrap narrow">
        <span class="eyebrow reveal"><span class="dot"></span>O problema</span>
        <h2 class="big reveal d1">O mercado está barulhento.</h2>
        <p class="lede reveal d2">
          Todo dia tem mais gente gritando para aparecer. Mais release, mais post, mais ruído. E quanto mais todo mundo grita, menos alguém de fato escuta. Percebemos isso cedo, e decidimos jogar um jogo diferente.
        </p>
      </div>
    </section>

    <!-- ============ A VIRADA (claro vira dark) ============ -->
    <section class="sec clear turn" id="turn">
      <div class="turn-scrim" aria-hidden="true"></div>
      <div class="wrap narrow turn-inner">
        <span class="eyebrow on-dark reveal"><span class="dot"></span>A virada</span>
        <p class="turn-pre reveal d1">Por isso paramos de tentar gritar mais alto.</p>
        <h2 class="hero-line reveal d2">Ser inevitável é <span class="serif warm-t">raro</span>.</h2>
        <p class="lede on-dark reveal d3">
          Ninguém empurra marca goela abaixo do mercado e faz durar. Marca de verdade vira aquilo que o mercado procura sozinho. Passamos os dias construindo essa força: a gravidade que faz a imprensa, o cliente e o investidor virem até você.
        </p>
      </div>
    </section>

    <!-- ============ ATO 2 · A CRENCA (dark) ============ -->
    <section class="sec dark" id="reputacao">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow on-dark"><span class="dot"></span>No que acreditamos</span>
          <h2>Reputação, para nós, vale o que aparece na conta quando a empresa é vendida.</h2>
          <p class="lede on-dark">
            Acompanhamos {site.exitsSupported} startups da primeira rodada até o exit. Na mesa de negociação, reputação deixa de ser discurso e vira número, e por isso a tratamos como ativo desde o primeiro dia.
          </p>
        </div>
        <p class="punch reveal d1">Aparecer dura um dia. Reputação é o que falam de você quando você <span class="warm-t">não está na sala</span>.</p>
      </div>
    </section>

    <!-- ============ ATO CMO · A CONVERSA QUE AMPLIAMOS (dark) ============ -->
    <section class="sec dark tight" id="cmo">
      <div class="wrap narrow">
        <span class="eyebrow on-dark reveal"><span class="dot"></span>A conversa que ampliamos</span>
        <p class="strike reveal d1">"Saímos na Exame essa semana."</p>
        <p class="reply reveal d2">"Ótimo. E daí?"</p>
        <p class="lede on-dark reveal d3">
          Toda reunião de marketing tem um momento parecido com esse. A pergunta carrega uma distância real: entre quem fala em cobertura e quem responde por receita. Passamos anos fechando essa distância, e foi assim que a nossa conversa com o marketing ficou maior.
        </p>
      </div>
    </section>

    <section class="sec dark has-g" id="atrai">
      <span class="gword" data-parallax-y="-12" aria-hidden="true" style="top:6%; left:-3%">massa</span>
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow on-dark"><span class="dot"></span>O que o marketing espera de nós</span>
          <h2>Quando a massa cresce, o mercado inteiro vem junto, e a imprensa é só o primeiro a chegar.</h2>
          <p class="lede on-dark">Quem responde por receita quer a força que move o pipeline, muito mais do que outra matéria na parede. A mesma gravidade que constrói reputação puxa quatro pessoas para perto da marca ao mesmo tempo.</p>
        </div>
        <div class="corpos">
          {corpos.map((c, i) => (
            <div class:list={['corpo-card', 'reveal', i === 1 && 'd1', i === 2 && 'd2', i === 3 && 'd3']}>
              <span class="c-ic"><iconify-icon icon={c.ic}></iconify-icon></span>
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </div>
          ))}
        </div>
        <p class="punch reveal">Um CMO chama isso de pipeline, de validação, de employer branding. Para nós, é a mesma <span class="warm-t">gravidade</span> agindo em quatro lugares de uma vez.</p>
      </div>
    </section>

    <section class="sec dark tight" id="idioma">
      <div class="wrap narrow">
        <div class="sec-head reveal">
          <span class="eyebrow on-dark"><span class="dot"></span>A língua de quem decide o orçamento</span>
          <h2>Aprendemos a relatar no idioma de quem aprova o orçamento.</h2>
          <p class="lede on-dark">Uma matéria na parede não sobrevive a uma reunião de conselho, mas receita, pipeline e crescimento sobrevivem. Sentamos desse lado da mesa vezes suficientes para aprender a falar assim, e é nessa língua que entregamos o relatório.</p>
        </div>
        <ul class="trad reveal d1">
          {traducoes.map((t) => (
            <li>
              <span class="de">{t.de}</span>
              <span class="ar" aria-hidden="true">&rarr;</span>
              <span class="para">{t.para}</span>
            </li>
          ))}
        </ul>
        <p class="punch reveal d2">A pergunta que mais abre orçamento é direta: quanto custa comprar todo esse espaço em mídia paga? Quando a resposta aparece, relações públicas deixam de ser linha de custo e viram linha de <span class="warm-t">retorno</span>.</p>
      </div>
    </section>

    <section class="sec dark tight" id="traducao">
      <div class="wrap narrow">
        <div class="sec-head reveal">
          <span class="eyebrow on-dark"><span class="dot"></span>Da cobertura à receita</span>
          <h2>Traduzir cobertura em receita é parte do trabalho.</h2>
          <p class="lede on-dark">Reputação não aparece no relatório como um número solto. Ela percorre um caminho até a venda, e acompanhamos cada passo dele.</p>
        </div>
        <ol class="path reveal d1">
          <li><span>Publicação</span></li>
          <li><span>Credibilidade</span></li>
          <li><span>Confiança</span></li>
          <li><span>Consideração</span></li>
          <li><span>Venda</span></li>
        </ol>
        <p class="lede on-dark reveal d2">Essa é a conversa inteira, da cadeira do CMO. Ela continua, com calma e com método, na página <a href="/para-cmos" class="ln">Para CMOs</a>.</p>
      </div>
    </section>

    <!-- ============ ATO 2 · O NOSSO JEITO (dark) ============ -->
    <section class="sec dark has-g" id="jeito">
      <span class="gword" data-parallax-y="-14" aria-hidden="true" style="top:6%; right:-3%">gravidade</span>
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow on-dark"><span class="dot"></span>O nosso jeito</span>
          <h2>Três coisas das quais não abrimos mão.</h2>
          <p class="lede on-dark">O método inteiro mora em <a href="/processos" class="ln">outra página</a>. Aqui ficam só os princípios que não mudam desde 2013.</p>
        </div>
        <div class="trio">
          {verdades.map((v, i) => (
            <div class:list={['truth-card', 'reveal', i === 1 && 'd1', i === 2 && 'd2']}>
              <span class="t-n">{v.n}</span>
              <h3>{v.t}</h3>
              <p>{v.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ MANIFESTO (dark, pronto para receber video) ============ -->
    <section class="sec clear manifesto" id="manifesto">
      <div class="mani-scrim" aria-hidden="true"></div>
      <div class="wrap mani-inner">
        <h2 class="hero-line reveal">Atenção se <span class="serif warm-t">conquista</span>, nunca se exige.</h2>
        <p class="lede on-dark reveal d1">
          Relevância cria campo. Marca relevante faz o mercado vir até ela, sem precisar correr atrás. Foi por isso que a PiaR nasceu, e é o que continuamos construindo, marca por marca.
        </p>
      </div>
    </section>

    <!-- ============ ATO 3 · A PROVA (dark) ============ -->
    <section class="sec dark" id="prova">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow on-dark"><span class="dot"></span>A prova</span>
          <h2>Em vez de encher esta página de prêmio, vamos contar o que dá para conferir.</h2>
        </div>
        <div class="stats reveal d1">
          <div class="stat"><span class="stat-n" data-count="13">13</span><span class="stat-l">anos puxando a conversa, desde 2013</span></div>
          <div class="stat"><span class="stat-n" data-count="470" data-suffix="+">470+</span><span class="stat-l">marcas atendidas em comunicação</span></div>
          <div class="stat"><span class="stat-n" data-count="8">8</span><span class="stat-l">startups acompanhadas até o exit</span></div>
        </div>
        <p class="lede on-dark reveal d2">
          Entramos cedo nessas histórias e ficamos até o fim: {exits.join(', ')}. Acompanhar uma empresa da primeira rodada até a venda ensina sobre reputação o que disparo nenhum ensina.
        </p>
        <div class="chips reveal d2">
          {exits.map((e) => <span class="chip warm-chip">{e}</span>)}
        </div>
        <p class="mono-note reveal d2">Entre as marcas atendidas</p>
        <div class="chips reveal d2">
          {clientes.map((c) => <span class="chip">{c}</span>)}
        </div>
      </div>
    </section>

    <!-- ============ ATO 3 · QUEM ESTA NA SALA (dark) ============ -->
    <section class="sec dark has-g" id="lideranca">
      <span class="gword" data-parallax-y="16" aria-hidden="true" style="bottom:-6%; left:-2%">inevitável</span>
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow on-dark"><span class="dot"></span>Quem faz</span>
          <h2>Quem assina está na sala.</h2>
          <p class="lede on-dark">Reunião semanal, funil de prospecção, edição de cada entrega. Quem dirige a PiaR está dentro de tudo isso, todo dia. Mais rotina do que organograma.</p>
        </div>
        <div class="leaders">
          {lideranca.map((l, i) => (
            <div class:list={['leader', 'reveal', i === 1 && 'd1', i === 2 && 'd2']}>
              <div class="leader-photo">
                <img src={withBase(l.foto)} alt={`${l.nome}, ${l.cargo} da PiaR`} class:list={[l.flip && 'flip']} loading="lazy" decoding="async" />
              </div>
              <span class="leader-chip">{l.cargo}</span>
              <h3>{l.nome}</h3>
              <p>{l.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CLIMAX + CTA (dark) ============ -->
    <section class="sec dark climax has-g" id="climax">
      <span class="gword big" data-parallax-y="-10" aria-hidden="true" style="top:50%; left:50%; transform:translate(-50%,-50%)">PiaR</span>
      <div class="wrap climax-inner">
        <span class="eyebrow on-dark reveal"><span class="dot"></span>O próximo passo</span>
        <h2 class="reveal d1">Vamos tornar a sua marca <span class="serif warm-t">inevitável</span>.</h2>
        <p class="lede on-dark reveal d2">
          Começa com um diagnóstico, sem pitch genérico. Olhamos onde a sua marca está vazando narrativa e por onde ela vira a referência do mercado. Você conta o contexto, mostramos a oportunidade na busca, na imprensa e na IA. Respondemos em até 1 dia útil.
        </p>
        <div class="cta-row reveal d3">
          <a href="/contato" class="btn btn-accent">Agendar diagnóstico<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
          <a href={`mailto:${site.email}`} class="btn btn-ghost-d">{site.email}</a>
        </div>
        <p class="cta-foot reveal d4">{site.address.street}, {site.address.locality} · CEP {site.address.postalCode}</p>
      </div>
    </section>

    <!-- ============ FAQ (dark) ============ -->
    <section class="sec dark tight" id="faq">
      <div class="wrap narrow">
        <div class="sec-head reveal">
          <span class="eyebrow on-dark"><span class="dot"></span>Perguntas frequentes</span>
          <h2>O que já dá para responder por aqui.</h2>
        </div>
        <div class="reveal d1">
          {faq.map((f) => (
            <details class="faq-item">
              <summary>{f.q}<iconify-icon icon="solar:add-square-linear"></iconify-icon></summary>
              <div class="faq-body">{f.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style is:global>
    :root {
      --space: #07080C;
      --cream: #FAFAFA;
      --cold: #5B7B9A;
      --amber: #EBC456;
      --warm: #FED136;
      --ink-muted: rgba(15, 15, 17, .6);
      --text-d: #FFFFFF;
      --text-d-muted: rgba(255, 255, 255, .68);
      --text-d-faint: rgba(255, 255, 255, .42);
      --hairline-l: rgba(0, 0, 0, .08);
      --r-card: 22px;
      --ease: cubic-bezier(.16, 1, .3, 1);
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    h1, h2, h3 { font-family: var(--font-display); font-weight: 600; letter-spacing: -.03em; margin: 0; }
    body { font-family: var(--font-sans); background: var(--cream); color: var(--ink); overflow-x: hidden; -webkit-font-smoothing: antialiased; }
    .serif { font-family: var(--font-display); font-style: italic; font-weight: 400; letter-spacing: -.02em; }
    .warm-t { color: var(--warm); }
    .ln { color: inherit; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--warm); }

    #scroll-progress { position: fixed; top: 0; left: 0; height: 2px; background: var(--warm); z-index: 9999; width: 0; transition: width .1s linear; }

    /* canvas fixo (ruido -> gravidade) */
    #field-bg { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; display: block; pointer-events: none; background: var(--cream); }
    .body-label { position: fixed; left: 0; top: 0; z-index: 3; display: inline-flex; align-items: center; gap: .5rem; padding: .42rem .85rem; border-radius: var(--r-pill); font-family: var(--font-mono); font-size: .6rem; letter-spacing: .12em; text-transform: uppercase; backdrop-filter: blur(6px); pointer-events: none; white-space: nowrap; opacity: 0; will-change: transform, opacity; }
