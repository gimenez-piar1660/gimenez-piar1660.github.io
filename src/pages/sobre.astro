          tr = smooth(tr < 0 ? 0 : tr > 1 ? 1 : tr);
          // fin: clima no fim (a dobra climax preenchendo a tela)
          var fin = 0;
          if (climaxEl) { var rc = climaxEl.getBoundingClientRect(); fin = 1 - (rc.top / ((H * 0.75) || 1)); }
          fin = smooth(fin < 0 ? 0 : fin > 1 ? 1 : fin);
          // clarao quando a gravidade acende (a virada)
          var ignite = Math.max(0, 1 - Math.abs(tr - 0.5) / 0.16);
          // act: a massa cresce no ato CMO (a dobra "o mercado vem") e relaxa depois
          var act = 0;
          if (atraiEl) { var rA = atraiEl.getBoundingClientRect(); act = 1 - Math.abs((rA.top + rA.height * 0.5) - H * 0.5) / (H * 0.9); }
          act = smooth(act < 0 ? 0 : act > 1 ? 1 : act);

          var base = Math.min(W, H);
          var cx = W * 0.5, cy = H * (0.46 + 0.04 * Math.sin(T * 0.2));

          // fundo: creme -> espaco
          var bg0 = lerp(250, 7, tr), bg1 = lerp(250, 8, tr), bg2 = lerp(250, 12, tr);
          ctx.clearRect(0, 0, W, H);
          ctx.fillStyle = 'rgb(' + (bg0 | 0) + ',' + (bg1 | 0) + ',' + (bg2 | 0) + ')';
          ctx.fillRect(0, 0, W, H);

          // brilho do nucleo (so na fase dark)
          if (tr > 0.02) {
            var glowR = base * (0.26 + tr * 0.16 + fin * 0.28 + act * 0.12);
            var g = ctx.createRadialGradient(cx, cy, 0, cx, cy, glowR);
            g.addColorStop(0, 'rgba(254,209,54,' + (tr * (0.12 + fin * 0.14 + act * 0.08)).toFixed(3) + ')');
            g.addColorStop(0.4, 'rgba(254,209,54,' + (tr * 0.04).toFixed(3) + ')');
            g.addColorStop(1, 'rgba(254,209,54,0)');
            ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
          }

          var tilt = 0.42;
          // pontos: lar espalhado -> orbita
          for (var i = 0; i < N; i++) {
            var p = P[i];
            var jx = Math.cos(p.jt + T * p.js) * 6, jy = Math.sin(p.jt + T * p.js * 1.3) * 6;
            var sxp = p.hx * W + jx, syp = p.hy * H + jy;
            var a = p.ang + T * p.sp;
            var orr = p.rr * base * (1 - fin * 0.12 - act * 0.06);
            var oxp = cx + Math.cos(a) * orr, oyp = cy + Math.sin(a) * orr * tilt;
            var x = lerp(sxp, oxp, tr), y = lerp(syp, oyp, tr);
            // cor: escuro sobre creme -> claro/quente sobre espaco
            var r = lerp(24, 255, tr), gg = lerp(24, 224, tr), b = lerp(28, 138, tr);
            var alpha = (0.32 + p.br * 0.4) * (1 - tr * 0.15);
            ctx.beginPath(); ctx.arc(x, y, p.sz + tr * 0.5, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(' + (r | 0) + ',' + (gg | 0) + ',' + (b | 0) + ',' + alpha.toFixed(3) + ')';
            ctx.fill();
          }

          // corpos maiores + tethers (so quando a gravidade ligou)
          if (tr > 0.05) {
            for (var k = 0; k < bodies.length; k++) {
              var bd = bodies[k];
              var ba = bd.ang + T * bd.sp;
              var brr = bd.rr * base * (1 - fin * 0.14 - act * 0.13);
              var bx = cx + Math.cos(ba) * brr, by = cy + Math.sin(ba) * brr * tilt;
              bd._x = bx; bd._y = by;
              ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(bx, by);
              ctx.strokeStyle = 'rgba(' + bd.col[0] + ',' + bd.col[1] + ',' + bd.col[2] + ',' + (tr * (0.07 + act * 0.08)).toFixed(3) + ')'; ctx.lineWidth = 1; ctx.stroke();
              var rad = (3 + fin * 5 + act * 3) * tr + 1;
              ctx.beginPath(); ctx.arc(bx, by, rad, 0, Math.PI * 2);
              ctx.fillStyle = 'rgba(' + bd.col[0] + ',' + bd.col[1] + ',' + bd.col[2] + ',' + tr.toFixed(3) + ')';
              ctx.shadowColor = 'rgba(' + bd.col[0] + ',' + bd.col[1] + ',' + bd.col[2] + ',.7)'; ctx.shadowBlur = (10 + fin * 16 + act * 14) * tr; ctx.fill(); ctx.shadowBlur = 0;
            }
          }

          // clarao da virada: flash radial quando a gravidade acende
          if (ignite > 0.01 && tr > 0.02) {
            var fr = base * (0.3 + ignite * 0.55);
            var fg2 = ctx.createRadialGradient(cx, cy, 0, cx, cy, fr);
            fg2.addColorStop(0, 'rgba(254,209,54,' + (ignite * 0.2).toFixed(3) + ')');
            fg2.addColorStop(1, 'rgba(254,209,54,0)');
            ctx.fillStyle = fg2; ctx.fillRect(0, 0, W, H);
          }

          // o nucleo (a marca): acende com tr, incha no clima
          if (tr > 0.02) {
            var coreR = (4 + tr * 4 + fin * fin * 26 + ignite * 6 + act * 7);
            var bloom = Math.sin(fin * Math.PI);
            if (bloom > 0.002) {
              ctx.beginPath(); ctx.arc(cx, cy, coreR + bloom * base * 0.16, 0, Math.PI * 2);
              ctx.strokeStyle = 'rgba(254,209,54,' + (bloom * 0.4).toFixed(3) + ')'; ctx.lineWidth = 1.5; ctx.stroke();
            }
            ctx.beginPath(); ctx.arc(cx, cy, coreR, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(254,209,54,' + tr.toFixed(3) + ')';
            ctx.shadowColor = 'rgba(254,209,54,.9)'; ctx.shadowBlur = (18 + fin * 30) * tr; ctx.fill(); ctx.shadowBlur = 0;
          }

          if (lblCore) {
            var show = tr > 0.5 && fin < 0.85;
            lblCore.style.transform = 'translate(' + cx + 'px,' + cy + 'px) translate(-50%, 18px)';
            lblCore.style.opacity = show ? ((tr - 0.5) * 2).toFixed(3) : '0';
          }

          // nomes dos corpos (o comprador / o investidor / o talento) durante o ato CMO
          var showB = false;
          if (atraiEl) { var ra = atraiEl.getBoundingClientRect(); showB = ra.top < H * 0.6 && ra.bottom > H * 0.25; }
          for (var li = 0; li < bLbls.length; li++) {
            var L = bLbls[li]; if (!L) continue;
            var bb = bodies[li];
            if (showB && bb && bb._x != null && tr > 0.6) {
              L.style.transform = 'translate(' + bb._x + 'px,' + bb._y + 'px) translate(-50%, 14px)';
              L.style.opacity = '0.9';
            } else { L.style.opacity = '0'; }
          }

          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      })();
    });
  </script>
</BaseLayout>
