        // limalha: cada peca tem posicao, orientacao atual e tamanho
        var N = 320, fil = [];
        for (var i = 0; i < N; i++) {
          fil.push({
            x: ((i * 131) % 100) / 100, y: ((i * 73) % 100) / 100,
            ang: ((i * 97) % 628) / 100, m: 0.5 + ((i * 53) % 100) / 120, k6: i % 6, init: false
          });
        }


        // na secao "Os ativos da voz", a voz se desdobra em 6 sub-polos (os ativos),
        // cada um puxando um cluster proprio da audiencia. Reversivel via observer.
        var spread = 0, spreadTarget = 0, spin6 = 0;
        var atSec = document.getElementById('ativos-sec');
        if (atSec && 'IntersectionObserver' in window && !prefersReduced) {
          new IntersectionObserver(function (es) {
            es.forEach(function (e) { spreadTarget = e.isIntersecting ? 1 : 0; });
          }, { threshold: 0.4 }).observe(atSec);
        }

        function frame() {
          var pp = polePath(scrollP); tpx = pp[0]; tpy = pp[1];
          pX += (tpx - pX) * 0.07; pY += (tpy - pY) * 0.07;
          var bx = pX * W, by = pY * H;
          var S = smooth(scrollP);                         // forca do campo (o treino)
          var finale = smooth((scrollP - 0.72) / 0.28);    // clima do fecho
          var axis = -Math.PI / 2;                          // o dipolo aponta pra cima
          var mx = Math.cos(axis), my = Math.sin(axis);
          var base = Math.min(W, H);
          spread += (spreadTarget - spread) * 0.06;          // a voz se desdobra nos 6 ativos
          spin6 += prefersReduced ? 0 : 0.004;
          var sp = [];
          for (var s6 = 0; s6 < 6; s6++) {
            var a6 = s6 * (Math.PI / 3) + spin6;
            var R6 = base * 0.21 * spread;
            sp.push([bx + Math.cos(a6) * R6, by + Math.sin(a6) * R6 * 0.7]);
          }

          // fundo, linhas de campo e brilho ficam no canvas principal: sao difusos, nao
          // disputam com a leitura, e recortar um gradiente deixaria buraco quadrado.
          ctx = mctx;
          mctx.clearRect(0, 0, W, H);
          mctx.fillStyle = '#07080C'; mctx.fillRect(0, 0, W, H);

          // linhas de campo dipolar (r = L sin^2(theta)); intensificam com o treino
          var nLines = 7;
          ctx.lineWidth = 1;
          for (var s = -1; s <= 1; s += 2) {
            for (var li = 1; li <= nLines; li++) {
              var L = (li / nLines) * (0.16 + S * 0.5) * base;
              ctx.beginPath();
              for (var th = 0; th <= Math.PI + 0.001; th += 0.12) {
                var rr = L * Math.sin(th) * Math.sin(th);
                // direcao: eixo (mx,my) girado por s*th
                var ca = Math.cos(s * th), sa = Math.sin(s * th);
                var dxr = mx * ca - my * sa, dyr = mx * sa + my * ca;
                var lx = bx + rr * dxr, ly = by + rr * dyr;
                if (th === 0) ctx.moveTo(lx, ly); else ctx.lineTo(lx, ly);
              }
              ctx.strokeStyle = 'rgba(254,209,54,' + ((0.015 + S * 0.05) * (1 - spread * 0.7)) + ')';
              ctx.stroke();
            }
          }

          // brilho do polo (cresce com o treino e estoura no fecho)
          var glowR = base * (0.34 + S * 0.16 + finale * 0.28);
          var g = ctx.createRadialGradient(bx, by, 0, bx, by, glowR);
          g.addColorStop(0, 'rgba(254,209,54,' + (0.12 + S * 0.14 + finale * 0.12) + ')');
          g.addColorStop(0.16, 'rgba(254,209,54,' + (0.05 + S * 0.06 + finale * 0.05) + ')');
          g.addColorStop(0.5, 'rgba(254,209,54,0)');
          ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);

          // daqui pra baixo desenha na camada recortavel: limalha, ativos e nucleo
          if (readDirty) updateRects();
          ctx = dctx;
          dctx.clearRect(0, 0, W, H);

          // a limalha (a imprensa) gira, aponta pro campo e e atraida
          for (var k = 0; k < fil.length; k++) {
            var f = fil[k];
            if (!f.init) { f.x = f.x * W; f.y = f.y * H; f.init = true; }
            var home = sp[f.k6], cx = home[0], cy = home[1];   // o ativo que puxa esta peca
            var rx = f.x - cx, ry = f.y - cy, r2 = rx * rx + ry * ry + 400, r = Math.sqrt(r2);
            // direcao do campo dipolar: B = 3(m.rhat)rhat - m
            var hx = rx / r, hy = ry / r, mdotr = mx * hx + my * hy;
            var Bx = 3 * mdotr * hx - mx, By = 3 * mdotr * hy - my;
            var bAng = Math.atan2(By, Bx);
            // desalinhamento que decai com o treino
            var noise = (1 - S) * Math.sin((k * 12.9898 + f.x * 0.01 + f.y * 0.01)) * 1.4;
            var target = bAng + noise;
            var da = Math.atan2(Math.sin(target - f.ang), Math.cos(target - f.ang));
            f.ang += da * (0.04 + S * 0.12);
            // movimento: deriva ao longo do campo + atracao radial pro polo (cresce com S e finale)
            var pull = (0.04 + S * 0.5 + finale * 1.15 + spread * 0.55);
            f.x += Math.cos(f.ang) * 0.5 - hx * pull;
            f.y += Math.sin(f.ang) * 0.5 - hy * pull;
            if (r < 22 || f.x < -40 || f.x > W + 40 || f.y < -40 || f.y > H + 40) {
              f.x = Math.random() * W; f.y = Math.random() * H;
            }
            // esquenta conforme alinha e aproxima
            var heat = Math.max(0, Math.min(1, (1 - (r - 30) / (base * 0.55)) * (0.3 + S)));
            var cr = Math.round(91 + 163 * heat), cg = Math.round(123 + 86 * heat), cb = Math.round(154 - 100 * heat);
            var len = 4 + f.m * 5 + heat * 6;
            ctx.beginPath();
            ctx.moveTo(f.x - Math.cos(f.ang) * len * 0.5, f.y - Math.sin(f.ang) * len * 0.5);
            ctx.lineTo(f.x + Math.cos(f.ang) * len * 0.5, f.y + Math.sin(f.ang) * len * 0.5);
            ctx.strokeStyle = 'rgba(' + cr + ',' + cg + ',' + cb + ',' + (0.34 + 0.5 * heat) + ')';
            ctx.lineWidth = 1 + f.m * 0.7; ctx.stroke();
          }

          // os 6 ativos: sub-polos que brilham quando a secao "Os ativos da voz" esta em vista
          if (spread > 0.01) {
            for (var s7 = 0; s7 < 6; s7++) {
              var P = sp[s7];
              ctx.beginPath(); ctx.moveTo(bx, by); ctx.lineTo(P[0], P[1]);
              ctx.strokeStyle = 'rgba(254,209,54,' + (0.1 * spread).toFixed(3) + ')'; ctx.lineWidth = 1; ctx.stroke();
              ctx.beginPath(); ctx.arc(P[0], P[1], 3 + 2 * spread, 0, Math.PI * 2);
              ctx.fillStyle = 'rgba(255,224,130,' + (0.85 * spread).toFixed(3) + ')';
              ctx.shadowColor = 'rgba(254,209,54,' + (0.7 * spread).toFixed(3) + ')'; ctx.shadowBlur = 10 * spread; ctx.fill(); ctx.shadowBlur = 0;
            }
          }

          // o porta-voz: nucleo quente, cresce com o campo e INCHA no fecho
          var coreR = 5 + S * 4 + finale * finale * 30;
          var bloom = Math.sin(finale * Math.PI);
          if (bloom > 0.002) {
            ctx.beginPath(); ctx.arc(bx, by, coreR + bloom * base * 0.2, 0, Math.PI * 2);
            ctx.strokeStyle = 'rgba(254,209,54,' + (bloom * 0.4).toFixed(3) + ')'; ctx.lineWidth = 1.5; ctx.stroke();
          }
          ctx.beginPath(); ctx.arc(bx, by, coreR, 0, Math.PI * 2);
          ctx.fillStyle = '#FED136'; ctx.shadowColor = 'rgba(254,209,54,.95)'; ctx.shadowBlur = 22 + S * 10 + finale * 34; ctx.fill(); ctx.shadowBlur = 0;
          if (finale > 0.02) {
            ctx.beginPath(); ctx.arc(bx, by, coreR + 2.5, 0, Math.PI * 2);
            ctx.strokeStyle = 'rgba(255,243,205,' + (0.55 * finale).toFixed(3) + ')'; ctx.lineWidth = 1.3; ctx.stroke();
          }

          // recorta a camada nas zonas de leitura e joga sobre o fundo
          maskRead(dctx);
          mctx.drawImage(deco, 0, 0, W, H);
          ctx = mctx;


          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      })();

      /* ========================================================
         O BALCAO DO REPORTER (mensageiro pago por tempo)
         O reporter pede, o relogio corre, a resposta crua e riscada
         e a resposta treinada se forma (typewriter). Cicla os pares.
         ======================================================== */
      (function reporterDesk() {
        var qEl = document.getElementById('desk-q');
        var rawEl = document.getElementById('desk-raw');
        var okEl = document.getElementById('desk-ok');
        var timeEl = document.getElementById('desk-time');
        var costEl = document.getElementById('desk-cost');
        if (!qEl || !rawEl || !okEl) return;
        var pairs = [
          ['Por que a margem caiu neste trimestre?', 'Olha, é complicado, tem vários fatores, o mercado está difícil...', 'Investimos a margem em crescimento. Ela volta no próximo ciclo, e mostro com que números.'],
          ['Vocês vão demitir?', 'Não posso comentar isso agora. Sem comentários.', 'Estamos reorganizando para crescer. Toda mudança vem com plano de transição e transparência.'],
          ['O concorrente cresceu mais. E vocês?', 'Cada empresa tem sua estratégia, não dá para comparar assim...', 'A gente compete por valor, não por volume. O cliente fica, e a recompra prova isso.']
        ];
        var idx = 0, t = 0, timer = null, typer = null;
        function money(v) { return 'R$ ' + v.toFixed(2).replace('.', ','); }
        function runMeter() {
          t = 0;
          if (timer) clearInterval(timer);
          timer = setInterval(function () {
            t += 0.1;
            if (timeEl) timeEl.textContent = t.toFixed(1).replace('.', ',') + 's';
            if (costEl) costEl.textContent = money(t * 0.9);   // cada segundo de antena tem preco
            if (t >= 6) clearInterval(timer);
          }, 100);
        }
        function type(el, text, done) {
          var i = 0; el.innerHTML = '';
          if (typer) clearInterval(typer);
          typer = setInterval(function () {
            i++;
            el.innerHTML = text.slice(0, i) + (i < text.length ? '<span class="caret">|</span>' : '');
            if (i >= text.length) { clearInterval(typer); if (done) done(); }
          }, 26);
        }
        function show(n) {
          var p = pairs[n];
          qEl.textContent = p[0];
          rawEl.textContent = p[1];
          okEl.innerHTML = '';
          runMeter();
          setTimeout(function () { type(okEl, p[2]); }, 650);
        }
        show(0);
        if (prefersReduced) { okEl.textContent = pairs[0][2]; if (timer) clearInterval(timer); return; }
        setInterval(function () { idx = (idx + 1) % pairs.length; show(idx); }, 6200);
      })();
    });
  </script>
</BaseLayout>
