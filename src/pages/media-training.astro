    .section h2 { font-size: clamp(1.9rem, 4.2vw, 3.5rem); font-weight: 600; line-height: 1.06; letter-spacing: -.03em; margin-top: 1rem; max-width: 20ch; text-wrap: balance; }
    .lede { font-size: clamp(1.05rem, 1.4vw, 1.25rem); line-height: 1.6; color: var(--text-d-muted); margin-top: 1.4rem; max-width: 58ch; }
    .punch { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.5rem, 3vw, 2.5rem); line-height: 1.18; letter-spacing: -.025em; margin-top: clamp(2.5rem, 5vw, 3.5rem); max-width: 26ch; color: #fff; }

    .strike { font-family: var(--font-display); font-weight: 500; font-size: clamp(1.6rem, 3.4vw, 2.6rem); letter-spacing: -.02em; color: rgba(180,200,220,.7); margin: 1.5rem 0 0; }
