  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- Lenis + ScrollTrigger (globais via bootstrap.ts) ---- */
      try {
        if (window.gsap && window.ScrollTrigger) window.gsap.registerPlugin(window.ScrollTrigger);
        if (!prefersReduced && window.Lenis) {
          var lenis = new window.Lenis({ duration: 1.15, easing: function (t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); }, smooth: true, lerp: 0.1 });
          if (window.ScrollTrigger) { lenis.on('scroll', window.ScrollTrigger.update); window.gsap.ticker.add(function (time) { lenis.raf(time * 1000); }); window.gsap.ticker.lagSmoothing(0); }
          else { var raf = function (t) { lenis.raf(t); requestAnimationFrame(raf); }; requestAnimationFrame(raf); }
        }
      } catch (e) { /* noop */ }

      /* ---- reveal ---- */
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('active'); io.unobserve(en.target); } });
      }, { threshold: 0.14 });
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

      /* ---- scroll progress ---- */
      var bar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', function () {
        var h = document.documentElement;
        var p = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
        if (bar) bar.style.width = p + '%';
      }, { passive: true });

      /* ---- parallax de profundidade ---- */
      if (!prefersReduced && window.gsap && window.ScrollTrigger) {
        window.gsap.utils.toArray('[data-parallax-y]').forEach(function (el) {
          var yp = parseFloat(el.getAttribute('data-parallax-y')) || 0;
          window.gsap.fromTo(el, { yPercent: 0 }, { yPercent: yp, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } });
        });
      }

      /* ---- lerp mouse-parallax no heroi (Tres Mares) ---- */
      if (!prefersReduced && window.gsap) {
        var heroFloats = window.gsap.utils.toArray('[class*="hero-float"]');
        if (heroFloats.length) {
          var movers = heroFloats.map(function (el, i) {
            return {
              depth: (i % 2 ? 1 : -1) * (16 + i * 8),
              qx: window.gsap.quickTo(el, 'x', { duration: 0.7, ease: 'power3' }),
              qy: window.gsap.quickTo(el, 'y', { duration: 0.7, ease: 'power3' })
            };
          });
          window.addEventListener('mousemove', function (e) {
            var nx = (e.clientX / window.innerWidth - 0.5);
            var ny = (e.clientY / window.innerHeight - 0.5);
            for (var k = 0; k < movers.length; k++) { movers[k].qx(nx * movers[k].depth); movers[k].qy(ny * movers[k].depth); }
          }, { passive: true });
        }
      }

      /* ========================================================
         HERO · enxame de nos (canvas 2D)
         muitos pontos pequenos com alta densidade (micro) vs
         poucos grandes (hubs). amarelo + preto.
         ======================================================== */
      (function heroSwarm() {
        var canvas = document.getElementById('nm-hero-canvas');
        if (!canvas) { return; }
        var ctx = canvas.getContext('2d');
        if (!ctx) { canvas.style.background = 'radial-gradient(70% 90% at 72% 32%, #2a2407 0%, #120f06 55%, #0A0A0C 100%)'; return; }
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0, t = 0;
        var nano = [];   // muitos pontos pequenos, densos
        var hubs = [];   // poucos grandes
        var pointer = { x: -1, y: -1, on: false };

        function build() {
          var r = canvas.getBoundingClientRect();
          W = r.width; H = r.height;
          canvas.width = Math.floor(W * dpr); canvas.height = Math.floor(H * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          // enxame de nano: densidade alta, concentrada no quadrante direito.
          var count = Math.round(Math.min(280, Math.max(120, (W * H) / 5200)));
          nano = [];
          for (var i = 0; i < count; i++) {
            // bias para a direita/centro do heroi (onde a foto/visual vive)
            var bx = Math.pow(Math.random(), 0.6);
            var x = W * (0.30 + 0.74 * bx);
            var y = H * (0.10 + 0.84 * Math.random());
            nano.push({
              x: x, y: y, hx: x, hy: y,
              r: 0.9 + Math.random() * 1.9,
              a: 0.18 + Math.random() * 0.5,
              ph: Math.random() * Math.PI * 2,
              sp: 0.4 + Math.random() * 1.1,
              amp: 5 + Math.random() * 14
            });
          }
          // poucos hubs grandes, esparsos.
          hubs = [
            { x: W * 0.82, y: H * 0.30, r: 26 + W * 0.01, ph: 0.4 },
            { x: W * 0.62, y: H * 0.70, r: 20 + W * 0.008, ph: 2.1 },
            { x: W * 0.92, y: H * 0.66, r: 16 + W * 0.006, ph: 4.0 }
          ];
        }
        build();
        window.addEventListener('resize', build, { passive: true });

        canvas.addEventListener('pointermove', function (e) {
          var r = canvas.getBoundingClientRect();
          pointer.x = e.clientX - r.left; pointer.y = e.clientY - r.top; pointer.on = true;
        }, { passive: true });
        canvas.addEventListener('pointerleave', function () { pointer.on = false; });

        function frame() {
          t += 0.016;
          ctx.clearRect(0, 0, W, H);

          // hubs grandes: halo amarelo fraco, poucos. soam distantes.
          for (var h = 0; h < hubs.length; h++) {
            var hu = hubs[h];
            var pr = hu.r * (1 + 0.06 * Math.sin(t * 0.8 + hu.ph));
            var g = ctx.createRadialGradient(hu.x, hu.y, 0, hu.x, hu.y, pr * 2.6);
            g.addColorStop(0, 'rgba(120,124,132,.16)');
            g.addColorStop(0.5, 'rgba(120,124,132,.05)');
            g.addColorStop(1, 'rgba(120,124,132,0)');
            ctx.fillStyle = g;
            ctx.beginPath(); ctx.arc(hu.x, hu.y, pr * 2.6, 0, Math.PI * 2); ctx.fill();
            ctx.beginPath(); ctx.arc(hu.x, hu.y, pr, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(150,154,162,.22)'; ctx.fill();
            ctx.lineWidth = 1; ctx.strokeStyle = 'rgba(180,184,192,.28)'; ctx.stroke();
          }

          // linhas de proximidade entre nano vizinhos (a malha de confianca)
          ctx.lineWidth = 0.6;
          for (var i = 0; i < nano.length; i++) {
            var a = nano[i];
            for (var j = i + 1; j < nano.length; j++) {
              var b = nano[j];
              var dx = a.x - b.x, dy = a.y - b.y;
              var d2 = dx * dx + dy * dy;
              if (d2 < 1600) {
                var op = (1 - d2 / 1600) * 0.16;
                ctx.strokeStyle = 'rgba(254,209,54,' + op.toFixed(3) + ')';
                ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
              }
            }
          }

          // enxame nano: muitos pontos amarelos pequenos, vivos.
          for (var k = 0; k < nano.length; k++) {
            var n = nano[k];
            // deriva organica
            n.x = n.hx + Math.cos(t * n.sp + n.ph) * n.amp;
            n.y = n.hy + Math.sin(t * n.sp * 0.8 + n.ph) * n.amp * 0.7;
            // repulsao suave do ponteiro: o enxame reage ao toque
            if (pointer.on) {
              var px = n.x - pointer.x, py = n.y - pointer.y;
              var pd = px * px + py * py;
              if (pd < 9000 && pd > 1) {
                var f = (1 - pd / 9000) * 14;
                var inv = 1 / Math.sqrt(pd);
                n.x += px * inv * f; n.y += py * inv * f;
              }
            }
            var tw = 0.6 + 0.4 * Math.sin(t * 2 + n.ph);
            ctx.beginPath(); ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(254,209,54,' + (n.a * tw).toFixed(3) + ')';
            ctx.fill();
          }

          if (!prefersReduced) { raf = requestAnimationFrame(frame); }
        }
        var raf = requestAnimationFrame(frame);
        if (prefersReduced) { frame(); }
      })();

      /* ========================================================
         DATAVIZ · enxame vs hub (canvas 2D)
         engajamento somado de muitos pequenos supera poucos grandes.
         barra de total que enche conforme o enxame pulsa.
         ======================================================== */
      (function swarmVsHub() {
        var canvas = document.getElementById('nm-swarm-canvas');
        if (!canvas) { return; }
        var ctx = canvas.getContext('2d');
        if (!ctx) { return; }
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0, t = 0;
        var swarm = [], hub = null, pulses = [], swarmFill = 0, hubFill = 0;

        function layout() {
          var r = canvas.getBoundingClientRect();
          W = r.width; H = r.height;
          canvas.width = Math.floor(W * dpr); canvas.height = Math.floor(H * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          // enxame: muitos pontos pequenos no lado esquerdo, em cluster.
          swarm = [];
          var cx = W * 0.27, cy = H * 0.42, count = 46;
          for (var i = 0; i < count; i++) {
            var ang = Math.random() * Math.PI * 2;
            var rad = Math.pow(Math.random(), 0.5) * Math.min(W, H) * 0.20;
            swarm.push({
              x: cx + Math.cos(ang) * rad,
              y: cy + Math.sin(ang) * rad,
              r: 1.6 + Math.random() * 2.2,
              ph: Math.random() * Math.PI * 2,
              w: 1 + Math.random() * 1.4   // peso de engajamento individual (pequeno)
            });
          }
          // hub: um no grande no lado direito.
          hub = { x: W * 0.76, y: H * 0.42, r: Math.min(W, H) * 0.13 };
        }
        layout();

        function spawn() {
          if (prefersReduced || swarm.length === 0) { return; }
          var s = swarm[Math.floor(Math.random() * swarm.length)];
          pulses.push({ x: s.x, y: s.y, tx: W * 0.5, ty: H * 0.80, p: 0, sp: 0.012 + Math.random() * 0.01, src: 'swarm' });
          // hub dispara mais raramente
          if (Math.random() < 0.34 && hub) {
            pulses.push({ x: hub.x, y: hub.y, tx: W * 0.5, ty: H * 0.80, p: 0, sp: 0.013, src: 'hub' });
          }
        }

        function draw() {
          t += 0.016;
          ctx.clearRect(0, 0, W, H);

          // rotulos
          ctx.font = '600 11px "JetBrains Mono", monospace';
          ctx.textBaseline = 'alphabetic';
          ctx.textAlign = 'center';
          ctx.fillStyle = 'rgba(255,255,255,.5)';
          ctx.fillText('MUITOS NANO E MICRO', W * 0.27, H * 0.10);
          ctx.fillText('UM HUB GRANDE', W * 0.76, H * 0.10);

          // hub grande (cinza, distante)
          var hp = hub.r * (1 + 0.04 * Math.sin(t));
          var hg = ctx.createRadialGradient(hub.x, hub.y, 0, hub.x, hub.y, hp * 1.8);
          hg.addColorStop(0, 'rgba(107,114,128,.35)');
          hg.addColorStop(1, 'rgba(107,114,128,0)');
          ctx.fillStyle = hg;
          ctx.beginPath(); ctx.arc(hub.x, hub.y, hp * 1.8, 0, Math.PI * 2); ctx.fill();
          ctx.beginPath(); ctx.arc(hub.x, hub.y, hp, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(107,114,128,.55)'; ctx.fill();
          ctx.lineWidth = 1; ctx.strokeStyle = 'rgba(150,154,162,.5)'; ctx.stroke();

          // malha do enxame
          ctx.lineWidth = 0.6;
          for (var i = 0; i < swarm.length; i++) {
            var a = swarm[i];
            for (var j = i + 1; j < swarm.length; j++) {
              var b = swarm[j];
              var dx = a.x - b.x, dy = a.y - b.y, d2 = dx * dx + dy * dy;
              if (d2 < 1100) {
                ctx.strokeStyle = 'rgba(254,209,54,' + ((1 - d2 / 1100) * 0.22).toFixed(3) + ')';
                ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
              }
            }
          }
          // nos do enxame
          for (var k = 0; k < swarm.length; k++) {
            var s = swarm[k];
            var tw = 0.55 + 0.45 * Math.sin(t * 2.4 + s.ph);
            var ox = Math.cos(t * 0.8 + s.ph) * 2.4;
            var oy = Math.sin(t * 0.7 + s.ph) * 2.0;
            ctx.beginPath(); ctx.arc(s.x + ox, s.y + oy, s.r, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(254,209,54,' + (0.55 + 0.4 * tw).toFixed(3) + ')'; ctx.fill();
          }

          // pulsos viajando ate a barra de total
          for (var p = pulses.length - 1; p >= 0; p--) {
            var pu = pulses[p];
            pu.p += pu.sp;
            var u = pu.p < 1 ? pu.p : 1;
            var ex = pu.x + (pu.tx - pu.x) * u;
            var ey = pu.y + (pu.ty - pu.y) * u;
            var col = pu.src === 'swarm' ? '254,209,54' : '150,154,162';
            ctx.beginPath(); ctx.arc(ex, ey, 2.4, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(' + col + ',.9)'; ctx.fill();
            if (pu.p >= 1) {
              if (pu.src === 'swarm') { swarmFill = Math.min(1, swarmFill + 0.020); }
              else { hubFill = Math.min(1, hubFill + 0.010); }
              pulses.splice(p, 1);
            }
          }
          // decaimento lento para a barra respirar
          swarmFill = Math.max(0, swarmFill - 0.0016);
          hubFill = Math.max(0, hubFill - 0.0016);

          // barra de engajamento somado (parte de baixo)
          var bx = W * 0.14, bw = W * 0.72, by = H * 0.86, bh = 12;
          ctx.fillStyle = 'rgba(255,255,255,.08)';
          roundRect(bx, by, bw, bh, 6); ctx.fill();
          // segmento do enxame (amarelo) ocupa mais
          var swW = bw * (0.30 + 0.55 * swarmFill);
          var hubW = bw * (0.12 + 0.20 * hubFill);
          ctx.fillStyle = 'rgba(150,154,162,.6)';
          roundRect(bx, by, hubW, bh, 6); ctx.fill();
          ctx.fillStyle = '#FED136';
          roundRect(bx, by, swW, bh, 6); ctx.fill();
          ctx.font = '600 10px "JetBrains Mono", monospace';
          ctx.textAlign = 'left';
          ctx.fillStyle = 'rgba(255,255,255,.62)';
          ctx.fillText('ENGAJAMENTO SOMADO', bx, by - 9);

          requestAnimationFrame(draw);
        }

        function roundRect(x, y, w, h, r) {
          if (w < 2 * r) { r = w / 2; }
          ctx.beginPath();
          ctx.moveTo(x + r, y);
          ctx.arcTo(x + w, y, x + w, y + h, r);
          ctx.arcTo(x + w, y + h, x, y + h, r);
          ctx.arcTo(x, y + h, x, y, r);
          ctx.arcTo(x, y, x + w, y, r);
          ctx.closePath();
        }

        window.addEventListener('resize', layout, { passive: true });

        if (prefersReduced) {
          swarmFill = 0.7; hubFill = 0.25;
          layout(); draw();
        } else {
          setInterval(spawn, 420);
          spawn();
          requestAnimationFrame(draw);
        }
      })();
    });
  </script>
</BaseLayout>
