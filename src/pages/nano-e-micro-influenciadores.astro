---
// ============================================================================
// Exemplar narrativo · Nano e micro influenciadores
// Conteudo voice-backed portado de:
//   src/content/pages/nano-e-micro-influenciadores.md
// Original preservado. Esta pagina e a versao "narrativa espetacular":
// heroi canvas 2D (enxame de nos: muitos micro densos vs poucos hubs grandes) +
// dataviz "enxame vs hub" (canvas) + scroll storytelling (GSAP/Lenis), sobre o
// DS da PiaR (eyebrow-dot, watermarks, inversao dark, contorno Tres Mares,
// lerp mouse-parallax). A cor-assinatura desta pagina e o amarelo PiaR.
// ============================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import { site } from '@/data/site';

const url = `${site.domain}/nano-e-micro-influenciadores`;

// Os quatro tiers da piramide de influencia.
const tiers = [
  {
    id: 'NANO',
    nome: '1k a 10k seguidores',
    funcao: 'Base da pirâmide. Audiência pequena, alta afinidade, tom pessoal: alguém parecido comigo.',
    metrica: '3% a 8% de engajamento',
    proximidade: 'Máxima',
    icon: 'solar:user-rounded-line-duotone',
    featured: true,
    badge: 'Onde a confiança mora',
  },
  {
    id: 'MICRO',
    nome: '10k a 100k seguidores',
    funcao: 'Ainda nichado, mas com alcance maior e percepção de especialista no tema.',
    metrica: 'Comunidade e escala',
    proximidade: 'Alta',
    icon: 'solar:users-group-rounded-line-duotone',
  },
  {
    id: 'MACRO',
    nome: '100k a 1 milhão',
    funcao: 'Perfis de grande público, mais distantes da audiência individual.',
    metrica: '1% a 2% de engajamento',
    proximidade: 'Baixa',
    icon: 'solar:users-group-two-rounded-line-duotone',
  },
  {
    id: 'MEGA',
    nome: 'Acima de 1 milhão',
    funcao: 'Máximo alcance, mínimo de proximidade, custo elevado.',
    metrica: 'Volume puro',
    proximidade: 'Mínima',
    icon: 'solar:crown-star-line-duotone',
  },
];

// Os quatro deslocamentos do angulo PiaR (influencia e relacao, nao midia avulsa).
const angulo = [
  {
    nome: 'Reputação antes de alcance',
    desc: 'Nano e micro entram como vozes de credibilidade dentro de uma estratégia de comunicação, integrados à assessoria de imprensa e ao Digital PR, e não como linha de mídia paga isolada.',
    icon: 'solar:shield-star-line-duotone',
  },
  {
    nome: 'Fit cultural e de valores',
    desc: 'A escolha começa pelo alinhamento entre o que o criador defende e o que a marca representa. É gestão de risco de imagem, território de relações públicas, não uma planilha de CPM.',
    icon: 'solar:heart-angle-line-duotone',
  },
  {
    nome: 'Mídia conquistada primeiro',
    desc: 'Earned media e relacionamento vêm antes de qualquer formato pago. A amplificação paga entra como complemento honesto e transparente, com sinalização clara, nunca como substituto.',
    icon: 'solar:medal-ribbons-star-line-duotone',
  },
  {
    nome: 'O criador como parceiro',
    desc: 'A relação continuada (always-on) protege o ativo do nano e do micro, que é a autenticidade. Tratar criador como fornecedor descartável queima a base e mina a confiança.',
    icon: 'solar:hand-shake-line-duotone',
  },
];

// As cinco frentes de planejamento (frameworks combinados).
const frentes = [
  {
    nome: 'Pirâmide de tiers',
    desc: 'Antes de escolher nomes, defina a função de cada faixa. Decidir a faixa é decidir o tipo de confiança que você quer mobilizar.',
    icon: 'solar:chart-square-line-duotone',
  },
  {
    nome: 'Estratégia em camadas',
    desc: 'Combinar muitos nano com um número menor de micro capta o melhor dos dois mundos: nano traz volume de conteúdo e UGC, micro traz alcance e credibilidade de especialista.',
    icon: 'solar:layers-minimalistic-line-duotone',
  },
  {
    nome: 'Programa always-on',
    desc: 'Manter um grupo recorrente de nano e micro como advogados de marca tende a ser mais barato e mais afim do que ativações isoladas. Compromisso operacional, não item de campanha.',
    icon: 'solar:refresh-circle-line-duotone',
  },
  {
    nome: 'Motor de UGC',
    desc: 'Uma campanha de seeding em escala produz conteúdo autêntico e alinhado, reaproveitável em mídia paga, e-mail e social. O ganho está no volume genuíno; o risco está em engessar o criador.',
    icon: 'solar:videocamera-record-line-duotone',
  },
  {
    nome: 'Vetting e detecção de fraude',
    desc: 'Triagem de autenticidade antes de contratar virou etapa central: seguidores reais, padrão de engajamento e indícios de bots ou inflação por IA. Proteção de reputação, não detalhe.',
    icon: 'solar:user-check-rounded-line-duotone',
  },
];

// Passo a passo para integrar nano e micro a comunicacao.
const passos = [
  {
    num: '01',
    titulo: 'Objetivo de reputação',
    fase: 'Antes de buscar nomes',
    desc: 'Decida o que a parceria precisa provar: autoridade em um tema, presença em um nicho, prova social para um lançamento. Métrica de venda entra, mas não sozinha.',
  },
  {
    num: '02',
    titulo: 'Padronize os tiers',
    fase: 'Alinhamento interno',
    desc: 'Fixe os cortes de nano e micro que a sua operação vai usar, por exemplo nano até 10 mil e micro até 100 mil, para evitar ruído de planejamento.',
  },
  {
    num: '03',
    titulo: 'Nicho e fit de valores',
    fase: 'Curadoria',
    desc: 'Liste temas e comunidades relevantes e selecione criadores cujo conteúdo e postura combinem com a marca. Fit vem antes de número de seguidores.',
  },
  {
    num: '04',
    titulo: 'Vetting de autenticidade',
    fase: 'Triagem',
    desc: 'Audite audiência real, padrão de engajamento e sinais de fraude. Descarte quem não passa. Documente o critério.',
  },
  {
    num: '05',
    titulo: 'Contrato e conformidade',
    fase: 'Curadoria de risco',
    desc: 'Formalize escopo, exclusividade, prazos e, principalmente, a sinalização de publicidade clara e ostensiva, conforme o Guia do CONAR.',
  },
  {
    num: '06',
    titulo: 'Briefing aberto',
    fase: 'Direção sem engessar',
    desc: 'Dê direção de marca e mensagens-chave, mas preserve o tom do criador. Roteiro engessado destrói a autenticidade que faz o nano e o micro funcionarem.',
  },
  {
    num: '07',
    titulo: 'Integre com PR',
    fase: 'Mídia conquistada',
    desc: 'Amarre, quando fizer sentido, a parceria a eventos, conteúdo proprietário e relacionamento com imprensa, transformando influência em cobertura.',
  },
  {
    num: '08',
    titulo: 'Meça além de likes',
    fase: 'Leitura de reputação',
    desc: 'Acompanhe engajamento qualificado, sentimento, share of voice e valor de mídia espontânea, além das metas de conversão.',
  },
];

// Metricas de reputacao (medir alem da conversao).
const metricas = [
  { nome: 'Engajamento qualificado', desc: 'Interações relevantes (comentários, salvamentos, compartilhamentos), não só curtidas.', icon: 'solar:chat-round-like-line-duotone' },
  { nome: 'Sentimento', desc: 'Como a audiência reage ao conteúdo e à marca: positivo, neutro ou negativo.', icon: 'solar:smile-circle-line-duotone' },
  { nome: 'Share of voice', desc: 'Quanto a marca aparece na conversa do nicho frente aos concorrentes.', icon: 'solar:volume-loud-line-duotone' },
  { nome: 'Valor de mídia espontânea', desc: 'Estimativa do valor da exposição conquistada via criadores e desdobramentos editoriais.', icon: 'solar:tag-price-line-duotone' },
  { nome: 'Conversão e ROI', desc: 'Metas de negócio (cadastros, instalações, vendas), lidas junto com as métricas acima, não isoladas.', icon: 'solar:graph-up-line-duotone' },
];

const exits = ['Axado', 'Trustvox', 'ViaNuvem', 'Konduto', 'Getrak', 'GrandChef', 'Xtech Commerce', 'Supermercado Now'];
const clientes = ['Sambatech', 'Liga Ventures', 'Doctoralia', 'Solides', 'PagBrasil', 'Corning'];

const faq = [
  {
    q: 'Qual a diferença entre nano e micro influenciador?',
    a: 'Nano costuma descrever perfis com cerca de 1.000 a 10.000 seguidores, e micro perfis entre 10.000 e 100.000 (algumas tabelas encerram a faixa micro em 50.000). A diferença principal não é só o número: nano tende a ter tom mais pessoal e máxima proximidade, enquanto micro já é percebido como especialista do nicho, com alcance maior. Padronize os cortes internamente antes de planejar.',
  },
  {
    q: 'Vale mais a pena que macro influenciadores e celebridades?',
    a: 'Depende do objetivo. Para autoridade em nicho, prova social e engajamento qualificado, nano e micro costumam render mais por real investido. Segundo a Collabstr, nano influenciadores entregam de 3% a 8% de engajamento globalmente, contra 1% a 2% dos macro. Para um único momento de alcance massivo, macro e celebridades ainda têm papel. Não é hierarquia, é função.',
  },
  {
    q: 'Quantos seguidores tem um nano influenciador?',
    a: 'No corte mais usado pelo mercado, de cerca de 1.000 a 10.000 seguidores. É a base da chamada pirâmide de influência.',
  },
  {
    q: 'Como saber se a audiência de um criador é real?',
    a: 'Por vetting: análise de seguidores reais, padrão de engajamento e indícios de bots ou inflação por IA, antes de fechar a parceria. Segundo a InfluenceFlow, a fraude se concentra no tier macro e é menos vantajosa para nano e micro, cujas audiências menores são mais fáceis de auditar. Ainda assim, a checagem é etapa obrigatória para proteger a reputação da marca.',
  },
  {
    q: 'Preciso sinalizar que o conteúdo é pago?',
    a: 'Sim. O Guia do CONAR exige que publicidade seja sinalizada de forma clara e ostensiva (por exemplo, #publi visível, não escondida no texto). A edição vigente a partir de 1º de junho de 2026 reforça isso e trata de temas como uso de IA e proteção de crianças e adolescentes. Não sinalizar gera risco legal e perda de confiança.',
  },
  {
    q: 'Nano e micro funcionam para B2B e mercados técnicos?',
    a: 'Sim. Em setores como fintech, BaaS, saúde e tecnologia, especialistas com audiência pequena e nichada costumam carregar mais autoridade que perfis de grande alcance genérico, porque a confiança no tema vale mais que o tamanho do público. É um uso ainda pouco explorado frente ao foco em moda e beleza.',
  },
  {
    q: 'Quantos criadores devo ativar por trimestre?',
    a: 'Não há número único. Materiais do setor, como digitalapplied.com e RISER, sugerem ativar de dezenas a poucas centenas de criadores por trimestre em um programa contínuo. O ponto não é o número, e sim ter operação, contrato e mensuração para sustentar a escala sem que o custo de coordenação anule o ganho.',
  },
];
---
<BaseLayout
  title="Nano e micro influenciadores: muitos pequenos batem poucos grandes"
  description="Nano e micro influenciadores como vozes de credibilidade, não mídia avulsa: tiers, engajamento, vetting, CONAR e integração com PR e reputação. O guia da PiaR."
  canonical={url}
>
  <Fragment slot="head">
    <style is:global>
      :root {
        --accent: #FED136;
        --accent-deep: #E0B420;
        --paper-warm: #F5F2E9;
        --nm-ink: #0A0A0C;
        --nm-ink-2: #141417;
        --nm-amber: #FFB020;
        --nm-glow: #FFD84A;
        --radius-card: 24px;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 700; }
      body { font-family: var(--font-sans); background: var(--paper); color: var(--primary); overflow-x: hidden; -webkit-font-smoothing: antialiased; font-feature-settings: "ss01", "cv11"; }

      #scroll-progress { position: fixed; top: 0; left: 0; height: 2px; background: var(--accent); z-index: 9999; width: 0; transition: width .1s linear; }

      .wrap { max-width: 1280px; margin: 0 auto; padding-inline: 1.5rem; position: relative; z-index: 1; }
      @media (min-width: 768px) { .wrap { padding-inline: 2rem; } }

      .eyebrow { display: inline-flex; align-items: center; gap: .6rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; color: var(--text-muted); font-weight: 600; }
      .eyebrow::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex-shrink: 0; box-shadow: 0 0 0 4px rgba(254,209,54,.18); }
      .eyebrow.on-dark { color: rgba(255,255,255,.72); }

      .accent-serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--accent-deep); letter-spacing: -.02em; }
      .accent-serif.on-dark { color: var(--accent); }

      /* botoes */
      .btn { display: inline-flex; align-items: center; gap: .55rem; padding: .9rem 1.7rem; border-radius: var(--radius-btn); font-size: .95rem; font-weight: 600; letter-spacing: -.01em; text-decoration: none; transition: var(--t-smooth); cursor: pointer; border: 1.5px solid transparent; }
      .btn iconify-icon { transition: transform .4s var(--ease-out-expo); }
      .btn:hover iconify-icon { transform: translateX(4px); }
      .btn-accent { background: var(--accent); color: var(--primary); border-color: var(--accent); }
      .btn-accent:hover { background: #FFD84A; transform: translateY(-2px); box-shadow: 0 16px 32px rgba(254,209,54,.32); }
      .btn-ghost-d { background: transparent; color: #fff; border-color: rgba(255,255,255,.25); }
      .btn-ghost-d:hover { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.5); }
      .btn-ghost { background: transparent; color: var(--primary); border-color: rgba(0,0,0,.16); }
      .btn-ghost:hover { background: rgba(0,0,0,.04); border-color: rgba(0,0,0,.32); }

      /* ===========================================================
         1 · HERO · enxame de nos (canvas 2D, amarelo + preto)
         =========================================================== */
      .nm-hero { position: relative; min-height: 100vh; min-height: 100svh; background: var(--nm-ink); color: #fff; overflow: hidden; display: flex; align-items: center; isolation: isolate; }
      #nm-hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; display: block; }
      .nm-hero .scrim { position: absolute; inset: 0; z-index: 1; pointer-events: none;
        background:
          radial-gradient(120% 90% at 16% 38%, rgba(10,10,12,.86) 0%, rgba(10,10,12,.36) 46%, rgba(10,10,12,0) 72%),
          linear-gradient(180deg, rgba(10,10,12,.5) 0%, rgba(10,10,12,0) 30%, rgba(10,10,12,.2) 74%, rgba(10,10,12,.92) 100%);
      }
      .nm-hero .hero-inner { position: relative; z-index: 2; width: 100%; padding-block: 9rem 4rem; }
      .nm-hero-chip { display: inline-flex; align-items: center; gap: .5rem; padding: .5rem 1rem; border-radius: var(--radius-pill); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(6px); font-family: var(--font-mono); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.78); }
      .nm-hero-chip .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px 1px rgba(254,209,54,.7); }
      .nm-hero h1 { font-size: clamp(2.8rem, 8vw, 7.6rem); font-weight: 700; line-height: .94; letter-spacing: -.045em; margin: 1.6rem 0 0; max-width: 16ch; text-wrap: balance; }
      .nm-hero .sub { font-size: clamp(1.1rem, 1.7vw, 1.4rem); line-height: 1.5; color: rgba(255,255,255,.74); margin-top: 1.75rem; max-width: 48ch; }
      .nm-hero .cta-row { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2.5rem; }
      .nm-scroll-cue { position: absolute; left: 50%; bottom: 1.75rem; transform: translateX(-50%); z-index: 2; display: inline-flex; flex-direction: column; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .6rem; letter-spacing: .2em; text-transform: uppercase; color: rgba(255,255,255,.5); }
      .nm-scroll-cue .line { width: 1px; height: 38px; background: linear-gradient(180deg, rgba(255,255,255,.5), transparent); animation: cuePulse 2.2s var(--ease-out-expo) infinite; }
      @keyframes cuePulse { 0%,100% { opacity: .3; transform: scaleY(.7); transform-origin: top; } 50% { opacity: 1; transform: scaleY(1); } }

      /* parallax de profundidade */
      .px { will-change: transform; }
      .has-ghost { overflow: hidden; }
      .ghost-mark { position: absolute; z-index: 0; font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: clamp(7rem, 24vw, 24rem); line-height: .78; letter-spacing: -.04em; color: rgba(15,15,17,.045); pointer-events: none; user-select: none; white-space: nowrap; }
      .section.dark .ghost-mark { color: rgba(255,255,255,.04); }
      .ghost-mark.tr { top: -2rem; right: -1.5rem; }
      .ghost-mark.bl { bottom: -3rem; left: -2rem; }
      .nm-hero-float { position: absolute; z-index: 2; display: inline-flex; align-items: center; gap: .5rem; padding: .55rem 1rem; border-radius: var(--radius-pill); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(6px); font-family: var(--font-mono); font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.72); }
      .nm-hero-float .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px 1px rgba(254,209,54,.7); }
      .nm-hero-float.f1 { right: 9%; top: 27%; }
      .nm-hero-float.f2 { right: 17%; bottom: 21%; }
      @media (max-width: 900px) { .nm-hero-float { display: none; } .ghost-mark { font-size: clamp(6rem, 30vw, 12rem); } }

      /* Tres Mares · contorno (enxame denso) como camada de profundidade */
      .has-contour { overflow: hidden; }
      .contour-field {
        position: absolute; inset: -14% -10%; z-index: 0; pointer-events: none;
        --contour-line: rgba(254,209,54,.09);
        background: repeating-radial-gradient(circle at 76% 44%, transparent 0 30px, var(--contour-line) 30px 31px);
        -webkit-mask-image: radial-gradient(circle at 76% 44%, #000 0%, rgba(0,0,0,.55) 42%, transparent 78%);
                mask-image: radial-gradient(circle at 76% 44%, #000 0%, rgba(0,0,0,.55) 42%, transparent 78%);
        will-change: transform;
      }
      @media (max-width: 760px) { .contour-field { opacity: .6; } }

      /* ===========================================================
         secoes base
         =========================================================== */
      .section { padding-block: clamp(5rem, 10vw, 9rem); position: relative; }
      .section.paper { background: var(--paper); border-top: 1px solid var(--hairline); }
      .section.warm { background: var(--paper-warm); border-top: 1px solid var(--hairline); }
      .section.dark { background: var(--nm-ink); color: #fff; border-top: 1px solid rgba(255,255,255,.06); }
      .section h2 { font-size: clamp(2.1rem, 4.6vw, 4rem); font-weight: 600; line-height: 1.03; letter-spacing: -.035em; margin: 1rem 0 0; max-width: 20ch; text-wrap: balance; }
      .section.dark h2 { color: #fff; }
      .lede { font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.55; color: var(--text-muted); margin-top: 1.5rem; max-width: 56ch; }
      .section.dark .lede { color: rgba(255,255,255,.72); }
      .sec-head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }

      /* compare 2 colunas (a virada de regua) */
      .compare { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
      @media (min-width: 900px) { .compare { grid-template-columns: 1fr 1fr; gap: 1.5rem; } }
      .compare-card { padding: clamp(2rem, 3vw, 2.75rem); border-radius: var(--radius-card); border: 1px solid var(--hairline); background: #fff; min-height: 280px; display: flex; flex-direction: column; }
      .compare-card .ctag { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--text-faint); }
      .compare-card h3 { font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 600; letter-spacing: -.025em; margin: .9rem 0 0; line-height: 1.1; }
      .compare-card p { font-size: 1.0625rem; line-height: 1.6; color: var(--text-muted); margin-top: 1rem; }
      .compare-card .steps { margin-top: auto; padding-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; color: var(--text-faint); }
      .compare-card .steps iconify-icon { color: var(--accent-deep); }
      .compare-card.is-dark { background: var(--nm-ink-2); border-color: rgba(255,255,255,.12); color: #fff; }
      .compare-card.is-dark .ctag { color: rgba(255,255,255,.45); }
      .compare-card.is-dark p { color: rgba(255,255,255,.72); }
      .compare-card.is-dark .steps { color: rgba(255,255,255,.5); }
      .compare-card.is-dark .steps iconify-icon { color: var(--accent); }
      .punch { font-family: var(--font-serif); font-style: italic; font-size: clamp(1.6rem, 3.4vw, 2.9rem); line-height: 1.18; letter-spacing: -.02em; margin-top: clamp(2.5rem, 5vw, 3.5rem); max-width: 24ch; }
      .punch .hl { color: var(--accent-deep); font-style: italic; }
      .section.dark .punch .hl { color: var(--accent); }

      /* tiers NANO/MICRO/MACRO/MEGA */
      .layers { display: grid; grid-template-columns: 1fr; gap: 1rem; }
      @media (min-width: 720px) { .layers { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
      @media (min-width: 1080px) { .layers { grid-template-columns: repeat(4, 1fr); gap: 1.25rem; } }
      .layer-card { position: relative; padding: clamp(1.6rem, 2.2vw, 2.1rem); border-radius: var(--radius-card); border: 1px solid var(--hairline); background: #fff; overflow: hidden; transition: var(--t-smooth); }
      .layer-card:hover { transform: translateY(-4px); box-shadow: 0 24px 48px rgba(0,0,0,.07); border-color: rgba(0,0,0,.14); }
      .layer-card .l-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: rgba(15,15,17,.05); color: var(--primary); font-size: 1.4rem; }
      .layer-card .l-id { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text-faint); margin-top: 1.25rem; }
