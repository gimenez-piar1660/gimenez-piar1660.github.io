    margin-top: 8px;
  }
  .diag .btn:hover { background: var(--ouro-claro); }
  .diag .btn:active { transform: scale(.99); }
  .diag .btn[disabled] { opacity: .6; cursor: progress; }
  .diag .btn.vazio { background: transparent; color: var(--cinza); border: 1px solid var(--linha); margin-top: 12px; }
  .diag .btn.vazio:hover { background: var(--preto-2); color: var(--off); }

  /* ---------- Tela 2 ---------- */
  .diag .progresso { margin-bottom: 28px; }
  .diag .barra { height: 3px; background: var(--preto-3); border-radius: 3px; overflow: hidden; }
  .diag .barra i { display: block; height: 100%; background: var(--ouro); width: 0; transition: width .3s ease; }
  .diag .contagem { display: flex; justify-content: space-between; margin-top: 11px; color: var(--cinza); }

  .diag .territorio { color: var(--ouro); margin-bottom: 12px; }
  .diag .pergunta h2 { font-size: clamp(21px, 4.4vw, 28px); margin-bottom: 24px; }
  .diag .opcoes { display: flex; flex-direction: column; gap: 9px; }
  .diag .opcao {
    background: var(--preto-2);
    border: 1px solid var(--linha);
    border-radius: var(--r-md);
    padding: 16px 18px;
    cursor: pointer;
    font-size: 15px;
    color: var(--off);
    text-align: left;
    font-family: inherit;
    transition: border-color .15s, background .15s;
    display: flex;
    align-items: center;
    gap: 13px;
    line-height: 1.4;
  }
  .diag .opcao:hover { border-color: var(--ouro); background: var(--preto-3); }
  .diag .opcao .marca {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid var(--gray-600);
    flex-shrink: 0;
    transition: border-color .15s;
  }
  .diag .opcao:hover .marca { border-color: var(--ouro); }

  .diag .voltar {
    background: none;
    border: none;
    color: var(--cinza);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    cursor: pointer;
    margin-top: 24px;
    padding: 6px 0;
  }
  .diag .voltar:hover { color: var(--off); }

  /* ---------- Tela 3 ---------- */
  .diag .nota { text-align: center; padding: 10px 0 30px; border-bottom: 1px solid var(--linha); margin-bottom: 34px; }
  .diag .nota .num { font-family: var(--display); font-weight: 800; font-size: clamp(62px, 15vw, 96px); line-height: 1; color: var(--ouro); }
  .diag .nota .de { color: var(--cinza); font-size: 14px; margin-top: 4px; }
  .diag .nota .faixa { font-family: var(--display); font-weight: 800; font-size: clamp(24px, 5.2vw, 34px); margin-top: 20px; }
  .diag .nota .resumo { color: var(--corpo); font-size: 16px; max-width: 56ch; margin: 16px auto 0; text-align: left; }

  /* mapa dos cinco territórios: a forma do resultado num olhar */
  .diag .mapa { margin-bottom: 34px; }
  .diag .mapa-linha {
    display: grid;
    grid-template-columns: 1fr 150px 46px;
    align-items: center;
    gap: 14px;
    padding: 11px 0;
    border-bottom: 1px solid var(--linha);
  }
  .diag .mapa-linha:first-child { border-top: 1px solid var(--linha); }
  .diag .mapa-linha .rot { font-size: 14.5px; color: var(--corpo); }
  .diag .mapa-linha .trilho { height: 6px; background: var(--trilho); border-radius: 4px; overflow: hidden; }
  .diag .mapa-linha .trilho i {
    display: block;
    height: 100%;
    width: 0;
    min-width: 3px;
    border-radius: 4px;
    transition: width .8s var(--ease-spring);
  }
  .diag .mapa-linha .trilho i.baixo { background: var(--alerta); }
  .diag .mapa-linha .trilho i.medio { background: var(--ouro); }
  .diag .mapa-linha .trilho i.alto { background: var(--ok); }
  .diag .mapa-linha .val { font-family: var(--mono); font-size: 12px; color: var(--cinza); text-align: right; }
  @media (max-width: 560px) {
    .diag .mapa-linha { grid-template-columns: 1fr 92px 40px; gap: 10px; }
    .diag .mapa-linha .rot { font-size: 13.5px; }
  }

  .diag .secao-titulo { margin-bottom: 20px; }
  .diag .secao-titulo h3 { font-size: 19px; margin-bottom: 6px; }
  .diag .secao-titulo p { color: var(--cinza); font-size: 14px; }

  .diag .card {
    background: var(--preto-2);
    border: 1px solid var(--linha);
    border-radius: var(--r-md);
    padding: 22px;
    margin-bottom: 14px;
  }
  .diag .card-topo { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
  .diag .card-topo .nome { color: var(--ouro); }
  .diag .nivel {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--r-pill);
    border: 1px solid;
    white-space: nowrap;
  }
  .diag .nivel.baixo { color: var(--alerta); border-color: rgba(232, 67, 61, .4); }
  .diag .nivel.medio { color: var(--ouro); border-color: rgba(254, 209, 54, .4); }
  .diag .nivel.alto { color: var(--ok); border-color: rgba(94, 194, 122, .4); }
  .diag .card h4 { font-size: 18px; line-height: 1.2; margin-bottom: 11px; }
  .diag .card p { font-size: 15px; color: var(--corpo); margin-bottom: 14px; }
  .diag .movimento { border-left: 2px solid var(--ouro); padding: 2px 0 2px 15px; }
  .diag .movimento .rot { color: var(--ouro); display: block; margin-bottom: 5px; }
  .diag .movimento p { font-size: 14.5px; color: var(--corpo); margin-bottom: 0; }

  .diag .oferta {
    background: linear-gradient(160deg, var(--preto-3), var(--preto-2));
    border: 1px solid rgba(254, 209, 54, .28);
    border-radius: var(--r-lg);
    padding: 30px 24px;
    margin-top: 38px;
  }
  .diag .oferta .rot { display: block; color: var(--ouro); margin-bottom: 12px; }
  .diag .oferta h3 { font-size: clamp(22px, 4.6vw, 29px); margin-bottom: 16px; }
  .diag .oferta h3 em { font-style: normal; color: var(--ouro); }
  .diag .oferta p { color: var(--corpo); font-size: 15px; margin-bottom: 14px; }
  .diag .oferta .ponte { color: var(--off); font-size: 16px; border-left: 2px solid var(--ouro); padding-left: 15px; margin-bottom: 20px; }
  .diag .dados { display: flex; gap: 26px; flex-wrap: wrap; margin: 22px 0; padding-top: 20px; border-top: 1px solid var(--linha); }
  .diag .dados div span { display: block; }
  .diag .dados .v { font-family: var(--display); font-weight: 800; font-size: 20px; color: var(--ouro); }
  .diag .dados .l { color: var(--cinza); font-size: 12.5px; margin-top: 2px; }

  .diag .rodape { text-align: center; color: var(--cinza); font-size: 12.5px; margin-top: 44px; padding-top: 22px; border-top: 1px solid var(--linha); }
  .diag .rodape .assinatura-rodape { margin-top: 10px; }
  .diag .imprimir { background: none; border: none; color: var(--cinza); font-size: 13px; text-decoration: underline; cursor: pointer; font-family: inherit; }

  /* Só existem no papel. */
  .diag .cabecalho-pdf,
  .diag .pdf-so { display: none; }

  /* ---------- Versão impressa / PDF ---------- */
  @media print {
    .diag { min-height: 0; }
    .diag::before { display: none; }
    .diag .wrap { max-width: none; padding: 15mm 14mm 0; }
    .diag #tela-resultado { padding-bottom: 0; }

    /* só o resultado vai para o papel */
    .diag .topo,
    .diag .btn,
    .diag .imprimir,
    .diag .rodape,
    .diag .voltar { display: none !important; }
    .diag .tela { display: none !important; }
    .diag #tela-resultado { display: block !important; }

    .diag .cabecalho-pdf {
      display: flex;
      align-items: center;
      gap: 12px;
      padding-bottom: 12px;
      margin-bottom: 22px;
      border-bottom: 1px solid var(--linha);
    }
    .diag .cabecalho-pdf .marca { font-family: var(--display); font-weight: 800; font-size: 14px; letter-spacing: .04em; color: var(--off); }
    .diag .cabecalho-pdf .marca span { color: var(--cinza); font-family: var(--body); font-weight: 400; font-size: 11px; letter-spacing: .1em; margin-left: 9px; }
    .diag .cabecalho-pdf .quem {
      margin-left: auto;
      text-align: right;
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--cinza);
      line-height: 1.6;
    }
    .diag .cabecalho-pdf .quem b { display: block; color: var(--ouro); font-weight: 500; }

    .diag .nota { padding-top: 0; page-break-after: avoid; }
    .diag .nota .assinatura { margin-bottom: 18px; }
    .diag .wave i { animation: none; opacity: .9; }

    .diag .mapa { page-break-inside: avoid; }
    .diag .card, .diag .oferta { page-break-inside: avoid; background: var(--preto-2) !important; }
    /* o mapa já anuncia os territórios; o subtítulo só criaria órfão no papel */
    .diag .secao-titulo { display: none; }
    .diag .card { margin-bottom: 5mm; }

    .diag .oferta { margin: 26px 0 0; background: var(--preto-3) !important; }
    .diag .pdf-so {
      display: block;
      margin-top: 18px;
      padding-top: 16px;
      border-top: 1px solid var(--linha);
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: .06em;
      color: var(--ouro);
    }
  }
</style>

<script is:inline define:vars={{ RD_PUBLIC_KEY, RD_ID_INICIO, RD_ID_COMPLETO, PRODUTO, CTA_PROGRAMA, PONTOS, PERGUNTAS, TERRITORIOS, FAIXAS }}>
(function () {
  'use strict';

  /* ===================== ESTADO ===================== */
  let atual = 0;
  const respostas = new Array(PERGUNTAS.length).fill(null);
  let lead = {};
  let origem = {};
  const $ = (id) => document.getElementById(id);

  const RD_ATIVO = Boolean(RD_PUBLIC_KEY) && RD_PUBLIC_KEY.indexOf('COLE-SUA') !== 0;

  function mostrarTela(id) {
    document.querySelectorAll('.diag .tela').forEach((t) => t.classList.remove('ativa'));
    $(id).classList.add('ativa');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  /* waveform: assinatura visual do THE MIC */
  function desenharWave(el, barras) {
    el.innerHTML = '';
    for (let i = 0; i < barras; i++) {
      const b = document.createElement('i');
      b.style.height = (8 + Math.abs(Math.sin(i * 0.55)) * 24) + 'px';
      b.style.animationDelay = (i * 0.045) + 's';
      el.appendChild(b);
    }
  }
  desenharWave($('wave-abertura'), 30);

  /* ---------- Origem do lead: mesma cadeia de /contato e /themic ----------
     Cookie piar_atrib (gravado só após consentimento de marketing, ver
     ConsentimentoCookies.astro) → sessionStorage → query string desta própria
     visita. Cobre quem converte na hora, antes de decidir sobre cookies, e
     quem chega pela home com UTM e converte aqui depois. */
  (function capturaOrigem() {
    let atrib = {};
    const bruto = document.cookie.split('; ').find((c) => c.indexOf('piar_atrib=') === 0);
    if (bruto) {
      try { atrib = JSON.parse(decodeURIComponent(bruto.slice('piar_atrib='.length))); } catch (err) { atrib = {}; }
    }
    if (!Object.keys(atrib).length) {
      try {
        const sessao = sessionStorage.getItem('piar_atrib');
        if (sessao) atrib = JSON.parse(sessao);
      } catch (err) { atrib = {}; }
    }
    const qs = new URLSearchParams(location.search);
    const externo = document.referrer && document.referrer.indexOf(location.origin) !== 0;

    origem = {
      cf_utm_source: atrib.utm_source || qs.get('utm_source') || '',
      cf_utm_medium: atrib.utm_medium || qs.get('utm_medium') || '',
      cf_utm_campaign: atrib.utm_campaign || qs.get('utm_campaign') || '',
      cf_utm_content: atrib.utm_content || qs.get('utm_content') || '',
      cf_landing_page: atrib.landing_page || (location.pathname + location.search),
      cf_referrer: atrib.referrer || (externo ? document.referrer : ''),
      cf_pagina_conversao: location.pathname,
      cf_produto_interesse: PRODUTO
    };
  })();

  /* ---------- Máscara do WhatsApp, igual à de /themic ---------- */
  (function mascaraTelefone() {
    const tel = $('telefone');
    tel.addEventListener('input', () => {
      let v = tel.value.replace(/\D/g, '').slice(0, 11);
      if (v.length > 6) v = '(' + v.slice(0, 2) + ') ' + v.slice(2, v.length === 11 ? 7 : 6) + '-' + v.slice(v.length === 11 ? 7 : 6);
      else if (v.length > 2) v = '(' + v.slice(0, 2) + ') ' + v.slice(2);
      else if (v.length > 0) v = '(' + v;
      tel.value = v;
    });
  })();

  /* ---------- Tela 1: valida, grava o lead e avança ---------- */
  $('form-lead').addEventListener('submit', async (e) => {
    e.preventDefault();
    if ($('botcheck').value) return;

    const nome = $('nome').value.trim();
    const email = $('email').value.trim();
    const empresa = $('empresa').value.trim();
    const telBruto = $('telefone').value.replace(/\D/g, '');
    let ok = true;

    const marca = (campo, valido) => {
      $('erro-' + campo).classList.toggle('on', !valido);
      if (!valido) ok = false;
    };

    marca('nome', nome.length >= 2);
    marca('email', /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email));
    marca('empresa', empresa.length >= 2);
    marca('telefone', telBruto.length >= 10);
    marca('consent', $('consent').checked);

    if (!ok) {
      const primeiro = document.querySelector('.diag .erro.on');
      if (primeiro) primeiro.closest('.campo').scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    lead = { nome, email, empresa, telefone: $('telefone').value.trim() };

    /* O envio acontece aqui de propósito: quem abandonar as perguntas já
       entrou na base, com origem e a tag diagnostico-autoridade. Falha de
       rede não trava a navegação, porque o envio do fim reenvia tudo. */
    const botao = $('btn-comecar');
    botao.disabled = true;
    try {
      await enviarLead(lead, null);
    } catch (err) {
      console.error('[diagnóstico] o lead parcial não gravou', err);
    }
    botao.disabled = false;

    mostrarTela('tela-perguntas');
    renderPergunta();
  });

  /* ---------- Tela 2 ---------- */
  function renderPergunta() {
    const p = PERGUNTAS[atual];
    $('barra-preenche').style.width = (atual / PERGUNTAS.length * 100) + '%';
    $('contador').textContent = 'Pergunta ' + (atual + 1) + ' de ' + PERGUNTAS.length;
    $('rotulo-territorio').textContent = TERRITORIOS[p.t].nome;
    $('texto-pergunta').textContent = p.q;

    const box = $('opcoes');
    box.innerHTML = '';
    p.o.forEach((texto, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'opcao';
      const marca = document.createElement('span');
      marca.className = 'marca';
      const label = document.createElement('span');
      label.textContent = texto;
      b.appendChild(marca);
      b.appendChild(label);
      b.addEventListener('click', () => responder(i));
      box.appendChild(b);
    });

    $('btn-voltar').style.visibility = atual === 0 ? 'hidden' : 'visible';
  }

  function responder(i) {
    respostas[atual] = i;
    if (atual < PERGUNTAS.length - 1) {
      atual++;
      renderPergunta();
    } else {
      calcular();
    }
  }

  $('btn-voltar').addEventListener('click', () => {
    if (atual > 0) { atual--; renderPergunta(); }
  });

  /* ---------- Tela 3 ---------- */
  function calcular() {
    const porTerritorio = {};
    Object.keys(TERRITORIOS).forEach((k) => { porTerritorio[k] = 0; });

    let total = 0;
    const tagsExtras = [];
    PERGUNTAS.forEach((p, i) => {
      const r = respostas[i];
      const tabela = p.p || PONTOS;
      const pts = r === null ? 0 : tabela[r];
      total += pts;
      porTerritorio[p.t] += pts;
      if (p.tags && r !== null && p.tags[r]) tagsExtras.push(p.tags[r]);
    });

    const faixa = FAIXAS.find((f) => total >= f.min && total <= f.max) || FAIXAS[0];

    $('nota-final').textContent = total;
    $('nome-faixa').textContent = faixa.nome;
    $('resumo-faixa').textContent = faixa.resumo;

    desenharWave($('wave-resultado'), 34);

    // mapa: a forma do resultado num olhar
    const mapa = $('mapa-territorios');
    mapa.innerHTML = '';
    Object.keys(TERRITORIOS).forEach((k) => {
      const pontos = porTerritorio[k];
      const classe = pontos <= 7 ? 'baixo' : (pontos <= 14 ? 'medio' : 'alto');

      const linha = document.createElement('div');
      linha.className = 'mapa-linha';

      const rot = document.createElement('span');
      rot.className = 'rot';
      rot.textContent = TERRITORIOS[k].nome;

      const trilho = document.createElement('div');
      trilho.className = 'trilho';
      const preenche = document.createElement('i');
      preenche.className = classe;
      trilho.appendChild(preenche);

      const val = document.createElement('span');
      val.className = 'val';
      val.textContent = pontos + '/20';

      linha.appendChild(rot);
      linha.appendChild(trilho);
      linha.appendChild(val);
      mapa.appendChild(linha);

      requestAnimationFrame(() => { preenche.style.width = (pontos / 20 * 100) + '%'; });
    });

    const cards = $('cards-territorios');
    cards.innerHTML = '';
    Object.keys(TERRITORIOS).forEach((k) => {
      const pontos = porTerritorio[k];                    // 0 a 20
      const idx = pontos <= 7 ? 0 : (pontos <= 14 ? 1 : 2);
      const rotulo = ['baixo', 'médio', 'alto'][idx];
      const classe = ['baixo', 'medio', 'alto'][idx];
      const a = TERRITORIOS[k].analises[idx];

      const el = document.createElement('div');
      el.className = 'card';

      const topo = document.createElement('div');
      topo.className = 'card-topo';
      const nome = document.createElement('span');
      nome.className = 'nome mono';
      nome.textContent = TERRITORIOS[k].nome;
      const nivel = document.createElement('span');
      nivel.className = 'nivel ' + classe;
      nivel.textContent = rotulo + ' · ' + pontos + '/20';
      topo.appendChild(nome);
      topo.appendChild(nivel);

      const h = document.createElement('h4');
      h.textContent = a.titulo;
      const p = document.createElement('p');
      p.textContent = a.texto;

      const mov = document.createElement('div');
      mov.className = 'movimento';
      const rot = document.createElement('span');
      rot.className = 'rot mono';
      rot.textContent = 'Primeiro movimento';
      const movP = document.createElement('p');
      movP.textContent = a.movimento;
      mov.appendChild(rot);
      mov.appendChild(movP);

      el.appendChild(topo);
      el.appendChild(h);
      el.appendChild(p);
      el.appendChild(mov);
      cards.appendChild(el);
    });

    // oferta ligada ao resultado: nomeia os dois territórios mais frágeis
    const ordenados = Object.keys(TERRITORIOS)
      .map((k) => ({ k: k, pts: porTerritorio[k], nome: TERRITORIOS[k].nome }))
      .sort((a, b) => a.pts - b.pts);
    const fracos = ordenados.filter((t) => t.pts <= 14).slice(0, 2);

    const titulo = $('titulo-oferta');
    titulo.textContent = '';
    const destaque = (texto) => {
      const em = document.createElement('em');
      em.textContent = texto;
      return em;
    };

    if (fracos.length === 2) {
      $('rot-oferta').textContent = 'Onde você está mais exposto hoje';
      titulo.appendChild(destaque(fracos[0].nome));
      titulo.appendChild(document.createTextNode(' e '));
      titulo.appendChild(destaque(fracos[1].nome));
      titulo.appendChild(document.createTextNode(': é exatamente aqui que o THE MIC trabalha.'));
    } else if (fracos.length === 1) {
      $('rot-oferta').textContent = 'Onde você está mais exposto hoje';
      titulo.appendChild(destaque(fracos[0].nome));
      titulo.appendChild(document.createTextNode(': é exatamente aqui que o THE MIC trabalha.'));
    } else {
      $('rot-oferta').textContent = 'O próximo nível';
      titulo.appendChild(document.createTextNode('Você já está bem nos cinco territórios. O THE MIC é sobre '));
      titulo.appendChild(destaque('sustentar isso'));
      titulo.appendChild(document.createTextNode(' sob pressão.'));
    }

    $('ponte-oferta').textContent = fracos.length
      ? 'Os cinco movimentos acima são o que dá para fazer sozinho nesta semana. O que não se resolve sozinho é o resto: sustentar um tema quando ninguém está olhando, responder a pergunta difícil sem hesitar e ter método no lugar de improviso. São dois dias para isso.'
      : 'A diferença entre quem aparece e quem se mantém é o que acontece na pergunta difícil, na crise e no dia em que o assunto não é confortável. São dois dias treinando exatamente isso.';

    // cabeçalho que aparece só na versão impressa / PDF
    const data = new Date().toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
    const cab = $('cabecalho-pdf');
    cab.innerHTML =
      '<svg class="mic" width="15" height="23" viewBox="0 0 24 36" fill="none" aria-hidden="true">' +
        '<rect x="8" y="1" width="8" height="19" rx="4" fill="currentColor"/>' +
        '<path d="M4 15v2a8 8 0 0 0 16 0v-2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>' +
        '<path d="M12 25v9M7.5 34.5h9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>' +
      '</svg>' +
      '<span class="marca">THE MIC<span>PIAR GROUP</span></span>' +
      '<span class="quem"><b></b>Diagnóstico de Autoridade · ' + data + '</span>';
    // O nome e a empresa entram como texto, nunca como HTML: são digitados
    // pela própria pessoa e iriam parar no innerHTML acima.
    cab.querySelector('.quem b').textContent = (lead.nome || '') + (lead.empresa ? ' · ' + lead.empresa : '');

    enviarLead(lead, { nota: total, faixa: faixa.nome, territorios: porTerritorio, extras: tagsExtras })
      .catch((err) => console.error('[diagnóstico] o resultado não gravou', err));

    mostrarTela('tela-resultado');
  }

  $('btn-refazer').addEventListener('click', () => {
    atual = 0;
    respostas.fill(null);
    mostrarTela('tela-perguntas');
    renderPergunta();
  });

  $('btn-imprimir').addEventListener('click', () => window.print());

  // O href já sai montado do Astro; esta linha existe só para o caso de a
  // pessoa ter chegado com UTM própria, que não deve ser sobrescrita.
  $('cta-programa').setAttribute('href', CTA_PROGRAMA);

  /* =====================================================================
     ENVIO PARA O RD STATION
     Chamado duas vezes: na captura (resultado = null) e no fim, com a nota.
     ===================================================================== */
  /* 'Lembrado as vezes' vira 'lembrado-as-vezes', o nome de tag combinado no
     briefing. O corte de acento e feito por codigo de caractere, e nao por um
     regex com o intervalo de diacriticos escrito no arquivo: escrito, ele vira
     caractere literal em qualquer normalizacao e passa a depender de o editor
     nao mexer. Aqui a fonte e ASCII puro e nao tem como quebrar em silencio. */
  function comoTag(texto) {
    return texto
      .toLowerCase()
      .normalize('NFD')
      .split('')
      .filter((c) => { const n = c.charCodeAt(0); return n < 0x300 || n > 0x36f; })
      .join('')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');
  }

  function enviarLead(dados, resultado) {
    const tags = ['diagnostico-autoridade'];

    const payload = Object.assign({}, origem, {
      conversion_identifier: resultado ? RD_ID_COMPLETO : RD_ID_INICIO,
      name: dados.nome,
      email: dados.email,
      personal_phone: dados.telefone,
      company_name: dados.empresa,
      traffic_source: origem.cf_utm_source || 'direto',
      traffic_medium: origem.cf_utm_medium || '',
      traffic_campaign: origem.cf_utm_campaign || ''
    });

    if (resultado) {
      tags.push('diagnostico-' + comoTag(resultado.faixa));
      (resultado.extras || []).forEach((t) => tags.push(t));

      // Numero vai como TEXTO de proposito. O schema da API de conversoes do
      // RD tipa todo campo cf_ como string (developers.rdstation.com/reference
      // /conversao), e valor numerico cru e descartado em silencio: a resposta
      // vem 200, o contato entra, e a pontuacao nao. Foi o que derrubou os
      // testes de 23/09/2026. O campo no painel segue sendo do tipo Numero;
      // quem converte "73" de volta para numero e o proprio RD.
      const n = (v) => String(v);
      payload.cf_diagnostico_nota = n(resultado.nota);
      payload.cf_diagnostico_faixa = resultado.faixa;
      payload.cf_diagnostico_imprensa = n(resultado.territorios.imprensa);
      payload.cf_diagnostico_digital = n(resultado.territorios.digital);
      payload.cf_diagnostico_busca = n(resultado.territorios.busca);
      payload.cf_diagnostico_narrativa = n(resultado.territorios.narrativa);
      payload.cf_diagnostico_preparo = n(resultado.territorios.preparo);
    }

    payload.tags = tags;

    if (!RD_ATIVO) {
      console.log('[diagnóstico] RD_PUBLIC_KEY ausente, modo demonstração.', payload);
      return Promise.resolve(false);
    }

    return fetch('https://api.rd.services/platform/conversions?api_key=' + encodeURIComponent(RD_PUBLIC_KEY), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ event_type: 'CONVERSION', event_family: 'CDP', payload: payload })
    }).then((resp) => {
      if (resp.ok) return true;
      // O corpo da resposta entra no erro de propósito. Quando um campo cf_*
      // não existe na conta, ou o identificador de API saiu diferente do que
      // foi combinado, é aqui que o RD diz qual. Sem isso sobra só o número do
      // status e o problema vira adivinhação no painel.
      return resp.text().then((corpo) => {
        throw new Error('RD Station respondeu ' + resp.status + ': ' + corpo.slice(0, 500));
      });
    });
  }
})();
</script>
</BaseLayout>
