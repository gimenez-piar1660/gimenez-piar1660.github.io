  }
  .diag .consent label { font-size: 12.5px; font-weight: 400; color: var(--cinza); line-height: 1.55; margin-bottom: 0; }
  .diag .consent label a { color: var(--ouro); text-decoration: underline; text-underline-offset: 3px; }

  .diag .erro { color: var(--alerta); font-size: 13px; margin-top: 6px; display: none; }
  .diag .erro.on { display: block; }

  .diag .botcheck { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .diag .btn {
    display: flex;
