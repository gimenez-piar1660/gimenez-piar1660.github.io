  <Footer />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- Lenis + ScrollTrigger (globais via bootstrap.ts) ---- */
      try {
        if (window.gsap && window.ScrollTrigger) window.gsap.registerPlugin(window.ScrollTrigger);
        if (!prefersReduced && window.Lenis) {
          var lenis = new window.Lenis({ duration: 1.15, easing: function (t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); }, smooth: true, lerp: 0.1 });
          if (window.ScrollTrigger) { lenis.on('scroll', window.ScrollTrigger.update); window.gsap.ticker.add(function (time) { lenis.raf(time * 1000); }); window.gsap.ticker.lagSmoothing(0); }
          else { var raf = function (t) { lenis.raf(t); requestAnimationFrame(raf); }; requestAnimationFrame(raf); }
        }
      } catch (e) { /* noop */ }

      /* ---- reveal ---- */
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('active'); io.unobserve(en.target); } });
      }, { threshold: 0.14 });
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

      /* ---- scroll progress ---- */
      var bar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', function () {
        var h = document.documentElement;
        var p = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
        if (bar) bar.style.width = p + '%';
      }, { passive: true });

      /* ---- parallax de profundidade ---- */
      if (!prefersReduced && window.gsap && window.ScrollTrigger) {
        window.gsap.utils.toArray('[data-parallax-y]').forEach(function (el) {
          var yp = parseFloat(el.getAttribute('data-parallax-y')) || 0;
          window.gsap.fromTo(el, { yPercent: 0 }, { yPercent: yp, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } });
        });
      }

      /* ---- lerp mouse-parallax no herói (Três Mares) ---- */
      if (!prefersReduced && window.gsap) {
        var heroFloats = window.gsap.utils.toArray('[class*="hero-float"]');
        if (heroFloats.length) {
          var movers = heroFloats.map(function (el, i) {
            return {
              depth: (i % 2 ? 1 : -1) * (16 + i * 8),
              qx: window.gsap.quickTo(el, 'x', { duration: 0.7, ease: 'power3' }),
              qy: window.gsap.quickTo(el, 'y', { duration: 0.7, ease: 'power3' })
            };
          });
          window.addEventListener('mousemove', function (e) {
            var nx = (e.clientX / window.innerWidth - 0.5);
            var ny = (e.clientY / window.innerHeight - 0.5);
            for (var k = 0; k < movers.length; k++) { movers[k].qx(nx * movers[k].depth); movers[k].qy(ny * movers[k].depth); }
          }, { passive: true });
        }
      }

      /* helper: curva da atenção (sino assimétrico) normalizada em [0..1] -> altura [0..1] */
      function attentionCurve(x) {
        // pico deslocado para a esquerda do centro: subida rápida, queda lenta.
        var peak = 0.42;
        var w = x < peak ? 0.20 : 0.32;
        var d = (x - peak) / w;
        var base = Math.exp(-d * d);          // sino gaussiano assimétrico
        var tail = 0.10 * Math.max(0, x);     // chão residual de atenção
        return Math.min(1, base + tail * (1 - base));
      }

      /* ========================================================
         HERO · a onda do ciclo de notícia (canvas 2D)
         Curva de atenção que varre da esquerda p/ direita; faixa
         "janela" na subida; ponto-surfista pega a onda perto do pico.
         ======================================================== */
      (function heroWave() {
        var canvas = document.getElementById('nj-hero-canvas');
        if (!canvas) return;
        var ctx;
        try { ctx = canvas.getContext('2d'); } catch (e) { ctx = null; }
        if (!ctx) {
          canvas.style.background = 'radial-gradient(72% 92% at 72% 32%, #4a2e05 0%, #1a1206 55%, #0C0A07 100%)';
          return;
        }
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0;

        function resize() {
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          W = canvas.clientWidth; H = canvas.clientHeight;
          canvas.width = Math.max(1, Math.floor(W * dpr));
          canvas.height = Math.max(1, Math.floor(H * dpr));
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        resize();
        window.addEventListener('resize', resize, { passive: true });

        // mapeia x normalizado -> ponto de tela da onda (baseline a ~78% da altura)
        function pt(xn, amp, baseY) {
          return { x: xn * W, y: baseY - attentionCurve(xn) * amp };
        }

        function paint(phase) {
          ctx.clearRect(0, 0, W, H);
          var baseY = H * 0.80;
          var amp = H * 0.52;
          // janela = faixa na subida da curva (antes do pico)
          var winA = 0.26, winB = 0.42;

          // faixa luminosa "a janela"
          var gx = ctx.createLinearGradient(winA * W, 0, winB * W, 0);
          gx.addColorStop(0, 'rgba(254,209,54,0)');
          gx.addColorStop(0.5, 'rgba(255,176,32,0.16)');
          gx.addColorStop(1, 'rgba(254,209,54,0)');
          ctx.fillStyle = gx;
          ctx.fillRect(winA * W, 0, (winB - winA) * W, H);

          // curvas de eco (fantasmas defasadas, dão sensação de onda viva)
          var echoes = prefersReduced ? 0 : 3;
          for (var e = echoes; e >= 1; e--) {
            var ph = phase - e * 0.18;
            var off = Math.sin(ph) * (H * 0.012 * e);
            ctx.beginPath();
            for (var i = 0; i <= 120; i++) {
              var xn = i / 120;
              var wob = prefersReduced ? 0 : Math.sin(xn * 9 + phase * 1.2) * 3 * attentionCurve(xn);
              var p = pt(xn, amp, baseY);
              var yy = p.y + off + wob;
              if (i === 0) ctx.moveTo(p.x, yy); else ctx.lineTo(p.x, yy);
            }
            ctx.strokeStyle = 'rgba(255,176,32,' + (0.05 * e) + ')';
            ctx.lineWidth = 1;
            ctx.stroke();
          }

          // preenchimento sob a curva principal
          ctx.beginPath();
          ctx.moveTo(0, baseY);
          var pathPts = [];
          for (var j = 0; j <= 140; j++) {
            var xn2 = j / 140;
            var wob2 = prefersReduced ? 0 : Math.sin(xn2 * 9 + phase * 1.2) * 3 * attentionCurve(xn2);
            var pp = pt(xn2, amp, baseY);
            pathPts.push({ x: pp.x, y: pp.y + wob2, xn: xn2 });
            ctx.lineTo(pp.x, pp.y + wob2);
          }
          ctx.lineTo(W, baseY);
          ctx.closePath();
          var fg = ctx.createLinearGradient(0, baseY - amp, 0, baseY);
          fg.addColorStop(0, 'rgba(255,176,32,0.20)');
          fg.addColorStop(0.6, 'rgba(255,154,60,0.06)');
          fg.addColorStop(1, 'rgba(12,10,7,0)');
          ctx.fillStyle = fg;
          ctx.fill();

          // linha principal da curva (âmbar -> amarelo no pico)
          ctx.beginPath();
          for (var k = 0; k < pathPts.length; k++) {
            if (k === 0) ctx.moveTo(pathPts[k].x, pathPts[k].y);
            else ctx.lineTo(pathPts[k].x, pathPts[k].y);
          }
          var lg = ctx.createLinearGradient(0, 0, W, 0);
          lg.addColorStop(0.0, 'rgba(255,176,32,0.55)');
          lg.addColorStop(0.42, 'rgba(255,209,92,1)');
          lg.addColorStop(0.75, 'rgba(255,154,60,0.7)');
          lg.addColorStop(1.0, 'rgba(255,154,60,0.3)');
          ctx.strokeStyle = lg;
          ctx.lineWidth = 2.4;
          ctx.shadowColor = 'rgba(255,176,32,0.5)';
          ctx.shadowBlur = prefersReduced ? 0 : 16;
          ctx.stroke();
          ctx.shadowBlur = 0;

          // ponto-surfista percorre a curva
          var sx = prefersReduced ? winB : ((phase * 0.085) % 1.18) - 0.09;
          sx = Math.max(0, Math.min(1, sx));
          var sp = pt(sx, amp, baseY);
          var inWindow = sx >= winA && sx <= winB;
          // brilho quando pega a onda (dentro da janela, perto do pico)
          var glow = inWindow ? 1 : 0.32;
          ctx.beginPath();
          ctx.arc(sp.x, sp.y, inWindow ? 18 : 11, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(255,209,92,' + (0.12 * glow) + ')';
          ctx.fill();
          ctx.beginPath();
          ctx.arc(sp.x, sp.y, inWindow ? 6.5 : 4.5, 0, Math.PI * 2);
          ctx.fillStyle = inWindow ? '#FFE08A' : '#FFB020';
          ctx.shadowColor = 'rgba(255,209,92,0.9)';
          ctx.shadowBlur = inWindow ? 22 : 8;
          ctx.fill();
          ctx.shadowBlur = 0;

          // marcação discreta do pico
          var peak = pt(0.42, amp, baseY);
          ctx.beginPath();
          ctx.arc(peak.x, peak.y, 2.5, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(255,255,255,0.6)';
          ctx.fill();
        }

        var startT = 0, rafId = 0;
        function frame(now) {
          if (!startT) startT = now;
          var phase = (now - startT) / 1000 * 1.1;
          paint(phase);
          if (!prefersReduced) rafId = requestAnimationFrame(frame);
        }
        if (prefersReduced) { paint(0); }
        else { rafId = requestAnimationFrame(frame); }
      })();

      /* ========================================================
         DATAVIZ · a curva da atenção (canvas 2D interativo)
         3 zonas rotuladas: cedo demais / a janela / tarde demais.
         Hover/scrub mostra rótulo; "a janela" pulsa em amarelo.
         ======================================================== */
      (function attentionViz() {
        var canvas = document.getElementById('nj-curve-canvas');
        if (!canvas) return;
        var ctx;
        try { ctx = canvas.getContext('2d'); } catch (e) { ctx = null; }
        if (!ctx) {
          canvas.style.background = 'linear-gradient(160deg, #15110A 0%, #0C0A07 72%)';
          return;
        }
        var readK = document.getElementById('nj-readout-k');
        var readV = document.getElementById('nj-readout-v');
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0;
        var mouseX = -1, activeZone = 1; // default destaca "A janela"

        // limites das 3 zonas em x normalizado
        var zCedoEnd = 0.30, zJanelaEnd = 0.55;
        var zones = [
          { k: 'Cedo demais', v: 'Só especulação. Fatos isolados, poucos detalhes. Falar agora é chutar.' },
          { k: 'A janela', v: 'Jornalistas buscam ângulo. Sua marca entra com dado, fonte ou análise.' },
          { k: 'Tarde demais', v: 'Saturação. A atenção caiu e quem chega agora só repete o que já foi dito.' }
        ];

        function resize() {
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          var rect = canvas.getBoundingClientRect();
          W = rect.width; H = rect.height;
          canvas.width = Math.max(1, Math.floor(W * dpr));
          canvas.height = Math.max(1, Math.floor(H * dpr));
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        resize();
        window.addEventListener('resize', resize, { passive: true });

        function pt(xn, amp, baseY) {
          return { x: 0.06 * W + xn * (0.88 * W), y: baseY - attentionCurve(xn) * amp };
        }

        function zoneOf(xn) {
          if (xn < zCedoEnd) return 0;
          if (xn < zJanelaEnd) return 1;
          return 2;
        }

        function setReadout(z) {
          if (readK) readK.textContent = zones[z].k;
          if (readV) readV.textContent = zones[z].v;
        }
        setReadout(activeZone);

        function draw(now) {
          var baseY = H * 0.84;
          var amp = H * 0.62;
          ctx.clearRect(0, 0, W, H);

          // grade discreta + baseline
          ctx.strokeStyle = 'rgba(255,255,255,0.06)';
          ctx.lineWidth = 1;
          ctx.beginPath(); ctx.moveTo(0.06 * W, baseY); ctx.lineTo(0.94 * W, baseY); ctx.stroke();

          var pulse = prefersReduced ? 0.5 : (Math.sin(now / 520) + 1) / 2;

          // pinta as bandas das 3 zonas
          var bands = [
            { a: 0.0, b: zCedoEnd, idx: 0, col: 'rgba(107,100,87,0.10)', colHi: 'rgba(107,100,87,0.22)' },
            { a: zCedoEnd, b: zJanelaEnd, idx: 1, col: 'rgba(254,209,54,0.10)', colHi: 'rgba(254,209,54,0.22)' },
            { a: zJanelaEnd, b: 1.0, idx: 2, col: 'rgba(138,131,120,0.08)', colHi: 'rgba(138,131,120,0.18)' }
          ];
          bands.forEach(function (bd) {
            var x0 = pt(bd.a, amp, baseY).x, x1 = pt(bd.b, amp, baseY).x;
            var isActive = bd.idx === activeZone;
            var isJanela = bd.idx === 1;
            var fill = isActive ? bd.colHi : bd.col;
            if (isJanela) {
              // janela pulsa em amarelo independentemente de estar ativa
              var a = 0.10 + (isActive ? 0.10 : 0.06) * pulse;
              fill = 'rgba(254,209,54,' + a + ')';
            }
            ctx.fillStyle = fill;
            ctx.fillRect(x0, 0, x1 - x0, baseY);
            // divisórias
            ctx.strokeStyle = 'rgba(255,255,255,0.10)';
            ctx.setLineDash([3, 4]);
            ctx.beginPath(); ctx.moveTo(x1, baseY * 0.06); ctx.lineTo(x1, baseY); ctx.stroke();
            ctx.setLineDash([]);
          });

          // rótulos das zonas no topo
          ctx.font = '600 10px "JetBrains Mono", monospace';
          ctx.textBaseline = 'top';
          ctx.textAlign = 'center';
          var labels = [
            { x: zCedoEnd / 2, t: 'CEDO DEMAIS', idx: 0 },
            { x: (zCedoEnd + zJanelaEnd) / 2, t: 'A JANELA', idx: 1 },
            { x: (zJanelaEnd + 1) / 2, t: 'TARDE DEMAIS', idx: 2 }
          ];
          labels.forEach(function (lb) {
            var px = pt(lb.x, amp, baseY).x;
            if (lb.idx === 1) ctx.fillStyle = 'rgba(255,209,92,' + (0.7 + 0.3 * pulse) + ')';
            else ctx.fillStyle = lb.idx === activeZone ? 'rgba(255,255,255,0.8)' : 'rgba(255,255,255,0.4)';
            ctx.fillText(lb.t, px, 14);
          });

          // área sob a curva
          ctx.beginPath();
          ctx.moveTo(pt(0, amp, baseY).x, baseY);
          var pts = [];
          for (var i = 0; i <= 160; i++) {
            var xn = i / 160;
            var p = pt(xn, amp, baseY);
            pts.push({ x: p.x, y: p.y, xn: xn });
            ctx.lineTo(p.x, p.y);
          }
          ctx.lineTo(pt(1, amp, baseY).x, baseY);
          ctx.closePath();
          var fg = ctx.createLinearGradient(0, baseY - amp, 0, baseY);
          fg.addColorStop(0, 'rgba(255,176,32,0.18)');
          fg.addColorStop(1, 'rgba(12,10,7,0)');
          ctx.fillStyle = fg;
          ctx.fill();

          // linha da curva
          ctx.beginPath();
          for (var k = 0; k < pts.length; k++) {
            if (k === 0) ctx.moveTo(pts[k].x, pts[k].y);
            else ctx.lineTo(pts[k].x, pts[k].y);
          }
          ctx.strokeStyle = 'rgba(255,209,92,0.92)';
          ctx.lineWidth = 2.2;
          ctx.shadowColor = 'rgba(255,176,32,0.5)';
          ctx.shadowBlur = prefersReduced ? 0 : 10;
          ctx.stroke();
          ctx.shadowBlur = 0;

          // marcador interativo (segue mouse; senão repousa no centro da janela)
          var markXn;
          if (mouseX >= 0) {
            markXn = (mouseX - 0.06 * W) / (0.88 * W);
            markXn = Math.max(0, Math.min(1, markXn));
          } else {
            markXn = (zCedoEnd + zJanelaEnd) / 2;
          }
          var mp = pt(markXn, amp, baseY);
          var inJanela = zoneOf(markXn) === 1;
          // guia vertical
          ctx.strokeStyle = inJanela ? 'rgba(255,209,92,0.5)' : 'rgba(255,255,255,0.25)';
          ctx.lineWidth = 1;
          ctx.beginPath(); ctx.moveTo(mp.x, mp.y); ctx.lineTo(mp.x, baseY); ctx.stroke();
          // ponto no marcador
          ctx.beginPath();
          ctx.arc(mp.x, mp.y, inJanela ? 7 : 5, 0, Math.PI * 2);
          ctx.fillStyle = inJanela ? '#FFE08A' : '#FFB020';
          ctx.shadowColor = 'rgba(255,209,92,0.9)';
          ctx.shadowBlur = inJanela ? 16 : 4;
          ctx.fill();
          ctx.shadowBlur = 0;

          if (!prefersReduced) requestAnimationFrame(draw);
        }

        canvas.addEventListener('mousemove', function (e) {
          var rect = canvas.getBoundingClientRect();
          mouseX = e.clientX - rect.left;
          var xn = (mouseX - 0.06 * W) / (0.88 * W);
          xn = Math.max(0, Math.min(1, xn));
          var z = zoneOf(xn);
          if (z !== activeZone) { activeZone = z; setReadout(z); }
        });
        canvas.addEventListener('mouseleave', function () {
          mouseX = -1; activeZone = 1; setReadout(1);
        });
        // touch scrub
        canvas.addEventListener('touchmove', function (e) {
          if (!e.touches || !e.touches[0]) return;
          var rect = canvas.getBoundingClientRect();
          mouseX = e.touches[0].clientX - rect.left;
          var xn = (mouseX - 0.06 * W) / (0.88 * W);
          xn = Math.max(0, Math.min(1, xn));
          var z = zoneOf(xn);
          if (z !== activeZone) { activeZone = z; setReadout(z); }
        }, { passive: true });

        if (prefersReduced) { draw(0); }
        else { requestAnimationFrame(draw); }
      })();
    });
  </script>
</BaseLayout>
