---
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { site } from '@/data/site';

// Hub editorial: cada conteúdo de src/content/pages vira uma caixinha que
// leva à página /<slug> (template [slug].astro). Sem conteúdo fabricado.
const ORDER = ['Relações Públicas', 'Reputação', 'Relações com Mídia', 'Data PR', 'GEO', 'Branding', 'Conteúdo', 'Influência', 'RevOps', 'Go-to-Market'];
const rank = (c?: string) => {
  const i = ORDER.indexOf(c ?? '');
  return i === -1 ? ORDER.length : i;
};
const pages = (await getCollection('pages', (e: CollectionEntry<'pages'>) => !e.data.draft)).sort(
  (a: CollectionEntry<'pages'>, b: CollectionEntry<'pages'>) =>
    rank(a.data.category) - rank(b.data.category) || a.data.title.localeCompare(b.data.title, 'pt-BR'),
);
const variants = ['', 'paper', 'yellow'];
---
<BaseLayout
  title="Insights PiaR — Data PR, GEO, Newsjacking, Reputação e Branding"
  description="Insights PiaR: guias autorais em pt-BR sobre relações públicas, Data PR, GEO, reputação, branding, newsjacking e mídia espontânea. Conteúdo da PiaR Group, agência de comunicação para inovação desde 2013."
>
  <Fragment slot="head">
    <style is:global>
      :root {
        --accent: #FED136;
        --accent-deep: #E0B420;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body { font-family: var(--font-sans); background: var(--paper); color: var(--primary); overflow-x: hidden; -webkit-font-smoothing: antialiased; font-feature-settings: "ss01", "cv11"; }
      ::selection { background: var(--primary); color: var(--accent); }
      html.lenis { height: auto; }
      .lenis.lenis-smooth { scroll-behavior: auto; }

      .ds-body-lg { font-size: 1.25rem; font-weight: 400; line-height: 1.5; letter-spacing: -.01em; }
      .ds-body { font-size: 1.0625rem; font-weight: 400; line-height: 1.5; letter-spacing: -.01em; }
      .ds-mono { font-family: var(--font-mono); font-size: .72rem; letter-spacing: -.01em; text-transform: uppercase; }
      .italic-serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -.02em; }

      .reveal { opacity: 0; transform: translateY(2rem); transition: var(--t-smooth); }
      .reveal.active { opacity: 1; transform: none; }
      .delay-100 { transition-delay: .08s; } .delay-200 { transition-delay: .16s; }

      #scroll-progress { position: fixed; top: 0; left: 0; height: 2px; background: var(--accent); z-index: 9999; width: 0; transition: width .1s linear; }

      .eyebrow-dot { display: inline-flex; align-items: center; gap: .55rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; color: var(--text-muted); font-weight: 600; }
      .eyebrow-dot::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex-shrink: 0; box-shadow: 0 0 0 4px rgba(254,209,54,.18); }

      .ink-pill { display: inline-flex; align-items: center; gap: .55rem; padding: .85rem 1.6rem; border-radius: var(--radius-btn); background: var(--accent); color: var(--primary); border: 1.5px solid var(--accent); font-size: .94rem; font-weight: 600; transition: var(--t-smooth); text-decoration: none; }
      .ink-pill:hover { background: #FFD84A; transform: translateY(-2px); box-shadow: 0 14px 28px rgba(254,209,54,.32); }
      .outline-pill { display: inline-flex; align-items: center; gap: .55rem; padding: .8rem 1.5rem; border-radius: var(--radius-btn); background: #fff; color: var(--primary); border: 1.5px solid var(--primary); font-size: .94rem; font-weight: 500; transition: var(--t-smooth); text-decoration: none; }
      .outline-pill:hover { background: var(--primary); color: var(--paper); }

      /* card editorial — a caixinha que leva ao conteúdo */
      .editorial-card { position: relative; background: #fff; border-radius: 24px; overflow: hidden; border: 1px solid var(--hairline); display: flex; flex-direction: column; transition: var(--t-smooth); text-decoration: none; color: var(--primary); }
      .editorial-card:hover { transform: translateY(-6px); box-shadow: 0 30px 60px rgba(0,0,0,.08); border-color: rgba(0,0,0,.12); }
      .editorial-card .cover { aspect-ratio: 16 / 7; position: relative; overflow: hidden; background: linear-gradient(135deg, #1A1A1D 0%, #0F0F11 100%); display: flex; align-items: center; justify-content: center; }
      .editorial-card .cover::after { content: ''; position: absolute; inset: 0; background: radial-gradient(80% 60% at 70% 30%, rgba(254,209,54,.22) 0%, transparent 65%); }
      .editorial-card .cover iconify-icon { font-size: 3rem; color: rgba(254,209,54,.65); position: relative; z-index: 1; }
      .editorial-card.paper .cover { background: var(--paper-lifted); border-bottom: 1px solid var(--hairline); }
      .editorial-card.paper .cover iconify-icon { color: rgba(15,15,17,.22); }
      .editorial-card.yellow .cover { background: var(--accent); }
      .editorial-card.yellow .cover iconify-icon { color: rgba(15,15,17,.4); }
      .editorial-card .body { padding: 1.6rem; display: flex; flex-direction: column; gap: .7rem; flex: 1; }
      .editorial-card .body .pub-meta { display: flex; align-items: center; gap: .6rem; font-family: var(--font-mono); font-size: .66rem; letter-spacing: .18em; text-transform: uppercase; color: var(--accent-deep); font-weight: 600; }
      .editorial-card .body h3 { font-size: 1.2rem; font-weight: 600; letter-spacing: -.02em; line-height: 1.22; margin: 0; }
      .editorial-card .body p { font-size: .9rem; color: var(--text-muted); line-height: 1.5; flex: 1; margin: 0; }
      .editorial-card .body .read-cue { display: inline-flex; align-items: center; gap: .35rem; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .18em; text-transform: uppercase; color: var(--primary); font-weight: 600; margin-top: auto; }
      .editorial-card:hover .read-cue iconify-icon { transform: translateX(4px); }
      .editorial-card .read-cue iconify-icon { transition: transform .4s var(--ease-out-expo); }

      /* boletim */
      .ghost-watermark { position: absolute; font-family: var(--font-sans); font-weight: 700; font-size: clamp(6rem, 18vw, 16rem); line-height: .85; letter-spacing: -.05em; color: rgba(15,15,17,.04); pointer-events: none; user-select: none; white-space: nowrap; z-index: 0; }
      .boletim-shell { position: relative; padding: clamp(3rem, 7vw, 6rem) clamp(2rem, 6vw, 5rem); border-radius: var(--radius-stadium); background: var(--paper-lifted); border: 1px solid var(--hairline); overflow: hidden; }
      .boletim-shell .ghost-watermark { top: -2rem; left: -2rem; }
      .boletim-form { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: .75rem; max-width: 36rem; margin-top: 2rem; }
      .boletim-form input { flex: 1 1 240px; padding: .95rem 1.25rem; border-radius: var(--radius-pill); border: 1.5px solid var(--primary); background: #fff; font-size: 1rem; font-family: inherit; color: var(--primary); transition: var(--t-smooth); }
      .boletim-form input:focus { outline: 2px solid var(--accent); outline-offset: 2px; }
      .boletim-form button { padding: .95rem 1.75rem; border-radius: var(--radius-pill); background: var(--primary); color: var(--paper); border: 1.5px solid var(--primary); font-size: 1rem; font-weight: 500; cursor: pointer; transition: var(--t-smooth); display: inline-flex; align-items: center; gap: .5rem; }
      .boletim-form button:hover { background: var(--accent); color: var(--primary); border-color: var(--accent); transform: translateY(-2px); }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
        .reveal { opacity: 1 !important; transform: none !important; }
      }
    </style>

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: 'Insights PiaR',
        url: `${site.domain}/insights`,
        inLanguage: 'pt-BR',
        isPartOf: { '@id': `${site.domain}/#organization` },
        about: { '@id': `${site.domain}/#organization` },
        mainEntity: {
          '@type': 'ItemList',
          name: 'Conteúdos PiaR',
          numberOfItems: pages.length,
          itemListElement: pages.map((p: CollectionEntry<'pages'>, i: number) => ({
            '@type': 'ListItem',
            position: i + 1,
            url: `${site.domain}/${p.id}`,
            name: p.data.title,
          })),
        },
      })}
    />
  </Fragment>

  <div id="scroll-progress"></div>

  <Nav current="insights" />

  <main id="main">

    <!-- HERO -->
    <section class="relative pt-32 md:pt-40 pb-10 md:pb-14 px-4 md:px-8">
      <div class="max-w-[1400px] mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 reveal">
          <div>
            <span class="eyebrow-dot">Insights · sala de redação</span>
            <h1 class="ds-h1 font-semibold tracking-tight mt-5" style="max-width:16ch">
              Os conteúdos da PiaR, <span class="italic-serif">em público</span>.
            </h1>
          </div>
          <p class="ds-body text-stone-500 max-w-md">
            Guias autorais sobre relações públicas, reputação, Data PR, GEO, branding e mídia
            espontânea. Cada caixinha leva a uma página completa, da PiaR Group desde 2013.
          </p>
        </div>
      </div>
    </section>

    <!-- GRID DE CONTEÚDOS · as caixinhas reais -->
    <section class="relative bg-[var(--paper)] pb-20 md:pb-28 px-4 md:px-8">
      <div class="max-w-[1400px] mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {pages.map((p: CollectionEntry<'pages'>, i: number) => (
            <a href={`/${p.id}`} class:list={['editorial-card', 'reveal', variants[i % 3]]}>
              <div class="cover"><iconify-icon icon={p.data.icon ?? 'solar:document-text-line-duotone'}></iconify-icon></div>
              <div class="body">
                <div class="pub-meta"><span>{p.data.category ?? 'Insight'}</span></div>
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
                <span class="read-cue">Ler<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- BOLETIM -->
    <section class="relative bg-white border-t border-[var(--hairline)] sec-pad">
      <div class="max-w-[1400px] mx-auto px-4 md:px-8">
        <div class="boletim-shell reveal">
          <span class="ghost-watermark">BOLETIM</span>
          <div class="relative z-10 max-w-3xl">
            <span class="eyebrow-dot">Boletim PiaR · quinzenal</span>
            <h2 class="ds-h2 font-semibold tracking-tight mt-4" style="max-width:18ch">
              A análise da quinzena, <span class="italic-serif">antes</span> de virar conversa.
            </h2>
            <p class="ds-body-lg text-stone-600 mt-6 max-w-2xl">
              Uma edição enxuta a cada quinze dias: a análise do período e o ângulo editorial que
              vem por aí. Sem newsletter genérica, entra só quem leria de qualquer jeito.
            </p>
            <form class="boletim-form" onsubmit="event.preventDefault(); alert('Em breve, integração com a infraestrutura de envio.');">
              <input type="email" placeholder="seu@email.com" aria-label="Seu e-mail" required />
              <button type="submit">Assinar<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></button>
            </form>
            <p class="ds-mono text-stone-400 mt-4">/// Sem spam · 1 edição a cada 15 dias · cancele em 1 clique</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="relative bg-[var(--paper)] border-t border-[var(--hairline)]">
      <div class="max-w-[1100px] mx-auto px-6 md:px-8 sec-pad text-center">
        <span class="eyebrow-dot reveal" style="display:inline-flex">Próximo passo</span>
        <h2 class="ds-h1 font-semibold tracking-tight mt-6 mb-6 reveal delay-100" style="max-width:22ch;margin-inline:auto;font-size:clamp(2.5rem,6vw,5rem)">
          Quer aplicar isso na sua <span class="italic-serif">marca</span>?
        </h2>
        <p class="ds-body-lg text-stone-500 max-w-2xl mx-auto mb-10 reveal delay-200">
          Sessão de 45 minutos para mapear onde sua marca está vazando narrativa e qual frente
          destrava a virada. Sem custo, sem pitch genérico.
        </p>
        <div class="flex gap-4 justify-center flex-wrap reveal delay-200">
          <a href="/contato" class="ink-pill">Agendar diagnóstico<iconify-icon icon="solar:calendar-mark-bold"></iconify-icon></a>
          <a href="/sobre" class="outline-pill">Conhecer a PiaR<iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
        </div>
      </div>
    </section>

  </main>

  <Footer />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      gsap.registerPlugin(ScrollTrigger);
      if (!prefersReduced) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smooth: true,
          lerp: 0.1,
        });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);
      }
      const progressBar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', () => {
        const h = document.documentElement;
        const p = (h.scrollTop) / (h.scrollHeight - h.clientHeight) * 100;
        if (progressBar) progressBar.style.width = p + '%';
      }, { passive: true });

      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('active'); io.unobserve(e.target); }
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    });
  </script>
</BaseLayout>
