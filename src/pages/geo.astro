---
// ============================================================================
// Exemplar narrativo · GEO PR
// Conteúdo voice-backed portado de:
//   src/content/pages/geo.md (fonte; renomeado de geo-generative-engine-optimization.md)
//   src/content/pages/o-que-e-geo-pr.md
// Originais preservados. Esta página é a versão "narrativa espetacular":
// herói WebGL (campo generativo) + dataviz de rede de citação (canvas) +
// scroll storytelling (GSAP/Lenis), sobre o DS da PiaR enriquecido com a
// estrutura Mastercard (eyebrow-dot, raios stadium/pill, inversão dark,
// gradiente-assinatura por categoria).
// ============================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import { site } from '@/data/site';

const url = `${site.domain}/geo`;

// As três camadas: SEO / GEO / GEO PR.
const camadas = [
  {
    id: 'SEO',
    nome: 'Search Engine Optimization',
    otimiza: 'A sua própria página, para ranquear no buscador.',
    metrica: 'Posição e clique',
    sinal: 'O seu domínio',
    icon: 'solar:magnifer-line-duotone',
  },
  {
    id: 'GEO',
    nome: 'Generative Engine Optimization',
    otimiza: 'O seu conteúdo, para ser citável dentro da resposta de IA.',
    metrica: 'A citação',
    sinal: 'O seu domínio',
    icon: 'solar:chat-square-code-line-duotone',
  },
  {
    id: 'GEO PR',
    nome: 'GEO operado por relações públicas',
    otimiza: 'O que terceiros de autoridade dizem sobre você.',
    metrica: 'A citação',
    sinal: 'Imprensa e especialistas',
    icon: 'solar:cpu-bolt-line-duotone',
    featured: true,
  },
];

// As quatro etapas do método aplicadas a GEO.
const etapas = [
  {
    num: '01',
    titulo: 'Diagnóstico de visibilidade em IA',
    prazo: 'Semanas 1 e 2',
    desc: 'Mapeamos as perguntas que decidem a compra no seu mercado, perguntamos a elas nos mecanismos generativos e medimos onde a sua marca aparece, onde não aparece e quem a IA cita no seu lugar.',
  },
  {
    num: '02',
    titulo: 'Messaging Framework',
    prazo: 'Semanas 3 e 4',
    desc: 'Definimos como a marca quer ser descrita e quais fatos, dados e porta-vozes sustentam essa descrição, para que a citação venha certa quando vier.',
  },
  {
    num: '03',
    titulo: 'Ativação editorial',
    prazo: 'Semanas 5 a 12',
    desc: 'Conquistamos a cobertura, a menção e o conteúdo próprio que alimentam as fontes que os modelos consomem. Com pauta e relacionamento, não disparo em massa.',
  },
  {
    num: '04',
    titulo: 'Monitoramento e escala',
    prazo: 'Ciclos quinzenais',
    desc: 'Acompanhamos a evolução das citações em IA junto com a cobertura de imprensa, e ajustamos a rota. Medição contínua, não foto única.',
  },
];

// As cinco frentes de GEO na PiaR.
const frentes = [
  {
    nome: 'Cobertura citável',
    desc: 'Pauta e relacionamento com a imprensa para que a marca apareça nos veículos e nas reportagens que os modelos consultam ao responder sobre o seu setor.',
    icon: 'solar:document-text-line-duotone',
  },
  {
    nome: 'Presença nos caminhos de citação',
    desc: 'Trabalho editorial para colocar a marca nos rankings, listas e portais setoriais que aparecem como fonte nas respostas de IA. Do jeito que se conquista menção, não comprando link.',
    icon: 'solar:routing-2-line-duotone',
  },
  {
    nome: 'Conteúdo próprio que vira fonte',
    desc: 'Material de autoridade no seu domínio, escrito para responder com precisão as perguntas que decidem a compra, com dados e porta-vozes nomeados.',
    icon: 'solar:pen-new-square-line-duotone',
  },
  {
    nome: 'Representação correta da marca',
    desc: 'Monitoramento de como ChatGPT, Gemini e os AI Overviews descrevem a sua empresa e os seus porta-vozes, e plano de resposta quando a representação está errada ou desatualizada.',
    icon: 'solar:shield-check-line-duotone',
  },
  {
    nome: 'Sinais técnicos para agentes',
    desc: 'Dados estruturados, metadados editoriais e regras claras para os bots de IA, para que o modelo entenda e cite a sua página sem ambiguidade. A engenharia vem por último, depois da autoridade.',
    icon: 'solar:code-square-line-duotone',
  },
];

const exits = site.exits;
const clientes = ['Sambatech', 'Liga Ventures', 'Printi', 'Doctoralia', 'Solides', 'Corning', 'PagBrasil', 'Sidia', 'FluencyPass', 'Unlimitail'];

const faq = [
  {
    q: 'GEO substitui o SEO?',
    a: 'Não. São disciplinas que convivem. O SEO continua decidindo a sua posição na busca clássica, onde grande parte do tráfego ainda acontece. O GEO decide se a sua marca aparece quando a resposta vem pronta de um modelo. A PiaR trata os dois como camadas da mesma reputação.',
  },
  {
    q: 'Quanto tempo até a minha marca ser citada por uma IA?',
    a: 'Depende de onde a marca parte e de quanto a concorrência já ocupa as fontes que o modelo consulta. Citação em IA é consequência de autoridade construída, não de um ajuste pontual no site. Por isso o diagnóstico vem primeiro, sem promessa de prazo que não se sustenta.',
  },
  {
    q: 'Vocês garantem que o ChatGPT vai citar a minha marca?',
    a: 'Não, e desconfie de quem garante. Nem a PiaR nem ninguém controla a saída de um modelo de linguagem. O que está sob controle é o trabalho que aumenta a probabilidade de citação: cobertura qualificada, presença nas fontes certas e sinais técnicos corretos. É isso que entregamos e medimos.',
  },
  {
    q: 'Qual a diferença entre a PiaR e uma agência de SEO que oferece GEO?',
    a: 'Uma agência de SEO trata GEO como otimização técnica de página. A PiaR trata como reputação: a IA cita quem a imprensa de autoridade já cita, e conquistar essa cobertura é trabalho de relações com a mídia. Fazemos a parte técnica também, mas ela vem por último, depois da autoridade.',
  },
  {
    q: 'Como vocês medem o resultado de GEO?',
    a: 'Medimos a presença da marca nas respostas dos mecanismos generativos para as perguntas que importam no seu mercado, acompanhada da cobertura de imprensa que alimenta essa presença. O monitoramento é contínuo, em ciclos quinzenais, e separa o que é resultado observado do que é estimativa.',
  },
  {
    q: 'Qual a diferença entre GEO e GEO PR?',
    a: 'GEO é a disciplina ampla de tornar a marca citável pela IA, com foco também no conteúdo do próprio domínio. GEO PR é o recorte operado por relações públicas, que constrói o sinal externo: a menção em mídia de autoridade. As duas se somam.',
  },
];
---
<BaseLayout
  title="O que é GEO: como a IA cita a sua marca"
  description="GEO (Generative Engine Optimization) é o trabalho de fazer a sua marca ser citada nas respostas de ChatGPT, Gemini, Perplexity e AI Overviews, não só listada na busca. Guia do que é, como difere de SEO e como se mede. Desde 2013."
  canonical={url}
>
  <Fragment slot="head">
    <style is:global>
      :root {
        --primary: #0F0F11;
        --accent: #FED136;
        --accent-deep: #E0B420;
        --paper: #FAFAFA;
        --paper-warm: #F4F1EA;       /* nó Mastercard: putty quente */
        --paper-lifted: #FCFBFA;
        --geo-ink: #0A0A0C;
        --geo-ink-2: #141417;
        --geo-amber: #FFB020;
        --geo-orange: #FF7A1A;
        --geo-rust: #C7410B;
        --text-muted: rgba(15, 15, 17, .62);
        --text-faint: rgba(15, 15, 17, .42);
        --hairline: rgba(0, 0, 0, .08);
        --hairline-strong: rgba(0, 0, 0, .14);
        --hairline-d: rgba(255, 255, 255, .12);
        --radius-btn: 20px;
        --radius-card: 24px;
        --radius-stadium: 40px;
        --radius-pill: 999px;
        --ease-out-expo: cubic-bezier(.16, 1, .3, 1);
        --t-smooth: all .6s var(--ease-out-expo);
        --font-display: 'Montserrat', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --font-sans: 'Open Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --font-serif: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 700; }
      body { font-family: var(--font-sans); background: var(--paper); color: var(--primary); overflow-x: hidden; -webkit-font-smoothing: antialiased; font-feature-settings: "ss01", "cv11"; }

      #scroll-progress { position: fixed; top: 0; left: 0; height: 2px; background: var(--accent); z-index: 9999; width: 0; transition: width .1s linear; }

      .wrap { max-width: 1280px; margin: 0 auto; padding-inline: 1.5rem; position: relative; z-index: 1; }
      @media (min-width: 768px) { .wrap { padding-inline: 2rem; } }

      .eyebrow { display: inline-flex; align-items: center; gap: .6rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; color: var(--text-muted); font-weight: 600; }
      .eyebrow::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex-shrink: 0; box-shadow: 0 0 0 4px rgba(254,209,54,.18); }
      .eyebrow.on-dark { color: rgba(255,255,255,.72); }

      .accent-serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--yellow-ink); letter-spacing: -.02em; }
      .accent-serif.on-dark { color: var(--accent); }

      /* botões */
      .btn { display: inline-flex; align-items: center; gap: .55rem; padding: .9rem 1.7rem; border-radius: var(--radius-btn); font-size: .95rem; font-weight: 600; letter-spacing: -.01em; text-decoration: none; transition: var(--t-smooth); cursor: pointer; border: 1.5px solid transparent; }
      .btn iconify-icon { transition: transform .4s var(--ease-out-expo); }
      .btn:hover iconify-icon { transform: translateX(4px); }
      .btn-accent { background: var(--accent); color: var(--primary); border-color: var(--accent); }
      .btn-accent:hover { background: #FFD84A; transform: translateY(-2px); box-shadow: 0 16px 32px rgba(254,209,54,.32); }
      .btn-ghost-d { background: transparent; color: #fff; border-color: rgba(255,255,255,.25); }
      .btn-ghost-d:hover { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.5); }
      .btn-ghost { background: transparent; color: var(--primary); border-color: rgba(0,0,0,.16); }
      .btn-ghost:hover { background: rgba(0,0,0,.04); border-color: rgba(0,0,0,.32); }

      /* ===========================================================
         1 · HERO · WebGL generative field
         =========================================================== */
      .geo-hero { position: relative; min-height: 100vh; min-height: 100svh; background: var(--geo-ink); color: #fff; overflow: hidden; display: flex; align-items: center; isolation: isolate; }
      #geo-hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; display: block; }
      .geo-hero .scrim { position: absolute; inset: 0; z-index: 1; pointer-events: none;
        background:
          radial-gradient(120% 90% at 18% 35%, rgba(10,10,12,.82) 0%, rgba(10,10,12,.35) 45%, rgba(10,10,12,0) 70%),
          linear-gradient(180deg, rgba(10,10,12,.5) 0%, rgba(10,10,12,0) 30%, rgba(10,10,12,.2) 75%, rgba(10,10,12,.9) 100%);
      }
      .geo-hero .hero-inner { position: relative; z-index: 2; width: 100%; padding-block: 9rem 4rem; }
      .geo-hero-chip { display: inline-flex; align-items: center; gap: .5rem; padding: .5rem 1rem; border-radius: var(--radius-pill); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(6px); font-family: var(--font-mono); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.78); }
      .geo-hero-chip .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px 1px rgba(254,209,54,.7); }
      .geo-hero h1 { font-size: clamp(2.9rem, 8.5vw, 8rem); font-weight: 700; line-height: .92; letter-spacing: -.045em; margin: 1.6rem 0 0; max-width: 17ch; text-wrap: balance; }
      .geo-hero .sub { font-size: clamp(1.1rem, 1.7vw, 1.4rem); line-height: 1.5; color: rgba(255,255,255,.74); margin-top: 1.75rem; max-width: 46ch; }
      .geo-hero .cta-row { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2.5rem; }
      .geo-scroll-cue { position: absolute; left: 50%; bottom: 1.75rem; transform: translateX(-50%); z-index: 2; display: inline-flex; flex-direction: column; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .6rem; letter-spacing: .2em; text-transform: uppercase; color: rgba(255,255,255,.5); }
      .geo-scroll-cue .line { width: 1px; height: 38px; background: linear-gradient(180deg, rgba(255,255,255,.5), transparent); animation: cuePulse 2.2s var(--ease-out-expo) infinite; }
      @keyframes cuePulse { 0%,100% { opacity: .3; transform: scaleY(.7); transform-origin: top; } 50% { opacity: 1; transform: scaleY(1); } }

      /* parallax de profundidade (nó Mastercard: depth / órbita / trajetória) */
      .px { will-change: transform; }
      .has-ghost { overflow: hidden; }
      .ghost-mark { position: absolute; z-index: 0; font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: clamp(7rem, 24vw, 24rem); line-height: .78; letter-spacing: -.04em; color: rgba(15,15,17,.045); pointer-events: none; user-select: none; white-space: nowrap; }
      .section.dark .ghost-mark { color: rgba(255,255,255,.04); }
      .ghost-mark.tr { top: -2rem; right: -1.5rem; }
      .ghost-mark.bl { bottom: -3rem; left: -2rem; }
      .geo-hero-float { position: absolute; z-index: 2; display: inline-flex; align-items: center; gap: .5rem; padding: .55rem 1rem; border-radius: var(--radius-pill); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(6px); font-family: var(--font-mono); font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.72); }
      .geo-hero-float .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--geo-orange); box-shadow: 0 0 8px 1px rgba(255,122,26,.7); }
      .geo-hero-float.f1 { right: 9%; top: 27%; }
      .geo-hero-float.f2 { right: 17%; bottom: 21%; }
      @media (max-width: 900px) { .geo-hero-float { display: none; } .ghost-mark { font-size: clamp(6rem, 30vw, 12rem); } }

      /* Três Mares · contorno topográfico (terreno de autoridade) como camada de profundidade */
      .has-contour { overflow: hidden; }
      .contour-field {
        position: absolute; inset: -14% -10%; z-index: 0; pointer-events: none;
        --contour-line: rgba(255,122,26,.11);
        background: repeating-radial-gradient(circle at 76% 40%, transparent 0 47px, var(--contour-line) 47px 48px);
        -webkit-mask-image: radial-gradient(circle at 76% 40%, #000 0%, rgba(0,0,0,.55) 42%, transparent 78%);
                mask-image: radial-gradient(circle at 76% 40%, #000 0%, rgba(0,0,0,.55) 42%, transparent 78%);
        will-change: transform;
      }
      @media (max-width: 760px) { .contour-field { opacity: .6; } }

      /* ===========================================================
         seções base
         =========================================================== */
      .section { padding-block: var(--sec-pad); position: relative; }
      .section.paper { background: var(--paper); border-top: 1px solid var(--hairline); }
      .section.warm { background: var(--paper-warm); border-top: 1px solid var(--hairline); }
      .section.dark { background: var(--geo-ink); color: #fff; border-top: 1px solid rgba(255,255,255,.06); }
      .section h2 { font-size: clamp(2.1rem, 4.6vw, 4rem); font-weight: 600; line-height: 1.03; letter-spacing: -.035em; margin: 1rem 0 0; max-width: 20ch; text-wrap: balance; }
      .section.dark h2 { color: #fff; }
      .lede { font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.55; color: var(--text-muted); margin-top: 1.5rem; max-width: 56ch; }
      .section.dark .lede { color: rgba(255,255,255,.72); }
      .sec-head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }

      /* compare 2 colunas (a virada) */
      .compare { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
      @media (min-width: 900px) { .compare { grid-template-columns: 1fr 1fr; gap: 1.5rem; } }
      .compare-card { padding: clamp(2rem, 3vw, 2.75rem); border-radius: var(--radius-card); border: 1px solid var(--hairline); background: #fff; min-height: 280px; display: flex; flex-direction: column; }
      .compare-card .ctag { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--text-faint); }
      .compare-card h3 { font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 600; letter-spacing: -.025em; margin: .9rem 0 0; line-height: 1.1; }
      .compare-card p { font-size: 1.0625rem; line-height: 1.6; color: var(--text-muted); margin-top: 1rem; }
      .compare-card .steps { margin-top: auto; padding-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; color: var(--text-faint); }
      .compare-card .steps iconify-icon { color: var(--accent-deep); }
      .compare-card.is-dark { background: var(--geo-ink-2); border-color: rgba(255,255,255,.12); color: #fff; }
      .compare-card.is-dark .ctag { color: rgba(255,255,255,.45); }
      .compare-card.is-dark p { color: rgba(255,255,255,.72); }
      .compare-card.is-dark .steps { color: rgba(255,255,255,.5); }
      .compare-card.is-dark .steps iconify-icon { color: var(--accent); }
      .punch { font-family: var(--font-serif); font-style: italic; font-size: clamp(1.6rem, 3.4vw, 2.9rem); line-height: 1.18; letter-spacing: -.02em; margin-top: clamp(2.5rem, 5vw, 3.5rem); max-width: 24ch; }
      .punch .hl { color: var(--yellow-ink); font-style: italic; }
      .section.dark .punch .hl { color: var(--accent); }

      /* camadas SEO/GEO/GEO PR */
      .layers { display: grid; grid-template-columns: 1fr; gap: 1rem; }
      @media (min-width: 980px) { .layers { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; } }
      .layer-card { position: relative; padding: clamp(1.75rem, 2.4vw, 2.25rem); border-radius: var(--radius-card); border: 1px solid var(--hairline); background: #fff; overflow: hidden; transition: var(--t-smooth); }
      .layer-card:hover { transform: translateY(-4px); box-shadow: 0 24px 48px rgba(0,0,0,.07); border-color: rgba(0,0,0,.14); }
      .layer-card .l-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: rgba(15,15,17,.05); color: var(--primary); font-size: 1.4rem; }
      .layer-card .l-id { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text-faint); margin-top: 1.25rem; }
      .layer-card .l-name { font-size: 1.4rem; font-weight: 600; letter-spacing: -.025em; margin-top: .3rem; line-height: 1.12; }
      .layer-card .l-otimiza { font-size: 1rem; line-height: 1.55; color: var(--text-muted); margin-top: .85rem; }
      .layer-card .l-meta { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--hairline); display: flex; flex-direction: column; gap: .55rem; }
      .layer-card .l-meta .row { display: flex; justify-content: space-between; gap: 1rem; font-size: .82rem; }
      .layer-card .l-meta .k { font-family: var(--font-mono); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: var(--text-faint); }
      .layer-card .l-meta .v { font-weight: 600; text-align: right; letter-spacing: -.01em; }
      .layer-card.featured { background: var(--geo-ink); color: #fff; border-color: var(--geo-ink); }
      .layer-card.featured::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(90% 60% at 80% 0%, rgba(255,122,26,.22) 0%, transparent 60%), radial-gradient(70% 50% at 10% 100%, rgba(254,209,54,.14) 0%, transparent 60%); }
      .layer-card.featured .l-icon { background: rgba(255,255,255,.08); color: var(--accent); position: relative; z-index: 1; }
      .layer-card.featured .l-id { color: var(--accent); position: relative; z-index: 1; }
      .layer-card.featured .l-name, .layer-card.featured .l-otimiza { position: relative; z-index: 1; }
      .layer-card.featured .l-otimiza { color: rgba(255,255,255,.75); }
      .layer-card.featured .l-meta { border-color: rgba(255,255,255,.16); position: relative; z-index: 1; }
      .layer-card.featured .l-meta .k { color: rgba(255,255,255,.5); }
      .layer-card.featured .badge { position: absolute; top: 1.25rem; right: 1.25rem; z-index: 1; font-family: var(--font-mono); font-size: .58rem; letter-spacing: .14em; text-transform: uppercase; color: var(--primary); background: var(--accent); padding: .3rem .6rem; border-radius: var(--radius-pill); font-weight: 700; }

      /* ===========================================================
         4 · DATAVIZ · rede de citação (canvas)
         =========================================================== */
      .viz-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center; }
      @media (min-width: 1024px) { .viz-grid { grid-template-columns: 1.05fr 1fr; gap: 3.5rem; } }
      .viz-stage { position: relative; aspect-ratio: 4 / 3; width: 100%; border-radius: var(--radius-card); overflow: hidden; background: linear-gradient(160deg, #141417 0%, #0A0A0C 70%); border: 1px solid rgba(255,255,255,.1); }
      #geo-network-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
      .viz-legend { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; margin-top: 1.5rem; }
      .viz-legend .li { display: inline-flex; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .04em; text-transform: uppercase; color: rgba(255,255,255,.6); }
      .viz-legend .sw { width: 12px; height: 12px; border-radius: 50%; }

      /* etapas (método) */
      .steps-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
