        var canvas = document.getElementById('geo-hero-canvas');
        if (!canvas) return;
        var gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
        if (!gl) { canvas.style.background = 'radial-gradient(70% 90% at 75% 30%, #4a1c05 0%, #160a06 55%, #0A0A0C 100%)'; return; }

        var vs = 'attribute vec2 p; void main(){ gl_Position = vec4(p,0.0,1.0); }';
        var fs = [
          'precision highp float;',
          'uniform vec2 r; uniform float t;',
          'float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7)))*43758.5453123); }',
          'float noise(vec2 p){ vec2 i=floor(p), f=fract(p); vec2 u=f*f*(3.0-2.0*f);',
          '  return mix(mix(hash(i),hash(i+vec2(1.0,0.0)),u.x), mix(hash(i+vec2(0.0,1.0)),hash(i+vec2(1.0,1.0)),u.x), u.y); }',
          'float fbm(vec2 p){ float v=0.0,a=0.5; for(int i=0;i<6;i++){ v+=a*noise(p); p*=2.03; a*=0.5; } return v; }',
          'void main(){',
          '  vec2 uv = gl_FragCoord.xy / r.xy;',
          '  vec2 p = (uv - 0.5) * vec2(r.x/r.y, 1.0) * 2.4;',
          '  float tt = t*0.035;',
          '  vec2 q = vec2(fbm(p + tt), fbm(p + vec2(5.2,1.3) - tt));',
          '  float f = fbm(p + 1.9*q + tt*0.6);',
          '  vec3 ink=vec3(0.039,0.039,0.047);',
          '  vec3 rust=vec3(0.78,0.255,0.043);',
          '  vec3 orange=vec3(1.0,0.478,0.10);',
          '  vec3 amber=vec3(1.0,0.69,0.125);',
          '  vec3 col = mix(ink, rust, smoothstep(0.18,0.55,f));',
          '  col = mix(col, orange, smoothstep(0.52,0.78,f));',
          '  col = mix(col, amber, smoothstep(0.74,0.95,f)*0.65);',
          '  float vig = smoothstep(1.25,0.15,length(uv-vec2(0.66,0.4)));',
          '  col *= 0.28 + 0.72*vig;',
          '  col *= 0.5 + 0.62*f;',
          '  gl_FragColor = vec4(col,1.0);',
          '}'
        ].join('\n');

        function sh(type, src) { var s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s); return s; }
        var prog = gl.createProgram();
        gl.attachShader(prog, sh(gl.VERTEX_SHADER, vs));
        gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, fs));
        gl.linkProgram(prog);
        if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) { canvas.style.background = 'radial-gradient(70% 90% at 75% 30%, #4a1c05 0%, #160a06 55%, #0A0A0C 100%)'; return; }
        gl.useProgram(prog);

        var buf = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, buf);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
        var loc = gl.getAttribLocation(prog, 'p');
        gl.enableVertexAttribArray(loc);
        gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
        var uR = gl.getUniformLocation(prog, 'r');
        var uT = gl.getUniformLocation(prog, 't');

        function resize() {
          var dpr = Math.min(window.devicePixelRatio || 1, 1.5);
          var w = canvas.clientWidth, h = canvas.clientHeight;
          canvas.width = Math.max(1, Math.floor(w * dpr));
          canvas.height = Math.max(1, Math.floor(h * dpr));
          gl.viewport(0, 0, canvas.width, canvas.height);
        }
        resize();
        window.addEventListener('resize', resize, { passive: true });

        var start = 0, raf = 0, running = false;
        function frame(now) {
          if (!start) start = now;
          gl.uniform2f(uR, canvas.width, canvas.height);
          gl.uniform1f(uT, (now - start) / 1000);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
          if (running) raf = requestAnimationFrame(frame);
        }
        if (prefersReduced) {
          // um único quadro estático, sem rAF contínuo
          frame(performance.now());
        } else if ('IntersectionObserver' in window) {
          // só desenha enquanto o herói está na viewport (pausa o rAF fora da tela)
          var vio = new IntersectionObserver(function (ents) {
            if (ents[0].isIntersecting) {
              if (!running) { running = true; raf = requestAnimationFrame(frame); }
            } else {
              running = false;
              if (raf) { cancelAnimationFrame(raf); raf = 0; }
            }
          }, { rootMargin: '200px' });
          vio.observe(canvas);
        } else {
          running = true;
          raf = requestAnimationFrame(frame);
        }
      })();

      /* ========================================================
         DATAVIZ · rede de citação (canvas 2D)
         imprensa -> marca -> resposta da IA
         ======================================================== */
      (function citationNet() {
        var canvas = document.getElementById('geo-network-canvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0;
        var press = ['Exame', 'Forbes', 'Valor', 'TechCrunch', 'Veja'];
        var pressNodes = [], brand = null, ai = null, pulses = [], hover = -1, mouse = { x: -1, y: -1 };
        var running = false, rafId = 0, spawnTimer = null;

        function layout() {
          var rect = canvas.getBoundingClientRect();
          W = rect.width; H = rect.height;
          canvas.width = Math.floor(W * dpr); canvas.height = Math.floor(H * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          var lx = W * 0.16, n = press.length;
          pressNodes = press.map(function (name, i) {
            var y = H * (0.16 + (0.68 * i) / (n - 1));
            return { x: lx, y: y, name: name, r: 4.5 };
          });
          brand = { x: W * 0.54, y: H * 0.5, r: 9, name: 'Sua marca' };
          ai = { x: W * 0.88, y: H * 0.5, r: 7, name: 'Resposta da IA' };
        }
        layout();

        function spawn() {
          if (prefersReduced) return;
          var src = Math.floor(Math.random() * pressNodes.length);
          pulses.push({ src: src, seg: 0, p: 0, sp: 0.006 + Math.random() * 0.006 });
        }

        function lerp(a, b, t) { return a + (b - a) * t; }

        function draw() {
          ctx.clearRect(0, 0, W, H);

          // edges press -> brand
          pressNodes.forEach(function (pn, i) {
            var active = hover === i;
            ctx.beginPath();
            ctx.moveTo(pn.x, pn.y);
            ctx.bezierCurveTo(lerp(pn.x, brand.x, 0.5), pn.y, lerp(pn.x, brand.x, 0.5), brand.y, brand.x, brand.y);
            ctx.strokeStyle = active ? 'rgba(254,209,54,.55)' : 'rgba(255,255,255,.12)';
            ctx.lineWidth = active ? 1.6 : 1;
            ctx.stroke();
          });
          // edge brand -> ai
          ctx.beginPath();
          ctx.moveTo(brand.x, brand.y);
          ctx.bezierCurveTo(lerp(brand.x, ai.x, 0.5), brand.y, lerp(brand.x, ai.x, 0.5), ai.y, ai.x, ai.y);
          ctx.strokeStyle = 'rgba(255,122,26,.35)';
          ctx.lineWidth = 1.4;
          ctx.stroke();

          // pulses
          for (var k = pulses.length - 1; k >= 0; k--) {
            var pu = pulses[k];
            pu.p += pu.sp;
            var pos;
            if (pu.seg === 0) {
              var pn = pressNodes[pu.src];
              pos = bez(pn.x, pn.y, lerp(pn.x, brand.x, 0.5), pn.y, lerp(pn.x, brand.x, 0.5), brand.y, brand.x, brand.y, pu.p);
              if (pu.p >= 1) { pu.seg = 1; pu.p = 0; }
            } else {
              pos = bez(brand.x, brand.y, lerp(brand.x, ai.x, 0.5), brand.y, lerp(brand.x, ai.x, 0.5), ai.y, ai.x, ai.y, pu.p);
              if (pu.p >= 1) { pulses.splice(k, 1); continue; }
            }
            var col = pu.seg === 0 ? '254,209,54' : '255,122,26';
            ctx.beginPath(); ctx.arc(pos.x, pos.y, 2.6, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(' + col + ',.95)'; ctx.fill();
            ctx.beginPath(); ctx.arc(pos.x, pos.y, 6, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(' + col + ',.18)'; ctx.fill();
          }

          // press nodes + labels
          ctx.font = '600 11px "JetBrains Mono", monospace';
          ctx.textBaseline = 'middle';
          pressNodes.forEach(function (pn, i) {
            var active = hover === i;
            ctx.beginPath(); ctx.arc(pn.x, pn.y, pn.r + (active ? 1.5 : 0), 0, Math.PI * 2);
            ctx.fillStyle = active ? '#FED136' : '#9aa0aa'; ctx.fill();
            ctx.textAlign = 'right';
            ctx.fillStyle = active ? 'rgba(255,255,255,.95)' : 'rgba(255,255,255,.55)';
            ctx.fillText(pn.name, pn.x - 12, pn.y);
          });

          // brand node (accent, pulsing ring)
          ctx.beginPath(); ctx.arc(brand.x, brand.y, brand.r, 0, Math.PI * 2);
          ctx.fillStyle = '#FED136'; ctx.fill();
          ctx.beginPath(); ctx.arc(brand.x, brand.y, brand.r + 6 + (Math.sin(Date.now() / 600) + 1) * 3, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(254,209,54,.35)'; ctx.lineWidth = 1; ctx.stroke();
          ctx.textAlign = 'center';
          ctx.fillStyle = 'rgba(255,255,255,.92)';
          ctx.fillText('Sua marca', brand.x, brand.y + brand.r + 16);

          // ai node (chip)
          ctx.beginPath(); ctx.arc(ai.x, ai.y, ai.r, 0, Math.PI * 2);
          ctx.fillStyle = '#FF7A1A'; ctx.fill();
          ctx.textAlign = 'center';
          ctx.fillStyle = 'rgba(255,255,255,.92)';
          ctx.fillText('Resposta da IA', ai.x, ai.y + ai.r + 16);

          if (running) rafId = requestAnimationFrame(draw);
        }

        function bez(x0, y0, cx1, cy1, cx2, cy2, x1, y1, t) {
          var u = 1 - t;
          var x = u * u * u * x0 + 3 * u * u * t * cx1 + 3 * u * t * t * cx2 + t * t * t * x1;
          var y = u * u * u * y0 + 3 * u * u * t * cy1 + 3 * u * t * t * cy2 + t * t * t * y1;
          return { x: x, y: y };
        }

        canvas.addEventListener('mousemove', function (e) {
          var rect = canvas.getBoundingClientRect();
          mouse.x = e.clientX - rect.left; mouse.y = e.clientY - rect.top;
          hover = -1;
          for (var i = 0; i < pressNodes.length; i++) {
            var pn = pressNodes[i];
            if (Math.hypot(pn.x - mouse.x, pn.y - mouse.y) < 26) { hover = i; break; }
          }
        });
        canvas.addEventListener('mouseleave', function () { hover = -1; });
        window.addEventListener('resize', layout, { passive: true });

        if (prefersReduced) {
          // estado estático único, sem rAF contínuo
          layout();
          draw();
        } else if ('IntersectionObserver' in window) {
          // só anima (rAF + spawn) enquanto a rede está na viewport
          var vioN = new IntersectionObserver(function (ents) {
            if (ents[0].isIntersecting) {
              if (!running) {
                running = true;
                spawn();
                if (!spawnTimer) spawnTimer = setInterval(spawn, 850);
                rafId = requestAnimationFrame(draw);
              }
            } else {
              running = false;
              if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
              if (spawnTimer) { clearInterval(spawnTimer); spawnTimer = null; }
            }
          }, { rootMargin: '200px' });
          vioN.observe(canvas);
        } else {
          running = true;
          setInterval(spawn, 850);
          spawn();
          rafId = requestAnimationFrame(draw);
        }
      })();
    });
  </script>
</BaseLayout>
