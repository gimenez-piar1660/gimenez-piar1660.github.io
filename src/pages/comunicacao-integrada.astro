        var READ_SEL = ['h1', 'h2', 'h3', '.eyebrow', '.lede', '.punch', '.hero-sub', '.strike', '.reply', '.cta-foot', '.chip'];
        var CARD_SEL = '.trio-card, .orbit-col, .faq-item, .sync-stage, .btn';
        var PAD = 14, FEATHER = 30;
        var FADE = [0.10, 0.14, 0.2, 0.28, 0.4, 0.55, 0.75, 0.9];   // rampa da borda macia
        var readEls = [], readRects = [], readDirty = true;

        function collectRead() {
          readEls = [];
          var all = document.querySelectorAll(READ_SEL.map(function (s) { return 'main ' + s; }).join(', '));
          for (var i = 0; i < all.length; i++) { if (!all[i].closest(CARD_SEL)) readEls.push(all[i]); }
          readDirty = true;
        }
        function updateRects() {
          readRects.length = 0;
          for (var i = 0; i < readEls.length; i++) {
            var r = readEls[i].getBoundingClientRect();
            if (r.width < 2 || r.height < 2 || r.bottom < -FEATHER || r.top > H + FEATHER) continue;
            readRects.push([r.left - PAD, r.top - PAD, r.width + PAD * 2, r.height + PAD * 2]);
