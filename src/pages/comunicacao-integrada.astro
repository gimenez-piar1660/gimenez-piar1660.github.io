            ctx.beginPath(); ctx.arc(x, y, rad, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(' + b.col[0] + ',' + b.col[1] + ',' + b.col[2] + ',1)';
            ctx.shadowColor = 'rgba(' + b.col[0] + ',' + b.col[1] + ',' + b.col[2] + ',.85)'; ctx.shadowBlur = 12 + finale * 18; ctx.fill(); ctx.shadowBlur = 0;

            if (lbls[i]) { lbls[i].style.transform = 'translate(' + x + 'px,' + y + 'px) translate(-50%, 16px)'; lbls[i].style.opacity = heroFade.toFixed(3); }
          }

          // baricentro: a marca, nucleo quente que incha no fecho
          var coreR = 5 + S * 3 + finale * finale * 26;
          var bloom = Math.sin(finale * Math.PI);
          if (bloom > 0.002) {
            ctx.beginPath(); ctx.arc(bx, by, coreR + bloom * base * 0.18, 0, Math.PI * 2);
            ctx.strokeStyle = 'rgba(254,209,54,' + (bloom * 0.4).toFixed(3) + ')'; ctx.lineWidth = 1.5; ctx.stroke();
          }
          ctx.beginPath(); ctx.arc(bx, by, coreR, 0, Math.PI * 2);
          ctx.fillStyle = '#FED136'; ctx.shadowColor = 'rgba(254,209,54,.95)'; ctx.shadowBlur = 20 + S * 8 + finale * 30; ctx.fill(); ctx.shadowBlur = 0;

          // recorta a camada nas zonas de leitura e joga sobre o fundo
          maskRead(dctx);
          mctx.drawImage(deco, 0, 0, W, H);
          ctx = mctx;

          heroFade += ((scrollP < 0.11 ? 1 : 0) - heroFade) * 0.07;
          if (lblMarca) { lblMarca.style.transform = 'translate(' + bx + 'px,' + by + 'px) translate(-50%, 16px)'; lblMarca.style.opacity = heroFade.toFixed(3); }

          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      })();

      /* ========================================================
         DATAVIZ: TRES ONDAS QUE ENTRAM EM FASE
         Fora de fase, se cancelam. Em sincronia, somam amplitude e
         brilham. Loop continuo defasado -> em fase -> defasado.
         ======================================================== */
      (function syncWave() {
        var canvas = document.getElementById('sync-canvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0;
        function resize() { var r = canvas.getBoundingClientRect(); W = r.width; H = r.height; canvas.width = W * dpr; canvas.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); }
        resize();
        window.addEventListener('resize', resize);
        var cols = [[254, 209, 54], [235, 196, 86], [120, 150, 184]];
        var t = 0;
        function frame() {
          t += prefersReduced ? 0 : 0.01;
          ctx.clearRect(0, 0, W, H);
          var sync = Math.sin(t * 0.5) * 0.5 + 0.5;          // 0 (defasado) .. 1 (em fase)
          var amp = H * 0.17;
          // a onda soma (a marca): aparece forte quando em fase
