    @media (min-width: 860px) { .orbit-mid { display: grid; place-items: center; width: 64px; height: 64px; } }
    .om-core { width: 16px; height: 16px; border-radius: 50%; background: var(--warm); box-shadow: 0 0 0 8px rgba(254,209,54,.1), 0 0 0 20px rgba(254,209,54,.05), 0 0 28px 4px rgba(254,209,54,.6); animation: pulse 3s var(--ease) infinite; }
    @keyframes pulse { 0%,100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.18); opacity: .85; } }

    /* trio de cards (frentes / destrava) */
    .trio { display: grid; grid-template-columns: 1fr; gap: 1rem; }
    @media (min-width: 760px) { .trio { grid-template-columns: repeat(3, 1fr); } }
    .trio-card { padding: clamp(1.5rem, 2.4vw, 2rem); border-radius: var(--r-card); border: 1px solid var(--hairline-d); background: rgba(13,15,22,.6); transition: var(--t-smooth); }
    .trio-card:hover { border-color: rgba(254,209,54,.28); transform: translateY(-4px); }
    .trio-card h3 { font-size: 1.3rem; font-weight: 600; letter-spacing: -.02em; margin: .7rem 0 0; }
    .trio-card p { font-size: 1rem; line-height: 1.55; color: var(--text-d-muted); margin: .6rem 0 0; }
    .m-n { font-family: var(--font-mono); font-size: .8rem; font-weight: 700; letter-spacing: .08em; color: var(--warm); }
    .c-ic { display: inline-flex; width: 46px; height: 46px; border-radius: 12px; align-items: center; justify-content: center; background: rgba(254,209,54,.1); color: var(--warm); font-size: 1.4rem; }

    /* dataviz: tres ondas em fase */
    /* O `max-height: 64vh` combinado com o aspect-ratio estrangulava a LARGURA: em 1440
       o palco parava em ~1024px numa coluna de 1160px. No desktop o grafico passa a 21/9,
       que preenche a coluna inteira e ainda fica mais baixo que antes. */
    .sync-stage { position: relative; border-radius: var(--r-card); overflow: hidden; border: 1px solid var(--hairline-d); background: rgba(4,5,7,.7); aspect-ratio: 16 / 9; max-height: 64vh; }
    @media (min-width: 900px) { .sync-stage { aspect-ratio: 21 / 9; max-height: none; } }
    #sync-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
    .sync-legend { position: absolute; left: 0; bottom: 0; z-index: 2; display: flex; flex-wrap: wrap; gap: 1.2rem; padding: clamp(1rem, 2.5vw, 1.6rem); pointer-events: none; }
    .sl { display: inline-flex; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: clamp(.58rem, 1vw, .7rem); letter-spacing: .1em; text-transform: uppercase; color: var(--text-d-muted); }
    .sl::before { content: ''; width: 14px; height: 2px; border-radius: 2px; }
    .sl.rp::before { background: #FED136; }
    .sl.brand::before { background: #EBC456; }
    .sl.rep::before { background: #789AB8; }

    .grav-cta { position: relative; z-index: 1; overflow: hidden; background: rgba(7,8,12,.5); padding-block: var(--sec-pad); border-top: 1px solid var(--hairline-d); }
    /* O fecho segue o mesmo eixo do resto da pagina: tudo alinhado a esquerda.
       As regras que centralizavam o lede e a fileira de botoes sairam: as bases
       de .lede e .cta-row ja alinham a esquerda sozinhas. */
    .cta-inner { text-align: left; display: flex; flex-direction: column; align-items: flex-start; position: relative; z-index: 2; }
    .grav-cta h2 { font-size: clamp(2rem, 4.6vw, 3.8rem); font-weight: 600; line-height: 1.08; letter-spacing: -.035em; margin-top: 1.2rem; max-width: 100%; }
    .cta-foot { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .1em; color: var(--text-d-faint); margin-top: 2.6rem; }

    .reveal { opacity: 0; transform: translateY(2rem); transition: opacity .8s var(--ease), transform .8s var(--ease); }
    .reveal.active { opacity: 1; transform: none; }
    .reveal.d1 { transition-delay: .1s; } .reveal.d2 { transition-delay: .2s; } .reveal.d3 { transition-delay: .3s; } .reveal.d4 { transition-delay: .4s; }

    @media (prefers-reduced-motion: reduce) {
      .reveal { opacity: 1; transform: none; transition: none; }
      .grav-cue .l, .om-core { animation: none; }
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- Lenis + ScrollTrigger ---- */
      try {
        if (window.gsap && window.ScrollTrigger) window.gsap.registerPlugin(window.ScrollTrigger);
        if (!prefersReduced && window.Lenis) {
          var lenis = new window.Lenis({ duration: 1.15, easing: function (t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); }, smooth: true, lerp: 0.1 });
          if (window.ScrollTrigger) { lenis.on('scroll', window.ScrollTrigger.update); window.gsap.ticker.add(function (time) { lenis.raf(time * 1000); }); window.gsap.ticker.lagSmoothing(0); }
          else { var raf0 = function (t) { lenis.raf(t); requestAnimationFrame(raf0); }; requestAnimationFrame(raf0); }
        }
      } catch (e) { /* noop */ }

      /* ---- reveal ---- */
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('active'); io.unobserve(en.target); } });
      }, { threshold: 0.14 });
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

      /* ---- scroll progress + progresso global (alimenta a ressonancia) ---- */
      var bar = document.getElementById('scroll-progress');
      var scrollP = 0;
      function onScroll() {
        var h = document.documentElement;
        scrollP = h.scrollTop / ((h.scrollHeight - h.clientHeight) || 1);
        if (bar) bar.style.width = (scrollP * 100) + '%';
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      /* ---- parallax de scroll (palavras-fantasma) ---- */
      if (!prefersReduced && window.gsap && window.ScrollTrigger) {
        window.gsap.utils.toArray('[data-parallax-y]').forEach(function (el) {
          var yp = parseFloat(el.getAttribute('data-parallax-y')) || 0;
          window.gsap.fromTo(el, { yPercent: 0 }, { yPercent: yp, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } });
        });
      }

      /* ========================================================
         DATAVIZ: TRES ONDAS QUE ENTRAM EM FASE
         Fora de fase, se cancelam. Em sincronia, somam amplitude e
         brilham. Loop continuo defasado -> em fase -> defasado.
         ======================================================== */
      (function syncWave() {
        var canvas = document.getElementById('sync-canvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0;
        function resize() { var r = canvas.getBoundingClientRect(); W = r.width; H = r.height; canvas.width = W * dpr; canvas.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); }
        resize();
        window.addEventListener('resize', resize);
        var cols = [[254, 209, 54], [235, 196, 86], [120, 150, 184]];
        var t = 0;
        function frame() {
          t += prefersReduced ? 0 : 0.01;
          ctx.clearRect(0, 0, W, H);
          var sync = Math.sin(t * 0.5) * 0.5 + 0.5;          // 0 (defasado) .. 1 (em fase)
          var amp = H * 0.17;
          // a onda soma (a marca): aparece forte quando em fase
          ctx.beginPath();
          for (var xs = 0; xs <= W; xs += 4) {
            var sum = 0;
            for (var j = 0; j < 3; j++) { var ph = (1 - sync) * (j * 2.1); sum += Math.sin(xs * 0.014 + t * 1.5 + ph); }
            var ys = H * 0.5 + (sum / 3) * amp * (0.6 + sync * 1.4);
            if (xs === 0) ctx.moveTo(xs, ys); else ctx.lineTo(xs, ys);
          }
          ctx.strokeStyle = 'rgba(254,209,54,' + (0.12 + sync * 0.5) + ')'; ctx.lineWidth = 2 + sync * 2; ctx.stroke();
          // as tres ondas
          for (var i = 0; i < 3; i++) {
            var phase = (1 - sync) * (i * 2.1);
            ctx.beginPath();
            for (var x = 0; x <= W; x += 4) {
              var y = H * 0.5 + Math.sin(x * 0.014 + t * 1.5 + phase) * amp;
              if (x === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
            }
            ctx.strokeStyle = 'rgba(' + cols[i][0] + ',' + cols[i][1] + ',' + cols[i][2] + ',' + (0.32 + 0.28 * (1 - sync)) + ')';
            ctx.lineWidth = 1.2; ctx.stroke();
          }
          if (sync > 0.92) { ctx.fillStyle = 'rgba(254,209,54,' + ((sync - 0.92) * 1.1) + ')'; ctx.fillRect(0, 0, W, H); }
          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      })();
    });
  </script>
