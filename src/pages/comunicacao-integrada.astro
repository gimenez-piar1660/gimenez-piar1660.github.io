         RP, branding e reputacao orbitam o baricentro (a marca).
         No topo, orbitas caoticas (silos). Conforme o scroll, o caos
         cede a razoes limpas e os rastros se entrelacam. Clima no
         fecho: os tres se aproximam e brilham. Sem mouse: o scroll.
         ======================================================== */
      (function resonantField() {
        var canvas = document.getElementById('field-bg');
        if (!canvas) return;
        var mctx = canvas.getContext('2d');
        if (!mctx) return;
        // camada separada so para os corpos e rastros: o fundo e o brilho ficam no canvas
        // principal e a decoracao vai nesta, para poder ser recortada nas zonas de leitura.
