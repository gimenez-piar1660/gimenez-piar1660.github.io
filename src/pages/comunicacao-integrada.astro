          if (!readRects.length) return;
          c.save();
          c.globalCompositeOperation = 'destination-out';
          c.fillStyle = '#000';
          for (var i = 0; i < readRects.length; i++) {
            var R = readRects[i];
            for (var s = 0; s < FADE.length; s++) {
              var ins = FEATHER * (1 - s / FADE.length);
              var w2 = R[2] - ins * 2, h2 = R[3] - ins * 2;
              if (w2 <= 0 || h2 <= 0) continue;
              c.globalAlpha = FADE[s];
              softRect(c, R[0] + ins, R[1] + ins, w2, h2, 18);
              c.fill();
            }
          }
          c.restore();
        }
        collectRead();
        window.addEventListener('load', collectRead);
        window.addEventListener('scroll', function () { readDirty = true; }, { passive: true });
        window.addEventListener('resize', resize);
        resize();

        var bodies = [
          { k: 2, ph: 0.0, col: [254, 209, 54], rB: 0.30, trail: [] },   // RP
          { k: 3, ph: 2.1, col: [235, 196, 86], rB: 0.235, trail: [] },  // Branding
          { k: 4, ph: 4.2, col: [120, 150, 184], rB: 0.37, trail: [] }   // Reputacao
        ];
        var T = 0;
        var lblMarca = document.getElementById('lbl-marca');
        var lbls = [document.getElementById('lbl-rp'), document.getElementById('lbl-brand'), document.getElementById('lbl-rep')];
        var heroFade = 1;

        function frame() {
          T += prefersReduced ? 0 : 0.006;
          var S = smooth(scrollP);
          var finale = smooth((scrollP - 0.72) / 0.28);
          var base = Math.min(W, H);
          var bx = W * 0.5, by = H * (0.46 + 0.05 * Math.sin(scrollP * Math.PI));

          // fundo e brilho ficam no canvas principal: sao difusos, nao disputam com a
          // leitura, e recortar um gradiente deixaria buraco quadrado.
          ctx = mctx;
          mctx.clearRect(0, 0, W, H);
          mctx.fillStyle = '#07080C'; mctx.fillRect(0, 0, W, H);

          // brilho do baricentro (a marca)
          var glowR = base * (0.32 + S * 0.14 + finale * 0.26);
          var g = ctx.createRadialGradient(bx, by, 0, bx, by, glowR);
          g.addColorStop(0, 'rgba(254,209,54,' + (0.10 + S * 0.10 + finale * 0.12) + ')');
          g.addColorStop(0.18, 'rgba(254,209,54,' + (0.04 + S * 0.04) + ')');
          g.addColorStop(0.5, 'rgba(254,209,54,0)');
          ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);

          // daqui pra baixo desenha na camada recortavel: rastros, corpos e baricentro
          if (readDirty) updateRects();
          ctx = dctx;
          dctx.clearRect(0, 0, W, H);

          var tilt = 0.4 + 0.28 * Math.sin(scrollP * Math.PI);  // o plano comum inclina (camera)
          for (var i = 0; i < bodies.length; i++) {
            var b = bodies[i];
            var chaos = 1 - S;
            var wob = chaos * 0.5 * Math.sin(T * 0.7 + b.k * 1.7);
            var ang = b.ph + T * (0.5 + b.k * 0.28) * (1 + wob * 0.3) + chaos * 1.3 * Math.sin(T * 0.3 + i);
            var ecc = chaos * 0.4;
            var r = b.rB * base * (1 + ecc * Math.sin(ang * 2 + b.k)) * (1 - finale * 0.12);
            var x = bx + Math.cos(ang) * r;
            var y = by + Math.sin(ang) * r * tilt;

            b.trail.push([x, y]); if (b.trail.length > 74) b.trail.shift();
            ctx.beginPath();
            for (var t2 = 0; t2 < b.trail.length; t2++) { var p = b.trail[t2]; if (t2 === 0) ctx.moveTo(p[0], p[1]); else ctx.lineTo(p[0], p[1]); }
            ctx.strokeStyle = 'rgba(' + b.col[0] + ',' + b.col[1] + ',' + b.col[2] + ',' + (0.05 + S * 0.16 + finale * 0.2) + ')';
            ctx.lineWidth = 1 + S * 0.6; ctx.stroke();

            // tether do baricentro ao corpo
            ctx.beginPath(); ctx.moveTo(bx, by); ctx.lineTo(x, y);
            ctx.strokeStyle = 'rgba(' + b.col[0] + ',' + b.col[1] + ',' + b.col[2] + ',' + (0.04 + S * 0.06) + ')'; ctx.lineWidth = 1; ctx.stroke();

            // o corpo
