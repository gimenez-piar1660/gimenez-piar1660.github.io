      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('active'); io.unobserve(en.target); } });
      }, { threshold: 0.14 });
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

      /* ---- scroll progress ---- */
      var bar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', function () {
        var h = document.documentElement;
        var p = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
        if (bar) bar.style.width = p + '%';
      }, { passive: true });

      /* ---- parallax de profundidade ---- */
      if (!prefersReduced && window.gsap && window.ScrollTrigger) {
        window.gsap.utils.toArray('[data-parallax-y]').forEach(function (el) {
          var yp = parseFloat(el.getAttribute('data-parallax-y')) || 0;
          window.gsap.fromTo(el, { yPercent: 0 }, { yPercent: yp, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } });
        });
      }

      /* ---- lerp mouse-parallax no herói (Três Mares) ---- */
      if (!prefersReduced && window.gsap) {
        var heroFloats = window.gsap.utils.toArray('[class*="hero-float"]');
        if (heroFloats.length) {
          var movers = heroFloats.map(function (el, i) {
            return {
              depth: (i % 2 ? 1 : -1) * (16 + i * 8),
              qx: window.gsap.quickTo(el, 'x', { duration: 0.7, ease: 'power3' }),
              qy: window.gsap.quickTo(el, 'y', { duration: 0.7, ease: 'power3' })
            };
          });
          window.addEventListener('mousemove', function (e) {
            var nx = (e.clientX / window.innerWidth - 0.5);
            var ny = (e.clientY / window.innerHeight - 0.5);
            for (var k = 0; k < movers.length; k++) { movers[k].qx(nx * movers[k].depth); movers[k].qy(ny * movers[k].depth); }
          }, { passive: true });
        }
      }

      /* ========================================================
         HERO · constelação de veículos de imprensa (canvas 2D)
         nós (veículos) orbitando a marca no centro, com links
         que se formam aos poucos · preto + glints amarelos
         ======================================================== */
      (function pressConstellation() {
        var canvas = document.getElementById('rp-hero-canvas');
        if (!canvas) { return; }
        var ctx = canvas.getContext('2d');
        if (!ctx) { canvas.style.background = 'radial-gradient(70% 90% at 72% 32%, #2a2305 0%, #120d05 55%, #0A0A0C 100%)'; return; }

        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0, cx = 0, cy = 0;
        var names = ['Exame', 'Forbes', 'Valor', 'Veja', 'TechCrunch', 'Estadão', 'Globo', 'Pequenas Empresas', 'Startups', 'O Globo', 'Época Negócios', 'Mobile Time'];
        var nodes = [], links = [], glints = [];

        function build() {
          var rect = canvas.getBoundingClientRect();
          W = rect.width; H = rect.height;
          canvas.width = Math.floor(W * dpr); canvas.height = Math.floor(H * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          // a marca: deslocada para a direita, longe do bloco de texto
          cx = W * 0.72; cy = H * 0.46;
          var base = Math.min(W, H);
          nodes = names.map(function (name, i) {
            var ring = i % 2 === 0 ? 0.28 : 0.46;
            var ang = (i / names.length) * Math.PI * 2 + (i % 2 ? 0.4 : 0);
            var rad = base * ring + (i % 3) * 14;
            return {
              name: name,
              ang: ang,
              rad: rad,
              sp: (0.00018 + (i % 4) * 0.00006) * (i % 2 ? 1 : -1),
              size: 2 + (i % 3) * 0.7,
              tw: Math.random() * Math.PI * 2
            };
          });
          links = [];
          glints = [];
        }
        build();

        function pos(n) {
          return { x: cx + Math.cos(n.ang) * n.rad, y: cy + Math.sin(n.ang) * n.rad * 0.82 };
        }

        function spawnLink() {
          if (prefersReduced) { return; }
          var i = Math.floor(Math.random() * nodes.length);
          links.push({ node: i, p: 0, sp: 0.012 + Math.random() * 0.01, life: 1 });
        }

        function spawnGlint() {
          if (prefersReduced) { return; }
          var i = Math.floor(Math.random() * nodes.length);
          glints.push({ node: i, p: 0, sp: 0.02 + Math.random() * 0.02 });
        }

        var t0 = 0;
        function frame(now) {
          if (!t0) { t0 = now; }
          var dt = now - t0; t0 = now;
          ctx.clearRect(0, 0, W, H);

          // halo da marca no centro
          var halo = ctx.createRadialGradient(cx, cy, 0, cx, cy, Math.min(W, H) * 0.5);
          halo.addColorStop(0, 'rgba(254,209,54,.12)');
          halo.addColorStop(0.4, 'rgba(254,209,54,.03)');
          halo.addColorStop(1, 'rgba(254,209,54,0)');
          ctx.fillStyle = halo;
          ctx.fillRect(0, 0, W, H);

          // avança órbitas
          for (var i = 0; i < nodes.length; i++) {
            if (!prefersReduced) { nodes[i].ang += nodes[i].sp * dt; nodes[i].tw += 0.04; }
          }

          // links permanentes tênues entre marca e cada veículo
          ctx.lineWidth = 1;
          for (var j = 0; j < nodes.length; j++) {
            var pj = pos(nodes[j]);
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.lineTo(pj.x, pj.y);
            ctx.strokeStyle = 'rgba(255,255,255,.05)';
            ctx.stroke();
          }

          // links que se formam aos poucos (linha amarela crescendo da marca ao nó)
          for (var l = links.length - 1; l >= 0; l--) {
            var lk = links[l];
            lk.p += lk.sp;
            if (lk.p >= 1) { lk.life -= 0.012; }
            if (lk.life <= 0) { links.splice(l, 1); continue; }
            var pn = pos(nodes[lk.node]);
            var grow = Math.min(lk.p, 1);
            var ex = cx + (pn.x - cx) * grow;
            var ey = cy + (pn.y - cy) * grow;
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.lineTo(ex, ey);
            ctx.strokeStyle = 'rgba(254,209,54,' + (0.5 * lk.life) + ')';
            ctx.lineWidth = 1.4;
            ctx.stroke();
          }

          // glints que viajam do veículo até a marca (a pauta chegando)
          for (var g = glints.length - 1; g >= 0; g--) {
            var gl = glints[g];
            gl.p += gl.sp;
            if (gl.p >= 1) { glints.splice(g, 1); continue; }
            var gn = pos(nodes[gl.node]);
            var gx = gn.x + (cx - gn.x) * gl.p;
            var gy = gn.y + (cy - gn.y) * gl.p;
            ctx.beginPath(); ctx.arc(gx, gy, 2.4, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(254,209,54,.95)'; ctx.fill();
            ctx.beginPath(); ctx.arc(gx, gy, 6, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(254,209,54,.16)'; ctx.fill();
          }

          // nós (veículos)
          ctx.font = '600 10px "JetBrains Mono", monospace';
          ctx.textBaseline = 'middle';
          ctx.textAlign = 'left';
          for (var k = 0; k < nodes.length; k++) {
            var nk = nodes[k];
            var p = pos(nk);
            var tw = 0.5 + 0.5 * Math.abs(Math.sin(nk.tw));
            ctx.beginPath(); ctx.arc(p.x, p.y, nk.size, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(220,224,230,' + (0.45 + tw * 0.4) + ')';
            ctx.fill();
            if (k % 2 === 0) {
              ctx.fillStyle = 'rgba(255,255,255,.28)';
              ctx.fillText(nk.name, p.x + nk.size + 5, p.y);
            }
          }

          // marca no centro (amarelo, anel pulsante)
          var pulse = (Math.sin(now / 620) + 1) * 3;
          ctx.beginPath(); ctx.arc(cx, cy, 11 + pulse, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(254,209,54,.3)'; ctx.lineWidth = 1; ctx.stroke();
          ctx.beginPath(); ctx.arc(cx, cy, 8, 0, Math.PI * 2);
          ctx.fillStyle = '#FED136'; ctx.fill();
          ctx.beginPath(); ctx.arc(cx, cy, 3, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(10,10,12,.9)'; ctx.fill();

          if (!prefersReduced) { requestAnimationFrame(frame); }
        }

        window.addEventListener('resize', build, { passive: true });

        if (prefersReduced) {
          // estado estático: algumas linhas e glints fixos
          spawnLink(); spawnGlint();
          requestAnimationFrame(frame);
        } else {
          setInterval(spawnLink, 1400);
          setInterval(spawnGlint, 700);
          spawnGlint();
          requestAnimationFrame(frame);
        }
      })();

      /* ========================================================
         DATAVIZ · rede veículo, jornalista, marca (canvas 2D)
         veículo -> jornalista -> marca, e a cobertura repetida
         ao longo do tempo vira reputação
         ======================================================== */
      (function relationNet() {
        var canvas = document.getElementById('rp-network-canvas');
        if (!canvas) { return; }
        var ctx = canvas.getContext('2d');
        if (!ctx) { return; }
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0;
        var veiculos = ['Exame', 'Valor', 'TechCrunch'];
        var vNodes = [], jNode = null, brand = null, pulses = [], hover = -1, mouse = { x: -1, y: -1 };
        var repScore = 0;

        function layout() {
          var rect = canvas.getBoundingClientRect();
          W = rect.width; H = rect.height;
          canvas.width = Math.floor(W * dpr); canvas.height = Math.floor(H * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          var lx = W * 0.15, n = veiculos.length;
          vNodes = veiculos.map(function (name, i) {
            var y = H * (0.22 + (0.56 * i) / (n - 1));
            return { x: lx, y: y, name: name, r: 4.5 };
          });
          jNode = { x: W * 0.46, y: H * 0.5, r: 7, name: 'Jornalista' };
          brand = { x: W * 0.82, y: H * 0.5, r: 9, name: 'Sua marca' };
        }
        layout();

        function spawn() {
          if (prefersReduced) { return; }
          var src = Math.floor(Math.random() * vNodes.length);
          pulses.push({ src: src, seg: 0, p: 0, sp: 0.007 + Math.random() * 0.006 });
        }

        function lerp(a, b, t) { return a + (b - a) * t; }

        function bez(x0, y0, cx1, cy1, cx2, cy2, x1, y1, t) {
          var u = 1 - t;
          var x = u * u * u * x0 + 3 * u * u * t * cx1 + 3 * u * t * t * cx2 + t * t * t * x1;
          var y = u * u * u * y0 + 3 * u * u * t * cy1 + 3 * u * t * t * cy2 + t * t * t * y1;
          return { x: x, y: y };
        }

        function draw() {
          ctx.clearRect(0, 0, W, H);

          // edges veiculo -> jornalista
          vNodes.forEach(function (vn, i) {
            var active = hover === i;
            ctx.beginPath();
            ctx.moveTo(vn.x, vn.y);
            ctx.bezierCurveTo(lerp(vn.x, jNode.x, 0.5), vn.y, lerp(vn.x, jNode.x, 0.5), jNode.y, jNode.x, jNode.y);
            ctx.strokeStyle = active ? 'rgba(255,176,32,.6)' : 'rgba(255,255,255,.12)';
            ctx.lineWidth = active ? 1.6 : 1;
            ctx.stroke();
          });
          // edge jornalista -> marca
          ctx.beginPath();
          ctx.moveTo(jNode.x, jNode.y);
          ctx.bezierCurveTo(lerp(jNode.x, brand.x, 0.5), jNode.y, lerp(jNode.x, brand.x, 0.5), brand.y, brand.x, brand.y);
          ctx.strokeStyle = 'rgba(254,209,54,.4)';
          ctx.lineWidth = 1.4;
          ctx.stroke();

          // pulses (a pauta viajando: veiculo -> jornalista -> marca)
          for (var k = pulses.length - 1; k >= 0; k--) {
            var pu = pulses[k];
            pu.p += pu.sp;
            var posP, col;
            if (pu.seg === 0) {
              var vn = vNodes[pu.src];
              posP = bez(vn.x, vn.y, lerp(vn.x, jNode.x, 0.5), vn.y, lerp(vn.x, jNode.x, 0.5), jNode.y, jNode.x, jNode.y, pu.p);
              col = '255,176,32';
              if (pu.p >= 1) { pu.seg = 1; pu.p = 0; }
            } else {
              posP = bez(jNode.x, jNode.y, lerp(jNode.x, brand.x, 0.5), jNode.y, lerp(jNode.x, brand.x, 0.5), brand.y, brand.x, brand.y, pu.p);
              col = '254,209,54';
              if (pu.p >= 1) { pulses.splice(k, 1); repScore = Math.min(1, repScore + 0.06); continue; }
            }
            ctx.beginPath(); ctx.arc(posP.x, posP.y, 2.6, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(' + col + ',.95)'; ctx.fill();
            ctx.beginPath(); ctx.arc(posP.x, posP.y, 6, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(' + col + ',.18)'; ctx.fill();
          }

          // decaimento lento do score (reputação precisa de cadência)
          if (!prefersReduced) { repScore = Math.max(0, repScore - 0.0012); }

          // veiculo nodes + labels
          ctx.font = '600 11px "JetBrains Mono", monospace';
          ctx.textBaseline = 'middle';
          vNodes.forEach(function (vn, i) {
            var active = hover === i;
            ctx.beginPath(); ctx.arc(vn.x, vn.y, vn.r + (active ? 1.5 : 0), 0, Math.PI * 2);
            ctx.fillStyle = active ? '#FFB020' : '#9aa0aa'; ctx.fill();
            ctx.textAlign = 'right';
            ctx.fillStyle = active ? 'rgba(255,255,255,.95)' : 'rgba(255,255,255,.55)';
            ctx.fillText(vn.name, vn.x - 12, vn.y);
          });

          // jornalista node
          ctx.beginPath(); ctx.arc(jNode.x, jNode.y, jNode.r, 0, Math.PI * 2);
          ctx.fillStyle = '#FFB020'; ctx.fill();
          ctx.textAlign = 'center';
          ctx.fillStyle = 'rgba(255,255,255,.92)';
          ctx.fillText('Jornalista', jNode.x, jNode.y + jNode.r + 16);

          // marca node (anel de reputação que cresce com a cadência)
          ctx.beginPath(); ctx.arc(brand.x, brand.y, brand.r, 0, Math.PI * 2);
          ctx.fillStyle = '#FED136'; ctx.fill();
          var repR = brand.r + 6 + repScore * 22;
          ctx.beginPath(); ctx.arc(brand.x, brand.y, repR, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(254,209,54,' + (0.18 + repScore * 0.4) + ')'; ctx.lineWidth = 1.5; ctx.stroke();
          ctx.textAlign = 'center';
          ctx.fillStyle = 'rgba(255,255,255,.92)';
          ctx.fillText('Reputação', brand.x, brand.y + brand.r + 16);

          requestAnimationFrame(draw);
        }

        canvas.addEventListener('mousemove', function (e) {
          var rect = canvas.getBoundingClientRect();
          mouse.x = e.clientX - rect.left; mouse.y = e.clientY - rect.top;
          hover = -1;
          for (var i = 0; i < vNodes.length; i++) {
            var vn = vNodes[i];
            if (Math.hypot(vn.x - mouse.x, vn.y - mouse.y) < 26) { hover = i; break; }
          }
        });
        canvas.addEventListener('mouseleave', function () { hover = -1; });
        window.addEventListener('resize', layout, { passive: true });

        if (prefersReduced) {
          repScore = 0.5;
          layout();
          draw();
        } else {
          setInterval(spawn, 900);
          spawn();
          requestAnimationFrame(draw);
        }
      })();
    });
  </script>
</BaseLayout>
