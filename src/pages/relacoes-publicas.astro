---
// ============================================================================
// Narrativa espetacular · Relações Públicas
// Conteúdo voice-backed portado de:
//   src/content/pages/relacoes-publicas.md
// Original preservado. Esta página é a versão "narrativa espetacular":
// herói canvas 2D (constelação de veículos de imprensa orbitando a marca,
// preto + glints amarelos) + dataviz de rede veículo, jornalista, marca
// (canvas 2D) + scroll storytelling (GSAP/Lenis), sobre o DS da PiaR.
// ============================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import { site } from '@/data/site';

const url = `${site.domain}/relacoes-publicas`;

// O que a PiaR entrega em relações públicas (cinco frentes).
const frentes = [
  {
    nome: 'Relações com a imprensa',
    desc: 'Pauta, relacionamento e cobertura editorial nos veículos que importam para o seu mercado. A abordagem nasce do veículo e do jornalista certos, não de uma lista.',
    icon: 'solar:notebook-line-duotone',
  },
  {
    nome: 'Narrativa e branding',
    desc: 'Posicionamento de marca, voz executiva e construção de percepção pública. A história que sustenta cada cobertura, contada de ponta a ponta.',
    icon: 'solar:pen-new-square-line-duotone',
  },
  {
    nome: 'Reputação',
    desc: 'Como a sua marca aparece na busca, na mídia e nas respostas de inteligência artificial. Reputação é o que sobra quando a cobertura passa.',
    icon: 'solar:shield-star-line-duotone',
  },
  {
    nome: 'Gestão de crise',
    desc: 'Protocolo de resposta, mapa de stakeholders e controle da narrativa quando o tempo conta. Uma capacidade da casa, pronta antes de precisar.',
    icon: 'solar:danger-triangle-line-duotone',
  },
  {
    nome: 'Conteúdo e social',
    desc: 'Presença digital e editorial que sustenta a reputação entre uma cobertura e outra. O ritmo que mantém a marca viva nos intervalos.',
    icon: 'solar:chat-round-line-duotone',
  },
];

// As quatro etapas do trabalho.
const etapas = [
  {
    num: '01',
    titulo: 'Diagnóstico e mapeamento',
    prazo: 'Semanas 1 e 2',
    desc: 'Quem precisa ouvir a marca, em quais veículos e com qual ângulo. Mapeamos o veículo e o jornalista antes de escrever a primeira linha.',
  },
  {
    num: '02',
    titulo: 'Messaging framework',
    prazo: 'A base da narrativa',
    desc: 'As mensagens-chave e a voz dos porta-vozes. É o que garante que a história chegue certa, com fatos e dados que a sustentam.',
  },
  {
    num: '03',
    titulo: 'Ativação editorial',
    prazo: 'Pauta e relacionamento',
    desc: 'Conquistamos a cobertura com os jornalistas mapeados. Com pauta que o veículo tem motivo para publicar, não disparo em massa.',
  },
  {
    num: '04',
    titulo: 'Monitoramento e escala',
    prazo: 'Ciclos quinzenais',
    desc: 'Ajustamos o que funciona e abandonamos o que não funciona. Medição contínua do que a cobertura gera em percepção e em negócio.',
  },
];

// Os seis vetores editoriais do PEP.
const vetores = [
  { nome: 'Palco', desc: 'Presença e autoridade em eventos e nos momentos certos.', icon: 'solar:microphone-large-line-duotone' },
  { nome: 'Conversa', desc: 'Pauta e relacionamento que abrem porta com a imprensa.', icon: 'solar:dialog-2-line-duotone' },
  { nome: 'Narrativa', desc: 'A história da marca contada de ponta a ponta.', icon: 'solar:book-2-line-duotone' },
  { nome: 'Cadência', desc: 'Ritmo editorial constante, não picos isolados.', icon: 'solar:pulse-line-duotone' },
  { nome: 'Alcance', desc: 'Distribuição da mensagem nos canais que importam.', icon: 'solar:radar-2-line-duotone' },
  { nome: 'Veículo', desc: 'Presença nos meios certos para cada público.', icon: 'solar:bus-line-duotone' },
];

// Como escolher uma agência (critérios).
const criterios = [
  {
    titulo: 'Peça prova datada, não adjetivo',
    desc: 'Caso com número e data vale mais que "líder de mercado". Se a agência não consegue nomear um resultado, é sinal.',
  },
  {
    titulo: 'Pergunte como ela decide a abordagem',
    desc: 'Se a resposta for "disparamos para a nossa base", você vai pagar por ruído. A pergunta certa é como ela identifica veículo e jornalista antes de escrever.',
  },
  {
    titulo: 'Verifique o relacionamento, não a lista',
    desc: 'Cobertura qualificada vem de quem o jornalista atende, não de quantos e-mails a agência envia.',
  },
  {
    titulo: 'Confirme quem assina o dia a dia',
    desc: 'Saber o nome do time que conduz a conta importa mais que o nome no contrato.',
  },
  {
    titulo: 'Cheque a revisão dos ativos',
    desc: 'Em setores regulados, comunicar sem revisão jurídica é um risco que a empresa herda.',
  },
  {
    titulo: 'Alinhe o modelo de cobrança ao escopo',
    desc: 'Fee mensal, projeto e PEP servem a momentos diferentes. A agência deve recomendar o que cabe no seu, não o mais caro.',
  },
];

const exits = site.exits;
const clientes = ['Sambatech', 'Liga Ventures', 'Printi', 'Qranio', 'Unifisa', 'Livup', 'Doctoralia', 'Solides', 'Corning', 'PagBrasil', 'Sidia', 'FluencyPass', 'Layer Up', 'Wylinka', 'Inovativa', 'Unlimitail'];

const faq = [
  {
    q: 'O que é uma agência de relações públicas?',
    a: 'É a empresa que constrói e protege a reputação de uma marca diante de imprensa, clientes, investidores e dos mecanismos que respondem por eles, como busca e inteligência artificial. O trabalho vai de assessoria de imprensa a narrativa, reputação e gestão de crise, e parte da decisão de qual história contar, para quem e por quê, antes de qualquer distribuição.',
  },
  {
    q: 'Qual a diferença entre relações públicas e assessoria de imprensa?',
    a: 'A assessoria de imprensa é a frente que cuida da relação com jornalistas e da cobertura editorial. Relações públicas é o conjunto maior, que inclui a assessoria e soma narrativa, branding, reputação e crise. Na PiaR, a imprensa é o ponto de partida, não o limite do trabalho.',
  },
  {
    q: 'Quanto custa contratar uma agência de PR?',
    a: 'O modelo mais comum é o fee mensal, em que a empresa contrata uma equipe e um escopo recorrentes. A PiaR também trabalha por projeto e pelo PEP, a metodologia de Projetos Especiais de PR, quando o objetivo pede um esforço concentrado. O investimento é definido sob consulta e depende do escopo, das frentes envolvidas e do nível de regulação do setor. O diagnóstico inicial é o que define a recomendação, e a PiaR sugere o modelo que cabe no momento da empresa, não o mais caro.',
  },
  {
    q: 'Como contratar a PiaR?',
    a: 'O primeiro passo é um diagnóstico. A empresa conta o contexto, a PiaR mapeia veículos, jornalistas e o ângulo, e apresenta a recomendação de escopo e modelo. A ativação editorial começa depois do messaging framework, e nada vai para a imprensa sem revisão.',
  },
  {
    q: 'A PiaR atende empresas fora de tecnologia?',
    a: 'O foco é startups, scale-ups e empresas de tecnologia, de fintech a healthtech, porque é onde está a experiência da casa. Empresas de outros setores com necessidade de comunicação para inovação podem levar o contexto ao diagnóstico.',
  },
  {
    q: 'A PiaR dispara release para uma lista de contatos?',
    a: 'Não como estratégia. A distribuição em massa de release é tratada como ruído. A abordagem nasce do mapeamento de veículo e jornalista, e a ferramenta de distribuição entra por último, depois da decisão editorial.',
  },
];
---
<BaseLayout
  title="Uma agência de relações públicas que começa pelo dado"
  description="Relações públicas para startups, scale-ups e empresas de tecnologia que precisam de cobertura qualificada e de marca forte. Desde 2013, em São Paulo."
  canonical={url}
>
  <Fragment slot="head">
    <style is:global>
      :root {
        --accent: #FED136;
        --accent-deep: #E0B420;
        --paper-warm: #F4F1EA;
        --rp-ink: #0A0A0C;
        --rp-ink-2: #141417;
        --rp-amber: #FFB020;
        --rp-glow: #FFD84A;
        --radius-card: 24px;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 700; }
      body { font-family: var(--font-sans); background: var(--paper); color: var(--primary); overflow-x: hidden; -webkit-font-smoothing: antialiased; font-feature-settings: "ss01", "cv11"; }

      #scroll-progress { position: fixed; top: 0; left: 0; height: 2px; background: var(--accent); z-index: 9999; width: 0; transition: width .1s linear; }

      .wrap { max-width: 1280px; margin: 0 auto; padding-inline: 1.5rem; position: relative; z-index: 1; }
      @media (min-width: 768px) { .wrap { padding-inline: 2rem; } }

      .eyebrow { display: inline-flex; align-items: center; gap: .6rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; color: var(--text-muted); font-weight: 600; }
      .eyebrow::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex-shrink: 0; box-shadow: 0 0 0 4px rgba(254,209,54,.18); }
      .eyebrow.on-dark { color: rgba(255,255,255,.72); }

      .accent-serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--accent-deep); letter-spacing: -.02em; }
      .accent-serif.on-dark { color: var(--accent); }

      /* botões */
      .btn { display: inline-flex; align-items: center; gap: .55rem; padding: .9rem 1.7rem; border-radius: var(--radius-btn); font-size: .95rem; font-weight: 600; letter-spacing: -.01em; text-decoration: none; transition: var(--t-smooth); cursor: pointer; border: 1.5px solid transparent; }
      .btn iconify-icon { transition: transform .4s var(--ease-out-expo); }
      .btn:hover iconify-icon { transform: translateX(4px); }
      .btn-accent { background: var(--accent); color: var(--primary); border-color: var(--accent); }
      .btn-accent:hover { background: #FFD84A; transform: translateY(-2px); box-shadow: 0 16px 32px rgba(254,209,54,.32); }
      .btn-ghost-d { background: transparent; color: #fff; border-color: rgba(255,255,255,.25); }
      .btn-ghost-d:hover { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.5); }
      .btn-ghost { background: transparent; color: var(--primary); border-color: rgba(0,0,0,.16); }
      .btn-ghost:hover { background: rgba(0,0,0,.04); border-color: rgba(0,0,0,.32); }

      /* ===========================================================
         1 · HERO · constelação de veículos (canvas 2D)
         =========================================================== */
      .rp-hero { position: relative; min-height: 100vh; min-height: 100svh; background: var(--rp-ink); color: #fff; overflow: hidden; display: flex; align-items: center; isolation: isolate; }
      #rp-hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; display: block; }
      .rp-hero .scrim { position: absolute; inset: 0; z-index: 1; pointer-events: none;
        background:
          radial-gradient(120% 90% at 16% 38%, rgba(10,10,12,.86) 0%, rgba(10,10,12,.4) 46%, rgba(10,10,12,0) 72%),
          linear-gradient(180deg, rgba(10,10,12,.5) 0%, rgba(10,10,12,0) 30%, rgba(10,10,12,.2) 74%, rgba(10,10,12,.92) 100%);
      }
      .rp-hero .hero-inner { position: relative; z-index: 2; width: 100%; padding-block: 9rem 4rem; }
      .rp-hero-chip { display: inline-flex; align-items: center; gap: .5rem; padding: .5rem 1rem; border-radius: var(--radius-pill); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(6px); font-family: var(--font-mono); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.78); }
      .rp-hero-chip .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px 1px rgba(254,209,54,.7); }
      .rp-hero h1 { font-size: clamp(2.9rem, 8.5vw, 8rem); font-weight: 700; line-height: .92; letter-spacing: -.045em; margin: 1.6rem 0 0; max-width: 16ch; text-wrap: balance; }
      .rp-hero .sub { font-size: clamp(1.1rem, 1.7vw, 1.4rem); line-height: 1.5; color: rgba(255,255,255,.74); margin-top: 1.75rem; max-width: 47ch; }
      .rp-hero .cta-row { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2.5rem; }
      .rp-scroll-cue { position: absolute; left: 50%; bottom: 1.75rem; transform: translateX(-50%); z-index: 2; display: inline-flex; flex-direction: column; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .6rem; letter-spacing: .2em; text-transform: uppercase; color: rgba(255,255,255,.5); }
      .rp-scroll-cue .line { width: 1px; height: 38px; background: linear-gradient(180deg, rgba(255,255,255,.5), transparent); animation: cuePulse 2.2s var(--ease-out-expo) infinite; }
      @keyframes cuePulse { 0%,100% { opacity: .3; transform: scaleY(.7); transform-origin: top; } 50% { opacity: 1; transform: scaleY(1); } }

      /* parallax / camadas de profundidade */
      .px { will-change: transform; }
      .has-ghost { overflow: hidden; }
      .ghost-mark { position: absolute; z-index: 0; font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: clamp(7rem, 24vw, 24rem); line-height: .78; letter-spacing: -.04em; color: rgba(15,15,17,.045); pointer-events: none; user-select: none; white-space: nowrap; }
      .section.dark .ghost-mark { color: rgba(255,255,255,.04); }
      .ghost-mark.tr { top: -2rem; right: -1.5rem; }
      .ghost-mark.bl { bottom: -3rem; left: -2rem; }
      .rp-hero-float { position: absolute; z-index: 2; display: inline-flex; align-items: center; gap: .5rem; padding: .55rem 1rem; border-radius: var(--radius-pill); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(6px); font-family: var(--font-mono); font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.72); }
      .rp-hero-float .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px 1px rgba(254,209,54,.7); }
      .rp-hero-float.f1 { right: 9%; top: 26%; }
      .rp-hero-float.f2 { right: 17%; bottom: 22%; }
      @media (max-width: 900px) { .rp-hero-float { display: none; } .ghost-mark { font-size: clamp(6rem, 30vw, 12rem); } }

      /* Três Mares · contorno radial (a cor desta página) como camada de profundidade */
      .has-contour { overflow: hidden; }
      .contour-field {
        position: absolute; inset: -14% -10%; z-index: 0; pointer-events: none;
        --contour-line: rgba(254,209,54,.10);
        background: repeating-radial-gradient(circle at 80% 35%, transparent 0 46px, var(--contour-line) 46px 47px);
        -webkit-mask-image: radial-gradient(circle at 80% 35%, #000 0%, rgba(0,0,0,.55) 42%, transparent 78%);
                mask-image: radial-gradient(circle at 80% 35%, #000 0%, rgba(0,0,0,.55) 42%, transparent 78%);
        will-change: transform;
      }
      @media (max-width: 760px) { .contour-field { opacity: .6; } }

      /* ===========================================================
         seções base
         =========================================================== */
      .section { padding-block: var(--sec-pad); position: relative; }
      .section.paper { background: var(--paper); border-top: 1px solid var(--hairline); }
      .section.warm { background: var(--paper-warm); border-top: 1px solid var(--hairline); }
      .section.dark { background: var(--rp-ink); color: #fff; border-top: 1px solid rgba(255,255,255,.06); }
      .section h2 { font-size: clamp(2.1rem, 4.6vw, 4rem); font-weight: 600; line-height: 1.03; letter-spacing: -.035em; margin: 1rem 0 0; max-width: 20ch; text-wrap: balance; }
      .section.dark h2 { color: #fff; }
      .lede { font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.55; color: var(--text-muted); margin-top: 1.5rem; max-width: 56ch; }
      .section.dark .lede { color: rgba(255,255,255,.72); }
      .sec-head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }

      /* compare 2 colunas (a virada: release vs. dado) */
      .compare { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
      @media (min-width: 900px) { .compare { grid-template-columns: 1fr 1fr; gap: 1.5rem; } }
      .compare-card { padding: clamp(2rem, 3vw, 2.75rem); border-radius: var(--radius-card); border: 1px solid var(--hairline); background: #fff; min-height: 280px; display: flex; flex-direction: column; }
      .compare-card .ctag { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--text-faint); }
      .compare-card h3 { font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 600; letter-spacing: -.025em; margin: .9rem 0 0; line-height: 1.1; }
      .compare-card p { font-size: 1.0625rem; line-height: 1.6; color: var(--text-muted); margin-top: 1rem; }
      .compare-card .steps { margin-top: auto; padding-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; color: var(--text-faint); }
      .compare-card .steps iconify-icon { color: var(--accent-deep); }
      .compare-card.is-dark { background: var(--rp-ink-2); border-color: rgba(255,255,255,.12); color: #fff; }
      .compare-card.is-dark .ctag { color: rgba(255,255,255,.45); }
      .compare-card.is-dark p { color: rgba(255,255,255,.72); }
      .compare-card.is-dark .steps { color: rgba(255,255,255,.5); }
      .compare-card.is-dark .steps iconify-icon { color: var(--accent); }
      .punch { font-family: var(--font-serif); font-style: italic; font-size: clamp(1.6rem, 3.4vw, 2.9rem); line-height: 1.18; letter-spacing: -.02em; margin-top: clamp(2.5rem, 5vw, 3.5rem); max-width: 24ch; }
      .punch .hl { color: var(--accent-deep); font-style: italic; }
      .section.dark .punch .hl { color: var(--accent); }

      /* frentes */
      .frentes-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
      @media (min-width: 720px) { .frentes-grid { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
      @media (min-width: 1100px) { .frentes-grid { grid-template-columns: repeat(3, 1fr); } }
      .frente-card { padding: clamp(1.75rem, 2.2vw, 2.25rem); border-radius: var(--radius-card); background: #fff; border: 1px solid var(--hairline); transition: var(--t-smooth); }
      .frente-card:hover { transform: translateY(-4px); box-shadow: 0 22px 44px rgba(0,0,0,.06); border-color: rgba(0,0,0,.14); }
      .frente-card .f-icon { width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; background: rgba(254,209,54,.14); color: var(--accent-deep); font-size: 1.5rem; }
      .frente-card .f-name { font-size: 1.25rem; font-weight: 600; letter-spacing: -.02em; margin-top: 1.25rem; }
      .frente-card .f-desc { font-size: .95rem; line-height: 1.6; color: var(--text-muted); margin-top: .7rem; }

      /* ===========================================================
         4 · DATAVIZ · rede veículo, jornalista, marca (canvas)
         =========================================================== */
      .viz-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center; }
      @media (min-width: 1024px) { .viz-grid { grid-template-columns: 1.05fr 1fr; gap: 3.5rem; } }
      .viz-stage { position: relative; aspect-ratio: 4 / 3; width: 100%; border-radius: var(--radius-card); overflow: hidden; background: linear-gradient(160deg, #141417 0%, #0A0A0C 70%); border: 1px solid rgba(255,255,255,.1); }
      #rp-network-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
      .viz-legend { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; margin-top: 1.5rem; }
      .viz-legend .li { display: inline-flex; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .04em; text-transform: uppercase; color: rgba(255,255,255,.6); }
      .viz-legend .sw { width: 12px; height: 12px; border-radius: 50%; }

      /* etapas (método) */
      .steps-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
      @media (min-width: 720px) { .steps-grid { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
      @media (min-width: 1100px) { .steps-grid { grid-template-columns: repeat(4, 1fr); } }
      .step-card { padding: 1.85rem 1.6rem; border-radius: var(--radius-card); background: #fff; border: 1px solid var(--hairline); transition: var(--t-smooth); display: flex; flex-direction: column; min-height: 250px; }
      .step-card:hover { transform: translateY(-4px); box-shadow: 0 22px 44px rgba(0,0,0,.06); border-color: rgba(254,209,54,.45); }
      .step-card .s-num { font-family: var(--font-mono); font-size: .9rem; font-weight: 700; letter-spacing: .1em; color: var(--accent-deep); }
      .step-card .s-prazo { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text-faint); margin-top: .9rem; }
      .step-card .s-titulo { font-size: 1.18rem; font-weight: 600; letter-spacing: -.02em; margin-top: .3rem; line-height: 1.2; }
      .step-card .s-desc { font-size: .92rem; line-height: 1.55; color: var(--text-muted); margin-top: .85rem; }

      /* PEP · vetores */
      .pep-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
      @media (min-width: 600px) { .pep-grid { grid-template-columns: 1fr 1fr; gap: 1.1rem; } }
      @media (min-width: 1000px) { .pep-grid { grid-template-columns: repeat(3, 1fr); } }
      .pep-card { padding: 1.6rem 1.5rem; border-radius: var(--radius-card); background: var(--rp-ink-2); border: 1px solid rgba(255,255,255,.1); transition: var(--t-smooth); }
      .pep-card:hover { transform: translateY(-4px); border-color: rgba(254,209,54,.4); box-shadow: 0 22px 44px rgba(0,0,0,.3); }
      .pep-card .p-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: rgba(254,209,54,.12); color: var(--accent); font-size: 1.4rem; }
      .pep-card .p-name { font-size: 1.18rem; font-weight: 600; letter-spacing: -.02em; margin-top: 1.1rem; color: #fff; }
      .pep-card .p-desc { font-size: .9rem; line-height: 1.55; color: rgba(255,255,255,.66); margin-top: .55rem; }

      /* critérios (como escolher) */
      .crit-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
      @media (min-width: 720px) { .crit-grid { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
      @media (min-width: 1100px) { .crit-grid { grid-template-columns: repeat(3, 1fr); } }
      .crit-card { padding: clamp(1.6rem, 2vw, 2rem); border-radius: var(--radius-card); background: #fff; border: 1px solid var(--hairline); transition: var(--t-smooth); display: flex; flex-direction: column; gap: .65rem; }
      .crit-card:hover { transform: translateY(-4px); box-shadow: 0 22px 44px rgba(0,0,0,.06); border-color: rgba(0,0,0,.14); }
      .crit-card .c-mark { font-family: var(--font-mono); font-size: .82rem; font-weight: 700; color: var(--accent-deep); }
      .crit-card .c-titulo { font-size: 1.12rem; font-weight: 600; letter-spacing: -.02em; line-height: 1.2; }
      .crit-card .c-desc { font-size: .92rem; line-height: 1.55; color: var(--text-muted); }

      /* prova */
      .chips { display: flex; flex-wrap: wrap; gap: .5rem; }
      .chip { display: inline-flex; align-items: center; padding: .5rem 1rem; border-radius: var(--radius-pill); font-family: var(--font-mono); font-size: .68rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; background: rgba(255,255,255,.06); color: #fff; border: 1px solid rgba(255,255,255,.16); }
      .honesty { margin-top: 2.5rem; padding: 1.75rem 2rem; border-radius: var(--radius-card); border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.03); display: flex; gap: 1rem; align-items: flex-start; max-width: 64ch; }
      .honesty iconify-icon { color: var(--accent); font-size: 1.5rem; flex-shrink: 0; margin-top: .1rem; }
      .honesty p { font-size: 1rem; line-height: 1.6; color: rgba(255,255,255,.82); margin: 0; }

      /* liderança */
      .lead-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 2.25rem; }
      @media (min-width: 720px) { .lead-grid { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; } }
      .lead-card { padding: 1.6rem 1.5rem; border-radius: var(--radius-card); background: #fff; border: 1px solid var(--hairline); }
      .lead-card .l-name { font-size: 1.2rem; font-weight: 600; letter-spacing: -.02em; }
      .lead-card .l-role { font-family: var(--font-mono); font-size: .66rem; letter-spacing: .14em; text-transform: uppercase; color: var(--accent-deep); margin-top: .5rem; }
      .lead-card .l-note { font-size: .92rem; line-height: 1.55; color: var(--text-muted); margin-top: .8rem; }

      /* faq */
      .faq-item { border-bottom: 1px solid var(--hairline); }
      .faq-item summary { list-style: none; cursor: pointer; padding: 1.6rem 0; display: flex; justify-content: space-between; align-items: center; gap: 2rem; font-size: 1.15rem; font-weight: 600; letter-spacing: -.01em; transition: color .3s; }
      .faq-item summary::-webkit-details-marker { display: none; }
      .faq-item summary:hover { color: var(--accent-deep); }
      .faq-item summary iconify-icon { transition: transform .4s var(--ease-out-expo); font-size: 1.5rem; color: var(--text-muted); flex-shrink: 0; }
      .faq-item[open] summary iconify-icon { transform: rotate(45deg); color: var(--accent-deep); }
      .faq-item .faq-body { padding: 0 0 1.6rem; color: var(--text-muted); max-width: 72ch; line-height: 1.65; }

      /* cta final */
      .cta-final { text-align: center; }
      .cta-final h2 { margin-inline: auto; max-width: 18ch; }
      .cta-final .lede { margin-inline: auto; }
      .cta-final .cta-row { justify-content: center; }

      /* reveal local */
      .reveal { opacity: 0; transform: translateY(2rem); transition: opacity .8s var(--ease-out-expo), transform .8s var(--ease-out-expo); }
      .reveal.active { opacity: 1; transform: none; }
      .d1 { transition-delay: .08s; } .d2 { transition-delay: .16s; } .d3 { transition-delay: .24s; } .d4 { transition-delay: .32s; }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
        .reveal { opacity: 1 !important; transform: none !important; }
        .rp-scroll-cue .line { animation: none; }
      }
