      /* quote block · single focal · placeholder honesto */
      .quote-block { padding: clamp(3rem, 6vw, 5rem) clamp(2rem, 5vw, 4rem); border-radius: var(--radius-stadium); background: var(--paper-lifted); border: 1px solid var(--hairline); position: relative; overflow: hidden; }
