  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      try {
        if (window.gsap && window.ScrollTrigger) window.gsap.registerPlugin(window.ScrollTrigger);
        if (!prefersReduced && window.Lenis) {
          const lenis = new window.Lenis({ duration: 1.2, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), smooth: true, lerp: 0.1 });
          if (window.ScrollTrigger) { lenis.on('scroll', window.ScrollTrigger.update); window.gsap.ticker.add((time) => lenis.raf(time * 1000)); window.gsap.ticker.lagSmoothing(0); }
        }
      } catch (e) { /* noop */ }
      const progressBar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', () => {
        const h = document.documentElement;
        const p = (h.scrollTop) / (h.scrollHeight - h.clientHeight) * 100;
        if (progressBar) progressBar.style.width = p + '%';
      }, { passive: true });

      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('active'); io.unobserve(e.target); }
        });
      }, { threshold: 0.15 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    });
  </script>
