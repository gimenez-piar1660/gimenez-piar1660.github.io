      .cap-card .cap-desc { font-size: .95rem; color: var(--text-muted); line-height: 1.55; }
      .cap-card .cap-foot { margin-top: auto; padding-top: 1.1rem; border-top: 1px solid var(--hairline); display: grid; gap: .55rem; }
      .cap-card .cap-foot .cap-line { display: flex; gap: .6rem; font-size: .85rem; }
      .cap-card .cap-foot .cap-key { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text-faint); font-weight: 600; min-width: 7.5ch; padding-top: .15rem; }
      .cap-card .cap-foot .cap-val { color: var(--text-muted); line-height: 1.45; }

      /* etapa card · método em 4 etapas (light) */
      .etapa-card { padding: 1.75rem; border-radius: 16px; background: #fff; border: 1px solid var(--hairline); }
      .etapa-card.is-accent { background: rgba(254,209,54,.1); border-color: rgba(254,209,54,.4); }
      .etapa-card .e-id { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .18em; text-transform: uppercase; color: var(--accent-deep); font-weight: 600; }
