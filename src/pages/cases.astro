      .case-card .case-lead { font-size: .94rem; color: var(--text-muted); line-height: 1.55; max-width: 56ch; flex: 1; }
      .case-card .case-foot { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; padding-top: 1rem; border-top: 1px solid var(--hairline); }
      .case-card .case-metric { display: flex; flex-direction: column; }
      .case-card .case-metric .m-label { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .2em; text-transform: uppercase; color: var(--text-faint); }
      .case-card .case-metric .m-val { font-size: 1.6rem; font-weight: 700; letter-spacing: -.025em; line-height: 1; margin-top: .25rem; }
      .case-card .case-metric .m-note { font-size: .78rem; color: var(--text-muted); margin-top: .3rem; max-width: 26ch; }
      .case-card .case-cue { display: inline-flex; align-items: center; gap: .35rem; font-family: var(--font-mono); font-size: .65rem; letter-spacing: .18em; text-transform: uppercase; font-weight: 600; padding: .5rem 1rem; border-radius: var(--radius-pill); transition: var(--t-smooth); flex-shrink: 0; }
