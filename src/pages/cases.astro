      .etapa-card .e-prazo { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text-faint); margin-top: .35rem; display: block; }
      .etapa-card .e-desc { font-size: .875rem; line-height: 1.55; color: var(--text-muted); margin-top: .6rem; }

      /* faq · acordeão light */
