      .case-card .case-cover::after { content: ''; position: absolute; inset: 0; background-image: radial-gradient(rgba(15,15,17,.06) 1px, transparent 1px); background-size: 28px 28px; opacity: .5; pointer-events: none; }
      .case-card .case-body { padding: 2rem 2rem 2.25rem; flex: 1; display: flex; flex-direction: column; gap: 1rem; }
      .case-card .case-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; font-family: var(--font-mono); font-size: .65rem; letter-spacing: .18em; text-transform: uppercase; color: var(--text-faint); font-weight: 600; }
