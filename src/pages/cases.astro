---
<BaseLayout
  title="Cases · comunicação para inovação por resultado"
  description="Cases da PiaR Group em fintech, healthtech, agro, crise e institucional: 470+ marcas em 13 anos. Cada projeto traz contexto, ângulo e trabalho, com número de lastro."
>
  <Fragment slot="head">
    <style is:global>
      /* Tokens herdados de tokens.css (fonte única da verdade): paper, acento,
         texto, raios, fontes e easings vêm todos do Design System. Sem override local. */
      :root {
        /* Paleta escura das páginas-deck (comunicacao-integrada, para-cmos, pep...).
           Estes nomes não estão em tokens.css; cada página do time escuro os declara. */
        --space: #07080C;
        --text-d: #FFFFFF;
        --text-d-muted: rgba(255, 255, 255, .68);
        --text-d-faint: rgba(255, 255, 255, .42);
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      /* A pagina roda escura por padrao, como o resto do site, e alterna faixas claras
         (.sec-light) secao a secao. Antes ela era clara de ponta a ponta, herdeira da
         direcao blend que foi descartada. */
      body { font-family: var(--font-sans); background: var(--space); color: var(--text-d); overflow-x: hidden; -webkit-font-smoothing: antialiased; font-feature-settings: "ss01", "cv11"; }
      ::selection { background: var(--primary); color: var(--accent); }
      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: rgba(255,255,255,.16); border-radius: 10px; }
      html.lenis { height: auto; }
      .lenis.lenis-smooth { scroll-behavior: auto; }

      .ds-body-lg { font-size: 1.25rem; font-weight: 400; line-height: 1.5; letter-spacing: -.01em; }
      .ds-body { font-size: 1.0625rem; font-weight: 400; line-height: 1.55; letter-spacing: -.01em; }
      .ds-body-sm { font-size: .875rem; font-weight: 400; line-height: 1.55; }
      .ds-mono { font-family: var(--font-mono); font-size: .72rem; letter-spacing: -.01em; text-transform: uppercase; }
      .italic-serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -.02em; }

      /* ---- Alternancia escuro / claro (o ritmo das demais paginas) ---- */
      .sec-dark  { background: var(--space); color: var(--text-d); border-top: 1px solid var(--hairline-d); }
      .sec-light { background: #fafafa; color: var(--primary); border-top: 1px solid var(--hairline); }

      .reveal { opacity: 0; transform: translateY(2rem); transition: var(--t-smooth); }
      .reveal.active { opacity: 1; transform: none; }
      .delay-100 { transition-delay: .1s; } .delay-200 { transition-delay: .2s; }
      .delay-300 { transition-delay: .3s; } .delay-400 { transition-delay: .4s; }

      #scroll-progress { position: fixed; top: 0; left: 0; height: 2px; background: var(--accent); z-index: 9999; width: 0; transition: width .1s linear; }

      /* eyebrow + bullet */
      .eyebrow-dot { display: inline-flex; align-items: center; gap: .55rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; color: var(--text-muted); font-weight: 600; }
      .eyebrow-dot::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex-shrink: 0; box-shadow: 0 0 0 4px rgba(254,209,54,.18); }
      .eyebrow-dot.on-dark { color: rgba(255,255,255,.72); }

      /* botões · só 3 raios (20 / 999 / 50%) */
      .ink-pill { display: inline-flex; align-items: center; gap: .55rem; padding: .85rem 1.6rem; border-radius: var(--radius-btn); background: var(--primary); color: var(--paper); border: 1.5px solid var(--primary); font-size: .94rem; font-weight: 500; letter-spacing: -.01em; transition: var(--t-smooth); text-decoration: none; }
      .ink-pill:hover { background: #000; transform: translateY(-2px); box-shadow: 0 14px 28px rgba(0,0,0,.18); }
      .ink-pill iconify-icon { transition: transform .4s var(--ease-out-expo); }
      .ink-pill:hover iconify-icon { transform: translateX(4px); }
      .ink-pill.yellow { background: var(--accent); color: var(--primary); border-color: var(--accent); }
      .ink-pill.yellow:hover { background: #FFD84A; box-shadow: 0 14px 28px rgba(254,209,54,.32); }
      .outline-pill { display: inline-flex; align-items: center; gap: .55rem; padding: .85rem 1.55rem; border-radius: var(--radius-btn); background: #fff; color: var(--primary); border: 1.5px solid var(--primary); font-size: .94rem; font-weight: 500; transition: var(--t-smooth); text-decoration: none; }
      .outline-pill:hover { background: var(--primary); color: var(--paper); }


      /* chip pill */
      .chip-pill { display: inline-flex; align-items: center; gap: .5rem; padding: .55rem 1.1rem; border-radius: var(--radius-pill); font-family: var(--font-mono); font-size: .68rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; }
      .chip-pill.yellow { background: var(--accent); color: var(--primary); }
      .chip-pill.outline-light { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,.28); }
      .chip-pill.outline-dark { background: transparent; color: var(--primary); border: 1px solid var(--hairline-strong); }
      .chip-pill.solid-dark { background: var(--primary); color: var(--paper); }

      /* stats band · 4 cells · 60-30-10 color rule respeitado */
      .stats-band { display: grid; grid-template-columns: 1fr; }
      @media (min-width: 768px) { .stats-band { grid-template-columns: repeat(4, 1fr); } }
      .stat-cell { padding: 2.5rem 2rem; border-right: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
      @media (min-width: 768px) { .stat-cell:nth-child(4) { border-right: 0; } .stat-cell { border-bottom: 0; } }
      .stat-cell .stat-num { font-size: clamp(2.5rem, 4.5vw, 4rem); font-weight: 700; letter-spacing: -.045em; line-height: 1; }
      .stat-cell .stat-num em { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--accent-deep); font-size: 0.65em; }
      .stat-cell .stat-num .accent { color: var(--accent); }
      .stat-cell .stat-label { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .22em; text-transform: uppercase; color: var(--accent-deep); font-weight: 600; margin-top: 1.25rem; }
      .stat-cell .stat-desc { font-size: .92rem; color: var(--text-muted); line-height: 1.5; margin-top: .65rem; max-width: 28ch; }

      /* case card · variantes paper / yellow / dark-featured */
      .case-card { position: relative; border-radius: 24px; overflow: hidden; transition: var(--t-smooth); text-decoration: none; display: flex; flex-direction: column; isolation: isolate; }
      .case-card:hover { transform: translateY(-6px); }
