  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      try {
        if (window.gsap && window.ScrollTrigger) window.gsap.registerPlugin(window.ScrollTrigger);
        if (!prefersReduced && window.Lenis) {
          const lenis = new window.Lenis({ duration: 1.2, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), smooth: true, lerp: 0.1 });
          if (window.ScrollTrigger) { lenis.on('scroll', window.ScrollTrigger.update); window.gsap.ticker.add((time) => lenis.raf(time * 1000)); window.gsap.ticker.lagSmoothing(0); }
        }
      } catch (e) { /* noop */ }
      const progressBar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', () => {
        const h = document.documentElement;
        const p = (h.scrollTop) / (h.scrollHeight - h.clientHeight) * 100;
        if (progressBar) progressBar.style.width = p + '%';
      }, { passive: true });

      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('active'); io.unobserve(e.target); }
        });
      }, { threshold: 0.15 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    });
      /* ---- Carrossel dos exits ---- */
      (function carrosselExits() {
        var trilho = document.getElementById('ec-trilho');
        if (!trilho) return;
        var slides = Array.prototype.slice.call(trilho.querySelectorAll('.ec-slide'));
        var pontos = Array.prototype.slice.call(document.querySelectorAll('.ec-ponto'));
        var ant = document.getElementById('ec-ant');
        var prox = document.getElementById('ec-prox');
        if (!slides.length) return;

        var atual = 0;
        function irPara(i) {
          i = Math.max(0, Math.min(slides.length - 1, i));
          trilho.scrollTo({ left: slides[i].offsetLeft - trilho.offsetLeft, behavior: 'smooth' });
        }
        function pintar(i) {
          atual = i;
          pontos.forEach(function (p, k) { p.setAttribute('aria-current', k === i ? 'true' : 'false'); });
          if (ant) ant.disabled = i === 0;
          if (prox) prox.disabled = i === slides.length - 1;
        }
        pintar(0);

        // quem manda no indicador e o scroll, nao o clique: arrastar no dedo tambem atualiza
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (ents) {
            ents.forEach(function (e) {
              if (e.isIntersecting && e.intersectionRatio > 0.6) pintar(slides.indexOf(e.target));
            });
          }, { root: trilho, threshold: [0.6] });
          slides.forEach(function (sl) { io.observe(sl); });
        }

        if (ant) ant.addEventListener('click', function () { irPara(atual - 1); });
        if (prox) prox.addEventListener('click', function () { irPara(atual + 1); });
        pontos.forEach(function (p) {
          p.addEventListener('click', function () { irPara(parseInt(p.getAttribute('data-ir'), 10) || 0); });
        });
        trilho.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowRight') { e.preventDefault(); irPara(atual + 1); }
          if (e.key === 'ArrowLeft') { e.preventDefault(); irPara(atual - 1); }
        });
        trilho.setAttribute('tabindex', '0');
      })();

  </script>
