      .partners-strip .partner:hover { border-color: var(--primary); background: var(--primary); color: var(--paper); transform: translateY(-2px); }

      /* capability card · capacidades descritas (crise, reputação) */
      .cap-card { background: #fff; border: 1px solid var(--hairline); border-radius: 24px; padding: 2.25rem 2rem 2rem; display: flex; flex-direction: column; gap: 1.1rem; transition: var(--t-smooth); }
      .cap-card:hover { box-shadow: 0 30px 60px rgba(0,0,0,.07); border-color: var(--hairline-strong); transform: translateY(-4px); }
      .cap-card .cap-head { display: flex; align-items: center; gap: .9rem; }
      .cap-card .cap-head iconify-icon { font-size: 2.1rem; color: var(--primary); flex-shrink: 0; }
      .cap-card .cap-setor { font-family: var(--font-mono); font-size: .65rem; letter-spacing: .2em; text-transform: uppercase; color: var(--text-faint); font-weight: 600; }
